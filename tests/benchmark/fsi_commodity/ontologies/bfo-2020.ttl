<http://purl.obolibrary.org/obo/BFO_0000142> a owl:Class ;
    rdfs:label "fiat line" ;
    rdfs:comment "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> .

<http://purl.obolibrary.org/obo/BFO_0000145> a owl:Class ;
    rdfs:label "relational quality" ;
    rdfs:comment "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> .

<http://purl.obolibrary.org/obo/BFO_0000146> a owl:Class ;
    rdfs:label "fiat surface" ;
    rdfs:comment "(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> .

<http://purl.obolibrary.org/obo/BFO_0000147> a owl:Class ;
    rdfs:label "fiat point" ;
    rdfs:comment "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> .

