@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://purl.obolibrary.org/obo/BFO_0000009> a owl:Class ;
    rdfs:label "two-dimensional spatial region" ;
    rdfs:comment "(Elucidation) A two-dimensional spatial region is a spatial region that is a whole consisting of a surface together with zero or more surfaces which may have spatial regions of lower dimension as parts" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006> .

<http://purl.obolibrary.org/obo/BFO_0000018> a owl:Class ;
    rdfs:label "zero-dimensional spatial region" ;
    rdfs:comment "(Elucidation) A zero-dimensional spatial region is one or a collection of more than one spatially disjoint points in space" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006> .

<http://purl.obolibrary.org/obo/BFO_0000023> a owl:Class ;
    rdfs:label "role" ;
    rdfs:comment "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:altLabel "externally-grounded realizable entity" .

<http://purl.obolibrary.org/obo/BFO_0000024> a owl:Class ;
    rdfs:label "fiat object part" ;
    rdfs:comment "(Elucidation) A fiat object part b is a material entity & such that if b exists then it is continuant part of some object c & demarcated from the remainder of c by one or more fiat surfaces" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

<http://purl.obolibrary.org/obo/BFO_0000026> a owl:Class ;
    rdfs:label "one-dimensional spatial region" ;
    rdfs:comment "(Elucidation) A one-dimensional spatial region is a whole consisting of a line together with zero or more lines which may have points as parts" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006> .

<http://purl.obolibrary.org/obo/BFO_0000027> a owl:Class ;
    rdfs:label "object aggregate" ;
    rdfs:comment "(Elucidation) An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

<http://purl.obolibrary.org/obo/BFO_0000028> a owl:Class ;
    rdfs:label "three-dimensional spatial region" ;
    rdfs:comment "(Elucidation) A three-dimensional spatial region is a whole consisting of a spatial volume together with zero or more spatial volumes which may have spatial regions of lower dimension as parts" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006> .

<http://purl.obolibrary.org/obo/BFO_0000029> a owl:Class ;
    rdfs:label "site" ;
    rdfs:comment "(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

<http://purl.obolibrary.org/obo/BFO_0000030> a owl:Class ;
    rdfs:label "object" ;
    rdfs:comment "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> .

<http://purl.obolibrary.org/obo/BFO_0000034> a owl:Class ;
    rdfs:label "function" ;
    rdfs:comment "(Elucidation) A function is a disposition that exists in virtue of its bearer's physical make-up & this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> .

<http://purl.obolibrary.org/obo/BFO_0000035> a owl:Class ;
    rdfs:label "process boundary" ;
    rdfs:comment "p is a process boundary =Def p is a temporal part of a process & p has no proper temporal parts" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> .

