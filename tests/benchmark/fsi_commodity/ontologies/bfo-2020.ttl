<http://purl.obolibrary.org/obo/bfo.owl> a owl:Ontology ;
    rdfs:label "Basic Formal Ontology 2020" ;
    owl:versionInfo "1" .

<http://purl.obolibrary.org/obo/BFO_0000019> a owl:Class ;
    rdfs:label "quality" ;
    rdfs:comment "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> .

<http://purl.obolibrary.org/obo/BFO_0000038> a owl:Class ;
    rdfs:label "one-dimensional temporal region" ;
    rdfs:comment "(Elucidation) A one-dimensional temporal region is a temporal region that is a whole that has a temporal interval and zero or more temporal intervals and temporal instants as parts" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000008> .

<http://purl.obolibrary.org/obo/BFO_0000148> a owl:Class ;
    rdfs:label "zero-dimensional temporal region" ;
    rdfs:comment "(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000008> .

<http://purl.obolibrary.org/obo/BFO_0000004> a owl:Class ;
    rdfs:label "independent continuant" ;
    rdfs:comment "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> .

<http://purl.obolibrary.org/obo/BFO_0000182> a owl:Class ;
    rdfs:label "history" ;
    rdfs:comment "(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> .

<http://purl.obolibrary.org/obo/BFO_0000001> a owl:Class ;
    rdfs:label "entity" ;
    rdfs:comment "(Elucidation) An entity is anything that exists or has existed or will exist" .

<http://purl.obolibrary.org/obo/BFO_0000140> a owl:Class ;
    rdfs:label "continuant fiat boundary" ;
    rdfs:comment "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

<http://purl.obolibrary.org/obo/BFO_0000141> a owl:Class ;
    rdfs:label "immaterial entity" ;
    rdfs:comment "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> .

<http://purl.obolibrary.org/obo/BFO_0000011> a owl:Class ;
    rdfs:label "spatiotemporal region" ;
    rdfs:comment "(Elucidation) A spatiotemporal region is an occurrent that is an occurrent part of spacetime" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> .

<http://purl.obolibrary.org/obo/BFO_0000017> a owl:Class ;
    rdfs:label "realizable entity" ;
    rdfs:comment "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> .

<http://purl.obolibrary.org/obo/BFO_0000203> a owl:Class ;
    rdfs:label "temporal instant" ;
    rdfs:comment "(Elucidation) A temporal instant is a zero-dimensional temporal region that has no proper temporal part" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000148> .

<http://purl.obolibrary.org/obo/BFO_0000016> a owl:Class ;
    rdfs:label "disposition" ;
    rdfs:comment "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:altLabel "internally-grounded realizable entity" .

<http://purl.obolibrary.org/obo/BFO_0000020> a owl:Class ;
    rdfs:label "specifically dependent continuant" ;
    rdfs:comment "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> .

<http://purl.obolibrary.org/obo/BFO_0000015> a owl:Class ;
    rdfs:label "process" ;
    rdfs:comment "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:altLabel "event" .

<http://purl.obolibrary.org/obo/BFO_0000006> a owl:Class ;
    rdfs:label "spatial region" ;
    rdfs:comment "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> .

<http://purl.obolibrary.org/obo/BFO_0000031> a owl:Class ;
    rdfs:label "generically dependent continuant" ;
    rdfs:comment "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
    skos:altLabel "g-dependent continuant" .

<http://purl.obolibrary.org/obo/BFO_0000008> a owl:Class ;
    rdfs:label "temporal region" ;
    rdfs:comment "(Elucidation) A temporal region is an occurrent over which processes can unfold" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> .

<http://purl.obolibrary.org/obo/BFO_0000040> a owl:Class ;
    rdfs:label "material entity" ;
    rdfs:comment "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> .

<http://purl.obolibrary.org/obo/BFO_0000002> a owl:Class ;
    rdfs:label "continuant" ;
    rdfs:comment "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .

<http://purl.obolibrary.org/obo/BFO_0000003> a owl:Class ;
    rdfs:label "occurrent" ;
    rdfs:comment "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .

