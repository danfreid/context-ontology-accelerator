    rdfs:range <urn:dcsa:ebl:Reference> .

<urn:dcsa:ebl:UpdateShippingInstructions.requestedCarrierCertificates> a owl:DatatypeProperty ;
    rdfs:label "requestedCarrierCertificates" ;
    rdfs:domain <urn:dcsa:ebl:UpdateShippingInstructions> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UpdateShippingInstructions.requestedCarrierClauses> a owl:DatatypeProperty ;
    rdfs:label "requestedCarrierClauses" ;
    rdfs:domain <urn:dcsa:ebl:UpdateShippingInstructions> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UpdateShippingInstructions.shippingInstructionsReference> a owl:DatatypeProperty ;
    rdfs:label "shippingInstructionsReference" ;
    rdfs:domain <urn:dcsa:ebl:UpdateShippingInstructions> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UpdateShippingInstructions.transportDocumentTypeCode> a owl:DatatypeProperty ;
    rdfs:label "transportDocumentTypeCode" ;
    rdfs:domain <urn:dcsa:ebl:UpdateShippingInstructions> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UpdateShippingInstructions.utilizedTransportEquipments> a owl:ObjectProperty ;
    rdfs:label "utilizedTransportEquipments" ;
    rdfs:domain <urn:dcsa:ebl:UpdateShippingInstructions> ;
    rdfs:range <urn:dcsa:ebl:UtilizedTransportEquipmentShipper> .

<urn:dcsa:ebl:UtilizedTransportEquipment.activeReeferSettings> a owl:ObjectProperty ;
    rdfs:label "activeReeferSettings" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipment> ;
    rdfs:range <urn:dcsa:ebl:ActiveReeferSettings> .

<urn:dcsa:ebl:UtilizedTransportEquipment.customsReferences> a owl:ObjectProperty ;
    rdfs:label "customsReferences" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipment> ;
    rdfs:range <urn:dcsa:ebl:CustomsReference> .

<urn:dcsa:ebl:UtilizedTransportEquipment.equipment> a owl:ObjectProperty ;
    rdfs:label "equipment" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipment> ;
    rdfs:range <urn:dcsa:ebl:Equipment> .

<urn:dcsa:ebl:UtilizedTransportEquipment.isNonOperatingReefer> a owl:DatatypeProperty ;
    rdfs:label "isNonOperatingReefer" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipment> ;
    rdfs:range xsd:boolean .

<urn:dcsa:ebl:UtilizedTransportEquipment.isShipperOwned> a owl:DatatypeProperty ;
    rdfs:label "isShipperOwned" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipment> ;
    rdfs:range xsd:boolean .

<urn:dcsa:ebl:UtilizedTransportEquipment.references> a owl:ObjectProperty ;
    rdfs:label "references" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipment> ;
    rdfs:range <urn:dcsa:ebl:Reference> .

<urn:dcsa:ebl:UtilizedTransportEquipment.seals> a owl:ObjectProperty ;
    rdfs:label "seals" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipment> ;
    rdfs:range <urn:dcsa:ebl:Seal> .

<urn:dcsa:ebl:UtilizedTransportEquipment.shippingMarks> a owl:DatatypeProperty ;
    rdfs:label "shippingMarks" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipment> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UtilizedTransportEquipmentHBL.ISOEquipmentCode> a owl:DatatypeProperty ;
    rdfs:label "ISOEquipmentCode" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentHBL> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UtilizedTransportEquipmentHBL.emptyIndicatorCode> a owl:DatatypeProperty ;
    rdfs:label "emptyIndicatorCode" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentHBL> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UtilizedTransportEquipmentHBL.equipmentReference> a owl:DatatypeProperty ;
    rdfs:label "equipmentReference" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentHBL> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UtilizedTransportEquipmentHBL.isShipperOwned> a owl:DatatypeProperty ;
    rdfs:label "isShipperOwned" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentHBL> ;
    rdfs:range xsd:boolean .

<urn:dcsa:ebl:UtilizedTransportEquipmentHBL.seals> a owl:ObjectProperty ;
    rdfs:label "seals" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentHBL> ;
    rdfs:range <urn:dcsa:ebl:Seal> .

<urn:dcsa:ebl:UtilizedTransportEquipmentShipper.customsReferences> a owl:ObjectProperty ;
    rdfs:label "customsReferences" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentShipper> ;
    rdfs:range <urn:dcsa:ebl:CustomsReference> .

<urn:dcsa:ebl:UtilizedTransportEquipmentShipper.emptyIndicatorCode> a owl:DatatypeProperty ;
    rdfs:label "emptyIndicatorCode" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentShipper> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:UtilizedTransportEquipmentShipper.references> a owl:ObjectProperty ;
    rdfs:label "references" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentShipper> ;
    rdfs:range <urn:dcsa:ebl:Reference> .

<urn:dcsa:ebl:UtilizedTransportEquipmentShipper.seals> a owl:ObjectProperty ;
    rdfs:label "seals" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentShipper> ;
    rdfs:range <urn:dcsa:ebl:Seal> .

<urn:dcsa:ebl:UtilizedTransportEquipmentShipper.shippingMarks> a owl:DatatypeProperty ;
    rdfs:label "shippingMarks" ;
    rdfs:domain <urn:dcsa:ebl:UtilizedTransportEquipmentShipper> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:VesselVoyage.carrierExportVoyageNumber> a owl:DatatypeProperty ;
    rdfs:label "carrierExportVoyageNumber" ;
    rdfs:domain <urn:dcsa:ebl:VesselVoyage> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:VesselVoyage.universalExportVoyageReference> a owl:DatatypeProperty ;
    rdfs:label "universalExportVoyageReference" ;
    rdfs:domain <urn:dcsa:ebl:VesselVoyage> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:VesselVoyage.vesselName> a owl:DatatypeProperty ;
    rdfs:label "vesselName" ;
    rdfs:domain <urn:dcsa:ebl:VesselVoyage> ;
    rdfs:range xsd:string .

<urn:dcsa:ebl:ApproveTransportDocument> a owl:Class ;
    rdfs:label "Approve Transport Document" ;
    skos:altLabel "ApproveTransportDocument",
        "approve transport document" .

<urn:dcsa:ebl:CancelShippingInstructionsUpdate> a owl:Class ;
    rdfs:label "Cancel Shipping Instructions Update" ;
    skos:altLabel "CancelShippingInstructionsUpdate",
        "cancel shipping instructions update" .

<urn:dcsa:ebl:CreateShippingInstructionsResponse> a owl:Class ;
    rdfs:label "Create Shipping Instructions Response" ;
    rdfs:comment "**Only** the `shippingInstructionsReference` is returned." ;
    skos:altLabel "CreateShippingInstructionsResponse",
        "create shipping instructions response" .

<urn:dcsa:ebl:InvoicePayableAt> a owl:Class ;
    rdfs:label "Invoice Payable At" ;
    rdfs:comment """Location where payment of ocean freight and charges for the main transport will take place by the customer.

The location can be provided as a `UN Location Code` or as a fallback - a `freeText` field""" ;
    skos:altLabel "InvoicePayableAt",
        "invoice payable at" .

<urn:dcsa:ebl:ShippingInstructionsFullNotification> a owl:Class ;
    rdfs:label "Shipping Instructions Full Notification" ;
    rdfs:comment """This property contains the shippingInstructions in case the subscriber is subscribing to the `Full State Transfer` of the Shipping Instructions.

In case the subscriber does not subscribe to the `Full State Transfer` of the Shipping Instructions then the content in this property can be ignored.""" ;
    rdfs:subClassOf <urn:dcsa:ebl:ShippingInstructions> ;
    skos:altLabel "ShippingInstructionsFullNotification",
        "shipping instructions full notification" .

<urn:dcsa:ebl:TransportDocumentFullNotification> a owl:Class ;
    rdfs:label "Transport Document Full Notification" ;
    rdfs:comment """This property contains the `transportDocument` in case the subscriber is subscribing to the `Full State Transfer` of the `Transport Document`.

In case the subscriber does not subscribe to the `Full State Transfer` of the `Transport Document` then the content in this property can be ignored.

**Condition:** Once the `Transport Document` has been Issued (`transportDocumentStatus='ISSUED'`) - the order of **ALL** lists/arrays in this property **MUST** be aligned with the order of the

    GET /v3/transport-documents/{transportDocumentReference}

payload implemented by the provider of the **Shipping Instructions and Transport Document** API.""" ;
    rdfs:subClassOf <urn:dcsa:ebl:TransportDocument> ;
    skos:altLabel "TransportDocumentFullNotification",
        "transport document full notification" .

<urn:dcsa:ebl:UpdatedShippingInstructionsFullNotification> a owl:Class ;
    rdfs:label "Updated Shipping Instructions" ;
    rdfs:comment """This property contains the updated shipping instructions in case:
  - an update is currently active
  - the subscriber is subscribing to the `Full State Transfer` of the Shipping Instructions

In case the subscriber does not subscribe to the `Full State Transfer` of the Shipping Instructions or no update is active - then the content in this property can be ignored.""" ;
    rdfs:subClassOf <urn:dcsa:ebl:ShippingInstructions> ;
    skos:altLabel "UpdatedShippingInstructionsFullNotification",
        "updated shipping instructions full notification" .

<urn:dcsa:ebl:UTEquipment> a owl:Class ;
    rdfs:label "Shipper Owned Equipment (SoC)" ;
    rdfs:comment "To be used for SoC (Shipper owned Containers). If `isShipperOwned` is true then the equipment used needs to be specified" ;
    skos:altLabel "UTEquipment",
        "utequipment" .

<urn:dcsa:ebl:UTEquipmentReference> a owl:Class ;
    rdfs:label "Carrier Owned Equipment" ;
    rdfs:comment "To be used when referring to carrier owned containers (`isShipperOwned` is false). In this case it is only necessary to provide `equipmentReference`" ;
    skos:altLabel "UTEquipmentReference",
        "utequipment reference" .

<urn:dcsa:ebl:GrossWeight> a owl:Class ;
    rdfs:label "Gross Weight" ;
    rdfs:comment "Total weight of the goods carried, including packaging." ;
    skos:altLabel "GrossWeight",
        "gross weight" .

<urn:dcsa:ebl:NetExplosiveContent> a owl:Class ;
    rdfs:label "Net Explosive Content" ;
    rdfs:comment "The total weight of the explosive substances, without the packaging’s, casings, etc." ;
    skos:altLabel "NetExplosiveContent",
        "net explosive content" .

<urn:dcsa:ebl:NetVolume> a owl:Class ;
    rdfs:label "Net Volume" ;
    rdfs:comment """The volume of the referenced dangerous goods.

**Condition:** only applicable to liquids and gas.""" ;
    skos:altLabel "NetVolume",
        "net volume" .

<urn:dcsa:ebl:NetWeight> a owl:Class ;
    rdfs:label "Net Weight" ;
    rdfs:comment "Total weight of the goods carried, excluding packaging." ;
    skos:altLabel "NetWeight",
        "net weight" .

<urn:dcsa:ebl:OtherDocumentPartyHBL> a owl:Class ;
    rdfs:label "Other Document Party (House B/L)" ;
    rdfs:comment "A list of document parties that can be optionally provided in the `Shipping Instructions` and `Transport Document`." ;
    skos:altLabel "OtherDocumentPartyHBL",
        "other document party hbl" .

<urn:dcsa:ebl:PartyContactDetailWithPattern> a owl:Class ;
    rdfs:label "Party Contact Detail (with phone pattern)" ;
    rdfs:comment "The contact details of the person to contact. It is mandatory to provide either `phone` and/or `email` along with the `name`, both can be provided." ;
    skos:altLabel "PartyContactDetailWithPattern",
        "party contact detail with pattern" .

<urn:dcsa:ebl:CargoGrossVolume> a owl:Class ;
    rdfs:label "Cargo Gross Volume" ;
    rdfs:comment "Calculated by multiplying the width, height, and length of the packed cargo." ;
    skos:altLabel "CargoGrossVolume",
        "cargo gross volume" .

<urn:dcsa:ebl:CargoItemHBL> a owl:Class ;
    rdfs:label "Cargo Item (House B/L)" ;
    rdfs:comment "A `cargoItem` is the smallest unit used by stuffing. A `cargoItem` cannot be split across containers." ;
    skos:altLabel "CargoItemHBL",
        "cargo item hbl" .

<urn:dcsa:ebl:CargoNetVolume> a owl:Class ;
    rdfs:label "Cargo Net Volume" ;
    rdfs:comment "Calculated by multiplying the width, height, and length of the cargo, excluding packaging." ;
    skos:altLabel "CargoNetVolume",
        "cargo net volume" .

<urn:dcsa:ebl:CargoNetWeight> a owl:Class ;
    rdfs:label "Cargo Net Weight" ;
    rdfs:comment "The weight of the cargo item excluding packaging being carried in the container. Excludes the tare weight of the container." ;
    skos:altLabel "CargoNetWeight",
        "cargo net weight" .

<urn:dcsa:ebl:CarriersAgentAtDestination> a owl:Class ;
    rdfs:label "Carrier's Agent At Destination" ;
    rdfs:comment "The party on the import side assigned by the carrier to whom the customer need to reach out to for cargo release." ;
    skos:altLabel "CarriersAgentAtDestination",
        "carriers agent at destination" .

<urn:dcsa:ebl:Equipment> a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:comment "Used for storing cargo in/on during transport. The equipment size/type is defined by the ISO 6346 code. The most common equipment size/type is 20'/40'/45' DRY Freight Container, but several different versions exist." ;
    skos:altLabel "equipment" .

<urn:dcsa:ebl:GeoCoordinate> a owl:Class ;
    rdfs:label "Geo Coordinate" ;
    rdfs:comment "An object used to express a location using `latitude` and `longitude`." ;
    skos:altLabel "GeoCoordinate",
        "geo coordinate" .

<urn:dcsa:ebl:InnerPackaging> a owl:Class ;
    rdfs:label "Inner Packaging" ;
    rdfs:comment "Object for inner packaging specification" ;
    skos:altLabel "InnerPackaging",
        "inner packaging" .

<urn:dcsa:ebl:InvoicePayableAtShippingInstructions> a owl:Class ;
    rdfs:label "Invoice Payable At (Shipping Instructions)" ;
    rdfs:comment """Location where payment of ocean freight and charges for the main transport will take place by the customer.

The location must be provided as a `UN Location Code`""" ;
    skos:altLabel "InvoicePayableAtShippingInstructions",
        "invoice payable at shipping instructions" .

<urn:dcsa:ebl:OtherDocumentParty> a owl:Class ;
    rdfs:label "Other Document Party" ;
    rdfs:comment "A list of document parties that can be optionally provided in the `Shipping Instructions` and `Transport Document`." ;
    skos:altLabel "OtherDocumentParty",
        "other document party" .

<urn:dcsa:ebl:PlaceOfAcceptance> a owl:Class ;
    rdfs:label "Place of Acceptance" ;
    rdfs:comment """An object to capture `Place of Acceptance` location specified as: identification of the seaport, freight terminal or other place at which the goods are taken over from the shipper by the Ocean Transport Intermediary (OTI) issuing the `House Bill of Lading`.

**Condition:** Mandatory if different from `Place of Receipt` or `Port of Loading` at the `Master Transport Document` level.

**Condition:** The location can be specified either using `UN Location Code` and/or (`Location Name` together with `Country Code`), all three properties can be specified.""" ;
    skos:altLabel "PlaceOfAcceptance",
        "place of acceptance" .

<urn:dcsa:ebl:PlaceOfFinalDelivery> a owl:Class ;
    rdfs:label "Place of Final Delivery" ;
    rdfs:comment """An object to capture `Place of Final Delivery` location specified as: Identification of the seaport, freight terminal or other place at which the goods are handed over from the `Ocean Transport Intermediary` (OTI) issuing the `House Bill of Lading` to the `Consignee`.

**Condition:** Mandatory if different from `Place of Delivery` at the `Master Transport Document` level.

**Condition:** The location can be specified either using `UN Location Code` and/or (`Location Name` together with `Country Code`), all three properties can be specified.""" ;
    skos:altLabel "PlaceOfFinalDelivery",
        "place of final delivery" .

<urn:dcsa:ebl:PortOfDischarge> a owl:Class ;
    rdfs:label "Port of Discharge" ;
    rdfs:comment """An object to capture `Port of Discharge` location specified as: the location where the cargo is discharged from the last sea-going vessel.

The location can be specified in **any** of the following ways: `UN Location Code` or `City and Country`.

**Condition:** It is expected that if a location is specified in multiple ways (e.g. both as an `UN Location Code` and as a `City and Country`) that both ways point to the same location.""" ;
    skos:altLabel "PortOfDischarge",
        "port of discharge" .

<urn:dcsa:ebl:PortOfLoading> a owl:Class ;
    rdfs:label "Port of Loading" ;
    rdfs:comment """An object to capture `Port of Loading` location specified as: the location where the cargo is loaded onto a first sea-going vessel for water transportation.

The location can be specified in **any** of the following ways: `UN Location Code` or `City and Country`.

**Condition:** It is expected that if a location is specified in multiple ways (e.g. both as an `UN Location Code` and as a `City and Country`) that both ways point to the same location.""" ;
    skos:altLabel "PortOfLoading",
        "port of loading" .

<urn:dcsa:ebl:ReferenceConsignmentItem> a owl:Class ;
    rdfs:label "Reference (Consignment Item)" ;
    rdfs:comment "References provided by the shipper or freight forwarder at the time of `Booking` or at the time of providing `Shipping Instructions`. Carriers share it back when providing `Track & Trace` event updates, some are also printed on the B/L. Customers can use these references to track shipments in their internal systems." ;
    skos:altLabel "ReferenceConsignmentItem",
        "reference consignment item" .

<urn:dcsa:ebl:RequiredEquipment> a owl:Class ;
    rdfs:label "Equipment (Required Properties)" ;
    rdfs:comment "Used for storing cargo in/on during transport. The equipment size/type is defined by the ISO 6346 code. The most common equipment size/type is 20'/40'/45' DRY Freight Container, but several different versions exist." ;
    skos:altLabel "RequiredEquipment",
        "required equipment" .

<urn:dcsa:ebl:TareWeight> a owl:Class ;
    rdfs:label "Tare Weight" ;
    rdfs:comment "The weight of an empty container (gross container weight)." ;
    skos:altLabel "TareWeight",
        "tare weight" .

<urn:dcsa:ebl:VesselVoyage> a owl:Class ;
    rdfs:label "Vessel/Voyage" ;
    rdfs:comment "Vessel and export voyage" ;
    skos:altLabel "VesselVoyage",
        "vessel voyage" .

<urn:dcsa:ebl:CargoGrossWeight> a owl:Class ;
    rdfs:label "Cargo Gross Weight" ;
    rdfs:comment "The weight of the cargo item including packaging being carried in the container. Excludes the tare weight of the container." ;
    skos:altLabel "CargoGrossWeight",
        "cargo gross weight" .

<urn:dcsa:ebl:City> a owl:Class ;
    rdfs:label "City" ;
    rdfs:comment "An object for storing city, state/region and country related information" ;
    skos:altLabel "city" .

<urn:dcsa:ebl:ConsignmentItemHBL> a owl:Class ;
    rdfs:label "Consignment Item (House B/L)" ;
    rdfs:comment "Defines a list of `CargoItems` belonging together in the same consignment. A `ConsignmentItem` can be split across multiple containers (`UtilizedTransportEquipment`) by referencing multiple `CargoItems`" ;
    skos:altLabel "ConsignmentItemHBL",
        "consignment item hbl" .

<urn:dcsa:ebl:EmergencyContactDetails> a owl:Class ;
    rdfs:label "Emergency Contact Details" ;
    rdfs:comment "24 hr emergency contact details" ;
    skos:altLabel "EmergencyContactDetails",
        "emergency contact details" .

<urn:dcsa:ebl:Facility> a owl:Class ;
    rdfs:label "Facility" ;
    rdfs:comment "An object used to express a location using a `Facility`. The facility can be expressed using one of `BIC` code or `SMDG` code. The `facilityCode` does not contain the `UNLocationCode` - this should be provided in the `UnLocationCode` attribute." ;
    skos:altLabel "facility" .

<urn:dcsa:ebl:IssueToParty> a owl:Class ;
    rdfs:label "Issue To Party" ;
    rdfs:comment "The party to whom the `Bill of Lading` must be issued." ;
    skos:altLabel "IssueToParty",
        "issue to party" .

<urn:dcsa:ebl:OnwardInlandRouting> a owl:Class ;
    rdfs:label "Onward Inland Routing" ;
    rdfs:comment """An object to capture `Onward Inland Routing` location specified as the end location of the inland movement that takes place after the container(s) being delivered to the port of discharge/place of delivery for account and risk of merchant (merchant haulage).

The location can be specified in **any** of the following ways: `UN Location Code`, `Facility` or an `Address`.

**Condition:** It is expected that if a location is specified in multiple ways (e.g. both as an `Address` and as a `Facility`) that both ways point to the same location.""" ;
    skos:altLabel "OnwardInlandRouting",
        "onward inland routing" .

<urn:dcsa:ebl:OuterPackagingHBL> a owl:Class ;
    rdfs:label "Outer Packaging (House B/L)" ;
    rdfs:comment "Object for outer packaging/overpack specification. Examples of overpacks are a number of packages stacked on to a pallet and secured by strapping or placed in a protective outer packaging such as a box or crate to form one unit for the convenience of handling and stowage during transport." ;
    skos:altLabel "OuterPackagingHBL",
        "outer packaging hbl" .

<urn:dcsa:ebl:OuterPackagingShipper> a owl:Class ;
    rdfs:label "Outer Packaging (Shipper)" ;
    rdfs:comment """Object for outer packaging/overpack specification. Examples of overpacks are a number of packages stacked on to a pallet and secured by strapping or placed in a protective outer packaging such as a box or crate to form one unit for the convenience of handling and stowage during transport.

**Condition:** Mandatory for non-dangerous goods cargo.""" ;
    skos:altLabel "OuterPackagingShipper",
        "outer packaging shipper" .

<urn:dcsa:ebl:PlaceOfIssue> a owl:Class ;
    rdfs:label "Place of Issue" ;
    rdfs:comment """An object to capture where the original Transport Document (`Bill of Lading`) will be issued.

**Condition:** The location can be specified as one of `UN Location Code` or `CountryCode`, but not both.""" ;
    skos:altLabel "PlaceOfIssue",
        "place of issue" .

<urn:dcsa:ebl:Seal> a owl:Class ;
    rdfs:label "Seal" ;
    rdfs:comment "Addresses the seal-related information associated with the shipment equipment. A seal is put on a shipment equipment once it is loaded. This `Seal` is meant to stay on until the shipment equipment reaches its final destination." ;
    skos:altLabel "seal" .

<urn:dcsa:ebl:DestinationChargesPaymentTerm> a owl:Class ;
    rdfs:label "Destination Charges Payment Term" ;
    rdfs:comment "An indicator of whether destination charges are prepaid (`PRE`) or collect (`COL`). When prepaid, the charges are the responsibility of the shipper or the Invoice payer on behalf of the shipper (if provided). When collect, the charges are the responsibility of the consignee or the Invoice payer on behalf of the consignee (if provided)." ;
    skos:altLabel "DestinationChargesPaymentTerm",
        "destination charges payment term" .

<urn:dcsa:ebl:IssuingParty> a owl:Class ;
    rdfs:label "Issuing Party" ;
    rdfs:comment "The company or a legal entity issuing the `Transport Document`." ;
    skos:altLabel "IssuingParty",
        "issuing party" .

<urn:dcsa:ebl:OriginChargesPaymentTerm> a owl:Class ;
    rdfs:label "Origin Charges Payment Term" ;
    rdfs:comment "An indicator of whether origin charges are prepaid (`PRE`) or collect (`COL`). When prepaid, the charges are the responsibility of the shipper or the Invoice payer on behalf of the shipper (if provided). When collect, the charges are the responsibility of the consignee or the Invoice payer on behalf of the consignee (if provided)." ;
    skos:altLabel "OriginChargesPaymentTerm",
        "origin charges payment term" .

<urn:dcsa:ebl:PlaceOfDelivery> a owl:Class ;
    rdfs:label "Place of Delivery" ;
    rdfs:comment """An object to capture `Place of Delivery` location specified as: the location where the cargo is handed over to the consignee, or his agent, by the shipping line and where responsibility of the shipping line ceases.

**Condition:** Only when onward transport is done by the carrier

The location can be specified in **any** of the following ways: `UN Location Code`, `Facility`, `Address` or a `Geo Coordinate`.

**Condition:** It is expected that if a location is specified in multiple ways (e.g. both as an `Address` and as a `Facility`) that both ways point to the same location.""" ;
    skos:altLabel "PlaceOfDelivery",
        "place of delivery" .

<urn:dcsa:ebl:PlaceOfReceipt> a owl:Class ;
    rdfs:label "Place of Receipt" ;
    rdfs:comment """An object to capture `Place of Receipt` location specified as: the location where the cargo is handed over by the shipper, or his agent, to the shipping line. This indicates the point at which the shipping line takes on responsibility for carriage of the container.

**Condition:** Only when pre-carriage is done by the carrier.

The location can be specified in **any** of the following ways: `UN Location Code`, `Facility`, `Address` or a `Geo Coordinate`.

**Condition:** It is expected that if a location is specified in multiple ways (e.g. both as an `Address` and as a `Facility`) that both ways point to the same location.""" ;
    skos:altLabel "PlaceOfReceipt",
        "place of receipt" .

<urn:dcsa:ebl:TransportDocumentData> a owl:Class ;
    rdfs:label "Transport Document Data" ;
    rdfs:comment "`Transport Document` specific properties for the `Notification`" ;
    skos:altLabel "TransportDocumentData",
        "transport document data" .

<urn:dcsa:ebl:UtilizedTransportEquipmentHBL> a owl:Class ;
    rdfs:label "Utilized Transport Equipment (House B/L)" ;
    rdfs:comment "Specifies the container (`Equipment`), `Seals` and `References`" ;
    skos:altLabel "UtilizedTransportEquipmentHBL",
        "utilized transport equipment hbl" .

<urn:dcsa:ebl:Buyer> a owl:Class ;
    rdfs:label "Buyer" ;
    rdfs:comment """The buyer is the last known entity to whom the goods are sold or agreed to be sold. If the goods are to be imported otherwise than in pursuance of a purchase, the details of the owner of the goods shall be provided.

**Condition:** Buyer and Seller are mandatory if `isCargoDeliveredInICS2Zone=true` and `manifesttypecode='ENS'` and `advancedManifestFilingPerformedBy='CARRIER'` and `isHouseBillofLadingsIssued=false`.""" ;
    skos:altLabel "buyer" .

<urn:dcsa:ebl:BuyerHBL> a owl:Class ;
    rdfs:label "Buyer (House B/L)" ;
    rdfs:comment """The buyer is the last known entity to whom the goods are sold or agreed to be sold. If the goods are to be imported otherwise than in pursuance of a purchase, the details of the owner of the goods shall be provided.

**Condition:** Buyer and Seller are mandatory if `isCargoDeliveredInICS2Zone=true` (on House B/L level) and `manifesttypecode='ENS'` and `advancedManifestFilingPerformedBy='CARRIER'`.""" ;
    skos:altLabel "BuyerHBL",
        "buyer hbl" .

<urn:dcsa:ebl:ConsigneeHBL> a owl:Class ;
    rdfs:label "Consignee (House B/L)" ;
    rdfs:comment "The ultimate recipient of the cargo. It must be different from the freight forwarder, (de)consolidator, postal operator, or customs agent." ;
    skos:altLabel "ConsigneeHBL",
        "consignee hbl" .

<urn:dcsa:ebl:DetailedError> a owl:Class ;
    rdfs:label "Detailed Error" ;
    rdfs:comment "A detailed description of what has caused the error." ;
    skos:altLabel "DetailedError",
        "detailed error" .

<urn:dcsa:ebl:DocumentPartiesHouseBL> a owl:Class ;
    rdfs:label "Document Parties (House B/L)" ;
    rdfs:comment """All `Parties` with associated roles for this `House Bill of Lading`.

**Condition:** `Buyer` and `Seller` are mandatory if `isCargoDeliveredInICS2Zone=true` (on House B/L level) **and** `advancedManifestFilingPerformedBy=CARRIER`""" ;
    skos:altLabel "DocumentPartiesHouseBL",
        "document parties house bl" .

<urn:dcsa:ebl:Endorsee> a owl:Class ;
    rdfs:label "Endorsee" ;
    rdfs:comment """The party to whom the title to the goods is transferred by means of endorsement.

**Condition:** Can only be provided for negotiable BLs (`isToOrder=true`). If a negotiable BL does not have an `Endorsee`, the BL is said to be "blank endorsed". Note `Consignee` and `Endorsee` are mutually exclusive.

**Condition:** If a `displayedAddress` is provided, it must be included in the `Transport Document` instead of the `address`.""" ;
    skos:altLabel "endorsee" .

<urn:dcsa:ebl:EndorseeShipper> a owl:Class ;
    rdfs:label "Endorsee (Shipper provided)" ;
    rdfs:comment """The party to whom the title to the goods is transferred by means of endorsement.

**Condition:** Can only be provided for negotiable BLs (`isToOrder=true`). If a negotiable BL does not have an `Endorsee`, the BL is said to be "blank endorsed". Note `Consignee` and `Endorsee` are mutually exclusive.

**Condition:** Either the `address` or a party `identifyingCode` must be provided in the `Shipping Instructions`. If a `displayedAddress` is provided, it must be included in the `Transport Document` instead of the `address`.""" ;
    skos:altLabel "EndorseeShipper",
        "endorsee shipper" .

<urn:dcsa:ebl:ExportLicense> a owl:Class ;
    rdfs:label "Export License" ;
    rdfs:comment """`Export License` requirements

**Condition:** Included if the property is provided in the `Shipping Instructions.`""" ;
    skos:altLabel "ExportLicense",
        "export license" .

<urn:dcsa:ebl:ImportLicense> a owl:Class ;
    rdfs:label "Import License" ;
    rdfs:comment """`Import License` requirements

**Condition:** Included if the property is provided in the `Shipping Instructions.`""" ;
    skos:altLabel "ImportLicense",
        "import license" .

<urn:dcsa:ebl:Limits> a owl:Class ;
    rdfs:label "Limits" ;
    rdfs:comment "Limits for the `Dangerous Goods`. The same `Temperature Unit` needs to apply to all attributes in this structure." ;
    skos:altLabel "limits" .

<urn:dcsa:ebl:NotifyPartyHBL> a owl:Class ;
    rdfs:label "Notify Party (House B/L)" ;
    rdfs:comment """The person to be notified when a shipment arrives at its destination.

**Condition:** Mandatory for To Order HBLs (HouseBL `isToOrder=true`)""" ;
    skos:altLabel "NotifyPartyHBL",
        "notify party hbl" .

<urn:dcsa:ebl:OuterPackaging> a owl:Class ;
    rdfs:label "Outer Packaging" ;
    rdfs:comment "Object for outer packaging/overpack specification. Examples of overpacks are a number of packages stacked on to a pallet and secured by strapping or placed in a protective outer packaging such as a box or crate to form one unit for the convenience of handling and stowage during transport." ;
    skos:altLabel "OuterPackaging",
        "outer packaging" .

<urn:dcsa:ebl:Party> a owl:Class ;
    rdfs:label "Party" ;
    rdfs:comment """Refers to a company or a legal entity.

**Condition:** Either the `address` or a party `identifyingCode` must be provided in the `Shipping Instructions`.""" ;
    skos:altLabel "party" .

<urn:dcsa:ebl:PartyContactDetailHBL> a owl:Class ;
    rdfs:label "Party Contact Detail (House B/L)" ;
    rdfs:comment "The contact details of the person to contact. It is mandatory to provide either `phone` and/or `email` along with the `name`, both can be provided." ;
    skos:altLabel "PartyContactDetailHBL",
        "party contact detail hbl" .

<urn:dcsa:ebl:PartyHBL> a owl:Class ;
    rdfs:label "Party (House B/L)" ;
    rdfs:comment "Refers to a company or a legal entity." ;
    skos:altLabel "PartyHBL",
        "party hbl" .

<urn:dcsa:ebl:Seller> a owl:Class ;
    rdfs:label "Seller" ;
    rdfs:comment """The seller is the last known entity by whom the goods are sold or agreed to be sold to the buyer. If the goods are to be imported otherwise than in pursuance of a purchase, the details of the owner of the goods shall be provided.

**Condition:** Buyer and Seller are mandatory if `isCargoDeliveredInICS2Zone=true` and `manifesttypecode='ENS'` and `advancedManifestFilingPerformedBy='CARRIER'` and `isHouseBillofLadingsIssued=false`.""" ;
    skos:altLabel "seller" .

<urn:dcsa:ebl:SellerHBL> a owl:Class ;
    rdfs:label "Seller (House B/L)" ;
    rdfs:comment """The seller is the last known entity by whom the goods are sold or agreed to be sold to the buyer. If the goods are to be imported otherwise than in pursuance of a purchase, the details of the owner of the goods shall be provided.

**Condition:** Buyer and Seller are mandatory if `isCargoDeliveredInICS2Zone=true` (on House B/L level) and `manifesttypecode='ENS'` and `advancedManifestFilingPerformedBy='CARRIER'`.""" ;
    skos:altLabel "SellerHBL",
        "seller hbl" .

<urn:dcsa:ebl:ShipperHBL> a owl:Class ;
    rdfs:label "Shipper (House B/L)" ;
    rdfs:comment "The `Shipper` on the `House Bill of Lading`." ;
    skos:altLabel "ShipperHBL",
        "shipper hbl" .

<urn:dcsa:ebl:AdvanceManifestFiling> a owl:Class ;
    rdfs:label "Advance Manifest Filing" ;
    rdfs:comment """An Advance Manifest Filing defined by a Manifest type code in combination with a country code.

A small list of **potential** examples:

| manifestTypeCode | countryCode | Description |
|-----------------------|:-------------:|-------------|
|ACI|EG|Advance Cargo Information in Egypt|
|ACE|US|Automated Commercial Environment in the United States|
|AFR|JP|Cargo Summary Notification (CSN)|
|ENS|NL|Entry Summary Declaration|""" ;
    skos:altLabel "AdvanceManifestFiling",
        "advance manifest filing" .

<urn:dcsa:ebl:Charge> a owl:Class ;
    rdfs:label "Charge" ;
    rdfs:comment "Addresses the monetary value of freight and other service charges for a `Booking`." ;
    skos:altLabel "charge" .

<urn:dcsa:ebl:DocumentParties> a owl:Class ;
    rdfs:label "Document Parties" ;
    rdfs:comment "All `Parties` with associated roles." ;
    skos:altLabel "DocumentParties",
        "document parties" .

<urn:dcsa:ebl:ErrorResponse> a owl:Class ;
    rdfs:label "Error Response" ;
    rdfs:comment "Unexpected error" ;
    skos:altLabel "ErrorResponse",
        "error response" .

<urn:dcsa:ebl:Feedback> a owl:Class ;
    rdfs:label "Feedback" ;
    rdfs:comment """Feedback that can be provided includes, but is not limited to:
- unsupported properties
- changed values
- removed properties
- general information""" ;
    skos:altLabel "feedback" .

<urn:dcsa:ebl:NationalCommodityCode> a owl:Class ;
    rdfs:label "National Commodity Code" ;
    rdfs:comment """The national commodity classification code linked to a country with a value.

An example could look like this:

| Type  | Country | Value |
|-------|:-------:|-------------|
|NCM|BR|['1515', '2106', '2507', '2512']|""" ;
    skos:altLabel "NationalCommodityCode",
        "national commodity code" .

<urn:dcsa:ebl:Reference> a owl:Class ;
    rdfs:label "Reference" ;
    rdfs:comment "References provided by the shipper or freight forwarder at the time of `Booking` or at the time of providing `Shipping Instructions`. Carriers share it back when providing `Track & Trace` event updates, some are also printed on the B/L. Customers can use these references to track shipments in their internal systems." ;
    skos:altLabel "reference" .

<urn:dcsa:ebl:ShippingInstructionsData> a owl:Class ;
    rdfs:label "Shipping Instructions Data" ;
    rdfs:comment "`Shipping Instructions` specific properties for the `Notification`" ;
    skos:altLabel "ShippingInstructionsData",
        "shipping instructions data" .

<urn:dcsa:ebl:ShippingInstructionsNotification> a owl:Class ;
    rdfs:label "Shipping Instructions Notification" ;
    rdfs:comment "`CloudEvent` specific properties for the `Notification`." ;
    skos:altLabel "ShippingInstructionsNotification",
        "shipping instructions notification" .

<urn:dcsa:ebl:TransportDocumentNotification> a owl:Class ;
    rdfs:label "Transport Document Notification" ;
    rdfs:comment "`CloudEvent` specific properties for the `Notification`." ;
    skos:altLabel "TransportDocumentNotification",
        "transport document notification" .

<urn:dcsa:ebl:UtilizedTransportEquipmentShipper> a owl:Class ;
    rdfs:label "Utilized Transport Equipment (Shipper)" ;
    rdfs:comment "Specifies the container (`Equipment`), `Seals` and `References`" ;
    skos:altLabel "UtilizedTransportEquipmentShipper",
        "utilized transport equipment shipper" .

<urn:dcsa:ebl:ExportLicenseShipper> a owl:Class ;
    rdfs:label "Export License (Shipper)" ;
    rdfs:comment """`Export License` requirements

**Condition:** Subject to local customs requirements and commodity.""" ;
    skos:altLabel "ExportLicenseShipper",
        "export license shipper" .

<urn:dcsa:ebl:ImportLicenseShipper> a owl:Class ;
    rdfs:label "Import License (Shipper)" ;
    rdfs:comment """`Import License` requirements

**Condition:** Subject to local customs requirements and commodity.""" ;
    skos:altLabel "ImportLicenseShipper",
        "import license shipper" .

<urn:dcsa:ebl:UtilizedTransportEquipment> a owl:Class ;
    rdfs:label "Utilized Transport Equipment" ;
    rdfs:comment "Specifies the container (`equipment`), the total `weight`, total `volume`, possible `ActiveReeferSettings`, `seals` and `references`" ;
    skos:altLabel "UtilizedTransportEquipment",
        "utilized transport equipment" .

<urn:dcsa:ebl:Consignee> a owl:Class ;
    rdfs:label "Consignee" ;
    rdfs:comment """The party to which goods are consigned in the `Master Bill of Lading`.

**Condition:** Mandatory for non-negotiable BL (`isToOrder=false`)

**Condition:** If a `displayedAddress` is provided, it must be included in the `Transport Document` instead of the `address`.""" ;
    skos:altLabel "consignee" .

<urn:dcsa:ebl:ConsigneeShipper> a owl:Class ;
    rdfs:label "Consignee (Shipper provided)" ;
    rdfs:comment """The party to which goods are consigned in the `Master Bill of Lading`.

**Condition:** Mandatory for non-negotiable BL (`isToOrder=false`)

**Condition:** Either the `address` or a party `identifyingCode` must be provided in the `Shipping Instructions`. If a `displayedAddress` is provided, it must be included in the `Transport Document` instead of the `address`.""" ;
    skos:altLabel "ConsigneeShipper",
        "consignee shipper" .

<urn:dcsa:ebl:NotifyParty> a owl:Class ;
    rdfs:label "Notify Party" ;
    rdfs:comment """The person to be notified when a shipment arrives at its destination.

**Condition:** Either the `address` or a party `identifyingCode` must be provided in the `Shipping Instructions`. If a `displayedAddress` is provided, it must be included in the `Transport Document` instead of the `address`.""" ;
    skos:altLabel "NotifyParty",
        "notify party" .

<urn:dcsa:ebl:CargoItem> a owl:Class ;
    rdfs:label "Cargo Item" ;
    rdfs:comment "A `cargoItem` is the smallest unit used by stuffing. A `cargoItem` cannot be split across containers." ;
    skos:altLabel "CargoItem",
        "cargo item" .

<urn:dcsa:ebl:ConsignmentItem> a owl:Class ;
    rdfs:label "Consignment Item" ;
    rdfs:comment "Defines a list of `CargoItems` belonging together and the associated `Booking`. A `ConsignmentItem` can be split across multiple containers (`UtilizedTransportEquipment`) by referencing multiple `CargoItems`" ;
    skos:altLabel "ConsignmentItem",
        "consignment item" .

<urn:dcsa:ebl:DocumentPartiesShippingInstructions> a owl:Class ;
    rdfs:label "Document Parties (Shipping Instructions)" ;
    rdfs:comment """All `Parties` with associated roles.

**Condition:** `Buyer` and `Seller` are mandatory if `isCargoDeliveredInICS2Zone=true` **and** `advancedManifestFilingPerformedBy=CARRIER` and `isHouseBillOfLadingsIssued=false`""" ;
    skos:altLabel "DocumentPartiesShippingInstructions",
        "document parties shipping instructions" .

<urn:dcsa:ebl:Shipper> a owl:Class ;
    rdfs:label "Shipper" ;
    rdfs:comment """The party by whom or in whose name or on whose behalf a contract of carriage of goods by sea has been concluded with a carrier, or the party by whom or in whose name, or on whose behalf, the goods are actually delivered to the carrier in relation to the contract of carriage by sea.

**Condition:** Either the `address` or a party `identifyingCode` must be provided in the `Shipping Instructions`. If a `displayedAddress` is provided, it must be included in the `Transport Document` instead of the `address`.""" ;
    skos:altLabel "shipper" .

<urn:dcsa:ebl:Transports> a owl:Class ;
    rdfs:label "Transports" ;
    skos:altLabel "transports" .

<urn:dcsa:ebl:CargoItemShipper> a owl:Class ;
    rdfs:label "Cargo Item (Shipper)" ;
    rdfs:comment "A `cargoItem` is the smallest unit used by stuffing. A `cargoItem` cannot be split across containers." ;
    skos:altLabel "CargoItemShipper",
        "cargo item shipper" .

<urn:dcsa:ebl:ActiveReeferSettings> a owl:Class ;
    rdfs:label "Active Reefer Settings" ;
    rdfs:comment """The specifications for a Reefer equipment.

**Condition:** Only applicable when `isNonOperatingReefer` is set to `false`""" ;
    skos:altLabel "ActiveReeferSettings",
        "active reefer settings" .

<urn:dcsa:ebl:HouseBillOfLading> a owl:Class ;
    rdfs:label "House Bill of Lading" ;
    rdfs:comment "A legal contract between the Ocean Transport Intermediary (OTI), such as a Non-Vessel Operating Common Carrier (NVOCC) or a freight forwarder, and the shipper that acknowledges the receipt of goods and outlines the terms of shipment." ;
    skos:altLabel "HouseBillOfLading",
        "house bill of lading" .

<urn:dcsa:ebl:ConsignmentItemShipper> a owl:Class ;
    rdfs:label "Consignment Item (Shipper)" ;
    rdfs:comment "Defines a list of `CargoItems` belonging together and the associated `Booking`. A `ConsignmentItem` can be split across multiple containers (`UtilizedTransportEquipment`) by referencing multiple `CargoItems`" ;
    skos:altLabel "ConsignmentItemShipper",
        "consignment item shipper" .

<urn:dcsa:ebl:CustomsReference> a owl:Class ;
    rdfs:label "Customs Reference" ;
    rdfs:comment """Reference associated with customs and/or excise purposes required by the relevant authorities for the import, export, or transit of the goods.

A small list of **potential** examples:

| Type  | Country | Description |
|-------|:-------:|-------------|
|UCR|NL|Unique Consignment Reference|
|CUS|NL|Customs Union and Statistics|
|ACID|EG|Advance Cargo Information Declaration in Egypt|
|CERS|CA|Canadian Export Reporting System|
|ITN|US|Internal Transaction Number in US|
|PEB|ID|PEB reference number|
|CSN|IN|Cargo Summary Notification (CSN)|""" ;
    skos:altLabel "CustomsReference",
        "customs reference" .

<urn:dcsa:ebl:PartyContactDetail> a owl:Class ;
    rdfs:label "Party Contact Detail" ;
    rdfs:comment "The contact details of the person to contact. It is mandatory to provide either `phone` and/or `email` along with the `name`, both can be provided." ;
    skos:altLabel "PartyContactDetail",
        "party contact detail" .

<urn:dcsa:ebl:PartyAddress> a owl:Class ;
    rdfs:label "Party Address" ;
    rdfs:comment "Address where the party is located. It is an object of the attributes below." ;
    skos:altLabel "PartyAddress",
        "party address" .

<urn:dcsa:ebl:Address> a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "An object for storing address related information" ;
    skos:altLabel "address" .

<urn:dcsa:ebl:IdentifyingCode> a owl:Class ;
    rdfs:label "Identifying Code" ;
    skos:altLabel "IdentifyingCode",
        "identifying code" .

<urn:dcsa:ebl:TaxLegalReference> a owl:Class ;
    rdfs:label "Tax & Legal Reference" ;
    rdfs:comment """Reference that uniquely identifies a party for tax and/or legal purposes in accordance with the relevant jurisdiction.

A small list of **potential** examples:

| Type  | Country | Description |
|-------|:-------:|-------------|
|EORI|NL|Economic Operators Registration and Identification|
|PAN|IN|Goods and Services Tax Identification Number in India|
|GSTIN|IN|Goods and Services Tax Identification Number in India|
|IEC|IN|Importer-Exported Code in India|
|RUC|EC|Registro Único del Contribuyente in Ecuador|
|RUC|PE|Registro Único del Contribuyente in Peru|
|NIF|MG|Numéro d'Identification Fiscal in Madagascar|
|NIF|DZ|Numéro d'Identification Fiscal in Algeria|""" ;
    skos:altLabel "TaxLegalReference",
        "tax legal reference" .

<urn:dcsa:ebl:DangerousGoods> a owl:Class ;
    rdfs:label "Dangerous Goods" ;
    rdfs:comment "Specification for `Dangerous Goods`. It is mandatory to provide one of `UNNumber` or `NANumber`. Dangerous Goods is based on **IMDG Amendment Version 41-22**." ;
    skos:altLabel "DangerousGoods",
        "dangerous goods" .

<urn:dcsa:ebl:CreateShippingInstructions> a owl:Class ;
    rdfs:label "Create Shipping Instructions" ;
    rdfs:comment "The `Shipping Instructions` is an enrichment to the original booking shared by the Shipper to the Carrier. The information given by the Shipper through the `Shipping Instructions` is the information required to create a `Draft Transport Document`." ;
    skos:altLabel "CreateShippingInstructions",
        "create shipping instructions" .

<urn:dcsa:ebl:UpdateShippingInstructions> a owl:Class ;
    rdfs:label "Update Shipping Instructions" ;
    rdfs:comment "The `Shipping Instructions` to update." ;
    skos:altLabel "UpdateShippingInstructions",
        "update shipping instructions" .

<urn:dcsa:ebl:ShippingInstructions> a owl:Class ;
    rdfs:label "Shipping Instructions" ;
    rdfs:comment "The `Shipping Instructions` as provided by the Shipper." ;
    skos:altLabel "ShippingInstructions",
        "shipping instructions" .

<urn:dcsa:ebl:TransportDocument> a owl:Class ;
    rdfs:label "Transport Document" ;
    rdfs:comment """The document that governs the terms of carriage between shipper and carrier for maritime transportation. Two distinct types of transport documents exist:
- Bill of Lading
- Sea Waybill.""" ;
    skos:altLabel "TransportDocument",
        "transport document" .

