<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/ContactRecord> a owl:Class ;
    rdfs:label "contact record" ;
    rdfs:comment "record about a party in a specific communicative or liaison role" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Record> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DeathCertificate> a owl:Class ;
    rdfs:label "death certificate" ;
    rdfs:comment "original document certifying the circumstances of the death (such as how and when it occurred), or a certified copy of or representation of the ensuing registration of that death" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/IdentityDocument> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DeathCertificateIdentificationScheme> a owl:Class ;
    rdfs:label "death certificate identification scheme" ;
    rdfs:comment "system for allocating identifiers to death certificates" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DeathCertificateIdentifier> a owl:Class ;
    rdfs:label "death certificate identifier" ;
    rdfs:comment "identifier associated with a vital record documenting the death of an individual" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> ;
    skos:altLabel "death certificate number" .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DriversLicense> a owl:Class ;
    rdfs:label "driver's license" ;
    rdfs:comment "an official document which states that a person may operate a motorized vehicle, such as a motorcycle, car, truck or a bus, on a public roadway or provides official identifying information for a non-driver" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/IdentityDocument> ;
    skos:altLabel "driving licence" .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DriversLicenseIdentificationScheme> a owl:Class ;
    rdfs:label "driver's license identification scheme" ;
    rdfs:comment "system for allocating identifiers to driver's, operating, or non-driver identification documents" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DriversLicenseIdentifier> a owl:Class ;
    rdfs:label "driver's license identifier" ;
    rdfs:comment "identifier associated with a drivers' or operating license for operating a motor vehicle or non-driver identification card" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> ;
