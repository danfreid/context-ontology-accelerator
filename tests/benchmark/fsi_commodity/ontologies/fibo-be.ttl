<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/TripleBottomLineObjective> a owl:Class ;
    rdfs:label "triple bottom line objective" ;
    rdfs:comment "financial objective that integrates economic performance, environmental stewardship, and social responsibility as co-equal criteria for success" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/InvestmentObjective> .

