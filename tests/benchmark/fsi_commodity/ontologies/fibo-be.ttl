<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/BirthCertificate> a owl:Class ;
    rdfs:label "birth certificate" ;
    rdfs:comment "an original document certifying the circumstances of the birth, or a certified copy of or representation of the ensuing registration of that birth" ;
