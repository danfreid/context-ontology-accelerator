    rdfs:comment "sequence of characters that can be used to uniquely identify funds" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/InterestRate> a owl:Class ;
    rdfs:label "interest rate" ;
    rdfs:comment "amount charged, expressed as a percentage of principal, in exchange for the use of assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/PercentageMonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/PreciousMetal> a owl:Class ;
    rdfs:label "precious metal" ;
    rdfs:comment "metal that is considered to be rare and/or have a high economic value" ;
