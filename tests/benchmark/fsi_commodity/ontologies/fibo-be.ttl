    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/BusinessStrategy> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Study> a owl:Class ;
    rdfs:label "study" ;
