    rdfs:comment "digital token capable of mutual substitution between the individual units of digital assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/DigitalToken> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Holding> a owl:Class ;
    rdfs:label "holding" ;
    rdfs:comment "owned financial interest consisting of legal or beneficial ownership of an asset or security that confers economic rights on its owner" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Income> a owl:Class ;
