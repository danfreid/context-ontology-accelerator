<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/ProgramName> a owl:Class ;
    rdfs:label "program name" ;
    rdfs:comment "contextual designation for a program within the context in which that program is administered" ;
