<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/DistributionStrategy> a owl:Class ;
    rdfs:label "distribution strategy" ;
    rdfs:comment "strategy for making a product or service available, or for distributing funds, such as in the form of a dividend or coupon" ;
