<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasTerm> a owl:ObjectProperty ;
    rdfs:label "has term" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Duration> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasThirdParty> a owl:ObjectProperty ;
    rdfs:label "has third party" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
