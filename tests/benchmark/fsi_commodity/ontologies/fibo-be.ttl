<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Claim> a owl:Class ;
    rdfs:label "claim" ;
    rdfs:comment "demand or assertion made by one party on another, based on facts that, taken together, give rise to a legally enforceable right or judicial action" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalConstruct> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContingentRight> a owl:Class ;
    rdfs:label "contingent right" ;
    rdfs:comment "right that depends on a future event or the performance of an action" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Right> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContractualCapability> a owl:Class ;
    rdfs:label "contractual capability" ;
    rdfs:comment "the capacity to enter into legally binding contracts" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContractualInterest> a owl:Class ;
    rdfs:label "contractual interest" ;
    rdfs:comment "legally enforceable benefit or entitlement arising from a contract, agreement, or instrument, in which an entity holds specified rights or obligations related to the performance, use, or benefit of something, without necessarily holding ownership" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContractualRight> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContractualObligation> a owl:Class ;
    rdfs:label "contractual obligation" ;
    rdfs:comment "legally binding obligation that arises from the terms of a contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalObligation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContractualOption> a owl:Class ;
    rdfs:label "contractual option" ;
    rdfs:comment "contractual right that may be exercised at some point in the future, such as an option to extend a contract, or other available but not obligatory rights as defined in the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContractualRight> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/DelegatedLegalAuthority> a owl:Class ;
    rdfs:label "delegated legal authority" ;
    rdfs:comment "institutionalized and legal power inherent in a particular job, function, or position that is meant to enable its holder to successfully carry out his or her responsibilities, where such power has been delegated through some formal means" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/DeliveryObligation> a owl:Class ;
    rdfs:label "delivery obligation" ;
    rdfs:comment "obligation to deliver something in order to satisfy a claim or debt" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContingentObligation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalRight> a owl:Class ;
    rdfs:label "legal right" ;
    rdfs:comment "personal right, privilege, or benefit that a government, contract, or law provides or protects, making an individual or entity eligible to receive something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Right> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LiabilityCapacity> a owl:Class ;
    rdfs:label "liability capacity" ;
    rdfs:comment "the ability to be sued at law" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LicenseIdentifier> a owl:Class ;
    rdfs:label "license identifier" ;
    rdfs:comment "an identifier associated with a license" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Licensee> a owl:Class ;
    rdfs:label "licensee" ;
    rdfs:comment "a party to whom a license has been granted" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Licensor> a owl:Class ;
    rdfs:label "licensor" ;
    rdfs:comment "a party who grants a license" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LitigationCapacity> a owl:Class ;
    rdfs:label "litigation capacity" ;
    rdfs:comment "the legal capacity to pursue a litigation action in law" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/NotificationObligation> a owl:Class ;
    rdfs:label "notification obligation" ;
    rdfs:comment "requirement for one party to formally inform another party (or parties) about specific events, actions, or changes as outlined in the agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContingentObligation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Regulation> a owl:Class ;
    rdfs:label "regulation" ;
    rdfs:comment "a rule used to carry out a law" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalConstruct> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ReportingPolicy> a owl:Class ;
    rdfs:label "reporting policy" ;
    rdfs:comment "policy specifying principles, rules and/or guidelines regarding some aspect of reporting" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Policy> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/SignatoryCapacity> a owl:Class ;
    rdfs:label "signatory capacity" ;
    rdfs:comment "the capacity of some natural person to sign agreements on the part of some organization or legal person" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> .

