<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/AmountOfMoney> a owl:Class ;
    rdfs:label "amount of money" ;
    rdfs:comment "amount of readily available cash in banknotes and coins" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> ;
