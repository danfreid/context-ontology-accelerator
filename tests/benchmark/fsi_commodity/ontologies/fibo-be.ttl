<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/AssignableContract> a owl:Class ;
    rdfs:label "assignable contract" ;
    rdfs:comment "contract in which contract holder (assignor) may transfer some or all of their rights and obligations to another party (assignee)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/TransferableContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/BilateralContract> a owl:Class ;
    rdfs:label "bilateral contract" ;
    rdfs:comment "contract where two parties commit to perform specific actions or obligations towards each other" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/BilateralAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/BilateralNettingProvision> a owl:Class ;
    rdfs:label "bilateral netting provision" ;
    rdfs:comment "netting provision that occurs between two parties, in which mutual obligations are offset to determine a single net payment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/BreachOfContract> a owl:Class ;
    rdfs:label "breach of contract" ;
    rdfs:comment "classifier of events representing a violation of an express, or implied, condition of a contract to do or not to do something, without a legitimate excuse" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/BreachOfCovenant> a owl:Class ;
    rdfs:label "breach of covenant" ;
    rdfs:comment "classifier of events representing breaking a promise specified in a contract to do or not to do something, without a legitimate excuse" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CloseOutNettingProvision> a owl:Class ;
    rdfs:label "close-out netting provision" ;
    rdfs:comment "netting provision that may be triggered when a counterparty defaults, leading to the termination of all outstanding transactions between the parties" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision> ;
    skos:altLabel "close out netting provision" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CollateralAgreement> a owl:Class ;
    rdfs:label "collateral agreement" ;
    rdfs:comment "written contract related to another contract designed to provide clarity and additional protection for all parties involved, that is separate from the primary contract and that can be independently enforced" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractDocument> a owl:Class ;
    rdfs:label "contract document" ;
    rdfs:comment "legal document that records the formal terms and conditions of some contract" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/LegalDocument> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualDefinition> a owl:Class ;
    rdfs:label "contractual definition" ;
    rdfs:comment "contractual element that specifies the meaning of a term in a legal document, whose definition is substitutable for the term whenever it occurs in the body of that document" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/DisclosureProvision> a owl:Class ;
    rdfs:label "disclosure provision" ;
    rdfs:comment "contractual provision that outlines the requirements and responsibilities of one or both parties to reveal certain information to each other" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/EarlyTerminationProvision> a owl:Class ;
    rdfs:label "early termination provision" ;
    rdfs:comment "termination of an agreement for any reason prior to its expiration date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/TerminationProvision> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/MasterAgreement> a owl:Class ;
    rdfs:label "master agreement" ;
    rdfs:comment "contract between named parties that outlines the terms and conditions designed to apply to a number of accounts, transactions, or other activities between the parties, and that consolidates and provides overarching terms for separate but related agreements" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> ;
    skos:altLabel "master contract" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/MilestoneEvent> a owl:Class ;
    rdfs:label "milestone event" ;
    rdfs:comment "event related to the status or level of completion of a designated activity, task, or segment of work required for contract fulfillment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/MilestoneSchedule> a owl:Class ;
    rdfs:label "milestone schedule" ;
    rdfs:comment "schedule of milestone events, observations, or other occurrences and the associated dates and/or times when they will be done" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/MultilateralContract> a owl:Class ;
    rdfs:label "multilateral contract" ;
    rdfs:comment "contract where multiple parties (i.e., more than two) commit to perform specific actions or obligations towards each other" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/MultilateralNettingProvision> a owl:Class ;
    rdfs:label "multilateral netting provision" ;
    rdfs:comment "netting provision that, when triggered, is facilitated by a central clearinghouse or financial institution" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NonTransferableContract> a owl:Class ;
    rdfs:label "non-transferable contract" ;
    rdfs:comment "contract between whose individual rights and obligations are not transferable to another party without prior written permission" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NotificationProvision> a owl:Class ;
    rdfs:label "notification provision" ;
    rdfs:comment "provision indicating that notification is required prior to the occurrence of a relevant event" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NovateableContract> a owl:Class ;
    rdfs:label "novateable contract" ;
    rdfs:comment "contract that may be replaced by another contract, and in that event, extinguishes the rights and obligations in effect under the original contract with those in the new agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/TransferableContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NovationNettingProvision> a owl:Class ;
    rdfs:label "novation netting provision" ;
    rdfs:comment "contractual element that specifies what should be done with respect to netting when a given contract is replaced with another" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/PaymentNettingProvision> a owl:Class ;
    rdfs:label "payment netting provision" ;
    rdfs:comment "netting provision that specifies the way in which all payments in a single currency owed between parties will be aggregated for each traded currency per value date and within the larger aggregate obligation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Representation> a owl:Class ;
    rdfs:label "representation" ;
    rdfs:comment "contractual element that is a statement made by a party to the contract, before or at the time of making the contract, in regard to some fact, circumstance, or state of affairs pertinent to the contract, which the counterparty(ies) rely on, or is influential in bringing about the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/SettlementNettingProvision> a owl:Class ;
    rdfs:label "settlement netting provision" ;
    rdfs:comment "netting provision that specifies the way in which on a given payment date, each party will aggregate the amounts of a currency to be delivered by it, and only the difference in the aggregate amounts will be delivered by the party with the larger aggregate obligation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/TermSheet> a owl:Class ;
    rdfs:label "term sheet" ;
    rdfs:comment "nonbinding agreement setting forth the basic terms and conditions under which a proposed business deal may be made" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/UnilateralContract> a owl:Class ;
    rdfs:label "unilateral contract" ;
    rdfs:comment "contract in which one party makes an offer that can only be accepted through performance rather than a return promise" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/UseOfProceedsProvision> a owl:Class ;
    rdfs:label "use of proceeds provision" ;
    rdfs:comment "contract provision specifying how funds obtained through financing, such as through a credit agreement, offering, warrant, or other instrument are intended to be used" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/VerbalContract> a owl:Class ;
    rdfs:label "verbal contract" ;
    rdfs:comment "contract that exists as a result of some verbal exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Warranty> a owl:Class ;
    rdfs:label "warranty" ;
    rdfs:comment "contractual element that is a statement of fact" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/definesTermsFor> a owl:ObjectProperty ;
    rdfs:label "defines terms for" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasBeneficiary> a owl:ObjectProperty ;
    rdfs:label "has beneficiary" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Beneficiary> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasContractDuration> a owl:ObjectProperty ;
    rdfs:label "has contract duration" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Duration> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasContractParty> a owl:ObjectProperty ;
    rdfs:label "has contract party" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasContractualElement> a owl:ObjectProperty ;
    rdfs:label "has contractual element" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> a owl:ObjectProperty ;
    rdfs:label "has counterparty" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasEarlyTerminationDate> a owl:ObjectProperty ;
    rdfs:label "has early termination date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasEffectiveDate> a owl:ObjectProperty ;
    rdfs:label "has effective date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasEffectiveDateTimeStamp> a owl:ObjectProperty ;
    rdfs:label "has effective date time stamp" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/DateTimeStamp> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasExecutionDate> a owl:ObjectProperty ;
