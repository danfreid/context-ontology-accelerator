<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/IndustrySectorClassifier> a owl:Class ;
    rdfs:label "industry sector classifier" ;
    rdfs:comment "standardized classification or delineation for an organization, or possibly for a security representing an interest in a given organization, per some scheme for such delineation, by industry" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/FinancialRecord> a owl:Class ;
    rdfs:label "financial record" ;
    rdfs:comment "record of financial information" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/hasExpirationDate> a owl:ObjectProperty ;
    rdfs:label "has expiration date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/hasRecord> a owl:ObjectProperty ;
    rdfs:label "has record" ;
    rdfs:range <https://www.omg.org/spec/Commons/Documents/Record> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/hasReportingPeriod> a owl:ObjectProperty ;
    rdfs:label "has reporting period" ;
