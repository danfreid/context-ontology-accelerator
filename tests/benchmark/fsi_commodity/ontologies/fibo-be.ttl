<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/ProjectIdentifier> a owl:Class ;
    rdfs:label "project identifier" ;
    rdfs:comment "sequence of characters uniquely identifying a specific project within the context in which that project or an overarching program is administered" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualIdentifiers/ContextualIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/ProjectName> a owl:Class ;
    rdfs:label "project name" ;
    rdfs:comment "contextual designation for a project" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/ContextualName> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/SalesStrategy> a owl:Class ;
