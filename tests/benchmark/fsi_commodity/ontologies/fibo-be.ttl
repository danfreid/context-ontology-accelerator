@prefix ns: <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.w3.org/2003/01/geo/wgs84_pos#alt> a owl:DatatypeProperty ;
    rdfs:label "alt" .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:label "lat" .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a owl:DatatypeProperty ;
    rdfs:label "long" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/Branch> a owl:Class ;
    rdfs:label "branch" ;
    rdfs:comment "part of a larger organization that might not be co-located with it" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationalSubUnit> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/Division> a owl:Class ;
    rdfs:label "division" ;
    rdfs:comment "part of an organization, such as a line of business, that may have separate accounting and reporting requirements" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationalSubUnit> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/JointVenture> a owl:Class ;
    rdfs:label "joint venture" ;
    rdfs:comment "legal entity that is formed between parties that pool their resources for the purpose of accomplishing a specific task but otherwise retain their distinct identities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/NonGovernmentalOrganization> a owl:Class ;
    rdfs:label "non-governmental organization" ;
    rdfs:comment "not-for-profit organization that functions independently of government" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/NotForProfitOrganization> ;
    skos:altLabel "NGO" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/OrganizationCoveringAgreement> a owl:Class ;
    rdfs:label "organization covering agreement" ;
    rdfs:comment "contract between the principals in a formal organization that specifies the relationship between the principals, and between the principals and the entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/ValueAddedTaxIdentificationNumber> a owl:Class ;
    rdfs:label "value-added tax identification number" ;
    rdfs:comment "tax identifier that identifies a taxable person (business) or non-taxable legal entity for a consumption tax that is assessed incrementally, levied on the price of a product or service at each stage of production, distribution, and sale to the end consumer" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> ;
    skos:altLabel "VAT identification number",
        "VAT registration number",
        "VATIN" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasEquity> a owl:ObjectProperty ;
    rdfs:label "has equity" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/OwnersEquity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasHeadquartersAddress> a owl:ObjectProperty ;
    rdfs:label "has headquarters address" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasOperatingAddress> a owl:ObjectProperty ;
    rdfs:label "has operating address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/Organization> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasRegisteredAddress> a owl:ObjectProperty ;
    rdfs:label "has registered address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/AccountingFramework> a owl:Class ;
    rdfs:label "accounting framework" ;
    rdfs:comment "framework, including policies, methods, rules, and processes, used to measure, recognize, present, and disclose the information appearing in an entity's financial statements, and, from a legal ownership perspective, that is applied for accounting consolidation determination" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipQualifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/ContractuallyCapableEntity> a owl:Class ;
    rdfs:label "contractually capable entity" ;
    rdfs:comment "a unique entity that is legally or financially responsible for the performance of financial transactions, or has the legal right in its jurisdiction to enter independently into legal contracts, regardless of whether it is incorporated or constituted in some other way (e.g. trust, partnership, contractual). This excludes natural persons, but includes governmental organizations and supranationals." ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormIdentifier> a owl:Class ;
    rdfs:label "entity legal form identifier" ;
    rdfs:comment "code that denotes an entity legal form as defined in ISO 20275" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormScheme> a owl:Class ;
    rdfs:label "entity legal form scheme" ;
    rdfs:comment "scheme that specifies the elements of the codes for entity legal forms, such as those that are sanctioned in a given jurisdiction as defined in ISO 20725" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LEIRegisteredEntity> a owl:Class ;
    rdfs:label "LEI registered entity" ;
    rdfs:comment "a legal person that has registered for and is identified by a legal entity identifier" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifier> a owl:Class ;
    rdfs:label "legal entity identifier" ;
    rdfs:comment "an organization identifier that uniquely identifies a legal person as defined in ISO 17442" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifierScheme> a owl:Class ;
    rdfs:label "legal entity identifier scheme" ;
    rdfs:comment "a scheme that specifies the elements of an unambiguous legal entity identifier (LEI) scheme to identify the legal entities relevant to any financial transaction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipPeriodQualifier> a owl:Class ;
    rdfs:label "relationship period qualifier" ;
    rdfs:comment "a classifier that qualifies something about the reporting period specified, such as that the date period reflects an accounting or document filing period" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipRecord> a owl:Class ;
    rdfs:label "relationship record" ;
    rdfs:comment "a record describing relationships between legal entities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Constituent> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatus> a owl:Class ;
    rdfs:label "relationship status" ;
    rdfs:comment "a classifier that specifies the status of the relationship between consolidated entities during the reporting period (active or inactive)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasLegalAddress> a owl:ObjectProperty ;
    rdfs:label "has legal address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasLegalForm> a owl:ObjectProperty ;
    rdfs:label "has legal form" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalForm> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasLegalFormAbbreviation> a owl:DatatypeProperty ;
    rdfs:label "has legal form abbreviation" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasOwnershipPercentage> a owl:DatatypeProperty ;
    rdfs:label "has ownership percentage" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasTransliteratedLegalFormAbbreviation> a owl:DatatypeProperty ;
    rdfs:label "has transliterated legal form abbreviation" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasTransliteratedName> a owl:DatatypeProperty ;
    rdfs:label "has transliterated name" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isConsolidatedBy> a owl:ObjectProperty ;
    rdfs:label "is consolidated by" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isConsolidationOf> a owl:ObjectProperty ;
    rdfs:label "is consolidation of" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isDirectlyConsolidatedBy> a owl:ObjectProperty ;
    rdfs:label "is directly consolidated by" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isInternationalBranchOf> a owl:ObjectProperty ;
    rdfs:label "is an international branch of" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isQuantifiedBy> a owl:DatatypeProperty ;
    rdfs:label "is quantified by" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isUltimatelyConsolidatedBy> a owl:ObjectProperty ;
    rdfs:label "is ultimately consolidated by" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/BusinessEntity> a owl:Class ;
    rdfs:label "business entity" ;
    rdfs:comment "entity that is formed and administered as per commercial law in order to engage in business activities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/FormalOrganization> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/BusinessLicense> a owl:Class ;
    rdfs:label "business license" ;
    rdfs:comment "license that allows the holder to conduct business or carry out a specific profession within some jurisdiction for some period of time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/License> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/CharteredLegalPerson> a owl:Class ;
    rdfs:label "chartered legal person" ;
    rdfs:comment "a legal person created by a royal charter or decree" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/LegallyCompetentNaturalPerson> a owl:Class ;
    rdfs:label "legally competent natural person" ;
    rdfs:comment "person who is considered competent, under the circumstances, to enter into a contract, conduct business, or participate in other activities that generally require the mental ability to understand problems and make decisions on his or her own behalf" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/PowerOfAttorney> a owl:Class ;
    rdfs:label "power of attorney" ;
    rdfs:comment "legal authorization given by one party (the principal) to another (the agent or attorney-in-fact) to perform certain acts on the principal's behalf" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/ProfitObjective> a owl:Class ;
    rdfs:label "profit objective" ;
    rdfs:comment "objective that reflects pursuit of a financial benefit that may be realized when the amount of revenue gained from a business activity exceeds the expenses, costs and taxes needed to sustain that activity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/BusinessObjective> ;
    skos:altLabel "for profit objective",
        "profit motive" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/PublicPurpose> a owl:Class ;
    rdfs:label "public purpose" ;
    rdfs:comment "objective that reflects values generally thought to be shared by and that is intended to benefit the populace as a whole" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Objective> ;
    skos:altLabel "public interest" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/ReligiousObjective> a owl:Class ;
    rdfs:label "religious objective" ;
    rdfs:comment "not-for-profit objective that reflects the religious goals of an organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/NotForProfitObjective> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/SpecialPurposeVehicle> a owl:Class ;
    rdfs:label "fonds commun de placement" ;
    rdfs:comment "legal entity created to fulfill narrow, specific, and frequently temporary objectives" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    skos:altLabel "SPE",
        "SPV",
        "special purpose entity" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/StatutoryBody> a owl:Class ;
    rdfs:label "statutory body" ;
    rdfs:comment "legal entity established by a government to consider evidence and make judgements in some field of activity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/VariableInterestEntity> a owl:Class ;
    rdfs:label "variable interest entity" ;
    rdfs:comment "legal entity whose shareholders are entitled to a percentage of a named company's profits via a private contract" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    skos:altLabel "VIE",
        "shell company" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/hasIntendedLiquidationDate> a owl:ObjectProperty ;
    rdfs:label "has intended liquidation date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ContractualControl> a owl:Class ;
    rdfs:label "contractual control" ;
    rdfs:comment "control established through the terms of some contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeJureControl> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControllingAlliance> a owl:Class ;
    rdfs:label "controlling alliance" ;
    rdfs:comment "group that has formed some alliance to jointly exercise control over some entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/FormalOrganizations/Group> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/CourtAppointedControl> a owl:Class ;
    rdfs:label "court appointed control" ;
    rdfs:comment "control conferred by the actions of some court, for example in the context of receivership" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeJureControl> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InfluenceBasedDeFactoControl> a owl:Class ;
    rdfs:label "influence-based de facto control" ;
    rdfs:comment "informal control that involves influence over some party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeFactoControl> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InfluenceBasedDeFactoControllingParty> a owl:Class ;
    rdfs:label "influence-based de facto controlling party" ;
    rdfs:comment "party that holds influence-based control over some other party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeFactoControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InvestmentBasedDeFactoControllingInterestParty> a owl:Class ;
    rdfs:label "investment-based de facto controlling interest party" ;
    rdfs:comment "party that holds investment-based control over some other party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/Investor> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/JointControllingParty> a owl:Class ;
    rdfs:label "joint controlling party" ;
    rdfs:comment "party that collectively has the authority to control the affairs of some business organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/Receiver> a owl:Class ;
    rdfs:label "receiver" ;
    rdfs:comment "party appointed by some court for the purposes of winding up the affairs of some entity which is no longer solvent" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeJureControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/SoleControllingParty> a owl:Class ;
    rdfs:label "sole controlling party" ;
    rdfs:comment "party that has sole control over and directs the affairs of some legal entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/TotalOwner> a owl:Class ;
    rdfs:label "total owner" ;
    rdfs:comment "party that has 100 percent ownership some legal entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/ConstitutionalOwner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/advises> a owl:ObjectProperty ;
    rdfs:label "advises" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/hasControllingOrganizationMember> a owl:ObjectProperty ;
    rdfs:label "has controlling organization member" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/hasMajorityControllingParty> a owl:ObjectProperty ;
    rdfs:label "has majority controlling party" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/MajorityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/isAdvisedBy> a owl:ObjectProperty ;
    rdfs:label "has advisor" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/isBasedOnInvestmentEquity> a owl:ObjectProperty ;
    rdfs:label "is based on investment equity" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InvestmentBasedDeFactoControl> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/InvestmentEquity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/isControllingMemberOf> a owl:ObjectProperty ;
    rdfs:label "is controlling member of" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/> a owl:Ontology ;
    rdfs:label "FIBO BE" ;
    owl:versionInfo "1" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/ControllingEquity> a owl:Class ;
    rdfs:label "controlling equity" ;
    rdfs:comment "shareholders's equity that formally confers control in the entity, either by law or as explicitly stated in a corresponding equity instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/ShareholdersEquity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/DirectConsolidation> a owl:Class ;
    rdfs:label "direct consolidation" ;
    rdfs:comment "direct ownership of an entity recorded as accounting consolidation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwnership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/ForeignBranchOwnership> a owl:Class ;
    rdfs:label "foreign branch ownership" ;
    rdfs:comment "ownership by some party of some formal organization or organizational sub-unit that is a foreign affiliate and legally part of the owning entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwnership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/InvestorContract> a owl:Class ;
    rdfs:label "investor contract" ;
    rdfs:comment "Contract setting out the terms under which some investor invests in the entity and setting out the rights which are conferred on that investor." ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/UltimateConsolidation> a owl:Class ;
    rdfs:label "ultimate ownership" ;
    rdfs:comment "highest-level (top, end) ancestral ownership, evidenced by accounting consolidation, by some party of some other legal entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwnership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/guarantees> a owl:ObjectProperty ;
    rdfs:label "guarantees" .

