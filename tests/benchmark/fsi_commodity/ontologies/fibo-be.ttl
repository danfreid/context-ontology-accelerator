<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/BirthCertificateIdentificationScheme> a owl:Class ;
    rdfs:label "birth certificate identification scheme" ;
    rdfs:comment "system for allocating identifiers to birth certificates" ;
