    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasExecutionDateTimeStamp> a owl:ObjectProperty ;
    rdfs:label "has execution date time stamp" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/DateTimeStamp> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasExtendablePeriod> a owl:ObjectProperty ;
    rdfs:label "has extendable period" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ExtensionProvision> ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDatePeriod> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasExtensionProvision> a owl:ObjectProperty ;
