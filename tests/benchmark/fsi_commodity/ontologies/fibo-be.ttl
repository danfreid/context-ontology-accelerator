<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Project> a owl:Class ;
    rdfs:label "project" ;
    rdfs:comment "state of affairs and unique and temporary organization, designed to deliver a tangible output" ;
