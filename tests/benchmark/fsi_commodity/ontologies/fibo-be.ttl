<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/BirthCertificateIdentifier> a owl:Class ;
    rdfs:label "birth certificate identifier" ;
    rdfs:comment "identifier associated with a vital record documenting the birth of a child" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> ;
