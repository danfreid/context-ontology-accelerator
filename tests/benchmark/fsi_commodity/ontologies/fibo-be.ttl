<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/hasStrategy> a owl:ObjectProperty ;
    rdfs:label "has strategy" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Strategy> .

