<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/EmancipatedMinor> a owl:Class ;
    rdfs:label "emancipated minor" ;
    rdfs:comment "a minor who is allowed to conduct a business or any other occupation on his or her own behalf or for their own account outside the control of a parent or guardian" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Minor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/IncapacitatedAdult> a owl:Class ;
    rdfs:label "incapacitated adult" ;
    rdfs:comment "an adult who is legally identified as not having legal capacity, typically as a result of some inherent physical or mental incapacity or as a result of having contracted some illness which temporarily deprives them of such capacity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Adult> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/LegalWorkingAgePerson> a owl:Class ;
    rdfs:label "legal working age person" ;
    rdfs:comment "person whose age is greater than the minimum legal working age specified in a jurisdiction in which they work" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/LegallyCapableAdult> a owl:Class ;
    rdfs:label "legally capable adult" ;
    rdfs:comment "person who has attained the age of majority as defined in some jurisdiction and who is allowed to conduct a business or any other occupation on his or her own behalf or for their own account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Adult> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/NationalIdentificationNumberScheme> a owl:Class ;
    rdfs:label "national identification number scheme" ;
    rdfs:comment "system for allocating identifiers to national identification numbers" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Passport> a owl:Class ;
    rdfs:label "passport" ;
    rdfs:comment "formal identity document, issued by a national government, which certifies the identity and nationality of its holder for the purpose of international travel" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/IdentityDocument> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/PassportNumber> a owl:Class ;
    rdfs:label "passport number" ;
    rdfs:comment "national identification number associated with a passport" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/NationalIdentificationNumber> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/PassportNumberIdentificationScheme> a owl:Class ;
    rdfs:label "passport number identification scheme" ;
    rdfs:comment "system for allocating identifiers to passports" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/PersonName> a owl:Class ;
    rdfs:label "person name" ;
    rdfs:comment "designation by which someone is known in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/ContextualName> .

