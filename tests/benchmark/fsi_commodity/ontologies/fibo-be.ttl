<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/CurrencyBasket> a owl:Class ;
    rdfs:label "currency basket" ;
    rdfs:comment "selected group of currencies, in which the weighted average is used as a measure of the value or the amount of an obligation" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/StructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/CurrencyIdentifier> a owl:Class ;
    rdfs:label "currency identifier" ;
    rdfs:comment "sequence of characters representing some currency" ;
