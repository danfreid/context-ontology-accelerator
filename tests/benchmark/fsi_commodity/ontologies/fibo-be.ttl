<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/NonFungibleToken> a owl:Class ;
    rdfs:label "non-fungible token" ;
    rdfs:comment "unique digital token that represents proof of ownership of one or more tangible and/or intangible assets with unique metadata and/or identification such that no two are identical or fungible" ;
