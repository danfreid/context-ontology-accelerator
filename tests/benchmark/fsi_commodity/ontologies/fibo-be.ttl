    rdfs:comment "schedule and communications tool used to manage meetings, plan events, and coordinate activities within and/or across organizations" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalculationPeriod> a owl:Class ;
    rdfs:label "calculation period" ;
    rdfs:comment "explicit period from the start to the end of a specific interval or range within which a computational process or operation occurs" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDatePeriod> .

