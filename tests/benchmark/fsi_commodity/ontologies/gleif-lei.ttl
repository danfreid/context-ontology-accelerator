@prefix ns: <https://www.gleif.org/ontology/L1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.gleif.org/ontology/Base/LegalPerson> a owl:Class ;
    rdfs:label "legal person" ;
    rdfs:comment "Any entity which can incur legal obligation and can be sued at law." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Entity> .

<https://www.gleif.org/ontology/Base/RegistrationAuthority> a owl:Class ;
    rdfs:label "registration authority" ;
    rdfs:comment "An organization that is responsible for maintaining a registry and provides registration services." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Entity> ;
    skos:altLabel "RA" .

