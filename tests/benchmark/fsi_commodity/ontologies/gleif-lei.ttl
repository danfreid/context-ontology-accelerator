<https://www.gleif.org/ontology/EntityLegalForm/EntityLegalFormIdentifier> a owl:Class ;
    rdfs:label "entity legal form identifier" ;
    rdfs:comment "A current code from the GLEIF-maintained list MUST be used. Values of the LegalFormEnum code list are maintained by GLEIF on behalf of ISO through the Entity Legal Form (ELF) as defined in ISO 20275." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Identifier> .

<https://www.gleif.org/ontology/L1/> a owl:Ontology ;
    rdfs:label "GLEIF LEI" ;
    owl:versionInfo "1" .

<https://www.gleif.org/ontology/L1/Branch> a owl:Class ;
    rdfs:label "branch" ;
    rdfs:comment "The entity is a branch of another legal entity." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/L1/RegisteredEntity> .

<https://www.gleif.org/ontology/L1/LEI> a owl:DatatypeProperty ;
    rdfs:label "LEI" ;
    rdfs:range xsd:string .

<https://www.gleif.org/ontology/L1/LegalEntityIdentifier> a owl:Class ;
    rdfs:label "legal entity identifier" ;
    rdfs:comment "The ISO 17442 compatible identifier for the legal entity referenced." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Identifier> .

<https://www.gleif.org/ontology/L1/LegalEntityIdentifierRegistryEntry> a owl:Class ;
    rdfs:label "legal entity identifier registry entry" ;
    rdfs:comment "The Registration container element which contains all information on the legal entity's LEI registration with the Managing LOU." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/RegistryEntry> .

<https://www.gleif.org/ontology/L1/RegistrationStatus> a owl:Class ;
    rdfs:label "legal entity identifier registration status" ;
    rdfs:comment "The status of the legal entity's LEI registration with the Managing LOU." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/RegistrationStatus> .

<https://www.gleif.org/ontology/L1/SoleProprietor> a owl:Class ;
    rdfs:label "sole proprietor" ;
    rdfs:comment "The legal entity represents an individual acting in a business capacity" ;
    rdfs:subClassOf <https://www.gleif.org/ontology/L1/LegalEntity> .

