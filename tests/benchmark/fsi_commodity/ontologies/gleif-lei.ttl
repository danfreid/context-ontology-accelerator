    rdfs:range <https://www.gleif.org/ontology/L2/RelationshipStatus> .

<https://www.gleif.org/ontology/L2/hasValidationDocuments> a owl:ObjectProperty ;
    rdfs:label "has validation documents" ;
    rdfs:domain <https://www.gleif.org/ontology/L2/LegalEntityRelationshipRecord> ;
    rdfs:range <https://www.gleif.org/ontology/L2/RelationshipValidationDocumentsKind> .

<https://www.gleif.org/ontology/L2/hasValidationReference> a owl:DatatypeProperty ;
    rdfs:label "has validation reference" ;
    rdfs:domain <https://www.gleif.org/ontology/L2/LegalEntityRelationshipRecord> .

<https://www.gleif.org/ontology/L2/hasValidationSources> a owl:ObjectProperty ;
    rdfs:label "has validation sources" ;
    rdfs:domain <https://www.gleif.org/ontology/L2/LegalEntityRelationshipRecord> ;
    rdfs:range <https://www.gleif.org/ontology/L1/ValidationSourceKind> .

<https://www.gleif.org/ontology/RegistrationAuthority/RegistrationAuthorityCode> a owl:Class ;
    rdfs:label "registration authority code" ;
    rdfs:comment "The reference code of the registration authority, taken from the Registration Authorities Code List maintained by GLEIF." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Identifier> .

<https://www.gleif.org/ontology/Base/EntityExpirationReason> a owl:Class ;
    rdfs:label "entity expiration reason" ;
    rdfs:comment "The reason that an entity ceased to exist and/or operate." ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/Base/EntityStatus> a owl:Class ;
    rdfs:label "entity status" ;
    rdfs:comment "The operational and/or legal registration status of the entity (may be ACTIVE or INACTIVE)" ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/Base/PhysicalAddressASCII> a owl:Class ;
    rdfs:label "physical address ASCII" ;
    rdfs:comment "An address transliterated to ASCII characters." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/PhysicalAddress> .

<https://www.gleif.org/ontology/EntityLegalForm/EntityLegalForm> a owl:Class ;
    rdfs:label "entity legal form" ;
    rdfs:comment "The legal form of the entity, taken from the ISO Entity Legal Form (ELF) code list maintained by GLEIF. " ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/L1/FundFamily> a owl:Class ;
    rdfs:label "fund family" ;
    rdfs:comment "The entity that is the manager of one or more funds." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/L1/LegalEntity> .

<https://www.gleif.org/ontology/L1/LocalOperatingUnit> a owl:Class ;
    rdfs:label "local operating unit" ;
    rdfs:comment "An entity that supplies registration, renewal and other services, and acts as the primary interface for legal entities wishing to obtain an LEI. Only organizations duly accredited by the Global Legal Entity Identifier Foundation (GLEIF) are authorized to issue LEIs." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/L1/LegalEntity> ;
    skos:altLabel "LEI issuer",
        "LOU" .

<https://www.gleif.org/ontology/L2/AccountingStandard> a owl:Class ;
    rdfs:label "accounting standard" ;
    rdfs:comment "the type of accounting standard used to source consolidation information, which is based on reported accounting roll-ups" ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/L2/RelationshipStatus> a owl:Class ;
    rdfs:label "relationship status" ;
    rdfs:comment "The status of the legal entities' relationship itself: active or inactive." ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/L2/RelationshipValidationDocumentsKind> a owl:Class ;
    rdfs:label "relationship validation documents kind" ;
    rdfs:comment "Type of source document(s) used for validating the relationship." ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/RegistrationAuthority/BusinessRegistry> a owl:Class ;
    rdfs:label "business registry" ;
    rdfs:comment "a registry for registering and maintaining information about business entities" ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Registry> .

<https://www.gleif.org/ontology/Base/Registry> a owl:Class ;
    rdfs:label "registry" ;
    rdfs:comment "A system, typically an information system, that records the registration of items." ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/L1/BusinessRegistryIdentifier> a owl:Class ;
    rdfs:label "business registry identifier" ;
    rdfs:comment "The legal entity is a branch of another legal entity." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/RegistryIdentifier> .

<https://www.gleif.org/ontology/L1/Fund> a owl:Class ;
    rdfs:label "fund" ;
    rdfs:comment "The legal entity is a fund." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/L1/RegisteredEntity> .

<https://www.gleif.org/ontology/L1/ValidationSourceKind> a owl:Class ;
    rdfs:label "LEI validation source kind" ;
    rdfs:comment "The level of validation of the reference data provided by the registrant." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/RegistrationStatus> .

<https://www.gleif.org/ontology/Base/RegistryIdentifier> a owl:Class ;
    rdfs:label "registry identifier" ;
    rdfs:comment "An identifier associated with an entry in a registry, i.e., one that provides an index to the registry for the recorded item." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Identifier> .

<https://www.gleif.org/ontology/L1/LegalEntity> a owl:Class ;
    rdfs:label "legal entity" ;
    rdfs:comment "LEI-registered entities that are legally or financially responsible for the performance of financial transactions or have the legal right in their jurisdiction to enter independently into legal contracts, regardless of whether they are incorporated or constituted in some other way (e.g. trust, partnership, contractual). It excludes natural persons, but includes governmental organizations and supranationals." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/L1/RegisteredEntity> .

<https://www.gleif.org/ontology/L2/AccountingConsolidation> a owl:Class ;
    rdfs:label "accounting consolidation" ;
    rdfs:comment "Accounting consolidation holds when '[in the] financial statements of a group [...] the assets, liabilities, equity, income, expenses and cash flows of the parent and its subsidiaries are presented as those of a single economic entity'." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/LegalEntityRelationship> .

<https://www.gleif.org/ontology/Base/Identifier> a owl:Class ;
    rdfs:label "identifier" ;
    rdfs:comment "Sequence of characters, capable of uniquely identifying that with which it is associated, within a specified context." ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/Base/RegistrationStatus> a owl:Class ;
    rdfs:label "registration status" ;
    rdfs:comment "A lifecycle stage indicating the status of a given registration of something, such as a business or legal entity." ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/Base/RegistryEntry> a owl:Class ;
    rdfs:label "registry entry" ;
    rdfs:comment "An entry in a registry that specifies something about the thing that is recorded." ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/Base/Period> a owl:Class ;
    rdfs:label "period" ;
    rdfs:comment "A period of time, with at least a start time, and possibly an end." ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/L2/LegalEntityRelationshipRecord> a owl:Class ;
    rdfs:label "legal entity relationship record" ;
    rdfs:comment "The Registration container element contains information specifying the LOU's administration of the relationship record." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/RegistryEntry> .

<https://www.gleif.org/ontology/L1/RegisteredEntity> a owl:Class ;
    rdfs:label "registered entity" ;
    rdfs:comment "LEI-registered entities including, but not limited to, unique parties that are legally or financially responsible for the performance of financial transactions or have the legal right in their jurisdiction to enter independently into legal contracts, regardless of whether they are incorporated or constituted in some other way (e.g. trust, partnership, contractual). It excludes natural persons, but includes governmental organizations and supranationals." ;
    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Entity> .

<https://www.gleif.org/ontology/Base/LegalEntityRelationship> a owl:Class ;
    rdfs:label "legal entity relationship" ;
    rdfs:comment "abstract superclass to represent a reified directed relationship" ;
    rdfs:subClassOf ns:Thing .

ns:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:comment "Synthesized root class" .

<https://www.gleif.org/ontology/Base/PhysicalAddress> a owl:Class ;
    rdfs:label "physical address" ;
    rdfs:comment "a physical address where communications can be addressed, papers served or representatives located for any kind of organization or person" ;
    rdfs:subClassOf ns:Thing .

<https://www.gleif.org/ontology/Base/Entity> a owl:Class ;
    rdfs:label "entity" ;
    rdfs:comment "A partnership, corporation, or other organization having the capacity to negotiate contracts, assume financial obligations, and pay off debts, organized under the laws of some jurisdiction." ;
    rdfs:subClassOf ns:Thing .

