    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Issuer> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/StrikePrice> a owl:Class ;
    rdfs:label "strike price" ;
    rdfs:comment "price at which a lot of the underlying asset may be bought or sold when the contract is exercised" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/EquityInstrument> a owl:Class ;
    rdfs:label "equity instrument" ;
    rdfs:comment "financial instrument representing an ownership interest in an entity or pool of assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Future> a owl:Class ;
    rdfs:label "future" ;
    rdfs:comment "derivative instrument that obligates the buyer to receive and the seller to deliver the assets specified at an agreed price, at some later point in time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> ;
    skos:altLabel "futures contract" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Issuer> a owl:Class ;
    rdfs:label "issuer" ;
    rdfs:comment "role of a party that makes (or proposes to make) one or more financial instruments available in some well-defined, typically formal way" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> a owl:Class ;
    rdfs:label "security" ;
    rdfs:comment "financial instrument that can be bought or sold" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Underlier> a owl:Class ;
    rdfs:label "underlier" ;
    rdfs:comment "something that can be assigned a value in the marketplace that forms the basis for a derivative or pool-backed instrument" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceDeterminationMethod> a owl:Class ;
    rdfs:label "price determination method" ;
    rdfs:comment "strategy for calculating or otherwise establishing a price for something" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> a owl:Class ;
    rdfs:label "security price" ;
    rdfs:comment "monetary price for a financial instrument at some point in time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account> a owl:Class ;
    rdfs:label "account" ;
    rdfs:comment "container for records associated with a business arrangement for regular transactions and services" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Balance> a owl:Class ;
    rdfs:label "balance" ;
    rdfs:comment "amount of money available or owed" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/OpenDate> a owl:Class ;
    rdfs:label "open date" ;
    rdfs:comment "date on which something was created" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Basket> a owl:Class ;
    rdfs:label "basket" ;
    rdfs:comment "collection of goods, services, or other things (e.g., financial contracts) that can be purchased and sold in some marketplace" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/BasketConstituent> a owl:Class ;
    rdfs:label "basket constituent" ;
    rdfs:comment "component of a basket" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> a owl:Class ;
    rdfs:label "financial service" ;
    rdfs:comment "service provided to consumers and businesses by financial institutions such as banks, insurance companies, brokerage firms, consumer finance companies, and investment companies" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Service> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> a owl:Class ;
    rdfs:label "financial service provider" ;
    rdfs:comment "functional entity either licensed to provide financial services to consumers and/or businesses or established by law to provide financial services, such as a central bank" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/SettlementTerms> a owl:Class ;
    rdfs:label "settlement terms" ;
    rdfs:comment "contract terms that define the commitment to and mechanism for settling one or more sides of a transaction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/WeightedBasket> a owl:Class ;
    rdfs:label "weighted basket" ;
    rdfs:comment "basket whose constituents have some relative importance with respect to one another" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Basket> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/WeightedBasketConstituent> a owl:Class ;
    rdfs:label "weighted basket constituent" ;
    rdfs:comment "component of a basket whose relative importance with respect to other basket constituents is known" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/BasketConstituent> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/ExchangeRate> a owl:Class ;
    rdfs:label "exchange rate" ;
    rdfs:comment "rate at which one currency can be exchanged for another" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Ratio> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/PercentageMonetaryAmount> a owl:Class ;
    rdfs:label "percentage monetary amount" ;
    rdfs:comment "measure of some amount of money expressed as a percentage of some other amount, some notional amount or some concrete money amount" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Percentage> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractDocument> a owl:Class ;
    rdfs:label "contract document" ;
    rdfs:comment "legal document that records the formal terms and conditions of some contract" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> a owl:Class ;
    rdfs:label "counterparty" ;
    rdfs:comment "party to a contract with whom one negotiates on a given agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentEvent> a owl:Class ;
    rdfs:label "assessment event" ;
    rdfs:comment "event involving the evaluation or estimation of the nature, quality, or ability of someone or something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ValueAssessment> a owl:Class ;
    rdfs:label "value assessment" ;
    rdfs:comment "assessment event to estimate the value of something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentEvent> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEvent> a owl:Class ;
    rdfs:label "lifecycle event" ;
    rdfs:comment "kind of event that occurs during one or more stages of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStatus> a owl:Class ;
    rdfs:label "lifecycle status" ;
    rdfs:comment "classifier indicating the position or state of something at a particular point in its life-cycle" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceInterval> a owl:Class ;
    rdfs:label "business recurrence interval" ;
    rdfs:comment "recurrence interval that is defined per a specific convention that determines how recurring days should be handled" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalObligation> a owl:Class ;
    rdfs:label "legal obligation" ;
    rdfs:comment "an obligation or duty that is enforceable by a court" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/TangibleAsset> a owl:Class ;
    rdfs:label "tangible asset" ;
    rdfs:comment "asset that is a physical, measurable resource, i.e., one that takes a physical form" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> a owl:Class ;
    rdfs:label "physical address" ;
    rdfs:comment "physical address where communications can be addressed, papers served or representatives located for any kind of organization or person" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Address> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Commodity> a owl:Class ;
    rdfs:label "commodity" ;
    rdfs:comment "material resource used in commerce that is interchangeable with other commodities of the same type" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Good> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Good> a owl:Class ;
    rdfs:label "good" ;
    rdfs:comment "physical, produced item over which ownership rights can be established, whose ownership can be passed from one party to another by engaging in transactions, and that is not money or real estate" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/NegotiableCommodity> a owl:Class ;
    rdfs:label "negotiable commodity" ;
    rdfs:comment "commodity that can be bought or sold in some marketplace" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Commodity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/QualifiedMeasure> a owl:Class ;
    rdfs:label "qualified measure" ;
    rdfs:comment "statistical measure that is constrained by features, quantity kinds or units that refine how it is calculated" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/ScopedMeasure> a owl:Class ;
    rdfs:label "scoped measure" ;
    rdfs:comment "qualified measure that is constrained by filters on the statistical population to which it applies" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/QualifiedMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalArea> a owl:Class ;
    rdfs:label "statistical area" ;
    rdfs:comment "physical location that is defined per some program for designating geographic regions for the purposes of tabulating and presenting statistical data" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeographicRegion> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/ExerciseConventions/ExerciseConvention> a owl:Class ;
    rdfs:label "exercise convention" ;
    rdfs:comment "convention that determines when the holder or future holder of an option can implement the rights defined in the option" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/Share> a owl:Class ;
    rdfs:label "share" ;
    rdfs:comment "financial instrument that signifies a unit of equity ownership in a corporation, or a unit of ownership in a mutual fund, or interest in a general or limited partnership, or a unit of ownership in a structured product, such as a real estate investment trust" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/EquityInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/SharePaymentStatus> a owl:Class ;
    rdfs:label "share payment status" ;
    rdfs:comment "classifier that specifies the overall payment status for shares issued" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStatus> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesClassification/FinancialInstrumentClassificationScheme> a owl:Class ;
    rdfs:label "financial instrument classification scheme" ;
    rdfs:comment "classification scheme defining a set of classifiers for financial instruments" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesClassification/FinancialInstrumentClassifier> a owl:Class ;
    rdfs:label "financial instrument classifier" ;
    rdfs:comment "classifier for a financial instrument based on its type and features" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> a owl:Class ;
    rdfs:label "code set" ;
    rdfs:comment "system of alpha-numeric symbols, or combinations of symbols, that stand for specified values in some context" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "coding scheme" .

<https://www.omg.org/spec/Commons/ContextualDesignators/Context> a owl:Class ;
    rdfs:label "context" ;
    rdfs:comment "situation or frame of reference in which something applies, exists, happens, or is used and that helps to illustrate or explain it" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/ContextualDesignators/ContextualDesignation> a owl:Class ;
    rdfs:label "contextual designation" ;
    rdfs:comment "designation that applies to something in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://www.omg.org/spec/Commons/ContextualIdentifiers/ContextualIdentifier> a owl:Class ;
    rdfs:label "contextual identifier" ;
    rdfs:comment "sequence of characters uniquely identifying that with which it is associated, within a specified context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/ContextualDesignation> .

<https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDatePeriod> a owl:Class ;
    rdfs:label "explicit date period" ;
    rdfs:comment "date period for which the start date, end date, and/or duration are required" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/DatePeriod> .

<https://www.omg.org/spec/Commons/Locations/GeographicRegionIdentifier> a owl:Class ;
    rdfs:label "geographic region identifier" ;
    rdfs:comment "string of letters that indicates a code or other identifier for geographical region, assigned for the purpose of uniquely identifying it within some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://www.omg.org/spec/Commons/Organizations/LegalPerson> a owl:Class ;
    rdfs:label "legal person" ;
    rdfs:comment "party that is recognized as having rights and obligations under the law, including but not limited to the right to sue and be sued, enter into contracts, own property, and incur financial and other obligations" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> .

<https://www.omg.org/spec/Commons/Organizations/Organization> a owl:Class ;
    rdfs:label "organisation" ;
    rdfs:comment "framework of authority within which a person, persons, or groups of people act, or are designated to act, towards some purpose, such as to meet a need or pursue collective goals" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> .

<https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> a owl:Class ;
    rdfs:label "organization identification scheme" ;
    rdfs:comment "identification scheme dedicated to the unique identification of organizations" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> a owl:Class ;
    rdfs:label "organisation identifier" ;
    rdfs:comment "identifier assigned to an organization within an organization identification scheme, and unique within that scheme" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://www.omg.org/spec/Commons/Organizations/Service> a owl:Class ;
    rdfs:label "service" ;
    rdfs:comment "intangible activity performed by some party for the benefit of another party" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Agent> a owl:Class ;
    rdfs:label "agent" ;
    rdfs:comment "something autonomous that can adapt to and interact with its environment" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> a owl:Class ;
    rdfs:label "agent role" ;
    rdfs:comment "role played by any agent" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Percentage> a owl:Class ;
    rdfs:label "percentage" ;
    rdfs:comment "ratio value expressed as a fraction of 100, i.e., in which the denominator is fixed rather than variable and equal to 100" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Ratio> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantity> a owl:Class ;
    rdfs:label "scalar quantity" ;
    rdfs:comment "property of a phenomenon, body, or substance, where the property has a magnitude that can be expressed by means of a number and a reference" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> a owl:Class ;
    rdfs:label "registry" ;
    rdfs:comment "authoritative record or collection of records relating to something" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> a owl:Class ;
    rdfs:label "language identifier" ;
    rdfs:comment "a string of characters that uniquely identifies a linguistic entity" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/CodeElement> ;
    skos:altLabel "language symbol" .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> a owl:Class ;
    rdfs:label "functional entity" ;
    rdfs:comment "party defined in terms of a function they or it performs" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/Swap> a owl:Class ;
    rdfs:label "swap" ;
    rdfs:comment "derivative instrument whereby counterparties agree to exchange periodic streams of cash flows or liabilities from two different financial instruments with each other" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> a owl:Class ;
    rdfs:label "creditor" ;
    rdfs:comment "a party to whom an obligation, such as an amount of money, or good, or performance of some service exists" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligee> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> a owl:Class ;
    rdfs:label "debtor" ;
    rdfs:comment "a party that owes a debt or other obligation to another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/InterestRate> a owl:Class ;
    rdfs:label "interest rate" ;
    rdfs:comment "amount charged, expressed as a percentage of principal, in exchange for the use of assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/PercentageMonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> a owl:Class ;
    rdfs:label "monetary price" ;
    rdfs:comment "price that that is expressed as a monetary amount" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Price> a owl:Class ;
    rdfs:label "price" ;
    rdfs:comment "amount of money, goods, or services requested, expected, required, or given in exchange for something else" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> a owl:Class ;
    rdfs:label "agreement" ;
    rdfs:comment "negotiated understanding between two or more parties, reflecting the offer and acceptance of commitments on the part of either party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> a owl:Class ;
    rdfs:label "commitment" ;
    rdfs:comment "promise made by some party to act or refrain from acting in some manner" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligee> a owl:Class ;
    rdfs:label "obligee" ;
    rdfs:comment "party to whom some commitment or obligation is owed, either legally or per the terms of an agreement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> a owl:Class ;
    rdfs:label "contract principal" ;
    rdfs:comment "party that originates a contract and is identified as the first party to that contract, in the event that the contract distinguishes any party as such" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> a owl:Class ;
    rdfs:label "contractual element" ;
    rdfs:comment "element, such as an arrangement, provision, requirement, rule, specification, and standard that forms an integral part of an agreement" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> a owl:Class ;
    rdfs:label "written contract" ;
    rdfs:comment "formal contract that is written and signed by the parties thereto" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/Index> a owl:Class ;
    rdfs:label "index" ;
    rdfs:comment "indirect shortcut derived from and pointing into, a greater volume of values, data, information or knowledge" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> a owl:Class ;
    rdfs:label "occurrence kind" ;
    rdfs:comment "classifier that specifies the general nature of an occurrence (event)" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Address> a owl:Class ;
    rdfs:label "address" ;
    rdfs:comment "index to a location to which communications may be delivered" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/Index> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> a owl:Class ;
    rdfs:label "conventional street address" ;
    rdfs:comment "physical address that identifies a location on a street to which communications may be delivered" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Buyer> a owl:Class ;
    rdfs:label "buyer" ;
    rdfs:comment "party that purchases something in exchange for money or other consideration under a contract of sale" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "buyer",
        "purchaser" .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Product> a owl:Class ;
    rdfs:label "product" ;
    rdfs:comment "commercially distributed good that is (1) tangible property, (2) the output or result of a fabrication, manufacturing, or production process, or (3) something that passes through a distribution channel before being consumed or used." ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Seller> a owl:Class ;
    rdfs:label "seller" ;
    rdfs:comment "party that makes, offers or contracts to make a sale to an actual or potential buyer" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "purveyor",
        "vendor" .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizedParty> a owl:Class ;
    rdfs:label "authorised party" ;
    rdfs:comment "party that has been given the ability to act on behalf of another party or to have specified capabilities under some set of guidelines for some period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> .

<https://www.omg.org/spec/Commons/Locations/Country> a owl:Class ;
    rdfs:label "country" ;
    rdfs:comment "geopolitical entity representing a distinct territorial body or political entity or dependent territory" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeopoliticalEntity> .

<https://www.omg.org/spec/Commons/Locations/CountrySubdivision> a owl:Class ;
    rdfs:label "country subdivision" ;
    rdfs:comment "geopolitical entity that is a legal division of a country, dependency, or other area of special geopolitical interest related to a country or other geopolitical entity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeopoliticalEntity> .

<https://www.omg.org/spec/Commons/Locations/Municipality> a owl:Class ;
    rdfs:label "municipality" ;
    rdfs:comment "urban administrative division having corporate status and usually powers of self-government or jurisdiction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/CountrySubdivision> .

<https://www.omg.org/spec/Commons/Organizations/FormalOrganization> a owl:Class ;
    rdfs:label "formal organisation" ;
    rdfs:comment "organization that is recognized in some legal jurisdiction, with associated rights and responsibilities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Organization> .

<https://www.omg.org/spec/Commons/Organizations/LegalEntity> a owl:Class ;
    rdfs:label "legal entity" ;
    rdfs:comment "legal person that is a partnership, corporation, or other organization having the capacity to negotiate contracts, assume financial obligations, and pay off debts, organized under the laws of some jurisdiction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/FormalOrganization> ;
    skos:altLabel "artificial person",
        "juridical entity",
        "juridical person",
        "juristic person" .

<https://www.omg.org/spec/Commons/Organizations/ServiceProvider> a owl:Class ;
    rdfs:label "service provider" ;
    rdfs:comment "role of an agent that provides some service, including but not limited to commercial or professional services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> a owl:Class ;
    rdfs:label "measurement unit" ;
    rdfs:comment "real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the second quantity to the first one as a number" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantity> ;
    skos:altLabel "unit of measurement" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityDimension> a owl:Class ;
    rdfs:label "quantity dimension" ;
    rdfs:comment "expression of the dependence of a quantity on the base quantities of a system of quantities as a product of powers of factors corresponding to the base quantities, omitting any numerical factor" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "dimension",
        "dimension of a quantity" .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/Registrar> a owl:Class ;
    rdfs:label "registrar" ;
    rdfs:comment "role of a party that acts as a representative of a registration authority to provide registration services, including official record keeping" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/ServiceProvider> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> a owl:Class ;
    rdfs:label "functional role" ;
    rdfs:comment "role representing an underlying functionality that something, such as a person, organization, process, or service, is expected to perform or deliver" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegionIdentifier> a owl:Class ;
    rdfs:label "geographic region identifier" ;
    rdfs:comment "a string of letters assigned to a country or other geographic region for the purpose of uniquely representing it" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/CodeElement> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/CodeElement> a owl:Class ;
    rdfs:label "code element" ;
    rdfs:comment "a sequence of characters denoting something that it is associated with for some purpose, within a specified context, according to some rule set" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/DerivativeTerms> a owl:Class ;
    rdfs:label "derivative terms" ;
    rdfs:comment "contractual terms specific to derivative contracts, including terms related to payments and delivery between parties" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> a owl:Class ;
    rdfs:label "contractual commitment" ;
    rdfs:comment "provision specifying something that the contracting parties agree to, i.e., a promise or pledge made by one of the parties to perform some action or fulfill some duty" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/Lifecycle> a owl:Class ;
    rdfs:label "lifecycle" ;
    rdfs:comment "arrangement that compares the cyclical nature of families, organizations, processes, products, marketing, and order management, portfolio management or other systems with the cradle to grave life stages (birth, growth, maturity, decay, and death) of living organisms" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> a owl:Class ;
    rdfs:label "business recurrence interval convention" ;
    rdfs:comment "convention that specifies how recurring days should be handled, such as the end of the month, a particular day of the month, a day of the week, or more specifically, a t-bill auction date" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> a owl:Class ;
    rdfs:label "schedule" ;
    rdfs:comment "collection of events, observations, or other occurrences and the associated dates and/or times when they will be done" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/Law> a owl:Class ;
    rdfs:label "law" ;
    rdfs:comment "rule recognized by some community as regulating the behavior of its members and that it may enforce through the imposition of penalties" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> a owl:Class ;
    rdfs:label "statistical measure" ;
    rdfs:comment "summary (means, mode, total, index, etc.) of the individual quantitative variable values for the statistical units in a specific group (study domain)" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizingParty> a owl:Class ;
    rdfs:label "authorising party" ;
    rdfs:comment "party that delegates some role, authority, or control to another party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> .

<https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> a owl:Class ;
    rdfs:label "explicit date" ;
    rdfs:comment "date in which the 'has date value' property is required" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> a owl:Class ;
    rdfs:label "time instant" ;
    rdfs:comment "temporal entity that is a member of a time scale, with no extent or duration" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "instant in time",
        "time point" .

<https://www.omg.org/spec/Commons/Identifiers/Identifier> a owl:Class ;
    rdfs:label "identifier" ;
    rdfs:comment "sequence of characters uniquely identifying that with which it is associated" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://www.omg.org/spec/Commons/Locations/GeopoliticalEntity> a owl:Class ;
    rdfs:label "geopolitical entity" ;
    rdfs:comment "geographic area that represents a geophysical location associated with some form of political structure" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeographicRegion> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Ratio> a owl:Class ;
    rdfs:label "ratio" ;
    rdfs:comment "proportional relationship between two different quantity values that gives rise to a datum of a specific quantity kind" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "rate" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapLeg> a owl:Class ;
    rdfs:label "swap leg" ;
    rdfs:comment "terms defining and the commitment to fulfill cashflow requirements (e.g., interest payments, coupon payments, etc.) for a component of a swap" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/CashflowTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> a owl:Class ;
    rdfs:label "debt" ;
    rdfs:comment "obligation to pay something, such as an amount of money, good, service, or instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> a owl:Class ;
    rdfs:label "monetary amount" ;
    rdfs:comment "measure that is an amount of money specified in monetary units" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> a owl:Class ;
    rdfs:label "obligor" ;
    rdfs:comment "party that is bound legally or by agreement to repay a debt, make a payment, do something, or refrain from doing something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "obligated party",
        "obligator" .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> a owl:Class ;
    rdfs:label "occurrence" ;
    rdfs:comment "happening of an OccurrenceKind, i.e., an event" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "event" .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Owner> a owl:Class ;
    rdfs:label "owner" ;
    rdfs:comment "party that is legally recognized as having the right to possess, the privilege to use, and ability to transfer any rights or privileges associated with something, as permitted by law" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Ownership> a owl:Class ;
    rdfs:label "ownership" ;
    rdfs:comment "situation in which some party holds the legal title to something (explicitly or implicitly) and has the right to transfer that title and/or possession" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/Authorization> a owl:Class ;
    rdfs:label "authorisation" ;
    rdfs:comment "situation in which a party authorizes someone to act on their behalf or to have specific capabilities under certain conditions for some period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://www.omg.org/spec/Commons/DatesAndTimes/DatePeriod> a owl:Class ;
    rdfs:label "date period" ;
    rdfs:comment "time span over one or more calendar days" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> a owl:Class ;
    rdfs:label "actor" ;
    rdfs:comment "primary performer in a relationship between parties, i.e., the party that does something, causes something to happen, or otherwise plays an agentive role in the relationship" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> a owl:Class ;
    rdfs:label "undergoer" ;
    rdfs:comment "something that plays the role of the object or recipient in a situation, i.e., the thing (or party) that the situation impacts, affects, or that otherwise plays a passive recipient / patient or thematic role" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> a owl:Class ;
    rdfs:label "quantity kind" ;
    rdfs:comment "aspect common to mutually comparable quantities" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "kind of quantity" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> a owl:Class ;
    rdfs:label "scalar quantity value" ;
    rdfs:comment "number and reference together expressing the magnitude of a quantity" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "measurement",
        "value of a quantity" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> a owl:Class ;
    rdfs:label "lifecycle stage" ;
    rdfs:comment "phase in a lifecycle" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> a owl:Class ;
    rdfs:label "asset" ;
    rdfs:comment "something of monetary value that is owned or provides benefit to some party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> ;
    skos:altLabel "economic resource" .

<https://www.omg.org/spec/Commons/DatesAndTimes/Duration> a owl:Class ;
    rdfs:label "duration" ;
    rdfs:comment "interval of time of some specific length" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Designators/Designation> a owl:Class ;
    rdfs:label "designation" ;
    rdfs:comment "representation for something, or for a conceptualization thereof, that denotes it in a domain or subject" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "designator" .

<https://www.omg.org/spec/Commons/Locations/GeographicRegion> a owl:Class ;
    rdfs:label "geographic region" ;
    rdfs:comment "area of land that has common features" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Party> a owl:Class ;
    rdfs:label "party" ;
    rdfs:comment "person or organization" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Agent> ;
    skos:altLabel "independent party" .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> a owl:Class ;
    rdfs:label "jurisdiction" ;
    rdfs:comment "power of a court or regulatory agency to adjudicate cases, issue orders, and interpret and apply the law with respect to some specific geographic area" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/Context> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> a owl:Class ;
    rdfs:label "financial instrument" ;
    rdfs:comment "written contract that gives rise to both a financial asset of one entity and a financial liability of another entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option> a owl:Class ;
    rdfs:label "option" ;
    rdfs:comment "derivative instrument that grants to the holder either the privilege to purchase or the privilege to sell the assets specified at a predetermined price or formula at or within a time period in the future" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> a owl:Class ;
    rdfs:label "contract party" ;
    rdfs:comment "legally competent party that has entered into a binding agreement, accepting and conceding obligations, responsibilities, and benefits as specified" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> a owl:Class ;
    rdfs:label "derivative instrument" ;
    rdfs:comment "financial instrument that confers on its holders certain rights or obligations, whose value is derived from one or more underlying assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    skos:altLabel "derivative contract" .

<https://www.omg.org/spec/Commons/DatesAndTimes/Date> a owl:Class ;
    rdfs:label "date" ;
    rdfs:comment "calendar day on some calendar" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> a owl:Class ;
    rdfs:label "currency" ;
    rdfs:comment "medium of exchange value, defined by reference to the geographical location of the monetary authorities responsible for it" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> ;
    skos:altLabel "currency unit",
        "monetary unit" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> a owl:Class ;
    rdfs:label "contract" ;
    rdfs:comment "voluntary, deliberate agreement between competent parties to which the parties agree to be legally bound, and for which the parties provide valuable consideration" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> .

<https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> a owl:Class ;
    rdfs:label "code element" ;
    rdfs:comment "sequence of characters denoting something for some purpose, within a specified context, according to some rule set" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> a owl:Class ;
    rdfs:label "situation" ;
    rdfs:comment "setting, state of being, or relationship that is relatively stable for some period of time" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RolesAndCompositions/Role> a owl:Class ;
    rdfs:label "role" ;
    rdfs:comment "named specific behavior of something participating in a particular context" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> a owl:Class ;
    rdfs:label "party role" ;
    rdfs:comment "role played by an organization or individual that may be time bound" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> .

ns:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:comment "Synthesized root class" .

