@prefix ns: <https://w3id.org/ontology-registry/fibo-derivatives#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentBody> a owl:Class ;
    rdfs:label "government body" ;
    rdfs:comment "formal organization that is an agency, instrumentality, or other body of a supranational, national, federal, state, or local government, including certain multijurisdictional agencies and departments that carry out the business of government" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/FormalOrganization> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/hasSharesAuthorized> a owl:DatatypeProperty ;
    rdfs:label "has shares authorized" ;
    rdfs:range xsd:nonNegativeInteger .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasRegisteredAddress> a owl:ObjectProperty ;
    rdfs:label "has registered address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalForm> a owl:Class ;
    rdfs:label "entity legal form" ;
    rdfs:comment "a classifier for a legal entity that indicates the nature of that entity as defined from a legal or regulatory perspective, in the jurisdiction in which it was established" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormIdentifier> a owl:Class ;
    rdfs:label "entity legal form identifier" ;
    rdfs:comment "code that denotes an entity legal form as defined in ISO 20275" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormScheme> a owl:Class ;
    rdfs:label "entity legal form scheme" ;
    rdfs:comment "scheme that specifies the elements of the codes for entity legal forms, such as those that are sanctioned in a given jurisdiction as defined in ISO 20725" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LEIRegisteredEntity> a owl:Class ;
    rdfs:label "LEI registered entity" ;
    rdfs:comment "a legal person that has registered for and is identified by a legal entity identifier" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifier> a owl:Class ;
    rdfs:label "legal entity identifier" ;
    rdfs:comment "an organization identifier that uniquely identifies a legal person as defined in ISO 17442" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifierScheme> a owl:Class ;
    rdfs:label "legal entity identifier scheme" ;
    rdfs:comment "a scheme that specifies the elements of an unambiguous legal entity identifier (LEI) scheme to identify the legal entities relevant to any financial transaction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatus> a owl:Class ;
    rdfs:label "relationship status" ;
    rdfs:comment "a classifier that specifies the status of the relationship between consolidated entities during the reporting period (active or inactive)" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasLegalAddress> a owl:ObjectProperty ;
    rdfs:label "has legal address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Authorization> a owl:Class ;
    rdfs:label "Authorization" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/AuthorizedParty> a owl:Class ;
    rdfs:label "AuthorizedParty" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/AuthorizingParty> a owl:Class ;
    rdfs:label "AuthorizingParty" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/authorizesThrough> a owl:ObjectProperty ;
    rdfs:label "authorizesThrough" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/hasAuthorizedParty> a owl:ObjectProperty ;
    rdfs:label "hasAuthorizedParty" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/hasAuthorizingParty> a owl:ObjectProperty ;
    rdfs:label "hasAuthorizingParty" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/isAuthorizedThrough> a owl:ObjectProperty ;
    rdfs:label "isAuthorizedThrough" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/CreditDerivative> a owl:Class ;
    rdfs:label "credit derivative" ;
    rdfs:comment "derivative instrument that is a privately held, negotiable bilateral contract traded over-the-counter (OTC) between two parties in a creditor/debtor relationship, enabling the creditor to effectively transfer some or all of the risk of a debtor defaulting to a third party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/InterestRateDerivative> a owl:Class ;
    rdfs:label "interest rate derivative" ;
    rdfs:comment "rate-based derivative whose underlier is an interest rate" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/RateBasedDerivative> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ObservableValue> a owl:Class ;
    rdfs:label "observable value" ;
    rdfs:comment "specification for the value for something discernible and for which evidence can be obtained" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UnderlyingAssetValuation> a owl:Class ;
    rdfs:label "underlying asset valuation" ;
    rdfs:comment "assessment activity to estimate the value of an underlying asset of a derivative" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ValueAssessment> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasSettlementTerms> a owl:ObjectProperty ;
    rdfs:label "has settlement terms" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/SettlementTerms> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasValuationTerms> a owl:ObjectProperty ;
    rdfs:label "has valuation terms" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ValuationTerms> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/specifiesValueOf> a owl:ObjectProperty ;
    rdfs:label "specifies value of" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/FuturesAndForwards/FinancialFuture> a owl:Class ;
    rdfs:label "financial future" ;
    rdfs:comment "futures contract based on underlying assets excluding commodities" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Future> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/FuturesAndForwards/Forward> a owl:Class ;
    rdfs:label "forward" ;
    rdfs:comment "derivative instrument that is privately negotiated between parties to buy the underlier at a specified future date at the price specified in the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/OverTheCounterDerivativeInstrument> ;
    skos:altLabel "forward contract" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/CallOption> a owl:Class ;
    rdfs:label "call option" ;
    rdfs:comment "option giving the buyer (holder) the right, but not the obligation, to buy the assets specified at a fixed price or formula, on or before a specified date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/Moneyness> a owl:Class ;
    rdfs:label "moneyness" ;
    rdfs:comment "classifier for a derivative relating its strike price to the price of its underlying asset" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/PutOption> a owl:Class ;
    rdfs:label "put option" ;
    rdfs:comment "option giving the buyer (holder) the right, but not the obligation, to sell the assets specified at a fixed price or formula, on or before a specified date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/VanillaOption> a owl:Class ;
    rdfs:label "vanilla option" ;
    rdfs:comment "common option giving the buyer (holder) the right, but not the obligation, to buy (via a call option) or sell (via a put option) the underlying assets specified at a pre-determined price (i.e., the strike price, fixed or calculated), on or before a specified date (the expiration date)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/hasExercisePrice> a owl:ObjectProperty ;
    rdfs:label "has exercise price" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/StrikePrice> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/hasExerciseSchedule> a owl:ObjectProperty ;
    rdfs:label "has exercise schedule" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/hasExerciseStyle> a owl:ObjectProperty ;
    rdfs:label "has exercise style" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/ExerciseConventions/ExerciseConvention> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/hasOptionWriter> a owl:ObjectProperty ;
    rdfs:label "has option writer" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Options/OptionIssuer> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/FixedLeg> a owl:Class ;
    rdfs:label "fixed leg" ;
    rdfs:comment "swap leg whose paying party is obligated to make payments from time to time over the term of a swap calculated by reference to a fixed annual rate or consisting of at least one payment of a fixed amount" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapLeg> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/FloatingLeg> a owl:Class ;
    rdfs:label "floating leg" ;
    rdfs:comment "swap leg whose paying party is obligated to make payments from time to time over the term of a swap calculated by reference to some variable rate, calculated based on the change in value of some underlying asset, or consisting of at least one payment of some floating amount" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapLeg> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapParty> a owl:Class ;
    rdfs:label "swap party" ;
    rdfs:comment "party to a swap and therefore a legal party to the contract that embodies that transaction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapPayingParty> a owl:Class ;
    rdfs:label "swap paying party" ;
    rdfs:comment "swap party responsible for making payments for a given leg of the transaction as defined in the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/PayingParty> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapReceivingParty> a owl:Class ;
    rdfs:label "swap receiving party" ;
    rdfs:comment "swap party that receives payments for a given leg of the transaction as defined in the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ReceivingParty> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapTerms> a owl:Class ;
    rdfs:label "swap terms" ;
    rdfs:comment "legal contractual terms of a swap transaction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/DerivativeTerms> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/hasLeg> a owl:ObjectProperty ;
    rdfs:label "has leg" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/Swap> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapLeg> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/isLegOf> a owl:ObjectProperty ;
    rdfs:label "is leg of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/SwapLeg> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/Swaps/Swap> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreement> a owl:Class ;
    rdfs:label "credit agreement" ;
    rdfs:comment "contractual agreement in which a debtor receives something of value and typically agrees to repay the creditor by some date in the future, in some form (e.g., cash, securities, etc.), generally with interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention> a owl:Class ;
    rdfs:label "day-count convention" ;
    rdfs:comment "a business recurrence interval convention that is used to calculate the number of days in an interest payment, which applies to the amount of accrued interest or the present value for debt instruments" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> a owl:Class ;
    rdfs:label "debt terms" ;
    rdfs:comment "contract terms that specify the formal rights and obligations of borrower and lender under a contract in which funds are lent from the one party to the other" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/FixedInterestRate> a owl:Class ;
    rdfs:label "fixed interest rate" ;
    rdfs:comment "interest rate that does not fluctuate over the lifetime of a loan or other debt instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/InterestRate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwed> a owl:ObjectProperty ;
    rdfs:label "is owed" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwedBy> a owl:ObjectProperty ;
    rdfs:label "is owed by" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwedTo> a owl:ObjectProperty ;
    rdfs:label "is owed to" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/owes> a owl:ObjectProperty ;
    rdfs:label "owes" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasUnderlier> a owl:ObjectProperty ;
    rdfs:label "has underlier" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Underlier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isDenominatedIn> a owl:ObjectProperty ;
    rdfs:label "is denominated in" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isLegallyRecordedIn> a owl:ObjectProperty ;
    rdfs:label "is legally recorded in" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isNegotiable> a owl:DatatypeProperty ;
    rdfs:label "is negotiable" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasLotSize> a owl:DatatypeProperty ;
    rdfs:label "has lot size" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasPriceDeterminationMethod> a owl:ObjectProperty ;
    rdfs:label "has price determination method" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceDeterminationMethod> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReason> a owl:Class ;
    rdfs:label "entity expiration reason" ;
    rdfs:comment "code for the reason that a legal entity ceased to exist and/or operate" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityStatus> a owl:Class ;
    rdfs:label "entity status" ;
    rdfs:comment "lifecycle stage indicating the operational and/or legal status of an entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevel> a owl:Class ;
    rdfs:label "entity validation level" ;
    rdfs:comment "code for the level of validation performed by the GLEIF or LOU with respect to the reference data provided by the registrant" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus> a owl:Class ;
    rdfs:label "registration status" ;
    rdfs:comment "lifecycle stage indicating the status of a given registration of something, such as a business or legal entity, as specified by the registration authority" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/CryptoAssetServicesProvider> a owl:Class ;
    rdfs:label "crypto asset services provider" ;
    rdfs:comment "financial services provider that provides services for crypto assets that enable the control of crypto assets, and participate in, or provide, financial services for issuers' offers, or sale, of crypto assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> ;
    skos:altLabel "CASP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DataReportingServicesProvider> a owl:Class ;
    rdfs:label "data reporting services provider" ;
    rdfs:comment "market data provider and reporting party that reports and/or publishes data on securities transactions, including required regulatory reporting for such transactions, and as such is subject to regulatory supervision" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
    skos:altLabel "DRSP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> a owl:Class ;
    rdfs:label "exchange" ;
    rdfs:comment "any organization, association, or group of persons, whether incorporated or unincorporated, which constitutes, maintains, or provides a facility for bringing together purchasers and sellers of financial instruments, commodities, or other products, services, or goods, and includes the market place and facilities maintained by such exchange" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "market" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketCategoryClassifier> a owl:Class ;
    rdfs:label "market category classifier" ;
    rdfs:comment "classifier representing the controlled vocabulary that delineates the nature of the exchange or data reporting services provider where possible" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifierCodeStatus> a owl:Class ;
    rdfs:label "market indicator code status" ;
    rdfs:comment "lifecycle stage indicating the status of the MIC code, as specified by the registration authority" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketLevelClassifier> a owl:Class ;
    rdfs:label "market level classifier" ;
    rdfs:comment "classifier that indicates whether the exchange or data reporting services provider is an operating level or market segment level facility" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/TradeReportingFacility> a owl:Class ;
    rdfs:label "trade reporting facility" ;
