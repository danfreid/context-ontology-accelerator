<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/owes> a owl:ObjectProperty ;
    rdfs:label "owes" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/GovernmentGuaranty> a owl:Class ;
    rdfs:label "government guaranty" ;
    rdfs:comment "guaranty provided by a government entity, such as for a government-backed security" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/InsuranceBackedGuaranty> a owl:Class ;
    rdfs:label "insurance-backed guaranty" ;
    rdfs:comment "guaranty that is realized as an insurance policy" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/InsurancePolicy> a owl:Class ;
    rdfs:label "insurance policy" ;
    rdfs:comment "contract that (1) puts an indemnity cover into effect, (2) serves as a legal evidence of the insurance agreement, (3) sets out the exact terms on which the indemnity cover has been provided, and (4) states associated information such as the (a) specific risks and perils covered, (b) duration of coverage, (c) amount of premium, (d) mode of premium payment, and (e) deductibles, if any" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> ;
    skos:altLabel "insurance contract" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Insurer> a owl:Class ;
    rdfs:label "insurer" ;
    rdfs:comment "financial service provider that issues an insurance policy" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/JointGuaranty> a owl:Class ;
    rdfs:label "joint guaranty" ;
    rdfs:comment "guaranty provided by at least two parties, jointly and severally" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/LetterOfCredit> a owl:Class ;
    rdfs:label "letter of credit" ;
    rdfs:comment "letter from a bank or other creditworthy institution guaranteeing that a buyer's payment to a seller will be received on time and for the correct amount" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CommittedCreditFacility> ;
    skos:altLabel "L/C" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/LetterOfCreditGuaranty> a owl:Class ;
    rdfs:label "letter of credit guaranty" ;
    rdfs:comment "guaranty that takes the form of a letter of credit, i.e., a document issued by a bank guaranteeing the payment up to a stated amount for a specified period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/CollateralizedGuaranty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/NegativePledge> a owl:Class ;
    rdfs:label "negative pledge" ;
    rdfs:comment "guaranty whereby the issuer will not pledge any assets if doing so would result in less security for lender(s) or investor(s)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Policyholder> a owl:Class ;
    rdfs:label "policyholder" ;
    rdfs:comment "counterparty to and typically owner of an insurance policy" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> ;
    skos:altLabel "insured party" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/hasGuaranteedAmount> a owl:ObjectProperty ;
    rdfs:label "has guaranteed amount" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/hasGuarantor> a owl:ObjectProperty ;
    rdfs:label "has guarantor" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guarantor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/hasGuarantorParty> a owl:ObjectProperty ;
    rdfs:label "has guarantor party" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guarantor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/hasPriorityLevel> a owl:ObjectProperty ;
    rdfs:label "has priority level" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/PriorityLevel> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/isGuaranteedBy> a owl:ObjectProperty ;
    rdfs:label "is guaranteed by" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guarantor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/isGuarantorOf> a owl:ObjectProperty ;
    rdfs:label "is guarantor of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guarantor> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CommodityInstrument> a owl:Class ;
    rdfs:label "commodity instrument" ;
    rdfs:comment "financial instrument representing an ownership interest in bulk goods, such as raw materials and primary agricultural products" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CurrencyInstrument> a owl:Class ;
    rdfs:label "currency instrument" ;
    rdfs:comment "financial instrument used for the purposes of currency trading" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Entitlement> a owl:Class ;
    rdfs:label "entitlement" ;
    rdfs:comment "financial instrument that provides the holder an interest in, or the privilege to subscribe to, or to receive specific assets under terms specified" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    skos:altLabel "right" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/EquityInstrument> a owl:Class ;
    rdfs:label "equity instrument" ;
    rdfs:comment "financial instrument representing an ownership interest in an entity or pool of assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/ExemptSecurity> a owl:Class ;
    rdfs:label "exempt security" ;
    rdfs:comment "security that is exempt from certain regulatory rules" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrumentIdentifier> a owl:Class ;
    rdfs:label "financial instrument identifier" ;
    rdfs:comment "sequence of characters uniquely identifying a financial instrument for some purpose and within a specified context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Future> a owl:Class ;
    rdfs:label "future" ;
    rdfs:comment "derivative instrument that obligates the buyer to receive and the seller to deliver the assets specified at an agreed price, at some later point in time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/NegotiableSecurity> a owl:Class ;
    rdfs:label "negotiable security" ;
    rdfs:comment "security that can be transferred to another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/NonNegotiableSecurity> a owl:Class ;
    rdfs:label "non-negotiable security" ;
    rdfs:comment "security that is not transferable to another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Option> a owl:Class ;
    rdfs:label "option" ;
    rdfs:comment "derivative instrument that grants to the holder either the privilege to purchase or the privilege to sell the assets specified at a predetermined price or formula at or within a time period in the future" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/PackagedFinancialProduct> a owl:Class ;
    rdfs:label "packaged financial product" ;
    rdfs:comment "financial product that acts as a container for at least one financial instrument, including other financial products, and whose value is derived from, or based on a reference asset, market measure, or investment strategy" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/ContractualProduct> ;
    skos:altLabel "market-linked investment",
        "structured product" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/PromissoryNote> a owl:Class ;
    rdfs:label "promissory note" ;
    rdfs:comment "debt instrument that is a written promise by one party to another that commits that party to pay a specified sum on demand or within a specified time frame under specified terms" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DebtInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/SpotContract> a owl:Class ;
    rdfs:label "spot contract" ;
    rdfs:comment "financial instrument that settles for immediate delivery on a specified date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/StandardizedTerms> a owl:Class ;
    rdfs:label "standardized terms" ;
    rdfs:comment "contract terms that, grouped together, that are generally and consistently reused across many contracts, published by some organization, and capable of being incorporated into a contract by reference" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasBuyingCurrency> a owl:ObjectProperty ;
    rdfs:label "has buying currency" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasCalculationAgent> a owl:ObjectProperty ;
    rdfs:label "has calculation agent" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CalculationAgent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasCommodityValueAsOfExecutionDate> a owl:ObjectProperty ;
    rdfs:label "has commodity value as of execution date" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasNominalValue> a owl:ObjectProperty ;
    rdfs:label "has nominal value" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasPrincipalExecutiveOfficeAddress> a owl:ObjectProperty ;
    rdfs:label "has principal executive office address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalPerson> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasRedemptionProvision> a owl:ObjectProperty ;
    rdfs:label "has redemption terms" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/RedemptionProvision> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasSellingCurrency> a owl:ObjectProperty ;
    rdfs:label "has selling currency" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasShareholder> a owl:ObjectProperty ;
    rdfs:label "has shareholder" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Issuer> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/Shareholder> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasUnderlier> a owl:ObjectProperty ;
    rdfs:label "has underlier" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Underlier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/hasValueExpressedIn> a owl:ObjectProperty ;
    rdfs:label "has value expressed in" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/holdsSharesIn> a owl:ObjectProperty ;
    rdfs:label "holds shares in" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/Shareholder> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Issuer> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isDenominatedIn> a owl:ObjectProperty ;
    rdfs:label "is denominated in" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isLegallyRecordedIn> a owl:ObjectProperty ;
    rdfs:label "is legally recorded in" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isNegotiable> a owl:DatatypeProperty ;
    rdfs:label "is negotiable" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/AdjustedClosingPrice> a owl:Class ;
    rdfs:label "adjusted closing price" ;
    rdfs:comment "amended closing price to reflect a security's value after accounting for any corporate actions, such as stock splits, dividends, and rights offerings" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/ClosingPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/BestBid> a owl:Class ;
    rdfs:label "best bid" ;
    rdfs:comment "highest bid price a prospective buyer is willing to pay at a particular time for a given security" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/BidPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/BestOffer> a owl:Class ;
    rdfs:label "best offer" ;
    rdfs:comment "lowest price acceptable to a prospective seller for a given security at a particular point in time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/OfferPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/BidAskSpread> a owl:Class ;
    rdfs:label "bid ask spread" ;
    rdfs:comment "difference between an offer (ask) price and a bid price" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceSpread> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/CleanPrice> a owl:Class ;
    rdfs:label "clean price" ;
    rdfs:comment "debt instrument price that does not include accrued interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/CollectionOfSecurityPrices> a owl:Class ;
    rdfs:label "collection of security prices" ;
    rdfs:comment "collection consisting of a series of prices, each of which has a specific date and time associated with it, for some security" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedStructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/CompositeMarket> a owl:Class ;
    rdfs:label "composite market" ;
    rdfs:comment "group of exchanges and trading venues referenced for pricing purposes" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/StructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/DerivedPrice> a owl:Class ;
    rdfs:label "derived price" ;
    rdfs:comment "price that stems from another source or calculation rather than being quoted or based on actual trading data" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/CalculatedPrice> ;
    skos:altLabel "interpolated price",
        "matrix price" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/DirtyPrice> a owl:Class ;
    rdfs:label "dirty price" ;
    rdfs:comment "debt instrument price that includes accrued interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/HighPrice> a owl:Class ;
    rdfs:label "high price" ;
    rdfs:comment "highest price for a given security over the period specified" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/InternalRateOfReturn> a owl:Class ;
    rdfs:label "internal rate of return" ;
    rdfs:comment "discount rate that results in a net present value (NPV) of zero for a series of future cash flows" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/RateOfReturn> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/IntraDayPrice> a owl:Class ;
    rdfs:label "intra day price" ;
    rdfs:comment "price for a given security at some point between the opening and official closing price on an exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/MarketPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/LowPrice> a owl:Class ;
    rdfs:label "low price" ;
    rdfs:comment "lowest value for a given security over the period specified" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/MidPrice> a owl:Class ;
    rdfs:label "mid price" ;
    rdfs:comment "arithmetic mean between bid and offer prices" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/OfficialClosingPrice> a owl:Class ;
    rdfs:label "official closing price" ;
    rdfs:comment "price of the final trade of a security at the end of a trading day on a given exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/ClosingPrice> ;
    skos:altLabel "end-of-day price" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/OpeningPrice> a owl:Class ;
    rdfs:label "opening price" ;
    rdfs:comment "price at which something first trades at the start of a trading day" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/MarketPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PricingModel> a owl:Class ;
    rdfs:label "pricing model" ;
    rdfs:comment "expression used to determine a value for an instrument at a given point in time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/TradingDay> a owl:Class ;
    rdfs:label "trading day" ;
    rdfs:comment "time span that a particular trading venue is open" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDatePeriod> ;
    skos:altLabel "RTH",
        "regular trading hours" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/TradingSession> a owl:Class ;
    rdfs:label "trading session" ;
    rdfs:comment "window of time within a trading day in which orders may be placed and filled" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDatePeriod> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/VolumeWeightedAveragePrice> a owl:Class ;
    rdfs:label "volume-weighted average price" ;
    rdfs:comment "average price at which a given security has traded throughout a trading day, determined by multiplying each trade by its volume, adding the results, then dividing by the volume traded for the day" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceAnalytic> ;
    skos:altLabel "VWAP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/VolumeWeightedOpenPrice> a owl:Class ;
    rdfs:label "volume-weighted open price" ;
    rdfs:comment "price determined by multiplying each trade by its volume, adding the results, then dividing by the volume over a certain period during the trading day (rather than over the course of the entire day)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceAnalytic> ;
    skos:altLabel "VWOP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/Yield> a owl:Class ;
    rdfs:label "yield" ;
    rdfs:comment "return on the investor's capital investment" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Percentage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/YieldSpread> a owl:Class ;
    rdfs:label "yield spread" ;
    rdfs:comment "the spread between the yields of two items" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Difference> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasBookDepth> a owl:DatatypeProperty ;
    rdfs:label "has book depth" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> ;
    rdfs:range xsd:integer .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasClosingPriceDeterminationMethod> a owl:ObjectProperty ;
    rdfs:label "has closing price determination method" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/ClosingPriceDeterminationMethod> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasLotSize> a owl:DatatypeProperty ;
    rdfs:label "has lot size" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasNumberOfDaysAccrued> a owl:DatatypeProperty ;
    rdfs:label "has number of days accrued" ;
    rdfs:range xsd:integer .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasPriceDeterminationMethod> a owl:ObjectProperty ;
    rdfs:label "has price determination method" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceDeterminationMethod> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasPricingSource> a owl:ObjectProperty ;
    rdfs:label "has pricing source" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasQuoteLotSize> a owl:DatatypeProperty ;
    rdfs:label "has quote lot size" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasRateOfReturn> a owl:ObjectProperty ;
    rdfs:label "has rate of return" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/RateOfReturn> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasRoundLotSize> a owl:DatatypeProperty ;
    rdfs:label "has round lot size" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasTradingDateTime> a owl:ObjectProperty ;
    rdfs:label "has trading date time" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/DateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/hasTradingVolume> a owl:DatatypeProperty ;
    rdfs:label "has trading volume" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/BusinessRegisterIdentifier> a owl:Class ;
    rdfs:label "business register identifier" ;
    rdfs:comment "identifier that uniquely identifies a business register, such as a register identified by the Global Legal Entity Identifier Foundation (GLEIF) registration authorities list" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityLegalFormRegistry> a owl:Class ;
    rdfs:label "entity legal form registry" ;
    rdfs:comment "registry for registering and maintaining information about the legal forms that are valid for business entities for a particular jurisdiction following the ISO 20275 standard" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> ;
    skos:altLabel "ELF registry" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityLegalFormRegistryEntry> a owl:Class ;
    rdfs:label "entity legal form registry entry" ;
    rdfs:comment "entry in an entity legal form registry that conforms to ISO 20275" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistryEntry> ;
    skos:altLabel "ELF registry entry" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/LegalEntityIdentifierRegistry> a owl:Class ;
    rdfs:label "legal entity identifier registry" ;
    rdfs:comment "registry for registering and maintaining information about business entities for a particular jurisdiction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/BusinessRegistry> ;
    skos:altLabel "LEI registry" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/LegalEntityIdentifierRegistryEntry> a owl:Class ;
    rdfs:label "legal entity identifier registry entry" ;
    rdfs:comment "entry in a legal entity identifier registry that conforms to ISO 17442 and the Global Legal Entity Identifier Foundation (GLEIF) Common Data Format (CDF)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/BusinessRegistryEntry> ;
    skos:altLabel "LEI registry entry" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/LocalOperatingUnit> a owl:Class ;
    rdfs:label "local operating unit" ;
    rdfs:comment "registrar that is authorized by the Global LEI Foundation to issue legal entity identifiers" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registrar> ;
    skos:altLabel "LOU" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/NorthAmericanIndustryClassificationSystemCode> a owl:Class ;
    rdfs:label "North American Industry Classification System code" ;
    rdfs:comment "the North American Industry Classification System (NAICS) code representing an industry" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> ;
    skos:altLabel "NAICS code" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/NorthAmericanIndustryClassificationSystemScheme> a owl:Class ;
    rdfs:label "North American Industry Classification System scheme" ;
    rdfs:comment "the scheme defining the North American Industry Classification System (NAICS) Codes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/IndustrySectorClassificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationAuthorityCode> a owl:Class ;
    rdfs:label "registration authority code" ;
    rdfs:comment "identifier that uniquely identifies a business registry, and is associated with a registration authority and jurisdiction, issued by the Global Legal Entity Identifier Foundation (GLEIF)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/StandardIndustrialClassificationCode> a owl:Class ;
    rdfs:label "standard industrial classification code" ;
    rdfs:comment "the SIC code representing an industry" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> ;
    skos:altLabel "SIC code" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/StandardIndustrialClassificationScheme> a owl:Class ;
    rdfs:label "standard industrial classification scheme" ;
    rdfs:comment "the scheme defining the Standard Industrial Classification (SIC) Code List" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasAlternativeLanguageLegalName> a owl:DatatypeProperty ;
    rdfs:label "has alternative language legal name" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasAutomaticallyTransliteratedLegalName> a owl:DatatypeProperty ;
    rdfs:label "has automatically transliterated legal name" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasEntityExpirationDate> a owl:DatatypeProperty ;
    rdfs:label "has entity expiration date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasEntityExpirationReason> a owl:ObjectProperty ;
    rdfs:label "has entity expiration reason" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReason> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasEntityStatus> a owl:ObjectProperty ;
    rdfs:label "has entity status" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityStatus> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasExpiryDate> a owl:DatatypeProperty ;
    rdfs:label "has expiry date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasInitialRegistrationDate> a owl:DatatypeProperty ;
    rdfs:label "has initial registration date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasManagingLocalOperatingUnit> a owl:ObjectProperty ;
    rdfs:label "has managing local operating unit" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasPreferredTransliteratedLegalName> a owl:DatatypeProperty ;
    rdfs:label "has preferred transliterated legal name" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasPriorLegalName> a owl:DatatypeProperty ;
    rdfs:label "has prior legal name" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasRegistrationRevisionDate> a owl:DatatypeProperty ;
    rdfs:label "has registration status revision date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasRegistrationStatus> a owl:ObjectProperty ;
    rdfs:label "has registration status" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasRegistryName> a owl:DatatypeProperty ;
    rdfs:label "has registry name" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasRenewalDate> a owl:DatatypeProperty ;
    rdfs:label "has renewal date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasTradingOrOperationalName> a owl:DatatypeProperty ;
    rdfs:label "has trading or operational name" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasTransliteratedLegalName> a owl:DatatypeProperty ;
    rdfs:label "has transliterated legal name" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasValidationAuthority> a owl:ObjectProperty ;
    rdfs:label "has validation authority" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/BusinessRegistrationAuthority> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasValidationDate> a owl:DatatypeProperty ;
    rdfs:label "has validation date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/hasValidationLevel> a owl:ObjectProperty ;
    rdfs:label "has validation level" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevel> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/isSelfMaintained> a owl:DatatypeProperty ;
    rdfs:label "is self-maintained" ;
    rdfs:range xsd:string .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/BankHoldingCompany> a owl:Class ;
    rdfs:label "bank holding company" ;
    rdfs:comment "any company that owns and/or has direct or indirect control of one or more banks; BHCs may also own nonbanking subsidiaries such as broker-dealers and asset managers" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/BankingProduct> a owl:Class ;
    rdfs:label "banking product" ;
    rdfs:comment "product provided to consumers and businesses by a depository institution" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialProduct> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/BankingService> a owl:Class ;
    rdfs:label "banking service" ;
    rdfs:comment "financial service offered by a depository institution" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/BrokerageFirm> a owl:Class ;
    rdfs:label "brokerage firm" ;
    rdfs:comment "firm in the business of buying and selling securities, operating as both a broker and a dealer, depending on the transaction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> ;
    skos:altLabel "market maker" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/BusinessIdentifierCode> a owl:Class ;
    rdfs:label "business identifier code" ;
    rdfs:comment "international identifier for financial and non-financial institutions used to facilitate automated processing of information for financial services" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> ;
    skos:altLabel "BIC",
        "SWIFT ID",
        "SWIFT code",
        "SWIFT-BIC",
        "bank identifier code",
        "business entity identifier" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/BusinessIdentifierCodeScheme> a owl:Class ;
    rdfs:label "business identifier code scheme" ;
    rdfs:comment "scheme that specifies the elements of a unique business identifier code (BIC) scheme to identify financial and non-financial institutions used to facilitate automated processing of information for financial services" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/BusinessPartyPrefix> a owl:Class ;
    rdfs:label "business party prefix" ;
    rdfs:comment "four-character (4 alphanumeric) code associated with an organization for the purposes of banking telecommunications" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> ;
    skos:altLabel "bank code",
        "institution code" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/BusinessPartySuffix> a owl:Class ;
    rdfs:label "business party suffix" ;
    rdfs:comment "two-character (2 alphanumeric) code associated with the organization for the purposes of banking telecommunications" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/CentralBank> a owl:Class ;
    rdfs:label "central bank" ;
    rdfs:comment "financial institution that is the monetary authority and major regulatory bank for a country (or group of countries)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/MonetaryAuthority> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/CentralCounterpartyClearingHouse> a owl:Class ;
    rdfs:label "central counterparty clearing house" ;
    rdfs:comment "clearing house that helps facilitate trading in derivatives and equities markets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ClearingHouse> ;
    skos:altLabel "CCP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/CentralSecuritiesDepository> a owl:Class ;
    rdfs:label "central securities depository" ;
    rdfs:comment "functional entity that provides a central point for depositing financial instruments ('securities'), for example, bonds and shares" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> ;
    skos:altLabel "CSD" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ClearingBank> a owl:Class ;
    rdfs:label "clearing bank" ;
    rdfs:comment "commercial bank that facilitates payment and settlement of financial transactions, such as check clearing or facilitating trades between the sellers and buyers of securities or other financial instruments or contracts" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/CommercialBank> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ClearingCorporation> a owl:Class ;
    rdfs:label "clearing corporation" ;
    rdfs:comment "clearing house that is organized as a corporation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ClearingHouse> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ClearingService> a owl:Class ;
    rdfs:label "clearing service" ;
    rdfs:comment "service provided on behalf of an institutional market participant by a clearing services provider following a trade that finalizes the transfer of security ownership" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/CommercialFinanceCompany> a owl:Class ;
    rdfs:label "commercial finance company" ;
    rdfs:comment "finance company that makes loans to manufacturers and wholesalers, secured by accounts receivable, inventories, and equipment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinanceCompany> ;
    skos:altLabel "commercial credit company" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/CommodityTradingAdvisor> a owl:Class ;
    rdfs:label "commodity trading advisor" ;
    rdfs:comment "party that directly or indirectly advises others as to the value or advisability of buying or selling futures contracts or options" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> ;
    skos:altLabel "CTA" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ConsumerFinanceCompany> a owl:Class ;
    rdfs:label "consumer finance company" ;
    rdfs:comment "finance company that lends to individuals under the small loans laws of the jurisdiction in which they operate" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinanceCompany> ;
    skos:altLabel "direct loan company",
        "small loan company" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ContractualSavingsInstitution> a owl:Class ;
    rdfs:label "contractual savings institution" ;
    rdfs:comment "financial institution that provides the opportunity for individuals to invest in collective investment vehicles in a fiduciary rather than a principle role" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> ;
    skos:altLabel "institutional investment firm",
        "institutional investor",
        "investisseur institutionnel" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/CreditUnion> a owl:Class ;
    rdfs:label "credit union" ;
    rdfs:comment "not-for-profit depository institution that makes personal loans and offers other consumer banking services, organized for the purpose of promoting thrift among its members and creating a source of credit for provident or productive purposes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/DepositoryInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/DataProcessingService> a owl:Class ;
    rdfs:label "data processing service" ;
    rdfs:comment "financial service offered by an entity primarily engaged in providing infrastructure for hosting or data processing services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/DataProcessingServicer> a owl:Class ;
    rdfs:label "data processing servicer" ;
    rdfs:comment "finance services provider primarily engaged in providing infrastructure for hosting or data processing services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/DevelopmentBank> a owl:Class ;
    rdfs:label "development bank" ;
    rdfs:comment "national or regional financial institution designed to provide medium- and long-term capital for productive investment, often accompanied by technical assistance, in poor countries" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialInstitution> ;
    skos:altLabel "development finance company (DFC)",
        "development financial institution (DFI)" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FaceAmountCertificateCompany> a owl:Class ;
    rdfs:label "face amount certificate company" ;
    rdfs:comment "investment company which is engaged or proposes to engage in the business of issuing face-amount certificates of the installment type, or which has been engaged in such business and has any such certificate outstanding" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/InvestmentCompany> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialServiceProviderIdentifierScheme> a owl:Class ;
    rdfs:label "financial service provider identifier scheme" ;
    rdfs:comment "scheme that defines the financial service provider identifier per the issuing registration authority or regulatory agency" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FuturesCommissionMerchant> a owl:Class ;
    rdfs:label "futures commission merchant" ;
    rdfs:comment "party that does both of the following: (1) solicits or accepts orders to buy or sell futures contracts, options on futures, retail off-exchange forex contracts, or swaps and (2) accepts money or other assets from customers to support such orders" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> ;
    skos:altLabel "FCM" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/HoldingCompany> a owl:Class ;
    rdfs:label "holding company" ;
    rdfs:comment "business entity established to own stock in another company, typically to own enough voting shares to have some level of control over that company's policies and management" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/InsuranceCompany> a owl:Class ;
    rdfs:label "insurance company" ;
    rdfs:comment "non-depository institution whose primary and predominant business activity is the writing of insurance or the reinsuring of risks underwritten by insurance companies, and that provides compensation based on the happening of at least one contingency" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/RiskPoolingInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/InsuranceService> a owl:Class ;
    rdfs:label "insurance service" ;
    rdfs:comment "financial service in which the insurer promises to provide compensation for specific potential future losses in exchange for a periodic payment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/InvestmentBank> a owl:Class ;
    rdfs:label "investment bank" ;
    rdfs:comment "financial service provider that acts as an underwriter or agent that serves as intermediary between the issuer of securities and the investing public" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/InvestmentService> a owl:Class ;
    rdfs:label "investment service" ;
    rdfs:comment "financial service designed to assist investors in using capital to create more money, either through income-producing vehicles or through more risk-oriented ventures to result in capital gains, including but not limited to providing investment advice, asset and portfolio management, and brokerage services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ManagementCompany> a owl:Class ;
    rdfs:label "management company" ;
    rdfs:comment "investment company that sells and manages a portfolio of securities other than a face-amount certificate company or unit investment fund" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/InvestmentCompany> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/MoneyServicesBusiness> a owl:Class ;
    rdfs:label "money services business" ;
    rdfs:comment "any person doing business, whether or not on a regular basis or as an organized business concern, in one of the following capacities: (1) currency dealer or exchanger, (2) check casher, (3) issuer of traveler's checks, money orders, or stored value, (4) seller or redeemer of traveler's checks, money orders, or stored value, (5) money transmitter, or (6) postal service" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> ;
    skos:altLabel "MSB" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/MortgageCompany> a owl:Class ;
    rdfs:label "mortgage company" ;
    rdfs:comment "financial service provider that originates and/or funds mortgages for residential or commercial property" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/PaymentService> a owl:Class ;
    rdfs:label "payment service" ;
    rdfs:comment "financial service that involves acceptance of electronic payments by a variety of payment methods including credit card, bank-based payments such as direct debit, bank transfer, and real-time bank transfer based on online banking" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/MerchantService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/PayrollService> a owl:Class ;
    rdfs:label "payroll service" ;
    rdfs:comment "financial service, typically provided to small businesses that are not large enough to have an internal finance organization, that involves managing payment of wages to employees" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/PrincipalUnderwriter> a owl:Class ;
    rdfs:label "principal underwriter" ;
    rdfs:comment "underwriter who, as principal, purchases from an investment company, or pursuant to some contract has the right to purchase from such company, any security for distribution, or who as agent for such company sells or has the right to sell any security to a dealer or to the public, excluding any dealer who purchases from such company through sn underwriter acting as an agent for such company" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/Underwriter> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/RegisteredInvestmentAdvisor> a owl:Class ;
    rdfs:label "registered investment advisor" ;
    rdfs:comment "registered agent and financial service provider that advises high net worth individuals on investments and manages their portfolios" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/RegisteredAgent> ;
    skos:altLabel "RIA" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/SalesFinanceCompany> a owl:Class ;
    rdfs:label "sales finance company" ;
    rdfs:comment "finance company that purchases retail and wholesale paper from automobile and other consumer and commercial goods dealers" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinanceCompany> ;
    skos:altLabel "acceptance company" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/SavingsAssociation> a owl:Class ;
    rdfs:label "savings association" ;
    rdfs:comment "depository institution that is (a) any federal savings bank or association chartered under section 1464 of the Federal Deposit Insurance Act; (b) any state chartered building and loan association, savings and loan association, or homestead association; or (c) any cooperative bank (other than a cooperative bank which is a state bank as defined in subsection (a)(2)) of the Federal Deposit Insurance Act, which is organized and operating according to the laws of the State (as defined in subsection (a)(3)) in which it is chartered or organized; and (c) any corporation (other than a bank) that the board of directors and the comptroller of the currency jointly determine to be operating in substantially the same manner as such a depository institution" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/DepositoryInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/SelfRegulatingOrganization> a owl:Class ;
    rdfs:label "self-regulating organization" ;
    rdfs:comment "non-governmental organization that has the power to create and exercise some degree of regulatory authority over an industry or profession in some country or group of countries" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegulatoryAgencies/RegulatoryAgency> ;
    skos:altLabel "SRO" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/TrustCompany> a owl:Class ;
    rdfs:label "trust company" ;
    rdfs:comment "financial institution that acts as a fiduciary, trustee or agent of trusts and agencies" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/UnitInvestmentTrust> a owl:Class ;
    rdfs:label "unit investment trust" ;
    rdfs:comment "investment company which (a) is organized under a trust indenture, contract of custodianship or agency, or similar instrument, (b) does not have a board of directors, and (c) issues only redeemable securities, each of which represents an undivided interest in a unit of specified securities; but does not include a voting trust" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/InvestmentCompany> ;
    skos:altLabel "UIT",
        "unit investment company" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/WealthManagementService> a owl:Class ;
    rdfs:label "wealth management service" ;
    rdfs:comment "financial service that combines financial and investment advice, accounting and tax services, retirement planning and legal or estate planning for one set fee" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/hasDateEstablished> a owl:ObjectProperty ;
    rdfs:label "has date established" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/hasDateEstablishmentTerminated> a owl:ObjectProperty ;
    rdfs:label "has date establishment terminated" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/hasDateInsured> a owl:ObjectProperty ;
    rdfs:label "has date insured" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/hasPortfolioCompany> a owl:ObjectProperty ;
    rdfs:label "has portfolio company" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/isPortfolioCompanyOf> a owl:ObjectProperty ;
    rdfs:label "is portfolio company of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/regulatesSupplyOf> a owl:ObjectProperty ;
    rdfs:label "regulates supply of" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegulatoryAgencies/RegulatoryAgency> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ApprovedPublicationArrangement> a owl:Class ;
    rdfs:label "approved publication arrangement" ;
    rdfs:comment "data reporting services provider that is authorized to provide the service of publishing certain trade reports on behalf of banks, investment firms, or asset management companies" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DataReportingServicesProvider> ;
    skos:altLabel "APA",
        "authorised publication arrangement",
        "authorized publication arrangement" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ApprovedReportingMechanism> a owl:Class ;
    rdfs:label "approved reporting mechanism" ;
    rdfs:comment "data reporting services provider that is authorized to provide the service of reporting details of transactions to competent authorities or ESMA (the European Securities and Markets Authority) on behalf of investment firms" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DataReportingServicesProvider> ;
    skos:altLabel "ARM" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/AuctionMarket> a owl:Class ;
    rdfs:label "auction market" ;
    rdfs:comment "exchange in which buyers and sellers submit competitive bids that do not involve direct negotiations between parties, as part of an auction scheduled either on demand or on a periodic basis" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ConsolidatedTapeProvider> a owl:Class ;
    rdfs:label "consolidated tape provider" ;
    rdfs:comment "data reporting services provider that is authorized to provide the service of collecting trade reports for financial instruments from regulated markets, MTFs, OTFs and APAs and consolidating them into a continuous electronic live data stream providing price and volume data per financial instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DataReportingServicesProvider> ;
    skos:altLabel "CTP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/CryptoAssetServicesProvider> a owl:Class ;
    rdfs:label "crypto asset services provider" ;
    rdfs:comment "financial services provider that provides services for crypto assets that enable the control of crypto assets, and participate in, or provide, financial services for issuers' offers, or sale, of crypto assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> ;
    skos:altLabel "CASP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DarkPool> a owl:Class ;
    rdfs:label "dark pool" ;
    rdfs:comment "privately organized alternative trading system, that allows institutional investors the ability to trade without exposure until after the trade has been executed and reported" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/AlternativeTradingSystem> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DesignatedContractMarket> a owl:Class ;
    rdfs:label "designated contract market" ;
    rdfs:comment "exchange, trading system, or platform that enables listing for trading futures or option contracts based on any underlying commodity, index or instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "DCM" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ElectronicCommunicationNetwork> a owl:Class ;
    rdfs:label "electronic communication network" ;
    rdfs:comment "alternative trading system that automatically matches buy and sell orders for securities in the market" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/AlternativeTradingSystem> ;
    skos:altLabel "ECN" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/ExchangeParticipant> a owl:Class ;
    rdfs:label "exchange participant" ;
    rdfs:comment "registered agent who, in accordance with the rules of an exchange, may trade on or through the exchange and whose name is entered in a list, register or roll kept by the exchange as an agent who may trade on or through the exchange" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/InterdealerQuotationSystem> a owl:Class ;
    rdfs:label "interdealer quotation system" ;
    rdfs:comment "automated system for organizing and disseminating price quotes by brokers and dealer firms that facilitates electronic trading in securities" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "IQS",
        "inter-dealer quotation system" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketCategoryClassifier> a owl:Class ;
    rdfs:label "market category classifier" ;
    rdfs:comment "classifier representing the controlled vocabulary that delineates the nature of the exchange or data reporting services provider where possible" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketLevelClassifier> a owl:Class ;
    rdfs:label "market level classifier" ;
    rdfs:comment "classifier that indicates whether the exchange or data reporting services provider is an operating level or market segment level facility" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketSegmentLevelMarket> a owl:Class ;
    rdfs:label "market segment-level market" ;
    rdfs:comment "section of an exchange/market/trade reporting facility that specialises in one or more specific instruments or that is regulated differently" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketSegmentLevelMarketIdentifier> a owl:Class ;
    rdfs:label "market segment-level market identifier" ;
    rdfs:comment "market identifier that identifies a section of an exchange/market/trade reporting facility that specialises in one or more specific instruments or that is regulated differently" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/OffMarketFacility> a owl:Class ;
    rdfs:label "off-market facility" ;
    rdfs:comment "facility used for reporting over-the-counter (OTC) and other direct trades that are not executed by the exchange but are reported through the exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "off-book",
        "off-facility" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/OperatingLevelMarket> a owl:Class ;
    rdfs:label "operating-level market" ;
    rdfs:comment "exchange/market/trade reporting facility in a specific market/country" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/OperatingLevelMarketIdentifier> a owl:Class ;
    rdfs:label "operating-level market identifier" ;
    rdfs:comment "market identifier that identifies an exchange/market/trade reporting facility in a specific market/country" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/OrganizedTradingFacility> a owl:Class ;
    rdfs:label "organized trading facility" ;
    rdfs:comment "multi-lateral system which is not an RM or an MTF and in which multiple third-party buying and selling interests in bonds, structured finance products, emission allowances or derivatives are able to interact in the system in a way that results in a contract in accordance with the provisions of Title II of MiFID II" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/AlternativeTradingSystem> ;
    skos:altLabel "OTF" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/QuoteDrivenMarket> a owl:Class ;
    rdfs:label "quote-driven market" ;
    rdfs:comment "exchange in which prices are determined from bid and ask quotations made by market makers, dealers, or specialists" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "price-driven market" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/RecognizedMarketOperator> a owl:Class ;
    rdfs:label "recognised market operator" ;
    rdfs:comment "exchange that is operated or maintained by an operator registered under certain securities regulations that brings together purchasers and sellers of capital market products" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "RMO" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/RegisteredMultilateralTradingFacility> a owl:Class ;
    rdfs:label "registered multilateral trading facility" ;
    rdfs:comment "multilateral system operated by an investment firm or market operator, which brings together multiple third-party buying and selling interests in financial instruments in the system, in accordance with non-discretionary rules, in a way that results in a contract in accordance with the provisions of Title II of the MiFID II" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MultilateralTradingFacility> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/RegulatedExchange> a owl:Class ;
    rdfs:label "regulated exchange" ;
    rdfs:comment "regulated market that is operated by and/or managed by a market operator that brings together or facilitates the bringing together of multiple third-party buying and selling interests in financial instruments" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "RM",
        "regulated market" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/SwapExecutionFacility> a owl:Class ;
    rdfs:label "swap execution facility" ;
    rdfs:comment "exchange that enables participants to execute and trade swaps" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "SEF" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/SystematicInternaliser> a owl:Class ;
    rdfs:label "systematic internaliser" ;
    rdfs:comment "investment firm that, on an organised, frequent, systematic and substantial basis, deals on its own account by executing client orders outside a regulated exchange, MTF or OTF without operating a multilateral system" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "SI" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/TradeReportingFacility> a owl:Class ;
    rdfs:label "trade reporting facility" ;
    rdfs:comment "facility that provides a mechanism for the reporting of transactions effected otherwise than on an exchange" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/SitesAndFacilities/Facility> ;
    skos:altLabel "TRF" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/hasFacilityAcronym> a owl:DatatypeProperty ;
    rdfs:label "has facility acronym" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/hasMarketIdentifierCodeStatus> a owl:ObjectProperty ;
    rdfs:label "has market identifier code status" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifierCodeStatus> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/operatesInCountry> a owl:ObjectProperty ;
    rdfs:label "operates in country" ;
    rdfs:range <https://www.omg.org/spec/Commons/Locations/Country> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/operatesInMunicipality> a owl:ObjectProperty ;
    rdfs:label "operates in municipality" ;
    rdfs:range <https://www.omg.org/spec/Commons/Locations/Municipality> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountAsAnAsset> a owl:Class ;
    rdfs:label "account as an asset" ;
    rdfs:comment "financial asset in the form of an account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/FinancialAsset> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountOwnership> a owl:Class ;
    rdfs:label "account ownership" ;
    rdfs:comment "holding of an account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Ownership> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountProvider> a owl:Class ;
    rdfs:label "account provider" ;
    rdfs:comment "party that provides and services an account" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/ServiceProvider> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountSpecificServiceAgreement> a owl:Class ;
    rdfs:label "account-specific service agreement" ;
    rdfs:comment "service-agreement that is account-specific, applicable in cases where a client might hold multiple accounts with differing terms and conditions" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/ServiceAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountingTransaction> a owl:Class ;
    rdfs:label "accounting transaction" ;
    rdfs:comment "event recognized by an entry in the records of an account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/TransactionEvent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BankIdentifier> a owl:Class ;
    rdfs:label "bank identifier" ;
    rdfs:comment "identifier that uniquely identifies the financial institution and, when appropriate, the branch of that financial institution servicing an account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialServiceProviderIdentifier> ;
    skos:altLabel "bank number" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BasicBankAccountIdentifier> a owl:Class ;
    rdfs:label "basic bank account identifier" ;
    rdfs:comment "identifier that uniquely identifies an individual account at a specific financial institution in a particular country and which includes a bank identifier of the financial institution servicing that account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BankAccountIdentifier> ;
    skos:altLabel "BBAN",
        "basic bank account number" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BrokerageAccount> a owl:Class ;
    rdfs:label "brokerage account" ;
    rdfs:comment "account offered by a broker that allows the investor to deposit funds and place investment orders" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/InvestmentAccount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/CertificateOfDeposit> a owl:Class ;
    rdfs:label "certificate of deposit" ;
    rdfs:comment "cash instrument associated with a time deposit account that cannot be withdrawn for a certain period of time (term)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CashInstrument> ;
    skos:altLabel "CD" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/ChartOfAccounts> a owl:Class ;
    rdfs:label "chart of accounts" ;
    rdfs:comment "structured system of financial account codes used to classify, record, and organize an entity's financial transactions in accordance with applicable legal, regulatory, and reporting requirements" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/FinancialRecord> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/CommercialLendingService> a owl:Class ;
    rdfs:label "commercial lending service" ;
    rdfs:comment "service involving the extension of credit to support business activities" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/DemandDepositAccount> a owl:Class ;
    rdfs:label "demand deposit account" ;
    rdfs:comment "non-interest-bearing deposit account in which deposits are payable immediately on demand, or that are issued with an original maturity or required notice period of less than seven days, or that represent funds for which the depository institution does not reserve the right to require at least seven days' written notice of an intended withdrawal" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionDepositAccount> ;
    skos:altLabel "DDA" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/DistributedLedger> a owl:Class ;
    rdfs:label "distributed ledger" ;
    rdfs:comment "ledger that is shared across a set of nodes and synchronized between the nodes using a consensus mechanism" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Ledger> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/DistributedLedgerTechnology> a owl:Class ;
    rdfs:label "distributed ledger technology" ;
    rdfs:comment "method that enables the operation and use of distributed ledgers" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Method> ;
    skos:altLabel "DLT" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Fee> a owl:Class ;
    rdfs:label "fee" ;
    rdfs:comment "charge for services performed" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/GeneralLedger> a owl:Class ;
    rdfs:label "general ledger" ;
    rdfs:comment "organized collection of ledger accounts used to record and summarize changes in position as transactions are posted during an accounting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/FinancialRecord> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/InternationalBankAccountIdentifier> a owl:Class ;
    rdfs:label "international bank account identifier" ;
    rdfs:comment "identifier for a bank account that is an expanded version of the basic bank account number (BBAN), intended for use internationally" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BankAccountIdentifier> ;
    skos:altLabel "IBAN",
        "international bank account number" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/LedgerAccount> a owl:Class ;
    rdfs:label "ledger account" ;
    rdfs:comment "individual record for one element or sub-element in a ledger that records and summarizes increases, decreases, and balances associated with that specific element" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/LedgerAccountClassifier> a owl:Class ;
    rdfs:label "ledger account classifier" ;
    rdfs:comment "classifier used to organize an entity's financial accounts in accordance with applicable legal, regulatory, and reporting requirements" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/LendingOfficer> a owl:Class ;
    rdfs:label "lending officer" ;
    rdfs:comment "corporate officer that has overarching responsibility for the relationship with a specific borrower or account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/CorporateOfficer> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/NonTransactionDepositAccount> a owl:Class ;
    rdfs:label "non-transaction deposit account" ;
    rdfs:comment "any deposit account that is not explicitly considered a transaction account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/DepositAccount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/RelationshipManager> a owl:Class ;
    rdfs:label "relationship manager" ;
    rdfs:comment "responsible party who manages a client's account and oversees their relationship with the service provider" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/ResponsibleParty> ;
    skos:altLabel "account manager" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TimeCertificateOfDepositAccount> a owl:Class ;
    rdfs:label "time certificate of deposit account" ;
    rdfs:comment "time deposit account that allows deposits evidenced by a negotiable or nonnegotiable instrument, or a deposit in book entry form evidenced by a receipt or similar acknowledgement issued by the bank, that provides, on its face, that the amount of such deposit is payable to the bearer, to any specified person, or to the order of a specified person, as follows: (1) on a certain date not less than seven days after the date of deposit, (2) at the expiration of a specified period not less than seven days after the date of the deposit, or (3) upon written notice to the bank which is to be given not less than seven days before the date of withdrawal." ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TimeDepositAccount> ;
    skos:altLabel "CDA" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TimeDepositOpenAccount> a owl:Class ;
    rdfs:label "time deposit open account" ;
    rdfs:comment "time deposit account that allows deposits (other than time certificates of deposit) for which there is in force a written contract with the depositor that neither the whole nor any part of such deposit may be withdrawn prior to (1) the date of maturity, which shall be not less than seven days after the date of the deposit, or (2) the expiration of a specified period of written notice of not less than seven days" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TimeDepositAccount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionCategory> a owl:Class ;
    rdfs:label "transaction category" ;
    rdfs:comment "high-level classifier for an individual transaction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionIdentifier> a owl:Class ;
    rdfs:label "transaction identifier" ;
    rdfs:comment "identifier for an individual transaction associated with an account" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionRecordIdentifier> a owl:Class ;
    rdfs:label "transaction record identifier" ;
    rdfs:comment "unique identifier for record of transactions" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegisteredIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionSubcategory> a owl:Class ;
    rdfs:label "transaction subcategory" ;
    rdfs:comment "second-level classifier for a transaction, e.g., direct deposit, check, cash advance, withdrawal, payment, purchase, and so forth" ;
