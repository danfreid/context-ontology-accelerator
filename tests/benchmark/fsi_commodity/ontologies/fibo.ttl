<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/NationalIdentificationNumberScheme> a owl:Class ;
    rdfs:label "national identification number scheme" ;
    rdfs:comment "system for allocating identifiers to national identification numbers" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Passport> a owl:Class ;
    rdfs:label "passport" ;
    rdfs:comment "formal identity document, issued by a national government, which certifies the identity and nationality of its holder for the purpose of international travel" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/IdentityDocument> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/PassportNumber> a owl:Class ;
    rdfs:label "passport number" ;
    rdfs:comment "national identification number associated with a passport" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegisteredIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/PassportNumberIdentificationScheme> a owl:Class ;
    rdfs:label "passport number identification scheme" ;
    rdfs:comment "system for allocating identifiers to passports" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/PersonName> a owl:Class ;
    rdfs:label "person name" ;
    rdfs:comment "designation by which someone is known in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/ContextualName> .

