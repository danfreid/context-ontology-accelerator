@prefix ns: <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.w3.org/2003/01/geo/wgs84_pos#alt> a owl:DatatypeProperty ;
    rdfs:label "alt" .

<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a owl:DatatypeProperty ;
    rdfs:label "lat" .

<http://www.w3.org/2003/01/geo/wgs84_pos#long> a owl:DatatypeProperty ;
    rdfs:label "long" .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/Association> a owl:Class ;
    rdfs:label "association" ;
    rdfs:comment "not-for-profit organization that is owned by and acts on behalf of its members" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/NotForProfitOrganization> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/CooperativeSociety> a owl:Class ;
    rdfs:label "cooperative society" ;
    rdfs:comment "organization owned by and operated for the benefit of those using its services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> ;
    skos:altLabel "cooperative" .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FamilyOffice> a owl:Class ;
    rdfs:label "family office" ;
    rdfs:comment "organization that assumes the day-to-day administration and management of a family's affairs" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/MerchantCategoryCodeScheme> a owl:Class ;
    rdfs:label "merchant category code scheme" ;
    rdfs:comment "scheme defining a set of codes for classifying merchant services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/IndustrySectorClassificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/MerchantIdentifier> a owl:Class ;
    rdfs:label "merchant identifier" ;
    rdfs:comment "unique identifier for a merchant that is used, for example, for transaction interchange purposes" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/Syndicate> a owl:Class ;
    rdfs:label "syndicate" ;
    rdfs:comment "temporary, self-organizing group of people, companies, corporations or entities organized as an alliance whose purpose is to transact some specific business, or to pursue or promote a shared interest" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Organization> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/SyndicateMember> a owl:Class ;
    rdfs:label "syndicate member" ;
    rdfs:comment "role of an individual or organization that is a member of an alliance set up to pool resources and share risk with respect to a large transaction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> ;
    skos:altLabel "participating member",
        "syndicate participant" .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/hasMerchantCategoryDescription> a owl:DatatypeProperty ;
    rdfs:label "has merchant category description" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/MerchantCategoryCode> ;
    rdfs:range xsd:string .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/APIFirstMarketDataProvider> a owl:Class ;
    rdfs:label "API-first market data provider" ;
    rdfs:comment "market data provider that delivers financial information primarily through programmatic interfaces, offering real-time or historical data via APIs for automated consumption" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/AlternativeDataProvider> a owl:Class ;
    rdfs:label "alternative data provider" ;
    rdfs:comment "market data provider that supplies non-traditional datasets derived from sources such as web activity, sentiment analysis, geospatial signals, or other alternative information channels" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/CryptoDigitalAssetDataProvider> a owl:Class ;
    rdfs:label "crypto and digital-asset data provider" ;
    rdfs:comment "market data provider that supplies pricing, reference data, and analytics for digital tokens and crypto-assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/DerivativesVolatilityDataProvider> a owl:Class ;
    rdfs:label "derivatives and volatility data provider" ;
    rdfs:comment "market data provider that supplies pricing, implied-volatility surfaces, and analytics for derivatives, including options, futures, and structured products" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/ExchangeSourcedDataProvider> a owl:Class ;
    rdfs:label "exchange-sourced data provider" ;
    rdfs:comment "market data provider that distributes financial information originating directly from trading venues, including order-book data, trades, quotes, and venue-specific reference data" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/FixedIncomeSpecialistProvider> a owl:Class ;
    rdfs:label "fixed income specialist provider" ;
    rdfs:comment "market data provider that focuses on pricing, reference data, and analytics for fixed-income instruments such as bonds, credit products, and money-market securities" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/InstitutionalMarketDataProvider> a owl:Class ;
    rdfs:label "institutional market data provider" ;
    rdfs:comment "market data provider that supplies multi-asset financial information, analytics, and reference data to financial institutions such as banks, asset managers, and trading firms" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/ReferenceDataSpecialistProvider> a owl:Class ;
    rdfs:label "reference data specialist provider" ;
    rdfs:comment "market data provider that focuses on authoritative reference data, including corporate actions, instrument identifiers, classifications, and entity information aligned with ISO standards" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/hasPublisher> a owl:ObjectProperty ;
    rdfs:label "has publisher" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/isPublishedBy> a owl:ObjectProperty ;
    rdfs:label "is published by" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> ;
    rdfs:range <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/publishes> a owl:ObjectProperty ;
    rdfs:label "publishes" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/DevolvedGovernment> a owl:Class ;
    rdfs:label "devolved government" ;
    rdfs:comment "government and the politicians that that run a subnational territory with powers that may be temporary and reversible, ultimately residing with the central government" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Government> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/ExecutiveBranch> a owl:Class ;
    rdfs:label "executive branch" ;
    rdfs:comment "the branch of government that is authorized and responsible for the daily administration of the government" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/BranchOfGovernment> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/FederalGovernment> a owl:Class ;
    rdfs:label "federal government" ;
    rdfs:comment "union of states under a central government distinct from the individual governments of the separate states" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/NationalGovernment> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/FederatedSovereignty> a owl:Class ;
    rdfs:label "federated sovereignty" ;
    rdfs:comment "polity characterized by a union of partially self-governing states or regions under a central (federal) government" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/SovereignState> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentAgency> a owl:Class ;
    rdfs:label "government agency" ;
    rdfs:comment "permanent or semi-permanent organization, often an appointed commission, in the machinery of government that is responsible for the oversight and administration of specific functions" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentBody> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentAppointee> a owl:Class ;
    rdfs:label "government appointee" ;
    rdfs:comment "individual designated by government decree to lead, or participate in some capacity in a government body" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Executive> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentDepartment> a owl:Class ;
    rdfs:label "government department" ;
    rdfs:comment "specialized organization responsible for a sector of government public administration" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentBody> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentMinister> a owl:Class ;
    rdfs:label "government minister" ;
    rdfs:comment "government official that is an executive, who is either appointed or elected to a high office in the government" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentOfficial> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Judiciary> a owl:Class ;
    rdfs:label "judiciary" ;
    rdfs:comment "branch of government that comprises the system of courts that interprets and applies the law in the name of the supranational, national, federal, or regional government, depending on its jurisdiction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/BranchOfGovernment> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Legislature> a owl:Class ;
    rdfs:label "legislature" ;
    rdfs:comment "the law-making body of a political unit, usually a national government, that has power to enact, amend, and repeal public policy" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/BranchOfGovernment> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/MunicipalEntity> a owl:Class ;
    rdfs:label "municipal entity" ;
    rdfs:comment "polity that typically represents a city, township, or other administrative subdivision having corporate status and powers of self-government or jurisdiction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Polity> ;
    skos:altLabel "municipality" .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/MunicipalGovernment> a owl:Class ;
    rdfs:label "municipal government" ;
    rdfs:comment "regional government of a city, township, or other administrative subdivision" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Government> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/RegionalGovernment> a owl:Class ;
    rdfs:label "regional government" ;
    rdfs:comment "administrative body for a geographic area, such as a county, smaller town, or other similar community" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Government> ;
    skos:altLabel "local government" .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/RegionalSovereignty> a owl:Class ;
    rdfs:label "regional sovereignty" ;
    rdfs:comment "legal person that corresponds to an administrative division, administrative unit, administrative entity or country subdivision (or, sometimes, geopolitical division or subnational entity), that has the capacity to incur debt, issue contracts, and enter into relations with other similar entities" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Polity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/SupranationalEntity> a owl:Class ;
    rdfs:label "supranational entity" ;
    rdfs:comment "governmental or non-governmental entity that is established by international law or treaty or incorporated at an international level" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Polity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/TribalArea> a owl:Class ;
    rdfs:label "tribal area" ;
    rdfs:comment "designation for geographic region administered by a group of indigenous people rather than by a sovereign state or regional governmental entity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeopoliticalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/TribalEntity> a owl:Class ;
    rdfs:label "tribal entity" ;
    rdfs:comment "legal entity that represents fundamental unit of sovereign tribal (indigenous) government" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Polity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/TribalGovernment> a owl:Class ;
    rdfs:label "tribal government" ;
    rdfs:comment "government representing a group of indigenous people that has legal authority to govern those people, including authority to legislate the existence of tribal entities" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Government> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/hasFullSovereigntyOver> a owl:ObjectProperty ;
    rdfs:label "has full sovereignty over" .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/hasSharedSovereigntyOver> a owl:ObjectProperty ;
    rdfs:label "has shared sovereignty over" .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/hasSovereigntyOver> a owl:ObjectProperty ;
    rdfs:label "has sovereignty over" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Polity> ;
    rdfs:range <https://www.omg.org/spec/Commons/Locations/GeopoliticalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/isElectedBy> a owl:ObjectProperty ;
    rdfs:label "is elected by" .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/isInstrumentOf> a owl:ObjectProperty ;
    rdfs:label "is an instrument of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Instrumentality> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Government> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/isRepresentedBy> a owl:ObjectProperty ;
    rdfs:label "is represented by" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/BenefitCorporation> a owl:Class ;
    rdfs:label "benefit corporation" ;
    rdfs:comment "not-for-profit corporation set up under specific state legislation, typically to provide some social benefit, without an obligation to maximize shareholder return" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/NotForProfitCorporation> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/BoardAgreement> a owl:Class ;
    rdfs:label "board agreement" ;
    rdfs:comment "formal, legally binding agreement between members of the Board of Directors of the organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/OrganizationCoveringAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/CommonInterestDevelopmentCorporation> a owl:Class ;
    rdfs:label "common interest development corporation" ;
    rdfs:comment "not-for-profit corporation set up under specific state legislation as a business entity for homeowners' associations" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/NotForProfitCorporation> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/ForProfitCorporation> a owl:Class ;
    rdfs:label "for profit corporation" ;
    rdfs:comment "corporation whose objective is to make money, i.e., to ensure realization of a financial benefit such that the amount of revenue gained from a business activity exceeds the expenses, costs and taxes needed to sustain that activity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/Corporation> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/IncorporationGuarantee> a owl:Class ;
    rdfs:label "incorporation guarantee" ;
    rdfs:comment "guarantee that is part of the financial basis by which some legal entity is incorporated" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/Constitution> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/JointStockCompany> a owl:Class ;
    rdfs:label "joint stock company" ;
    rdfs:comment "for-profit, unincorporated business that has some characteristics of a corporation and some features of a partnership, with ownership interests represented by shares of stock" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/BusinessEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/PrivatelyHeldCompany> a owl:Class ;
    rdfs:label "privately held company" ;
    rdfs:comment "corporation whose issued shares are all held by a family or a small group of investors and, therefore, cannot be bought by the public" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/StockCorporation> ;
    skos:altLabel "closed corporation",
        "privately held corporation" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/PubliclyHeldCompany> a owl:Class ;
    rdfs:label "publicly held company" ;
    rdfs:comment "corporation whose shares are traded and held publicly" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/StockCorporation> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/RegistrationIdentifier> a owl:Class ;
    rdfs:label "registration identifier" ;
    rdfs:comment "identifier that is officially allocated to an organization at the time of registration, typically in a jurisdiction in which said organization is organized or registered and used in that jurisdiction to identify the organization" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/RegistrationIdentifierScheme> a owl:Class ;
    rdfs:label "registration identifier scheme" ;
    rdfs:comment "scheme that defines the registration identifier per the issuing registration authority" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/ReligiousCorporation> a owl:Class ;
    rdfs:label "religious corporation" ;
    rdfs:comment "not-for-profit corporation whose objective is specific to some fundamental set of beliefs and practices generally agreed upon by a number of people, and that is incorporated under the law" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/NotForProfitCorporation> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/hasDateOfIncorporation> a owl:ObjectProperty ;
    rdfs:label "has date of incorporation" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/hasDateOfRegistration> a owl:ObjectProperty ;
    rdfs:label "has date of registration" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/hasIssuedCapital> a owl:ObjectProperty ;
    rdfs:label "has issued capital" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/hasSharesAuthorized> a owl:DatatypeProperty ;
    rdfs:label "has shares authorized" ;
    rdfs:range xsd:nonNegativeInteger .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/isConstitutedBy> a owl:ObjectProperty ;
    rdfs:label "is constituted by" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/Corporation> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/Constitution> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/isIncorporatedIn> a owl:ObjectProperty ;
    rdfs:label "is incorporated in" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/Corporation> ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/Branch> a owl:Class ;
    rdfs:label "branch" ;
    rdfs:comment "part of a larger organization that might not be co-located with it" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationalSubUnit> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/Division> a owl:Class ;
    rdfs:label "division" ;
    rdfs:comment "part of an organization, such as a line of business, that may have separate accounting and reporting requirements" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationalSubUnit> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/JointVenture> a owl:Class ;
    rdfs:label "joint venture" ;
    rdfs:comment "legal entity that is formed between parties that pool their resources for the purpose of accomplishing a specific task but otherwise retain their distinct identities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/NonGovernmentalOrganization> a owl:Class ;
    rdfs:label "non-governmental organization" ;
    rdfs:comment "not-for-profit organization that functions independently of government" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/NotForProfitOrganization> ;
    skos:altLabel "NGO" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/ValueAddedTaxIdentificationNumber> a owl:Class ;
    rdfs:label "value-added tax identification number" ;
    rdfs:comment "tax identifier that identifies a taxable person (business) or non-taxable legal entity for a consumption tax that is assessed incrementally, levied on the price of a product or service at each stage of production, distribution, and sale to the end consumer" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> ;
    skos:altLabel "VAT identification number",
        "VAT registration number",
        "VATIN" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasEquity> a owl:ObjectProperty ;
    rdfs:label "has equity" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/OwnersEquity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasHeadquartersAddress> a owl:ObjectProperty ;
    rdfs:label "has headquarters address" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasOperatingAddress> a owl:ObjectProperty ;
    rdfs:label "has operating address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/Organization> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasRegisteredAddress> a owl:ObjectProperty ;
    rdfs:label "has registered address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/AccountingFramework> a owl:Class ;
    rdfs:label "accounting framework" ;
    rdfs:comment "framework, including policies, methods, rules, and processes, used to measure, recognize, present, and disclose the information appearing in an entity's financial statements, and, from a legal ownership perspective, that is applied for accounting consolidation determination" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipQualifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/ContractuallyCapableEntity> a owl:Class ;
    rdfs:label "contractually capable entity" ;
    rdfs:comment "a unique entity that is legally or financially responsible for the performance of financial transactions, or has the legal right in its jurisdiction to enter independently into legal contracts, regardless of whether it is incorporated or constituted in some other way (e.g. trust, partnership, contractual). This excludes natural persons, but includes governmental organizations and supranationals." ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormIdentifier> a owl:Class ;
    rdfs:label "entity legal form identifier" ;
    rdfs:comment "code that denotes an entity legal form as defined in ISO 20275" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormScheme> a owl:Class ;
    rdfs:label "entity legal form scheme" ;
    rdfs:comment "scheme that specifies the elements of the codes for entity legal forms, such as those that are sanctioned in a given jurisdiction as defined in ISO 20725" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LEIRegisteredEntity> a owl:Class ;
    rdfs:label "LEI registered entity" ;
    rdfs:comment "a legal person that has registered for and is identified by a legal entity identifier" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifier> a owl:Class ;
    rdfs:label "legal entity identifier" ;
    rdfs:comment "an organization identifier that uniquely identifies a legal person as defined in ISO 17442" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegisteredIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifierScheme> a owl:Class ;
    rdfs:label "legal entity identifier scheme" ;
    rdfs:comment "a scheme that specifies the elements of an unambiguous legal entity identifier (LEI) scheme to identify the legal entities relevant to any financial transaction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipPeriodQualifier> a owl:Class ;
    rdfs:label "relationship period qualifier" ;
    rdfs:comment "a classifier that qualifies something about the reporting period specified, such as that the date period reflects an accounting or document filing period" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipRecord> a owl:Class ;
    rdfs:label "relationship record" ;
    rdfs:comment "a record describing relationships between legal entities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Constituent> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatus> a owl:Class ;
    rdfs:label "relationship status" ;
    rdfs:comment "a classifier that specifies the status of the relationship between consolidated entities during the reporting period (active or inactive)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasLegalAddress> a owl:ObjectProperty ;
    rdfs:label "has legal address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasLegalForm> a owl:ObjectProperty ;
    rdfs:label "has legal form" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalForm> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasLegalFormAbbreviation> a owl:DatatypeProperty ;
    rdfs:label "has legal form abbreviation" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasOwnershipPercentage> a owl:DatatypeProperty ;
    rdfs:label "has ownership percentage" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasTransliteratedLegalFormAbbreviation> a owl:DatatypeProperty ;
    rdfs:label "has transliterated legal form abbreviation" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasTransliteratedName> a owl:DatatypeProperty ;
    rdfs:label "has transliterated name" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isConsolidatedBy> a owl:ObjectProperty ;
    rdfs:label "is consolidated by" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isConsolidationOf> a owl:ObjectProperty ;
    rdfs:label "is consolidation of" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isDirectlyConsolidatedBy> a owl:ObjectProperty ;
    rdfs:label "is directly consolidated by" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isInternationalBranchOf> a owl:ObjectProperty ;
    rdfs:label "is an international branch of" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isQuantifiedBy> a owl:DatatypeProperty ;
    rdfs:label "is quantified by" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/isUltimatelyConsolidatedBy> a owl:ObjectProperty ;
    rdfs:label "is ultimately consolidated by" ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/BusinessLicense> a owl:Class ;
    rdfs:label "business license" ;
    rdfs:comment "license that allows the holder to conduct business or carry out a specific profession within some jurisdiction for some period of time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/License> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/CharteredLegalPerson> a owl:Class ;
    rdfs:label "chartered legal person" ;
    rdfs:comment "a legal person created by a royal charter or decree" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/PowerOfAttorney> a owl:Class ;
    rdfs:label "power of attorney" ;
    rdfs:comment "legal authorization given by one party (the principal) to another (the agent or attorney-in-fact) to perform certain acts on the principal's behalf" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/ProfitObjective> a owl:Class ;
    rdfs:label "profit objective" ;
    rdfs:comment "objective that reflects pursuit of a financial benefit that may be realized when the amount of revenue gained from a business activity exceeds the expenses, costs and taxes needed to sustain that activity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/BusinessObjective> ;
    skos:altLabel "for profit objective",
        "profit motive" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/PublicPurpose> a owl:Class ;
    rdfs:label "public purpose" ;
    rdfs:comment "objective that reflects values generally thought to be shared by and that is intended to benefit the populace as a whole" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Objective> ;
    skos:altLabel "public interest" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/ReligiousObjective> a owl:Class ;
    rdfs:label "religious objective" ;
    rdfs:comment "not-for-profit objective that reflects the religious goals of an organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/NotForProfitObjective> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/SpecialPurposeVehicle> a owl:Class ;
    rdfs:label "special purpose vehicle" ;
    rdfs:comment "legal entity created to fulfill narrow, specific, and frequently temporary objectives" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    skos:altLabel "SPE",
        "SPV",
        "special purpose entity" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/StatutoryBody> a owl:Class ;
    rdfs:label "statutory body" ;
    rdfs:comment "legal entity established by a government to consider evidence and make judgements in some field of activity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/VariableInterestEntity> a owl:Class ;
    rdfs:label "variable interest entity" ;
    rdfs:comment "legal entity whose shareholders are entitled to a percentage of a named company's profits via a private contract" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    skos:altLabel "VIE",
        "shell company" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/hasIntendedLiquidationDate> a owl:ObjectProperty ;
    rdfs:label "has intended liquidation date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ContractualControl> a owl:Class ;
    rdfs:label "contractual control" ;
    rdfs:comment "control established through the terms of some contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeJureControl> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControllingAlliance> a owl:Class ;
    rdfs:label "controlling alliance" ;
    rdfs:comment "group that has formed some alliance to jointly exercise control over some entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/FormalOrganizations/Group> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/CourtAppointedControl> a owl:Class ;
    rdfs:label "court appointed control" ;
    rdfs:comment "control conferred by the actions of some court, for example in the context of receivership" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeJureControl> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InfluenceBasedDeFactoControl> a owl:Class ;
    rdfs:label "influence-based de facto control" ;
    rdfs:comment "informal control that involves influence over some party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeFactoControl> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InfluenceBasedDeFactoControllingParty> a owl:Class ;
    rdfs:label "influence-based de facto controlling party" ;
    rdfs:comment "party that holds influence-based control over some other party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeFactoControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InvestmentBasedDeFactoControllingInterestParty> a owl:Class ;
    rdfs:label "investment-based de facto controlling interest party" ;
    rdfs:comment "party that holds investment-based control over some other party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/Investor> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/JointControllingParty> a owl:Class ;
    rdfs:label "joint controlling party" ;
    rdfs:comment "party that collectively has the authority to control the affairs of some business organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/Receiver> a owl:Class ;
    rdfs:label "receiver" ;
    rdfs:comment "party appointed by some court for the purposes of winding up the affairs of some entity which is no longer solvent" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeJureControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/SoleControllingParty> a owl:Class ;
    rdfs:label "sole controlling party" ;
    rdfs:comment "party that has sole control over and directs the affairs of some legal entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/advises> a owl:ObjectProperty ;
    rdfs:label "advises" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/hasControllingOrganizationMember> a owl:ObjectProperty ;
    rdfs:label "has controlling organization member" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/hasMajorityControllingParty> a owl:ObjectProperty ;
    rdfs:label "has majority controlling party" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/MajorityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/isAdvisedBy> a owl:ObjectProperty ;
    rdfs:label "has advisor" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/isBasedOnInvestmentEquity> a owl:ObjectProperty ;
    rdfs:label "is based on investment equity" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InvestmentBasedDeFactoControl> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/InvestmentEquity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/isControllingMemberOf> a owl:ObjectProperty ;
    rdfs:label "is controlling member of" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Affiliation> a owl:Class ;
    rdfs:label "affiliation" ;
    rdfs:comment "situation in which a controlled party is affiliated with a controlling party for some period of time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/Control> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/JointVenturePartner> a owl:Class ;
    rdfs:label "joint venture partner" ;
    rdfs:comment "party that shares capital, technology, human resources, risks, and benefits of an entity under shared control" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/SignificantShareholder> a owl:Class ;
    rdfs:label "significant shareholder" ;
    rdfs:comment "party that owns a significant voting stake in an organization that is less than 50 percent but greater than some threshold" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/VotingShareholder> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/hasAffiliate> a owl:ObjectProperty ;
    rdfs:label "has affiliate" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Affiliate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/hasControllingAffiliate> a owl:ObjectProperty ;
    rdfs:label "has controlling affiliate" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControlledAffiliate> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControllingAffiliate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/hasDomesticUltimateParent> a owl:ObjectProperty ;
    rdfs:label "has domestic ultimate parent" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/DomesticUltimateParent> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/hasGlobalUltimateParent> a owl:ObjectProperty ;
    rdfs:label "has global ultimate parent" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/GlobalUltimateParent> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/hasSubsidiary> a owl:ObjectProperty ;
    rdfs:label "has subsidiary" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Subsidiary> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/isAffiliateOf> a owl:ObjectProperty ;
    rdfs:label "is affiliate of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Affiliate> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Affiliate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/isControllingAffiliateOf> a owl:ObjectProperty ;
    rdfs:label "is controlling affiliate of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControllingAffiliate> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControlledAffiliate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/isParentCompanyOf> a owl:ObjectProperty ;
    rdfs:label "is parent company of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControllingAffiliate> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Subsidiary> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/isSubsidiaryOf> a owl:ObjectProperty ;
    rdfs:label "is subsidiary of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Subsidiary> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControllingAffiliate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/isWhollyOwnedBy> a owl:ObjectProperty ;
    rdfs:label "is wholly owned by" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/TotalControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/BeneficialOwnership> a owl:Class ;
    rdfs:label "beneficial ownership" ;
    rdfs:comment "situation linking party that enjoys the benefits of ownership (such as receipt of income) of something even though its ownership (title) may be in the name of another party (called a nominee or registered owner) to the asset that they own" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Ownership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/PurchaseLot> a owl:Class ;
    rdfs:label "purchase lot" ;
    rdfs:comment "financial asset that is a block of securities or other financial assets bought in one transaction on a given date at a specific price" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/FinancialAsset> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/Shareholding> a owl:Class ;
    rdfs:label "shareholding" ;
    rdfs:comment "ownership interest in the equity of a company, represented by shares that confer financial rights and governance privileges" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/FinancialAsset> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/TaxLot> a owl:Class ;
    rdfs:label "tax lot" ;
    rdfs:comment "financial asset that is a block of securities or other financial assets with a distinct cost basis for tax reporting purposes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/FinancialAsset> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/consistsOfNumberOfUnits> a owl:DatatypeProperty ;
    rdfs:label "consists of number of units" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/hasBeneficialOwner> a owl:ObjectProperty ;
    rdfs:label "has beneficial owner" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/BeneficialOwner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/isBeneficialOwnerOf> a owl:ObjectProperty ;
    rdfs:label "is beneficial owner of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/BeneficialOwner> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ArticlesOfIncorporation> a owl:Class ;
    rdfs:label "articles of incorporation" ;
    rdfs:comment "contract that establishes a new corporation or, when amended, adjusts the legal basis for the corporation, and outlines basic information about the corporation, including the type of business, and a description of the business' operational characteristics" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/InstrumentOfIncorporation> ;
    skos:altLabel "articles of association" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Authorization> a owl:Class ;
    rdfs:label "Authorization" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/AuthorizedParty> a owl:Class ;
    rdfs:label "AuthorizedParty" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/AuthorizingParty> a owl:Class ;
    rdfs:label "AuthorizingParty" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/BoardCapacity> a owl:Class ;
    rdfs:label "board capacity" ;
    rdfs:comment "authority to act in a fiduciary capacity with respect to the organization, including but not limited to determining and executing corporate policy" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/DelegatedLegalAuthority> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/BoardCompositionControl> a owl:Class ;
    rdfs:label "board composition control" ;
    rdfs:comment "situation in which a voting shareholder, entity owner, or some other party in the case of a not-for-profit organization, appoints and/or nominates someone to the board of directors of an organization for some period of time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/Control> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/BoardMembership> a owl:Class ;
    rdfs:label "board membership" ;
    rdfs:comment "situation relating an individual member of the board of directors to the organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/Control> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/BoardOfDirectors> a owl:Class ;
    rdfs:label "board of directors" ;
    rdfs:comment "group of people comprising the governing body of an organization that has the authority to set organizational strategy and policies as well as to select and, to some degree manage, leadership" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ChiefExecutiveOfficer> a owl:Class ;
    rdfs:label "chief executive officer" ;
    rdfs:comment "top corporate officer responsible for an organization's overall operations and performance" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/PrincipalParty> ;
    skos:altLabel "CEO" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ChiefFinancialOfficer> a owl:Class ;
    rdfs:label "chief financial officer" ;
    rdfs:comment "senior-most corporate officer responsible for financial control and planning for an organization or project" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/CorporateOfficer> ;
    skos:altLabel "CFO" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/CompanyLaw> a owl:Class ;
    rdfs:label "company law" ;
    rdfs:comment "legislation under which the formation, registration or incorporation, governance, and dissolution of a firm is administered and controlled" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/StatuteLaw> ;
    skos:altLabel "corporate law" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/CompanySecretary> a owl:Class ;
    rdfs:label "company secretary" ;
    rdfs:comment "corporate officer appointed by the directors of an organization, responsible for ensuring compliance with legal obligations related to corporate governance" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/CorporateOfficer> ;
    skos:altLabel "corporate secretary" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ControllingNominee> a owl:Class ;
    rdfs:label "controlling nominee" ;
    rdfs:comment "party that holds legal title to an asset (e.g., stocks, bonds, or property) on behalf of the beneficial owner" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/LegallyDelegatedAuthority> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/CorporateBylaws> a owl:Class ;
    rdfs:label "corporate bylaws" ;
    rdfs:comment "written rules for conduct of a corporation, adopted by the board of directors" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Bylaws> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ExecutiveBoardMember> a owl:Class ;
    rdfs:label "executive board member" ;
    rdfs:comment "member of a board of directors that is also an employee of the organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/BoardMember> ;
    skos:altLabel "inside director" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ExternalAuditor> a owl:Class ;
    rdfs:label "external auditor" ;
    rdfs:comment "independent party qualified and authorized to examine and report on the accuracy of financial records and ensure that companies comply with tax laws" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Auditor> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/InternalAuditor> a owl:Class ;
    rdfs:label "internal auditor" ;
    rdfs:comment "employee who is qualified and authorized to review and verify the accuracy of financial records and evaluate internal controls and compliance" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/FormalOrganizations/Employee> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/LegallyDelegatedAuthority> a owl:Class ;
    rdfs:label "LegallyDelegatedAuthority" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/NonExecutiveBoardMember> a owl:Class ;
    rdfs:label "non-executive board member" ;
    rdfs:comment "member of the board of directors of an organization that has no executive responsibilities towards the running of that organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/BoardMember> ;
    skos:altLabel "outside director" .

