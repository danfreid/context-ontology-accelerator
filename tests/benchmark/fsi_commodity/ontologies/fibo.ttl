<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ArbitraryUnit> a owl:Class ;
    rdfs:label "arbitrary unit" ;
    rdfs:comment "arbitrarily defined unit of measurement, where a relation of the unit to a physical unit of the SI does not exist or is unknown" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/BaseQuantityKind> a owl:Class ;
    rdfs:label "base quantity kind" ;
    rdfs:comment "quantity in a conventionally chosen subset of a given system of quantities, where no quantity in the subset can be expressed in terms of the other quantities within that subset" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> ;
    skos:altLabel "base quantity",
        "simple quantity kind" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/BaseUnit> a owl:Class ;
    rdfs:label "base unit" ;
    rdfs:comment "measurement unit that is defined by a system of units to be the reference measurement unit for a base quantity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/PhysicalUnit> ;
    skos:altLabel "simple unit" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/CoherentDerivedUnit> a owl:Class ;
    rdfs:label "coherent derived unit" ;
    rdfs:comment "derived unit that, for a given system of quantities and for a chosen set of base units, is a product of powers of base units with no other proportionality factor than one" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/DerivedUnit> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Constant> a owl:Class ;
    rdfs:label "constant" ;
    rdfs:comment "symbol that represents a value that does not change (i.e., is fixed) with respect to a formula or expression" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ConversionFactorBetweenUnits> a owl:Class ;
    rdfs:label "conversion factor between units" ;
    rdfs:comment "ratio of two measurement units for quantities of the same kind" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Factor> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/CyclicRatioScale> a owl:Class ;
    rdfs:label "cyclic ratio scale" ;
    rdfs:comment "measurement scale that represents a ratio scale with a periodic cycle" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/RatioScale> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/DerivedQuantityKind> a owl:Class ;
    rdfs:label "derived quantity kind" ;
    rdfs:comment "quantity, in a system of quantities, defined in terms of the base quantities of that system" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/DimensionlessQuantity> a owl:Class ;
    rdfs:label "dimensionless quantity" ;
    rdfs:comment "quantity for which all the exponents of the factors corresponding to the base quantities in its quantity dimension are zero" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> ;
    skos:altLabel "quantity of dimension one" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/IntervalScale> a owl:Class ;
    rdfs:label "interval scale" ;
    rdfs:comment "measurement scale that represents quantitative values and for which mode, median and mean can be calculated" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementScale> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/LogarithmicScale> a owl:Class ;
    rdfs:label "logarithmic scale" ;
    rdfs:comment "measurement scale on which the actual distance of a point from the scale's zero is proportional to the logarithm of the corresponding scale number rather than to the number itself" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementScale> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MaterialMeasure> a owl:Class ;
    rdfs:label "material measure" ;
    rdfs:comment "something that reproduces or supplies one or more quantities, each with an assigned quantity value" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Measure> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementProcedure> a owl:Class ;
    rdfs:label "measurement procedure" ;
    rdfs:comment "procedure of a measurement according to one or more measurement principles (i.e. phenomena, observables) and a given measurement method, based on a measurement model and including any calculation to obtain a measurement result" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementReference> ;
    skos:altLabel "SOP",
        "standard operating procedure" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/NominalScale> a owl:Class ;
    rdfs:label "nominal scale" ;
    rdfs:comment "measurement scale that represents objects as belonging to classes that have no particular order" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementScale> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/OrdinalScale> a owl:Class ;
    rdfs:label "ordinal scale" ;
    rdfs:comment "quantity-value scale for ordinal quantities, i.e., one that represents order but no further algebraic structure" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementScale> ;
    skos:altLabel "ordinal quantity-value scale",
        "ordinal value scale" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Prefix> a owl:Class ;
    rdfs:label "prefix" ;
    rdfs:comment "named multiple or sub-multiple multiplication factor used in the specification of a derived unit" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Factor> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/PrefixedUnit> a owl:Class ;
    rdfs:label "prefixed unit" ;
    rdfs:comment "conversion-based unit that is defined with respect to another measurement reference unit through a linear conversion relationship with a named prefix that represents a multiple or submultiple of a unit" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ConversionBasedUnit> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKindPowerFactor> a owl:Class ;
    rdfs:label "quantity kind power factor" ;
    rdfs:comment "factor in a product of powers that defines a derived quantity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Factor> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityName> a owl:Class ;
    rdfs:label "quantity name" ;
    rdfs:comment "human-readable textual representation of the quantity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/ContextualName> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/RatioScaleWithAdditionalLimitValues> a owl:Class ;
    rdfs:label "ratio scale with additional limit values" ;
    rdfs:comment "measurement scale that that represents a ratio scale that has additional limit values" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/RatioScale> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ReferenceMaterial> a owl:Class ;
    rdfs:label "reference material" ;
    rdfs:comment "material, sufficiently homogeneous and stable with reference to specified properties, which has been established to be fit for its intended use in measurement or in examination of nominal properties" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementReference> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/SystemOfQuantities> a owl:Class ;
    rdfs:label "system of quantities" ;
    rdfs:comment "set of quantities together with a set of non-contradictory equations relating those quantities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/SystemOfUnits> a owl:Class ;
    rdfs:label "system of units" ;
    rdfs:comment "set of base units and derived units, together with their multiples and submultiples, defined in accordance with given rules, for a given system of quantities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Total> a owl:Class ;
    rdfs:label "total" ;
    rdfs:comment "sum of the values for some characteristic of all units" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/UnitPowerFactor> a owl:Class ;
    rdfs:label "unit power factor" ;
    rdfs:comment "factor in a product of powers that defines a derived unit" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Factor> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Variable> a owl:Class ;
    rdfs:label "variable" ;
    rdfs:comment "symbol that represents a parameter in a formula or expression" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/describesActualExpression> a owl:DatatypeProperty ;
    rdfs:label "describes actual expression" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/expressesTheMagnitudeOf> a owl:ObjectProperty ;
    rdfs:label "expresses the magnitude of" ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantity> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasArgument> a owl:ObjectProperty ;
    rdfs:label "has argument" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasDenominator> a owl:ObjectProperty ;
    rdfs:label "has denominator" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasDimension> a owl:ObjectProperty ;
    rdfs:label "has dimension" ;
    rdfs:domain <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityDimension> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasExponent> a owl:DatatypeProperty ;
    rdfs:label "has exponent" ;
    rdfs:range owl:rational .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasExpression> a owl:ObjectProperty ;
    rdfs:label "has expression" ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasFactor> a owl:ObjectProperty ;
    rdfs:label "has factor" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasFactorValue> a owl:DatatypeProperty ;
    rdfs:label "has factor value" ;
