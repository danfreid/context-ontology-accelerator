<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasLongitude> a owl:DatatypeProperty ;
    rdfs:label "has longitude" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasMaximumLatitude> a owl:DatatypeProperty ;
    rdfs:label "has maximum latitude" ;
    rdfs:range xsd:decimal .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasMaximumLongitude> a owl:DatatypeProperty ;
    rdfs:label "has maximum longitude" ;
    rdfs:range xsd:decimal .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasMinimumLatitude> a owl:DatatypeProperty ;
    rdfs:label "has minimum latitude" ;
    rdfs:range xsd:decimal .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasMinimumLongitude> a owl:DatatypeProperty ;
    rdfs:label "has minimum longitude" ;
    rdfs:range xsd:decimal .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasNumericRegionCode> a owl:DatatypeProperty ;
    rdfs:label "has numeric region code" ;
    rdfs:range xsd:string .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasPart> a owl:ObjectProperty ;
    rdfs:label "has part" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasRemarks> a owl:DatatypeProperty ;
    rdfs:label "has remarks" ;
    rdfs:domain <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeopoliticalEntity> ;
    rdfs:range xsd:string .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasSubregion> a owl:ObjectProperty ;
    rdfs:label "has subregion" ;
    rdfs:domain <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegion> ;
    rdfs:range <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegion> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/isClassifiedBy> a owl:ObjectProperty ;
    rdfs:label "is classified by" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/isIndependent> a owl:DatatypeProperty ;
    rdfs:label "is independent" ;
    rdfs:domain <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeopoliticalEntity> ;
    rdfs:range xsd:boolean .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/isPartOf> a owl:ObjectProperty ;
    rdfs:label "is a part of" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/isSubregionOf> a owl:ObjectProperty ;
    rdfs:label "is a subregion of" ;
    rdfs:domain <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegion> ;
    rdfs:range <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegion> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/isUsedBy> a owl:ObjectProperty ;
    rdfs:label "is used by" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/uses> a owl:ObjectProperty ;
    rdfs:label "uses" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/usesAdministrativeLanguage> a owl:ObjectProperty ;
    rdfs:label "uses administrative language" ;
    rdfs:domain <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeopoliticalEntity> ;
    rdfs:range <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Alpha2Code> a owl:Class ;
    rdfs:label "alpha-2 code" ;
    rdfs:comment "a language identifier for a human language as defined by ISO 639-1, that is, a two-letter combination of characters used to represent a language or languages" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/AncientLanguage> a owl:Class ;
    rdfs:label "ancient language" ;
    rdfs:comment "an extinct language that has an attested literature and is recognized as having special status in the academic community" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/ExtinctLanguage> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/ArtificialLanguage> a owl:Class ;
    rdfs:label "artificial language" ;
    rdfs:comment "a language for human communication that has been artificially devised" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/BibliographicCode> a owl:Class ;
    rdfs:label "bibliographic code" ;
    rdfs:comment "an alpha-3 code that is a member of the set of bibliographic codes in ISO 639-2" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/CodeElement> a owl:Class ;
    rdfs:label "code element" ;
    rdfs:comment "a sequence of characters denoting something that it is associated with for some purpose, within a specified context, according to some rule set" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/CodeSet> a owl:Class ;
    rdfs:label "code set" ;
    rdfs:comment "a system of alpha-numeric symbols, or combinations of symbols, that stand for specified values in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Arrangement> ;
    skos:altLabel "coding scheme" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/CollectiveLanguageCode> a owl:Class ;
    rdfs:label "collective language code" ;
    rdfs:comment "a language identifier or code used to represent a group of languages" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Dialect> a owl:Class ;
    rdfs:label "dialect" ;
    rdfs:comment "a language variant that is specific to a geographical region or speech community" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageVariant> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/HistoricalLanguage> a owl:Class ;
    rdfs:label "historical language" ;
    rdfs:comment "a well-known prior version of a living or extinct language" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/IdentificationScheme> a owl:Class ;
    rdfs:label "identification scheme" ;
    rdfs:comment "a system for allocating identifiers to objects" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Arrangement> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/IndividualLanguageIdentifier> a owl:Class ;
    rdfs:label "individual language identifier" ;
    rdfs:comment "a language identifier whose scope is that of an individual (distinct) language" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageFamily> a owl:Class ;
    rdfs:label "language family" ;
    rdfs:comment "a group of individual languages related to each other through common ancestry" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageGroup> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageVariation> a owl:Class ;
    rdfs:label "language variation" ;
    rdfs:comment "continuous change within and between individual languages" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LivingLanguage> a owl:Class ;
    rdfs:label "living language" ;
    rdfs:comment "an individual language or variant in use today by some speech community" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Macrolanguage> a owl:Class ;
    rdfs:label "macrolanguage" ;
    rdfs:comment "a language that may be viewed in some circumstances as an individual language, but actually represents two or more individual languages" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/MacrolanguageIdentifier> a owl:Class ;
    rdfs:label "macrolanguage identifier" ;
    rdfs:comment "a language identifier whose scope is that of a macrolanguage" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/NaturalLanguage> a owl:Class ;
    rdfs:label "natural language" ;
    rdfs:comment "a language used in human communications that is not artificial in nature" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Orthography> a owl:Class ;
    rdfs:label "orthography" ;
    rdfs:comment "a set of conventions and rules for representing language in written form" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Collection> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/RemainderGroup> a owl:Class ;
    rdfs:label "remainder group" ;
    rdfs:comment "a group of languages that explicitly excludes certain individual languages" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageGroup> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Script> a owl:Class ;
    rdfs:label "script" ;
    rdfs:comment "a set of graphic characters used to represent one or more languages in writing" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Collection> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/SpecialPurposeCode> a owl:Class ;
    rdfs:label "special purpose code" ;
    rdfs:comment "a language identifier whose scope is that of a special purpose language construct" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/SpecialPurposeLanguageConcept> a owl:Class ;
    rdfs:label "special purpose language concept" ;
    rdfs:comment "a language concept introduced in ISO 639-3 to satisfy special-purpose requirements, typically to support application constraints" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/SpokenLanguage> a owl:Class ;
    rdfs:label "spoken language" ;
    rdfs:comment "an individual language or language variant that is articulated through speech (oral or vocal) sounds" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/StandardVariant> a owl:Class ;
    rdfs:label "standard variant" ;
    rdfs:comment "a language variant with a high degree of status and normalization, typically used in public discourse, centers of government and commerce" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageVariant> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/TerminologyCode> a owl:Class ;
    rdfs:label "terminology code" ;
    rdfs:comment "a language identifier whose scope is that of terminological codes" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Alpha3Code> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Transcription> a owl:Class ;
    rdfs:label "transcription" ;
    rdfs:comment "the representation of speech or signing in written form" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Transliteration> a owl:Class ;
    rdfs:label "transliteration" ;
    rdfs:comment "the conversion of text from one script to another without loss of information" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/WritingSystem> a owl:Class ;
    rdfs:label "writing system" ;
    rdfs:comment "a system for writing a language, including the requisite script and character set" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Arrangement> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/WrittenLanguage> a owl:Class ;
    rdfs:label "written language" ;
    rdfs:comment "the representation of a language via a writing system, with a relatively normalized orthography" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/denotes> a owl:ObjectProperty ;
    rdfs:label "denotes" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/has> a owl:ObjectProperty ;
    rdfs:label "has" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasDenotation> a owl:ObjectProperty ;
    rdfs:label "has denotation" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasEarlierForm> a owl:ObjectProperty ;
    rdfs:label "has earlier form" ;
    rdfs:domain <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> ;
    rdfs:range <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasEnglishName> a owl:DatatypeProperty ;
    rdfs:label "has English name" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasFrenchName> a owl:DatatypeProperty ;
    rdfs:label "has French name" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasGermanName> a owl:DatatypeProperty ;
    rdfs:label "has German name" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasIndigenousName> a owl:DatatypeProperty ;
    rdfs:label "has indigenous name" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasMember> a owl:ObjectProperty ;
    rdfs:label "has member" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasName> a owl:DatatypeProperty ;
    rdfs:label "has name" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/hasTag> a owl:DatatypeProperty ;
    rdfs:label "has tag" ;
    rdfs:range xsd:string .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/identifies> a owl:ObjectProperty ;
    rdfs:label "identifies" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/isIdentifiedBy> a owl:ObjectProperty ;
    rdfs:label "is identified by" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/isMemberOf> a owl:ObjectProperty ;
    rdfs:label "is member of" .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/Merchant> a owl:Class ;
    rdfs:label "merchant" ;
    rdfs:comment "party engaged in the purchase and sales of goods produced by others for profit" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/MerchantCategoryCode> a owl:Class ;
    rdfs:label "merchant category code" ;
    rdfs:comment "code used internationally to classify a merchant" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/IndustrySectorClassifier> ;
    skos:altLabel "MCC" .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentOfficial> a owl:Class ;
    rdfs:label "government official" ;
    rdfs:comment "person elected or appointed to administer some aspect of a government" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/ResponsibleParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Instrumentality> a owl:Class ;
    rdfs:label "instrumentality" ;
    rdfs:comment "organization that serves a public purpose and is closely tied to a government, but is not a government agency" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/NationalGovernment> a owl:Class ;
    rdfs:label "national government" ;
    rdfs:comment "government and the politicians that that run a country as a whole (as opposed to local government)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Government> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/SovereignState> a owl:Class ;
    rdfs:label "sovereign state" ;
    rdfs:comment "non-physical juridical entity that is represented by one centralized government that has sovereignty over a geographic area" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Polity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/InstrumentOfIncorporation> a owl:Class ;
    rdfs:label "instrument of incorporation" ;
    rdfs:comment "memorandum and articles of association by which some legal entity is established" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/Constitution> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalForm> a owl:Class ;
    rdfs:label "entity legal form" ;
    rdfs:comment "a classifier for a legal entity that indicates the nature of that entity as defined from a legal or regulatory perspective, in the jurisdiction in which it was established" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipQualifier> a owl:Class ;
    rdfs:label "relationship qualifier" ;
    rdfs:comment "a classifier that qualifies something about the relationship between consolidated entities during the reporting period, such as the accounting framework used" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/NotForProfitObjective> a owl:Class ;
    rdfs:label "not for profit objective" ;
    rdfs:comment "objective that reflects the charitable, educational, religious, humanitarian, public services, or other not for profit goals of an organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Objective> ;
    skos:altLabel "nonprofit objective" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeFactoControllingInterestParty> a owl:Class ;
    rdfs:label "de facto controlling interest party" ;
    rdfs:comment "party that exercises some control over an entity other than via explicit, legal means" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/InvestmentBasedDeFactoControl> a owl:Class ;
    rdfs:label "investment-based de facto control" ;
    rdfs:comment "control that arises through some investment in some entity, other than via the holding of constitutional equity (shares etc.) in that entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeFactoControl> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/TotalOwner> a owl:Class ;
    rdfs:label "total owner" ;
    rdfs:comment "party that has 100 percent ownership some legal entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/ConstitutionalOwner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/DomesticUltimateParent> a owl:Class ;
    rdfs:label "domestic ultimate parent" ;
    rdfs:comment "party that is recognized as the ultimate parent of a given organization within the country or jurisdiction of incorporation or organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/TotalControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/GlobalUltimateParent> a owl:Class ;
    rdfs:label "global ultimate parent" ;
    rdfs:comment "party that is recognized as the ultimate parent of a given organization world-wide" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/TotalControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/VotingShareholder> a owl:Class ;
    rdfs:label "voting shareholder" ;
    rdfs:comment "shareholder whose shares confer the right to vote in corporate elections, including the right to elect directors at annual or special meetings, and to express their views to corporate management and directors on significant issues that may affect the value of those shares" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeJureControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Auditor> a owl:Class ;
    rdfs:label "auditor" ;
    rdfs:comment "party qualified and authorized to review and verify the accuracy of financial records and ensure that companies comply with tax laws" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizedParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/AuthorizedIndividual> a owl:Class ;
    rdfs:label "authorized individual" ;
    rdfs:comment "role of an individual that has been given the responsibility to act on behalf of another party under some set of guidelines" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/ResponsibleParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Bylaws> a owl:Class ;
    rdfs:label "bylaws" ;
    rdfs:comment "written rules for conduct of a corporation, association, partnership or any organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/Law> ;
    skos:altLabel "byelaws",
        "membership agreement" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Executive> a owl:Class ;
    rdfs:label "executive" ;
    rdfs:comment "person appointed and given the responsibility to manage the affairs of an organization and the authority to make decisions within specified role-specific boundaries" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/LegallyDelegatedAuthority> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/ConstitutionalOwner> a owl:Class ;
    rdfs:label "constitutional owner" ;
    rdfs:comment "entity owner that holds an equity stake in said entity, in the form of shareholders' equity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/InvestmentEquity> a owl:Class ;
    rdfs:label "investment equity" ;
    rdfs:comment "equity that represents an ownership interest in some entity, but may or may not take the form of shareholders's equity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/OwnersEquity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/Investor> a owl:Class ;
    rdfs:label "investor" ;
    rdfs:comment "party that owns some stake in some organization by way of investment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/LimitedPartnership> a owl:Class ;
    rdfs:label "limited partnership" ;
    rdfs:comment "partnership that has at least one general partner and at least one limited partner" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partnership> ;
    skos:altLabel "LP" .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partner> a owl:Class ;
    rdfs:label "partner" ;
    rdfs:comment "co-owner, member, and agent of a partnership whose participation level, including proportional liabilities and share in the profit / loss of the business is specified in a partnership agreement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/CashflowTerms> a owl:Class ;
    rdfs:label "cashflow terms" ;
    rdfs:comment "terms setting out a cashflow structure of payments committed to by one party to a contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/DerivativeTerms> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/InterestRateDerivative> a owl:Class ;
    rdfs:label "interest rate derivative" ;
    rdfs:comment "rate-based derivative whose underlier is an interest rate" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/RateBasedDerivative> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ValuationTerms> a owl:Class ;
    rdfs:label "valuation terms" ;
    rdfs:comment "contract terms specific to valuation of the underlying asset(s)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/DerivativeTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Borrower> a owl:Class ;
    rdfs:label "borrower" ;
    rdfs:comment "party to a credit agreement that is obligated to repay the amount borrowed (principal) with interest and other fees according to the terms of the instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention> a owl:Class ;
    rdfs:label "day-count convention" ;
    rdfs:comment "a business recurrence interval convention that is used to calculate the number of days in an interest payment, which applies to the amount of accrued interest or the present value for debt instruments" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Lender> a owl:Class ;
    rdfs:label "lender" ;
    rdfs:comment "a party that extends credit or money to a borrower with the expectation of being repaid, usually with interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/CollateralizedGuaranty> a owl:Class ;
    rdfs:label "collateralized guaranty" ;
    rdfs:comment "guaranty that takes the form of some asset that is pledged by a borrower to a lender (usually in return for a loan)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/PriorityLevel> a owl:Class ;
    rdfs:label "priority level" ;
    rdfs:comment "relative ranking that a guaranty has in the context of a contract, for example for a credit enhancement priority" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CalculationAgent> a owl:Class ;
    rdfs:label "calculation agent" ;
    rdfs:comment "party that is responsible for determining the value of an instrument and in some cases, determines how much the parties owe one another" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/ThirdPartyAgent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/CashInstrument> a owl:Class ;
    rdfs:label "cash instrument" ;
    rdfs:comment "financial instrument whose value is determined by the market and that is readily transferable (highly liquid)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DebtInstrument> a owl:Class ;
    rdfs:label "debt instrument" ;
    rdfs:comment "financial instrument and credit agreement evidencing monies owed by the issuer to the holder on terms as specified" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/SecuritiesTransaction> a owl:Class ;
    rdfs:label "securities transaction" ;
    rdfs:comment "transaction between two or more parties involving the exchange of commonly defined financial products" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Trade> ;
    skos:altLabel "financial transaction" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Underlier> a owl:Class ;
    rdfs:label "underlier" ;
    rdfs:comment "something that can be assigned a value in the marketplace that forms the basis for a derivative or pool-backed instrument" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/BidPrice> a owl:Class ;
    rdfs:label "bid price" ;
    rdfs:comment "price a prospective buyer is willing to pay" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/ClosingPriceDeterminationMethod> a owl:Class ;
    rdfs:label "closing price determination method" ;
    rdfs:comment "strategy for calculating or otherwise determining an official closing price" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceDeterminationMethod> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/OfferPrice> a owl:Class ;
    rdfs:label "offer price" ;
    rdfs:comment "price suggested by a prospective seller at a particular time for a given security" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> ;
    skos:altLabel "ask price",
        "asking price",
        "offering price" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceSpread> a owl:Class ;
    rdfs:label "price spread" ;
    rdfs:comment "difference between two prices" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Difference> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/BusinessRegistrationAuthority> a owl:Class ;
    rdfs:label "business registration authority" ;
    rdfs:comment "registration authority that is responsible for maintaining a registry of business entities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistrationAuthority> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/BusinessRegistry> a owl:Class ;
    rdfs:label "business registry" ;
    rdfs:comment "registry for registering and maintaining information about business entities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/BusinessRegistryEntry> a owl:Class ;
    rdfs:label "business registry entry" ;
    rdfs:comment "entry in a business registry" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistryEntry> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReason> a owl:Class ;
    rdfs:label "entity expiration reason" ;
    rdfs:comment "code for the reason that a legal entity ceased to exist and/or operate" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityStatus> a owl:Class ;
    rdfs:label "entity status" ;
    rdfs:comment "lifecycle stage indicating the operational and/or legal status of an entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevel> a owl:Class ;
    rdfs:label "entity validation level" ;
    rdfs:comment "code for the level of validation performed by the GLEIF or LOU with respect to the reference data provided by the registrant" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus> a owl:Class ;
    rdfs:label "registration status" ;
    rdfs:comment "lifecycle stage indicating the status of a given registration of something, such as a business or legal entity, as specified by the registration authority" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/Bank> a owl:Class ;
    rdfs:label "bank" ;
    rdfs:comment "depository institution, usually a corporation, that accepts deposits, makes loans, pays checks, and performs related services, for individual members of the public, businesses or other organizations" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/DepositoryInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/CommercialBank> a owl:Class ;
    rdfs:label "commercial bank" ;
    rdfs:comment "depository institution that engages in various financial services, such as accepting deposits and making loans" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/Bank> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ElectronicFundsTransferService> a owl:Class ;
    rdfs:label "electronic funds transfer service" ;
    rdfs:comment "service involving any transfer of funds other than a transaction involving a paper instrument, that is initiated through an electronic terminal, telephone, or computer and that orders or authorizes a financial institution to debit or credit an account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> ;
    skos:altLabel "EFT",
        "wire transfer service" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialServiceProviderIdentifier> a owl:Class ;
    rdfs:label "financial service provider identifier" ;
    rdfs:comment "identifier that is officially allocated to a financial service provider based on a function that they provide, typically in a jurisdiction over which a regulatory agency has some jurisdiction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyRoleIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/MerchantService> a owl:Class ;
    rdfs:label "merchant service" ;
    rdfs:comment "financial service provided by a financial institution to a merchant or other business, including but not limited to managing financial transactions via a secure channel" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/MonetaryAuthority> a owl:Class ;
    rdfs:label "monetary authority" ;
    rdfs:comment "regulatory agency that controls the monetary policy, regulation and supply of money in some country or group of countries" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegulatoryAgencies/RegulatoryAgency> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/RiskPoolingInstitution> a owl:Class ;
    rdfs:label "risk pooling institution" ;
    rdfs:comment "financial institution that provides some financial service while spreading the financial risk inherent in that service to lower the probability of a catastrophic financial event by aggregating customers across diverse dimensions as a risk management practice" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/UnderwritingArrangement> a owl:Class ;
    rdfs:label "underwriting arrangement" ;
    rdfs:comment "written contract between parties that commits the underwriter to assuming risk" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifierCodeStatus> a owl:Class ;
    rdfs:label "market indicator code status" ;
    rdfs:comment "lifecycle stage indicating the status of the MIC code, as specified by the registration authority" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MultilateralTradingFacility> a owl:Class ;
    rdfs:label "multilateral trading facility" ;
    rdfs:comment "trading system that facilitates the exchange of financial instruments between multiple parties" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/AlternativeTradingSystem> ;
    skos:altLabel "MTF" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountHolder> a owl:Class ;
    rdfs:label "account holder" ;
    rdfs:comment "party that owns an account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Owner> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountIdentifier> a owl:Class ;
    rdfs:label "account identifier" ;
    rdfs:comment "identifier that denotes an account" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegisteredIdentifier> ;
    skos:altLabel "account number" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/CloseDate> a owl:Class ;
    rdfs:label "close date" ;
    rdfs:comment "date on which something was closed" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/IndividualTransaction> a owl:Class ;
    rdfs:label "individual transaction" ;
    rdfs:comment "event that has a monetary impact and is documented in the records associated with an account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedCollectionConstituent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/InvestmentAccount> a owl:Class ;
    rdfs:label "investment account" ;
    rdfs:comment "account that provides a record of deposits of funds and/or securities held at a financial institution" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/InvestmentOrDepositAccount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Ledger> a owl:Class ;
    rdfs:label "ledger" ;
    rdfs:comment "organized record of business activities and transactions" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Record> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/LoanOrCreditAccount> a owl:Class ;
    rdfs:label "loan or credit account" ;
    rdfs:comment "account associated with a service in which the account holder receives funds from the account provider under certain terms and conditions for repayment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/OpenDate> a owl:Class ;
    rdfs:label "open date" ;
    rdfs:comment "date on which something was created" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/PaymentDueDate> a owl:Class ;
    rdfs:label "payment due date" ;
    rdfs:comment "date by which payment of the current outstanding balance, part thereof, or a minimum amount due must be made to the creditor" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/PostingDate> a owl:Class ;
    rdfs:label "posting date" ;
    rdfs:comment "date that determines in which posting period a document or journal entry is added to an account record" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionDate> a owl:Class ;
    rdfs:label "transaction date" ;
    rdfs:comment "date on which a specific transaction was initiated" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionDepositAccount> a owl:Class ;
    rdfs:label "transaction deposit account" ;
    rdfs:comment "deposit account from which the depositor / account holder is permitted to make transfers or withdrawals by negotiable / transferable instruments, payment orders of withdrawal, telephone transfers, and so forth, and that may be accessible via an electronic device such as an automated teller machine (ATM), remote service unit (RSU), mobile device, and by debit card" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/DepositAccount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionRecord> a owl:Class ;
    rdfs:label "transaction record" ;
    rdfs:comment "record of transactions associated with an account" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/BasketConstituent> a owl:Class ;
    rdfs:label "basket constituent" ;
    rdfs:comment "component of a basket" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Constituent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Broker> a owl:Class ;
    rdfs:label "broker" ;
    rdfs:comment "any party that acts as an intermediary between a buyer and a seller, usually charging a commission" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractThirdParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Catalog> a owl:Class ;
    rdfs:label "catalog" ;
    rdfs:comment "publication including a list of products available for sale with their descriptions and possibly prices" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialExposure> a owl:Class ;
    rdfs:label "financial exposure" ;
    rdfs:comment "the extent to which an individual or organization is open to risk of suffering a loss in a transaction, or with respect to some investment or set of investments, e.g., some holding; the amount one stands to lose in that transaction or investment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Exposure> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialProduct> a owl:Class ;
    rdfs:label "financial product" ;
    rdfs:comment "product provided to consumers and businesses by financial institutions such as banks, insurance companies, brokerage firms, consumer finance companies, and investment companies" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Product> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/ThirdPartyAgent> a owl:Class ;
    rdfs:label "third-party agent" ;
    rdfs:comment "any service provider that is licensed to perform a legally binding function and has been legally empowered to act on behalf of another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/LegalAgent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Trade> a owl:Class ;
    rdfs:label "trade" ;
    rdfs:comment "situation that realizes an agreement between parties participating in a voluntary action of buying and selling goods and services" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/TradeIdentifier> a owl:Class ;
    rdfs:label "trade identifier" ;
    rdfs:comment "sequence of characters identifying a trade within some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/UniqueTransactionIdentifier> a owl:Class ;
    rdfs:label "unique transaction identifier" ;
    rdfs:comment "sequence of characters identifying a financial transaction uniquely whenever useful and agreed by the parties or community involved in the transaction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/TradeIdentifier> ;
    skos:altLabel "UTI" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/WeightedBasket> a owl:Class ;
    rdfs:label "weighted basket" ;
    rdfs:comment "basket whose constituents have some relative importance with respect to one another" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Basket> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/CalculatedPrice> a owl:Class ;
    rdfs:label "calculated price" ;
    rdfs:comment "monetary price determined by a formula" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Funds> a owl:Class ;
    rdfs:label "funds" ;
    rdfs:comment "artificial currency used as calculation basis for another currency(s) and accounting purposes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/AgeOfMajority> a owl:Class ;
    rdfs:label "age of majority" ;
    rdfs:comment "age at which someone acquires the rights and responsibilities of an adult in some jurisdiction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/LegalAge> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DateOfBirth> a owl:Class ;
    rdfs:label "date of birth" ;
    rdfs:comment "explicit date, i.e., the day, month and year, on which an individual was born" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> ;
    skos:altLabel "birth date",
        "birthday" .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DateOfDeath> a owl:Class ;
    rdfs:label "date of death" ;
    rdfs:comment "explicit date, i.e., the day, month and year, on which an individual died" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> ;
    skos:altLabel "death date" .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/LegalWorkingAge> a owl:Class ;
    rdfs:label "legal working age" ;
    rdfs:comment "age at which someone acquires the capacity to work legally in some jurisdiction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/LegalAge> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/LegalWorkingAgePerson> a owl:Class ;
    rdfs:label "legal working age person" ;
    rdfs:comment "person whose age is greater than the minimum legal working age specified in a jurisdiction in which they work" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Minor> a owl:Class ;
    rdfs:label "minor" ;
    rdfs:comment "a person under a certain age, usually the age of majority in a given jurisdiction, which legally demarcates childhood from adulthood" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/PlaceOfBirth> a owl:Class ;
    rdfs:label "place of birth" ;
    rdfs:comment "physical location, including country, region, and municipality where an individual was born" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/PhysicalLocation> ;
    skos:altLabel "birth place" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/UnilateralCommitment> a owl:Class ;
    rdfs:label "unilateral commitment" ;
    rdfs:comment "commitment (promise or obligation) made by one party without requiring a reciprocal promise from another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ConditionPrecedent> a owl:Class ;
    rdfs:label "condition precedent" ;
    rdfs:comment "stipulation that specifies conditions that must be met before some aspect of a contract takes effect" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractDocument> a owl:Class ;
    rdfs:label "contract document" ;
    rdfs:comment "legal document that records the formal terms and conditions of some contract" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/LegalDocument> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractMilestone> a owl:Class ;
    rdfs:label "contract milestone" ;
    rdfs:comment "classifier for an event (milestone), or set of events related to the status or level of completion of a designated activity, task, or segment of work required for contract fulfillment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NonBindingTerm> a owl:Class ;
    rdfs:label "non-binding term" ;
    rdfs:comment "contractual element that is not legally binding on any party to the agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/TerminationProvision> a owl:Class ;
    rdfs:label "termination provision" ;
    rdfs:comment "contractual element that specifies the circumstances under which the parties can dissolve their legal relationship and discontinue the fulfillment of their obligations under the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Arrangements/Scheme> a owl:Class ;
    rdfs:label "scheme" ;
    rdfs:comment "structure or means of organizing information such as a blueprint, schema, numbering system, organization structure, measurement system, plan, taxonomy, or language for organizing information" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Arrangement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Appraisal> a owl:Class ;
    rdfs:label "appraisal" ;
    rdfs:comment "written estimate of the market value of something as of some point in time, typically provided by a qualified appraiser" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentReport> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/MarketValue> a owl:Class ;
    rdfs:label "market value" ;
    rdfs:comment "price an asset would sell for in the market" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ValuationMethod> a owl:Class ;
    rdfs:label "valuation method" ;
    rdfs:comment "method used to determine the present or expected worth of an asset" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Strategy> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ValueAssessment> a owl:Class ;
    rdfs:label "value assessment" ;
    rdfs:comment "assessment event to estimate the value of something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentEvent> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/IndustrySectorClassifier> a owl:Class ;
    rdfs:label "industry sector classifier" ;
    rdfs:comment "standardized classification or delineation for an organization, or possibly for a security representing an interest in a given organization, per some scheme for such delineation, by industry" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/IndexingScheme> a owl:Class ;
    rdfs:label "indexing scheme" ;
    rdfs:comment "system for indexing values, data, information, or knowledge" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Arrangements/Scheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/Requester> a owl:Class ;
    rdfs:label "requester" ;
    rdfs:comment "party that asks for something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayConvention> a owl:Class ;
    rdfs:label "business day convention" ;
    rdfs:comment "convention that enumerates the possible ways to handle a date that falls on a weekend or holiday" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> ;
    skos:altLabel "business day adjustment" .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/Convention> a owl:Class ;
    rdfs:label "convention" ;
    rdfs:comment "widely accepted or established way of doing 'something' within some community of practice" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/AdHocSchedule> a owl:Class ;
    rdfs:label "ad hoc schedule" ;
    rdfs:comment "schedule consisting of some number of individual events that are not necessarily recurring" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Age> a owl:Class ;
    rdfs:label "age" ;
    rdfs:comment "length of time that something or someone has been alive or existed" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/Duration> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/AnchorDate> a owl:Class ;
    rdfs:label "anchor date" ;
    rdfs:comment "fixed reference point within a series or timeline" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalendarPeriod> a owl:Class ;
    rdfs:label "calendar period" ;
    rdfs:comment "time interval that occurs within a system that fixes the beginning and length of a segment of the year with respect to that system" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RelativeDate> a owl:Class ;
    rdfs:label "relative date" ;
    rdfs:comment "calculated date that is some duration before or after another date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalculatedDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/ScheduleStub> a owl:Class ;
    rdfs:label "schedule stub" ;
    rdfs:comment "date period before the start of the recurring part of a schedule or after the end of the recurring part, which may be associated with a specific occurrence kind" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/SpecifiedDate> a owl:Class ;
    rdfs:label "specified date" ;
    rdfs:comment "calculated date that is defined by a rule that is captured as a string by the 'hasDateSpecification' property" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalculatedDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/TimeDirection> a owl:Class ;
    rdfs:label "time direction" ;
    rdfs:comment "enumeration that indicates whether a calendar-specified date is figured from the start or the end of a calendar period" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Calculation> a owl:Class ;
    rdfs:label "calculation" ;
    rdfs:comment "actual execution of some computation, computational process, or operation that was scheduled or triggered by something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceBasedDate> a owl:Class ;
    rdfs:label "occurrence-based date" ;
    rdfs:comment "calculated date that is defined with respect to the occurrence of some occurrence kind" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalculatedDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/BusinessObjective> a owl:Class ;
    rdfs:label "business objective" ;
    rdfs:comment "objective that reflects the strategic goals and direction of a business within a time frame and available resources" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Objective> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/BusinessStrategy> a owl:Class ;
    rdfs:label "business strategy" ;
    rdfs:comment "strategy for achieving a specific business goal, objective, solution or outcome" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Strategy> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/FinancialObjective> a owl:Class ;
    rdfs:label "financial objective" ;
    rdfs:comment "objective that reflects the strategic financial goals and direction of a party within a time frame and available resources" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Objective> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Goal> a owl:Class ;
    rdfs:label "goal" ;
    rdfs:comment "aim distinguished by broad scope and aspirational character, often qualitative and long-term, in order to achieve a desired state" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Aim> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Program> a owl:Class ;
    rdfs:label "program" ;
    rdfs:comment "state of affairs and coordinated set of activities designed to obtain benefits not available from managing them individually" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContingentObligation> a owl:Class ;
    rdfs:label "contingent obligation" ;
    rdfs:comment "obligation that depends on a future event or the performance of an action" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Duty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/License> a owl:Class ;
    rdfs:label "license" ;
    rdfs:comment "grant of permission needed to do something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/LegalDocument> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Policy> a owl:Class ;
    rdfs:label "policy" ;
    rdfs:comment "system of principles, rules and guidelines, adopted by an organization to guide decision making with respect to particular situations and implemented via procedures or protocols to achieve stated goals" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/StatuteLaw> a owl:Class ;
    rdfs:label "statute law" ;
    rdfs:comment "law enacted by a legislature" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/Law> ;
    skos:altLabel "statutory law" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/FormalOrganizations/Group> a owl:Class ;
    rdfs:label "group" ;
    rdfs:comment "collection of agents (people, organizations, software agents, etc.) that are considered as a unit" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/DigitalAsset> a owl:Class ;
    rdfs:label "digital asset" ;
    rdfs:comment "asset that exists only in digital form or that is the digital representation of another asset" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/PaidInCapital> a owl:Class ;
    rdfs:label "paid-in capital" ;
    rdfs:comment "assets received from investors in exchange for an ownership interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/OwnersEquity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/ShareholdersEquity> a owl:Class ;
    rdfs:label "shareholders' equity" ;
    rdfs:comment "equity that is manifested in the form of shares in an entity, fund or structured product" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/OwnersEquity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyRoleIdentificationScheme> a owl:Class ;
    rdfs:label "party role identification scheme" ;
    rdfs:comment "system for allocating identifiers to roles that parties play" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressingScheme> a owl:Class ;
    rdfs:label "addressing scheme" ;
    rdfs:comment "system for allocating addresses to objects" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/IndexingScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Postcode> a owl:Class ;
    rdfs:label "postcode" ;
    rdfs:comment "sequence of characters used to assist in the sorting of mail" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> ;
    skos:altLabel "postal code" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PostdirectionalSymbol> a owl:Class ;
    rdfs:label "postdirectional symbol" ;
    rdfs:comment "geographic directional symbol that follows the street name and street suffix in a street address" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/GeographicDirectionalSymbol> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PredirectionalSymbol> a owl:Class ;
    rdfs:label "predirectional symbol" ;
    rdfs:comment "geographic directional symbol that occurs after the primary street number but before the street name in a street address" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/GeographicDirectionalSymbol> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PrimaryAddressNumber> a owl:Class ;
    rdfs:label "primary address number" ;
    rdfs:comment "address component that identifies a location with respect to a given street" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> ;
    skos:altLabel "street number" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnit> a owl:Class ;
    rdfs:label "secondary unit" ;
    rdfs:comment "address component that identifies an individual unit within a larger structure, such as an apartment, office, hangar, slip, mailbox, and so forth, at a given street address" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetName> a owl:Class ;
    rdfs:label "street name" ;
    rdfs:comment "identifier for a street in some context (e.g., city, municipality, geographic region)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Name> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetSuffix> a owl:Class ;
    rdfs:label "street suffix" ;
    rdfs:comment "classifier for a street or other delivery location, such as a dwelling located along a waterway" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StructureName> a owl:Class ;
    rdfs:label "structure name" ;
    rdfs:comment "name for a building, house, office complex, shopping center, or other structure or group of structures" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Name> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressComponent> a owl:Class ;
    rdfs:label "supplemental address component" ;
    rdfs:comment "address component that provides additional information that is important to ensuring proper delivery of communications" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressDesignator> a owl:Class ;
    rdfs:label "supplemental address designator" ;
    rdfs:comment "classifier for supplemental address information, such as a highway contract route, rural route, building complex, shopping center, condominium complex, mail box, or other similar designation" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/RealProperty/RealEstate> a owl:Class ;
    rdfs:label "real estate" ;
    rdfs:comment "real property, interests in mortgages on real property (including interests in mortgages on leaseholds of land or improvements thereon), and shares in qualified real estate investment trusts" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> ;
    skos:altLabel "real estate asset" .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/Payer> a owl:Class ;
    rdfs:label "payer" ;
    rdfs:comment "a party who pays a bill or fees, or who makes payments to a payee in partial or complete fulfillment of an obligation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/PaymentObligation> a owl:Class ;
    rdfs:label "payment obligation" ;
    rdfs:comment "legally enforceable duty to pay a sum of money according to the terms stated in a contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Consumer> a owl:Class ;
    rdfs:label "consumer" ;
    rdfs:comment "party that utilizes economic goods or services, typically for personal, family, or household purposes" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Good> a owl:Class ;
    rdfs:label "good" ;
    rdfs:comment "physical, produced item over which ownership rights can be established, whose ownership can be passed from one party to another by engaging in transactions, and that is not money or real estate" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/NegotiableCommodity> a owl:Class ;
    rdfs:label "negotiable commodity" ;
    rdfs:comment "commodity that can be bought or sold in some marketplace" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Commodity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/OffTheShelfProduct> a owl:Class ;
    rdfs:label "off-the-shelf product" ;
    rdfs:comment "product that is readily available from merchandise in stock, or can be quickly and easily configured to order, not specially designed or custom-made" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Product> ;
    skos:altLabel "COTS product",
        "commercial off-the-shelf product",
        "commercially available off-the-shelf product" .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/ServiceAgreement> a owl:Class ;
    rdfs:label "service agreement" ;
    rdfs:comment "written contract between a client and service provider whereby the service provider supplies some service in the form of time, effort, and/or expertise in exchange for compensation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> ;
    skos:altLabel "service contract" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/FinitePopulation> a owl:Class ;
    rdfs:label "finite population" ;
    rdfs:comment "population for which it is possible to count its units" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StandardDeviation> a owl:Class ;
    rdfs:label "standard deviation" ;
    rdfs:comment "square root of variance that measures the spread or dispersion around the mean of a data set" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Dispersion> ;
    skos:altLabel "SD" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalArea> a owl:Class ;
    rdfs:label "statistical area" ;
    rdfs:comment "physical location that is defined per some program for designating geographic regions for the purposes of tabulating and presenting statistical data" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeographicRegion> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Variance> a owl:Class ;
    rdfs:label "variance" ;
    rdfs:comment "measure of spread, calculated as the average squared deviation of each number from the mean of a data set" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Dispersion> ;
    skos:altLabel "second moment" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/ConsumerPriceIndex> a owl:Class ;
    rdfs:label "consumer price index" ;
    rdfs:comment "economic indicator representing measure of the change over time in the prices of consumer goods and services that households consume" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EconomicIndicator> ;
    skos:altLabel "CPI" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulationPartTime> a owl:Class ;
    rdfs:label "employed population part-time" ;
    rdfs:comment "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week based on usual working hours" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulation> ;
    skos:altLabel "population employed part-time" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EnterprisePopulation> a owl:Class ;
    rdfs:label "enterprise population" ;
    rdfs:comment "statistical universe consisting of enterprises designed for the purposes of supporting surveys such as those used as the basis for employment and producer price indices" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalUniverse> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/MarginallyAttachedPopulation> a owl:Class ;
    rdfs:label "marginally attached population" ;
    rdfs:comment "subset of the population that includes people who currently are neither working nor looking for work but indicate that they want and are available for a job and have looked for work sometime in the past 12 months" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/PopulationNotInLaborForce> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/PopulationNotInLaborForce> a owl:Class ;
    rdfs:label "population not in the labor force" ;
    rdfs:comment "subset of the civilian, noninstitutional population, that is considered neither employed nor unemployed by the reporting agency during the reporting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianNonInstitutionalPopulation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencyForwardRate> a owl:Class ;
    rdfs:label "currency forward rate" ;
    rdfs:comment "rate of exchange between two currencies for settlement at some future point in time, expressed as a premium on the spot rate" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/QuotedExchangeRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/ExchangeRateVolatility> a owl:Class ;
    rdfs:label "exchange rate volatility" ;
    rdfs:comment "statistical measure of the rate of change in the rate at which one currency can be exchanged for another" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/Volatility> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/ForeignExchangeService> a owl:Class ;
    rdfs:label "foreign exchange service" ;
    rdfs:comment "financial service involving the exchange of one currency for another, conversion of one currency for another, and transfer of money from one country to another whereby currency conversion is required" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/PriceVolatility> a owl:Class ;
    rdfs:label "price volatility" ;
    rdfs:comment "statistical measure of the rate of change in pricing for a given security or market index" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/Volatility> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterestRateBenchmark> a owl:Class ;
    rdfs:label "interest rate benchmark" ;
    rdfs:comment "classifier for regularly updated interest rates that are publicly accessible, typically set by a central bank or group of financial institutions" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/IndividualPaymentTransaction> a owl:Class ;
    rdfs:label "individual payment transaction" ;
    rdfs:comment "actual payment of principal, interest, fees, or other related amounts towards fulfillment of a debt obligation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/Payment> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Servicer> a owl:Class ;
    rdfs:label "servicer" ;
    rdfs:comment "party that collects principal and interest payments on behalf of the lender" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractThirdParty> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/ConversionTerms> a owl:Class ;
    rdfs:label "conversion terms" ;
    rdfs:comment "contract terms specifying when and how a security may be converted to another security (usually of the same issuer)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/RedemptionProvision> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/FinancialInstrumentShortName> a owl:Class ;
    rdfs:label "financial instrument short name" ;
    rdfs:comment "abbreviated name for a financial instrument within a defined structure as specified in ISO 18774" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> ;
    skos:altLabel "FISN" .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/PublicOffering> a owl:Class ;
    rdfs:label "public offering" ;
    rdfs:comment "offering of securities for sale to the investment public, after compliance with registration requirements of the relevant regulatory authorities" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/SecuritiesOffering> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/SecurityForm> a owl:Class ;
    rdfs:label "security form" ;
    rdfs:comment "nature of the proof of ownership of a security" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractDocument> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/RegisteredSecurity> a owl:Class ;
    rdfs:label "registered security" ;
    rdfs:comment "security that is registered with some registration authority" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> .

<https://www.omg.org/spec/Commons/ContextualIdentifiers/StructuredIdentifier> a owl:Class ;
    rdfs:label "structured identifier" ;
    rdfs:comment "sequence of characters uniquely identifying that with which it is associated, that includes other codes or identifiers, or that is constructed from other notions" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://www.omg.org/spec/Commons/DatesAndTimes/ProperInterval> a owl:Class ;
    rdfs:label "proper interval" ;
    rdfs:comment "time interval with a non-zero extent or duration" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval> .

<https://www.omg.org/spec/Commons/Documents/ReferenceDocument> a owl:Class ;
    rdfs:label "reference document" ;
    rdfs:comment "document that is used as a reference for something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Reference> .

<https://www.omg.org/spec/Commons/Locations/BusinessCenter> a owl:Class ;
    rdfs:label "business center" ;
    rdfs:comment "municipality where business is conducted, especially one that is considered a financial center" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/Municipality> .

<https://www.omg.org/spec/Commons/Locations/County> a owl:Class ;
    rdfs:label "county" ;
    rdfs:comment "political and administrative division of a country, state or province, providing certain local governmental services" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/CountrySubdivision> .

<https://www.omg.org/spec/Commons/Locations/Region> a owl:Class ;
    rdfs:label "region" ;
    rdfs:comment "area that is a continuous part of a surface, space, or body" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ConversionBasedUnit> a owl:Class ;
    rdfs:label "conversion-based unit" ;
    rdfs:comment "derived unit that is defined with respect to another reference unit through an explicit conversion relationship" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/DerivedUnit> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValueRange> a owl:Class ;
    rdfs:label "scalar quantity value range" ;
    rdfs:comment "expression of the lowest possible value and/or highest possible value for some scalar quantity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistrationScheme> a owl:Class ;
    rdfs:label "registration scheme" ;
    rdfs:comment "scheme for organizing information in a registry and allocating identifiers to registered items" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://www.omg.org/spec/Commons/SitesAndFacilities/Site> a owl:Class ;
    rdfs:label "site" ;
    rdfs:comment "place, setting, or context in which something, such as a facility, is situated" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/Context> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/CoordinateSystem> a owl:Class ;
    rdfs:label "coordinate system" ;
    rdfs:comment "a system that uses one or more numbers, or coordinates, to uniquely determine the position of a point or other geometric element on a planar or spherical surface" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Arrangement> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Location> a owl:Class ;
    rdfs:label "location" ;
    rdfs:comment "a place or position in time and/or space, including virtual place" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Alpha3Code> a owl:Class ;
    rdfs:label "alpha-3 code" ;
    rdfs:comment "a language identifier for a human language as defined by ISO 639, that is, a three-letter combination of characters used to represent a language or languages" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/ExtinctLanguage> a owl:Class ;
    rdfs:label "extinct language" ;
    rdfs:comment "an individual language or variant that is no longer in use and has no current descendant" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/IndividualLanguage> a owl:Class ;
    rdfs:label "individual language" ;
    rdfs:comment "a language that can be distinguished from another language by some set of rules" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/StockCorporation> a owl:Class ;
    rdfs:label "stock corporation" ;
    rdfs:comment "corporation that has shareholders, each of whom receives a portion of the ownership of the corporation through shares of stock" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/Corporation> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/OrganizationCoveringAgreement> a owl:Class ;
    rdfs:label "organization covering agreement" ;
    rdfs:comment "contract between the principals in a formal organization that specifies the relationship between the principals, and between the principals and the entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/BusinessEntity> a owl:Class ;
    rdfs:label "business entity" ;
    rdfs:comment "entity that is formed and administered as per commercial law in order to engage in business activities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/FormalOrganization> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/LegallyCompetentNaturalPerson> a owl:Class ;
    rdfs:label "legally competent natural person" ;
    rdfs:comment "person who is considered competent, under the circumstances, to enter into a contract, conduct business, or participate in other activities that generally require the mental ability to understand problems and make decisions on his or her own behalf" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/MajorityControllingParty> a owl:Class ;
    rdfs:label "majority controlling party" ;
    rdfs:comment "controlling party that possesses, either directly or indirectly, the power to direct or cause the direction of the management and policies of a legal person, whether through the ownership of a majority of voting securities, by contract, or otherwise" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/BeneficialOwner> a owl:Class ;
    rdfs:label "beneficial owner" ;
    rdfs:comment "party that enjoys the benefits of ownership (such as receipt of income) of something even though its ownership (title) may be in the name of another party (called a nominee or registered owner)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Owner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateOwnership/Shareholder> a owl:Class ;
    rdfs:label "shareholder" ;
    rdfs:comment "party that owns shares in and has rights and responsibilities with respect to some asset, provided in exchange for investment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> ;
    skos:altLabel "stockholder" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwner> a owl:Class ;
    rdfs:label "entity owner" ;
    rdfs:comment "owner (person, group of people, or other business entity) that owns, or holds an ownership interest in, a formal business organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Owner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/GeneralPartner> a owl:Class ;
    rdfs:label "general partner" ;
    rdfs:comment "partner and part-owner that is responsible for managing the day to day operations of the partnership and that may be jointly and severally liable for the obligations of the partnership" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeJureControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/LimitedPartner> a owl:Class ;
    rdfs:label "limited partner" ;
    rdfs:comment "partner whose liabilities are limited to the extent of their investment or guarantees and that has no involvement in the day to day operations of the partnership" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/LimitedLiabilityCompany> a owl:Class ;
    rdfs:label "limited liability company" ;
    rdfs:comment "private limited company that combines the pass through taxation of a sole proprietorship or partnership with the limited liability of a corporation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/PrivateCompanyWithLimitedLiability> ;
    skos:altLabel "LLC" .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/ManagingMember> a owl:Class ;
    rdfs:label "managing member" ;
    rdfs:comment "owner of an interest in a limited liability company who also runs the day-to-day business operations" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/PrincipalParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/PrivateCompanyWithLimitedLiability> a owl:Class ;
    rdfs:label "private company with limited liability" ;
    rdfs:comment "hybrid business entity having characteristics of both a corporation and a partnership or sole proprietorship (depending on how many owners there are)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/RateBasedDerivative> a owl:Class ;
    rdfs:label "rate-based derivative" ;
    rdfs:comment "derivative instrument where the holder has the right but may not have the obligation, depending on the nature of the instrument, to enter into the underlying contract, or pay or receive payment related to the underlying financial rate (or rate contract) on a specified future date based on a specified future rate and term" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditFacility> a owl:Class ;
    rdfs:label "credit facility" ;
    rdfs:comment "credit agreement that allows the borrower to periodically take out money over an extended period of time rather than reapplying for a loan every time they need funds" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically> ;
    skos:altLabel "master commitment" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> a owl:Class ;
    rdfs:label "creditor" ;
    rdfs:comment "a party to whom an obligation, such as an amount of money, or good, or performance of some service exists" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligee> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> a owl:Class ;
    rdfs:label "debtor" ;
    rdfs:comment "a party that owes a debt or other obligation to another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Interest> a owl:Class ;
    rdfs:label "interest" ;
    rdfs:comment "the cost of using credit, or another's money, expressed as a rate per period of time, payable by a debtor to a creditor in consideration of the credit extended to the debtor" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestCalculation> a owl:Class ;
    rdfs:label "interest calculation" ;
    rdfs:comment "event reflecting the calculation of interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Calculation> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Lease> a owl:Class ;
    rdfs:label "lease" ;
    rdfs:comment "credit agreement permitting the use of real estate, equipment or another asset, such as a vehicle, by the owner of that asset (the lessor) to a user (the lessee) for a specific period of time in return for payment as specified in the agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically> ;
    skos:altLabel "lease agreement",
        "lease contract" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/PrincipalRepaymentTerms> a owl:Class ;
    rdfs:label "principal repayment terms" ;
    rdfs:comment "contract terms that specify requirements for repayment of the principal" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/SubFacility> a owl:Class ;
    rdfs:label "sub-facility" ;
    rdfs:comment "portion of a credit facility extended to the borrower for some purpose, possibly per some schedule specified in the facility" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/VariableInterestRate> a owl:Class ;
    rdfs:label "variable interest rate" ;
    rdfs:comment "an interest rate that is allowed to vary over the maturity of a loan or other debt instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/InterestRate> ;
    skos:altLabel "adjustable rate" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/RedemptionProvision> a owl:Class ;
    rdfs:label "redemption provision" ;
    rdfs:comment "contract provision enabling the issuer (writer) to regain possession through repayment of some stipulated price" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/ClosingPrice> a owl:Class ;
    rdfs:label "closing price" ;
    rdfs:comment "cash value of the last transacted price before the market closes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/MarketPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceAnalytic> a owl:Class ;
    rdfs:label "price analytic" ;
    rdfs:comment "statistical measure involving security prices" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/ScopedMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/PriceDeterminationMethod> a owl:Class ;
    rdfs:label "price determination method" ;
    rdfs:comment "strategy for calculating or otherwise establishing a price for something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Strategy> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/RateOfReturn> a owl:Class ;
    rdfs:label "rate of return" ;
    rdfs:comment "net gain or loss on an investment over a specified time period, expressed as a percentage of the investment's initial cost or value as of a specific point in time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Percentage> ;
    skos:altLabel "RoR" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifier> a owl:Class ;
    rdfs:label "market identifier" ;
    rdfs:comment "identifier that specifies a universal method of identifying exchanges, trading platforms, regulated or non-regulated markets, and data reporting services providers as sources of prices and related information in order to facilitate automated processing" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> ;
    skos:altLabel "MIC",
        "Market Identifier Code" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountStatement> a owl:Class ;
    rdfs:label "account statement" ;
    rdfs:comment "periodic summary of account activity for a given period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/LegalDocument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BankAccountIdentifier> a owl:Class ;
    rdfs:label "bank account identifier" ;
    rdfs:comment "identifier that identifies a demand deposit account provided by a bank" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountIdentifier> ;
    skos:altLabel "bank account number" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/CustomerAccountHolder> a owl:Class ;
    rdfs:label "customer account holder" ;
    rdfs:comment "party that owns a customer account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/AccountHolder> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/DepositAccount> a owl:Class ;
    rdfs:label "deposit account" ;
    rdfs:comment "account that provides a record of money placed with a depository institution for safekeeping and management" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/InvestmentOrDepositAccount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/InvestmentOrDepositAccount> a owl:Class ;
    rdfs:label "investment or deposit account" ;
    rdfs:comment "account associated with a product or service that requires the account holder to provide funds for management by the account provider" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TimeDepositAccount> a owl:Class ;
    rdfs:label "time deposit account" ;
    rdfs:comment "deposit account that the depositor does not have a right, and is not permitted, to make withdrawals from within six days after the date of deposit unless the deposit is subject to an early withdrawal penalty of at least seven days' simple interest on amounts withdrawn within the first six days after deposit" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/ContractualProduct> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Basket> a owl:Class ;
    rdfs:label "basket" ;
    rdfs:comment "collection of goods, services, or other things (e.g., financial contracts) that can be purchased and sold in some marketplace" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/ContractLifecycleEvent> a owl:Class ;
    rdfs:label "contract lifecycle event" ;
    rdfs:comment "kind of event that occurs during one or more stages of the lifecycle of an agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEvent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Offering> a owl:Class ;
    rdfs:label "offering" ;
    rdfs:comment "expression of interest in providing something to someone that is contingent upon acceptance, forbearance, or some other consideration, as might be desired by an offeree(s)" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/RegisteredAgent> a owl:Class ;
    rdfs:label "registered agent" ;
    rdfs:comment "legal agent designated by some party to represent them and act on their behalf under a formal agency agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> ;
    skos:altLabel "resident agent",
        "statutory agent" .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Adult> a owl:Class ;
    rdfs:label "adult" ;
    rdfs:comment "person who has attained the age of majority as defined in some jurisdiction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Contact> a owl:Class ;
    rdfs:label "contact" ;
    rdfs:comment "role or associated with a party serving as a designated point of communication, typically within a system or process" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/IdentityDocument> a owl:Class ;
    rdfs:label "identity document" ;
    rdfs:comment "any legal document which may be used to verify aspects of a person's identity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/LegalDocument> ;
    skos:altLabel "identity card" .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/LegalAge> a owl:Class ;
    rdfs:label "legal age" ;
    rdfs:comment "age at which someone acquires the capacity to do something that they were prohibited from doing before under the law in some jurisdiction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Age> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Beneficiary> a owl:Class ;
    rdfs:label "beneficiary" ;
    rdfs:comment "party that receives some benefit or advantage or profits from something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligee> a owl:Class ;
    rdfs:label "obligee" ;
    rdfs:comment "party to whom some commitment or obligation is owed, either legally or per the terms of an agreement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CollateralAgreement> a owl:Class ;
    rdfs:label "collateral agreement" ;
    rdfs:comment "written contract related to another contract designed to provide clarity and additional protection for all parties involved, that is separate from the primary contract and that can be independently enforced" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ExtensionProvision> a owl:Class ;
    rdfs:label "extension provision" ;
    rdfs:comment "contract terms that specify the conditions under which a contract can be extended" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/TransferableContract> a owl:Class ;
    rdfs:label "transferable contract" ;
    rdfs:comment "contract in which the rights and obligations of one party may be transferred to another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentEvent> a owl:Class ;
    rdfs:label "assessment event" ;
    rdfs:comment "event involving the evaluation or estimation of the nature, quality, or ability of someone or something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentReport> a owl:Class ;
    rdfs:label "assessment report" ;
    rdfs:comment "report that includes an opinion, judgement, appraisal, or view about something and typically the methodology and raw inputs used to arrive at that opinion" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/Report> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/QuantitativeValue> a owl:Class ;
    rdfs:label "quantitative value" ;
    rdfs:comment "value determined via quantitative methods, expressed as a numerical value in appropriate units" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Value> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/ClassificationSchemes/IndustrySectorClassificationScheme> a owl:Class ;
    rdfs:label "industry sector classification scheme" ;
    rdfs:comment "system for allocating classifiers to organizations by industry sector" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/Index> a owl:Class ;
    rdfs:label "index" ;
    rdfs:comment "indirect shortcut derived from and pointing into, a greater volume of values, data, information or knowledge" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Reference> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/Report> a owl:Class ;
    rdfs:label "report" ;
    rdfs:comment "document that provides a structured description of something, prepared on ad hoc, periodic, recurring, regular, or as required basis" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Document> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/Submitter> a owl:Class ;
    rdfs:label "submitter" ;
    rdfs:comment "party presenting something, such as a regulatory report" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> a owl:Class ;
    rdfs:label "business recurrence interval convention" ;
    rdfs:comment "convention that specifies how recurring days should be handled, such as the end of the month, a particular day of the month, a day of the week, or more specifically, a t-bill auction date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/Convention> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RegularSchedule> a owl:Class ;
    rdfs:label "regular schedule" ;
    rdfs:comment "schedule whose time intervals recur regularly" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/StructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Aim> a owl:Class ;
    rdfs:label "aim" ;
    rdfs:comment "intention specifying a desired direction, condition, or situation toward which an agent's actions are directed, without requiring precise scope or measurable criteria" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Approach> a owl:Class ;
    rdfs:label "approach" ;
    rdfs:comment "way of addressing an aim or problem characterized by high-level planning and systematic execution, without presupposing scope or granularity" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/InvestmentObjective> a owl:Class ;
    rdfs:label "investment objective" ;
    rdfs:comment "financial objective used by an investor to determine whether or not a given potential investment is appropriate for themselves or on behalf of another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/FinancialObjective> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Method> a owl:Class ;
    rdfs:label "method" ;
    rdfs:comment "approach distinguished by systematic, repeatable procedures and operational specificity for doing or calculating something, consisting of defined steps or rules to achieve a result" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Approach> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/ContractualRight> a owl:Class ;
    rdfs:label "contractual right" ;
    rdfs:comment "legally enforceable benefit or entitlement granted to a party within a binding agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Right> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/DelegatedLegalAuthority> a owl:Class ;
    rdfs:label "delegated legal authority" ;
    rdfs:comment "institutionalized and legal power inherent in a particular job, function, or position that is meant to enable its holder to successfully carry out his or her responsibilities, where such power has been delegated through some formal means" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalObligation> a owl:Class ;
    rdfs:label "legal obligation" ;
    rdfs:comment "an obligation or duty that is enforceable by a court" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Duty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeFactoControl> a owl:Class ;
    rdfs:label "de facto control" ;
    rdfs:comment "control that exists informally and is accepted, although not formally recognized" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/Control> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/DeJureControl> a owl:Class ;
    rdfs:label "de jure control" ;
    rdfs:comment "control that exists as a matter of law, i.e., legitimate, legal control of something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/Control> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/DigitalToken> a owl:Class ;
    rdfs:label "digital token" ;
    rdfs:comment "digital asset which uses distributed ledger technology for its issuance, storage, exchange, record of ownership or transaction validation and is not a currency" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/DigitalAsset> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/TangibleAsset> a owl:Class ;
    rdfs:label "tangible asset" ;
    rdfs:comment "asset that is a physical, measurable resource, i.e., one that takes a physical form" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/GeographicDirectionalSymbol> a owl:Class ;
    rdfs:label "geographic directional symbol" ;
    rdfs:comment "code element that gives directional information for postal delivery" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Commodity> a owl:Class ;
    rdfs:label "commodity" ;
    rdfs:comment "material resource used in commerce that is interchangeable with other commodities of the same type" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Good> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/ContractualProduct> a owl:Class ;
    rdfs:label "contractual product" ;
    rdfs:comment "product that takes the form of an agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Product> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Supplier> a owl:Class ;
    rdfs:label "supplier" ;
    rdfs:comment "party that provides goods or services that some party wants or needs, especially over a long period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Formula> a owl:Class ;
    rdfs:label "formula" ;
    rdfs:comment "rule expressed in letters and symbols that consists of at least one expression" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Specification> ;
    skos:altLabel "complex expression" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Mean> a owl:Class ;
    rdfs:label "mean" ;
    rdfs:comment "most common measure of central tendency; the average of a set of numbers" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> ;
    skos:altLabel "expected value",
        "first (raw) moment" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/QualifiedMeasure> a owl:Class ;
    rdfs:label "qualified measure" ;
    rdfs:comment "statistical measure that is constrained by features, quantity kinds or units that refine how it is calculated" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianLaborForce> a owl:Class ;
    rdfs:label "civilian labor force" ;
    rdfs:comment "subset of the civilian, non-institutional population considered to be part of the labor force during a given reporting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianNonInstitutionalPopulation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnderemployedPopulation> a owl:Class ;
    rdfs:label "underemployed population" ;
    rdfs:comment "subset of the employed population that includes persons employed part-time for economic reasons, who want and are available for full-time work but have had to settle for a part-time schedule" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/HistoricalVolatility> a owl:Class ;
    rdfs:label "historical volatility" ;
    rdfs:comment "measure of volatility that uses actual values for pricing, rates, and other measurements calculated over some prior period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/Volatility> ;
    skos:altLabel "realized volatility" .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/PaymentHistory> a owl:Class ;
    rdfs:label "payment history" ;
    rdfs:comment "record of actual payments of principal, interest, and other related amounts made by a borrower to a lender or servicer in order to fulfill their re-payment obligation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/TransactionRecord> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/SecuredLoan> a owl:Class ;
    rdfs:label "secured loan" ;
    rdfs:comment "loan in which the borrower pledges some asset via a security agreement as collateral for the loan, or that is secured via third-party guarantee" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan> .

<https://www.omg.org/spec/Commons/ContextualDesignators/Context> a owl:Class ;
    rdfs:label "context" ;
    rdfs:comment "situation or frame of reference in which something applies, exists, happens, or is used and that helps to illustrate or explain it" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDuration> a owl:Class ;
    rdfs:label "explicit duration" ;
    rdfs:comment "duration for which the 'has duration value' property must have a value" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/Duration> .

<https://www.omg.org/spec/Commons/DatesAndTimes/TimePeriod> a owl:Class ;
    rdfs:label "time period" ;
    rdfs:comment "time span over some finite window" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval> .

<https://www.omg.org/spec/Commons/Documents/Certificate> a owl:Class ;
    rdfs:label "certificate" ;
    rdfs:comment "document attesting to the truth of some fact or set of facts" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Document> .

<https://www.omg.org/spec/Commons/Locations/GeographicRegionIdentifier> a owl:Class ;
    rdfs:label "geographic region identifier" ;
    rdfs:comment "string of letters that indicates a code or other identifier for geographical region, assigned for the purpose of uniquely identifying it within some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://www.omg.org/spec/Commons/Locations/PhysicalLocation> a owl:Class ;
    rdfs:label "physical location" ;
    rdfs:comment "location in physical space" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/Location> .

<https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> a owl:Class ;
    rdfs:label "organization identification scheme" ;
    rdfs:comment "identification scheme dedicated to the unique identification of organizations" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Agent> a owl:Class ;
    rdfs:label "agent" ;
    rdfs:comment "something autonomous that can adapt to and interact with its environment" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/DerivedUnit> a owl:Class ;
    rdfs:label "derived unit" ;
    rdfs:comment "measurement unit for a derived quantity, i.e., one that is defined with respect to one or more base units, such as as a product of powers of one or more other measurement units" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/PhysicalUnit> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Measure> a owl:Class ;
    rdfs:label "measure" ;
    rdfs:comment "amount or degree of something; the dimensions, capacity, or amount of something ascertained by measuring" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/PhysicalUnit> a owl:Class ;
    rdfs:label "physical unit" ;
    rdfs:comment "unit of measurement that is defined using a physical quantity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> ;
    skos:altLabel "physical unit of measurement" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityDimension> a owl:Class ;
    rdfs:label "quantity dimension" ;
    rdfs:comment "expression of the dependence of a quantity on the base quantities of a system of quantities as a product of powers of factors corresponding to the base quantities, omitting any numerical factor" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> ;
    skos:altLabel "dimension",
        "dimension of a quantity" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/RatioScale> a owl:Class ;
    rdfs:label "ratio scale" ;
    rdfs:comment "measurement scale that represents quantitative values, allows comparison of differences in values, has a fixed zero value and is invariant under multiplication by a positive number" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementScale> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantity> a owl:Class ;
    rdfs:label "scalar quantity" ;
    rdfs:comment "property of a phenomenon, body, or substance, where the property has a magnitude that can be expressed by means of a number and a reference" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> a owl:Class ;
    rdfs:label "functional role" ;
    rdfs:comment "role representing an underlying functionality that something, such as a person, organization, process, or service, is expected to perform or deliver" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/SitesAndFacilities/Facility> a owl:Class ;
    rdfs:label "facility" ;
    rdfs:comment "something established to serve a particular purpose, make some course of action or operation easier, or provide some capability or service" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegionIdentifier> a owl:Class ;
    rdfs:label "geographic region identifier" ;
    rdfs:comment "a string of letters assigned to a country or other geographic region for the purpose of uniquely representing it" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Identifier> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Identifier> a owl:Class ;
    rdfs:label "identifier" ;
    rdfs:comment "a sequence of characters uniquely identifying something that it is associated with for some purpose and within a specified context" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageGroup> a owl:Class ;
    rdfs:label "language group" ;
    rdfs:comment "a collection of two or more individual languages, treated as a group for some purpose" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Collection> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageVariant> a owl:Class ;
    rdfs:label "language variant" ;
    rdfs:comment "a variation of an individual language that is sufficiently unique that it can be identified and named" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/IndividualLanguage> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/BranchOfGovernment> a owl:Class ;
    rdfs:label "branch of government" ;
    rdfs:comment "division of the government of a state, with separate and independent powers and areas of responsibility so that the powers of one branch are not in conflict with the powers associated with the other branches" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentBody> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/GovernmentBody> a owl:Class ;
    rdfs:label "government body" ;
    rdfs:comment "formal organization that is an agency, instrumentality, or other body of a supranational, national, federal, state, or local government, including certain multijurisdictional agencies and departments that carry out the business of government" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/FormalOrganization> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/NotForProfitCorporation> a owl:Class ;
    rdfs:label "not-for-profit corporation" ;
    rdfs:comment "corporation approved by its jurisdictional oversight and tax authorities as operating for educational, charitable, social, religious, civic or humanitarian purposes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/NotForProfitOrganization> ;
    skos:altLabel "non-profit corporation" .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/NotForProfitOrganization> a owl:Class ;
    rdfs:label "not for profit organization" ;
    rdfs:comment "organization that uses its surplus revenues to further achieve its purpose rather than distributing its surplus income to the organization's owners (directors, investors, and equivalents) as profit / dividends" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/FormalOrganization> ;
    skos:altLabel "non-profit organization" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeJureControllingInterestParty> a owl:Class ;
    rdfs:label "de jure controlling interest party" ;
    rdfs:comment "party that has the legal authority to exercise control" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControlledAffiliate> a owl:Class ;
    rdfs:label "controlled affiliate" ;
    rdfs:comment "controlled party in an affiliation situation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Affiliate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Subsidiary> a owl:Class ;
    rdfs:label "subsidiary" ;
    rdfs:comment "legal entity that is entirely or majority owned and controlled by another legal entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControlledAffiliate> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/TotalControllingInterestParty> a owl:Class ;
    rdfs:label "total controlling interest party" ;
    rdfs:comment "voting shareholder that owns 100 percent of the voting shares in some legal entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/TotalOwner> ;
    skos:altLabel "parent company" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Signatory> a owl:Class ;
    rdfs:label "signatory" ;
    rdfs:comment "responsible party authorized to sign agreements on behalf of themselves, another person, or an organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/AuthorizedIndividual> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/DerivativeTerms> a owl:Class ;
    rdfs:label "derivative terms" ;
    rdfs:comment "contractual terms specific to derivative contracts, including terms related to payments and delivery between parties" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CommittedCreditFacility> a owl:Class ;
    rdfs:label "committed credit facility" ;
    rdfs:comment "credit facility that is a confirmed source of financing for the borrower, as long as the borrower meets the conditions of the agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditFacility> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically> a owl:Class ;
    rdfs:label "credit agreement repaid periodically" ;
    rdfs:comment "credit agreement in which the principal and accrued interest may be periodically repaid or exchanged" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> a owl:Class ;
    rdfs:label "debt terms" ;
    rdfs:comment "contract terms that specify the formal rights and obligations of borrower and lender under a contract in which funds are lent from the one party to the other" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Principal> a owl:Class ;
    rdfs:label "principal" ;
    rdfs:comment "with respect to a debt: the value of an obligation, such as a bond or loan, raised and that must be repaid at maturity; for investments: the original amount of money invested, separate from any associated interest, dividends or capital gains" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Aspect> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/ProjectedContractEventSchedule> a owl:Class ;
    rdfs:label "projected contract event schedule" ;
    rdfs:comment "schedule of events, including but not limited to anticipated payment events, rate reset events and others that are expected to occur over the lifetime of the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RegularSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Issuer> a owl:Class ;
    rdfs:label "issuer" ;
    rdfs:comment "role of a party that makes (or proposes to make) one or more financial instruments available in some well-defined, typically formal way" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/MarketPrice> a owl:Class ;
    rdfs:label "market price" ;
    rdfs:comment "last reported price at which a security was sold" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ClearingHouse> a owl:Class ;
    rdfs:label "clearing house" ;
    rdfs:comment "financial service provider that is exchange affiliated and provides clearing services, including the validation, delivery, and settlement of financial transactions, for financial intermediaries" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/DepositoryInstitution> a owl:Class ;
    rdfs:label "depository institution" ;
    rdfs:comment "any financial institution engaged in the business of receiving demand deposits from the public or other institutions" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinanceCompany> a owl:Class ;
    rdfs:label "finance company" ;
    rdfs:comment "financial intermediary in the business of making loans that obtains its financing from banks, institutions, and other money market sources rather than from deposits" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/InvestmentCompany> a owl:Class ;
    rdfs:label "investment company" ;
    rdfs:comment "any issuer which: (a) is or holds itself out as being engaged primarily, or proposes to engage primarily, in the business of investing, reinvesting, or trading in securities; (b) is engaged or proposes to engage in the business of issuing face-amount certificates of the installment type, or has been engaged in such business and has any such certificate outstanding; or (c) is engaged or proposes to engage in the business of investing, reinvesting, owning, holding, or trading in securities, and owns or proposes to acquire investment securities having a value exceeding 40 per centum of the value of such issuer&apos;s total assets (exclusive of Government securities and cash items) on an unconsolidated basis" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DataReportingServicesProvider> a owl:Class ;
    rdfs:label "data reporting services provider" ;
    rdfs:comment "market data provider and reporting party that reports and/or publishes data on securities transactions, including required regulatory reporting for such transactions, and as such is subject to regulatory supervision" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
    skos:altLabel "DRSP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/LegalAgent> a owl:Class ;
    rdfs:label "legal agent" ;
    rdfs:comment "any party that has been legally empowered to act on behalf of another party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/PercentageMonetaryAmount> a owl:Class ;
    rdfs:label "percentage monetary amount" ;
    rdfs:comment "measure of some amount of money expressed as a percentage of some other amount, some notional amount or some concrete money amount" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Percentage> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> a owl:Class ;
    rdfs:label "contract principal" ;
    rdfs:comment "party that originates a contract and is identified as the first party to that contract, in the event that the contract distinguishes any party as such" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/FinancialRecord> a owl:Class ;
    rdfs:label "financial record" ;
    rdfs:comment "record of financial information" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEvent> a owl:Class ;
    rdfs:label "lifecycle event" ;
    rdfs:comment "kind of event that occurs during one or more stages of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEventOccurrence> a owl:Class ;
    rdfs:label "lifecycle event occurrence" ;
    rdfs:comment "realization of an event in a stage of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleOccurrence> a owl:Class ;
    rdfs:label "lifecycle occurrence" ;
    rdfs:comment "realization of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStageOccurrence> a owl:Class ;
    rdfs:label "lifecycle stage occurrence" ;
    rdfs:comment "realization of a phase in a given lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceInterval> a owl:Class ;
    rdfs:label "business recurrence interval" ;
    rdfs:comment "recurrence interval that is defined per a specific convention that determines how recurring days should be handled" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RecurrenceInterval> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Duty> a owl:Class ;
    rdfs:label "duty" ;
    rdfs:comment "some obligation which exists and is imposed on some individual" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalConstruct> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/Right> a owl:Class ;
    rdfs:label "right" ;
    rdfs:comment "entitlement to perform certain actions (or not), or to be in certain states (or not); or entitlement that requires others to perform certain actions or be in certain states (or not)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalConstruct> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/Constitution> a owl:Class ;
    rdfs:label "constitution" ;
    rdfs:comment "set of basic principles by which an organization is governed, especially in relation to the rights of the people it governs" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/TransactionEvent> a owl:Class ;
    rdfs:label "transaction event" ;
    rdfs:comment "any sale, assignment, lease, license, loan, advance, contribution, or other transfer of any interest in or right to use any property (tangible or intangible) or money, however that transaction is effected, and regardless of whether the terms of the transaction are formally documented" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/ScopedMeasure> a owl:Class ;
    rdfs:label "scoped measure" ;
    rdfs:comment "qualified measure that is constrained by filters on the statistical population to which it applies" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/QualifiedMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianNonInstitutionalPopulation> a owl:Class ;
    rdfs:label "civilian non-institutional population" ;
    rdfs:comment "statistical universe consisting of people of a certain age who reside in a given region, do not live in institutions (for example, correctional facilities, long-term care hospitals, and nursing homes), and are not on active military duty" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalUniverse> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulation> a owl:Class ;
    rdfs:label "employed population" ;
    rdfs:comment "subset of the civilian labor force considered to be employed during the reporting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianLaborForce> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/GovernmentSpecifiedStatisticalArea> a owl:Class ;
    rdfs:label "government-specified statistical area" ;
    rdfs:comment "statistical area defined by a government agency" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalArea> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/InstitutionalUnit> a owl:Class ;
    rdfs:label "institutional unit" ;
    rdfs:comment "party that is capable, in its own right, of owning assets, incurring liabilities, and engaging in economic activities and in transactions with other parties" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/ProducerPriceIndex> a owl:Class ;
    rdfs:label "producer price index" ;
    rdfs:comment "economic indicator representing measure of the rate of change over time in the prices of goods and services bought and sold by producers" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> ;
    skos:altLabel "PPI" .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencySpotRate> a owl:Class ;
    rdfs:label "currency spot rate" ;
    rdfs:comment "rate at which one currency may be exchanged for another for immediate delivery" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/QuotedExchangeRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterbankRate> a owl:Class ;
    rdfs:label "interbank rate" ;
    rdfs:comment "reference rate that is the rate of interest charged on short-term loans between banks" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/ReferenceInterestRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/ReferenceInterestRate> a owl:Class ;
    rdfs:label "reference interest rate" ;
    rdfs:comment "market rate that is a rate of interest paid by or agreed among some bank or set of banks" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/MarketRate> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan> a owl:Class ;
    rdfs:label "loan" ;
    rdfs:comment "debt instrument whereby one party extends money or credit to another party (or parties) with the understanding that the borrowed money will be repaid according to the terms of the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/OfferingDocument> a owl:Class ;
    rdfs:label "offering document" ;
    rdfs:comment "legal document that states the objectives, risks and terms of an investment" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> .

<https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> a owl:Class ;
    rdfs:label "code set" ;
    rdfs:comment "system of alpha-numeric symbols, or combinations of symbols, that stand for specified values in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> ;
    skos:altLabel "coding scheme" .

<https://www.omg.org/spec/Commons/DatesAndTimes/DateTimeStamp> a owl:Class ;
    rdfs:label "date time stamp" ;
    rdfs:comment "time point including a date and a time that requires a time zone offset" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> ;
    skos:altLabel "time stamp" .

<https://www.omg.org/spec/Commons/DatesAndTimes/TimeOfDay> a owl:Class ;
    rdfs:label "time of day" ;
    rdfs:comment "explicit time, according to a clock" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> .

<https://www.omg.org/spec/Commons/Locations/Country> a owl:Class ;
    rdfs:label "country" ;
    rdfs:comment "geopolitical entity representing a distinct territorial body or political entity or dependent territory" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeopoliticalEntity> .

<https://www.omg.org/spec/Commons/Locations/Location> a owl:Class ;
    rdfs:label "location" ;
    rdfs:comment "place or position in time and/or space, including a virtual place" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Locations/Municipality> a owl:Class ;
    rdfs:label "municipality" ;
    rdfs:comment "urban administrative division having corporate status and usually powers of self-government or jurisdiction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/CountrySubdivision> .

<https://www.omg.org/spec/Commons/Organizations/MemberBearingOrganization> a owl:Class ;
    rdfs:label "member-bearing organization" ;
    rdfs:comment "role of a group or organization that has members that are people or other organizations" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> a owl:Class ;
    rdfs:label "organisation identifier" ;
    rdfs:comment "identifier assigned to an organization within an organization identification scheme, and unique within that scheme" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://www.omg.org/spec/Commons/Organizations/Service> a owl:Class ;
    rdfs:label "service" ;
    rdfs:comment "intangible activity performed by some party for the benefit of another party" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementReference> a owl:Class ;
    rdfs:label "measurement reference" ;
    rdfs:comment "measurement unit, measurement procedure, reference material, or a combination of such" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Reference> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Percentage> a owl:Class ;
    rdfs:label "percentage" ;
    rdfs:comment "ratio value expressed as a fraction of 100, i.e., in which the denominator is fixed rather than variable and equal to 100" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Ratio> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Ratio> a owl:Class ;
    rdfs:label "ratio" ;
    rdfs:comment "proportional relationship between two different quantity values that gives rise to a datum of a specific quantity kind" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> ;
    skos:altLabel "rate" .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/Registrar> a owl:Class ;
    rdfs:label "registrar" ;
    rdfs:comment "role of a party that acts as a representative of a registration authority to provide registration services, including official record keeping" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/ServiceProvider> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Collection> a owl:Class ;
    rdfs:label "collection" ;
    rdfs:comment "a grouping of some variable number of things (may be zero) that have some shared significance" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> a owl:Class ;
    rdfs:label "functional entity" ;
    rdfs:comment "party defined in terms of a function they or it performs" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/CorporateBodies/Corporation> a owl:Class ;
    rdfs:label "corporation" ;
    rdfs:comment "formal organization that is a legal entity (artificial person) distinct from its owners, created under the jurisdiction of the laws of a state or nation" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    skos:altLabel "body corporate" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/Affiliate> a owl:Class ;
    rdfs:label "affiliate" ;
    rdfs:comment "party that is related to a legal entity, directly, or indirectly through one or more intermediaries, and controls, or is controlled by, or is under common control with that entity, typically determined by the degree of ownership" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/CorporateControl/ControllingAffiliate> a owl:Class ;
    rdfs:label "controlling affiliate" ;
    rdfs:comment "controlling party in an affiliation situation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/MajorityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/BoardMember> a owl:Class ;
    rdfs:label "board member" ;
    rdfs:comment "party that has fiduciary responsibility with respect to the organization, including but not limited to determining and executing corporate policy" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/PrincipalParty> a owl:Class ;
    rdfs:label "principal party" ;
    rdfs:comment "controlling party that is responsible for the management of daily business operations of an organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Signatory> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Amortization> a owl:Class ;
    rdfs:label "amortization" ;
    rdfs:comment "the process of reduction of debt or other costs through periodic charges to assets or liabilities, such as through principal payments on mortgages" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Collateral> a owl:Class ;
    rdfs:label "collateral" ;
    rdfs:comment "something pledged as security to ensure fulfillment of an obligation to another party, to lend money, extend credit, or provision securities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> a owl:Class ;
    rdfs:label "debt" ;
    rdfs:comment "obligation to pay something, such as an amount of money, good, service, or instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guarantor> a owl:Class ;
    rdfs:label "guarantor" ;
    rdfs:comment "party that guarantees, endorses, or provides indemnity for some obligation on behalf of some other party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractThirdParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/Underwriter> a owl:Class ;
    rdfs:label "underwriter" ;
    rdfs:comment "financial service provider that evaluates and assumes another party's risk for a fee, such as a commission, premium, spread or interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/AlternativeTradingSystem> a owl:Class ;
    rdfs:label "alternative trading system" ;
    rdfs:comment "trading venue that is more loosely regulated than a regulated exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> ;
    skos:altLabel "ATS" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Balance> a owl:Class ;
    rdfs:label "balance" ;
    rdfs:comment "amount of money available or owed" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/ExposureBearer> a owl:Class ;
    rdfs:label "exposure bearer" ;
    rdfs:comment "party subject to influence or risk arising from a specific contract, instrument, or arrangement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> ;
    skos:altLabel "exposed party",
        "risk bearer",
        "risk-bearing party" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/ExposureSituation> a owl:Class ;
    rdfs:label "exposure situation" ;
    rdfs:comment "state of affairs in which some party is subject to influence or risk arising from a specific contract, instrument, or arrangement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/InterestRate> a owl:Class ;
    rdfs:label "interest rate" ;
    rdfs:comment "amount charged, expressed as a percentage of principal, in exchange for the use of assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/PercentageMonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Price> a owl:Class ;
    rdfs:label "price" ;
    rdfs:comment "amount of money, goods, or services requested, expected, required, or given in exchange for something else" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> a owl:Class ;
    rdfs:label "commitment" ;
    rdfs:comment "promise made by some party to act or refrain from acting in some manner" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> a owl:Class ;
    rdfs:label "obligor" ;
    rdfs:comment "party that is bound legally or by agreement to repay a debt, make a payment, do something, or refrain from doing something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "obligated party",
        "obligator" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> a owl:Class ;
    rdfs:label "counterparty" ;
    rdfs:comment "party to a contract with whom one negotiates on a given agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AppraisedValue> a owl:Class ;
    rdfs:label "appraised value" ;
    rdfs:comment "estimated value of some asset as of a given point in time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/MarketValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Value> a owl:Class ;
    rdfs:label "value" ;
    rdfs:comment "perceived worth of something, such as a product, service, or asset to a company, customer, or stakeholder" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Aspect> ;
    skos:altLabel "business value" .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalculatedDate> a owl:Class ;
    rdfs:label "calculated date" ;
    rdfs:comment "date that is or will be determined based on some formula" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/Law> a owl:Class ;
    rdfs:label "law" ;
    rdfs:comment "rule recognized by some community as regulating the behavior of its members and that it may enforce through the imposition of penalties" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/FormalOrganizations/Employer> a owl:Class ;
    rdfs:label "employer" ;
    rdfs:comment "party that provides compensation, including wages or a salary and potentially other benefits, in exchange for work performed by one or more people, and that has the right to control and direct the employee in the material details of how the work is to be performed" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/MemberBearingOrganization> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/FormalOrganizations/Employment> a owl:Class ;
    rdfs:label "employment" ;
    rdfs:comment "situation representing the state of being employed, i.e., the relationship that holds between an employer and employee for some period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Membership> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/FinancialAsset> a owl:Class ;
    rdfs:label "financial asset" ;
    rdfs:comment "non-physical, tangible asset whose value is derived from a contractual claim, such as bank deposits, bonds, stocks, rights, certificates, and bank balances" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/TangibleAsset> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyRoleIdentifier> a owl:Class ;
    rdfs:label "party role identifier" ;
    rdfs:comment "sequence of characters, capable of uniquely identifying a party based on a specific role that they play in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Address> a owl:Class ;
    rdfs:label "address" ;
    rdfs:comment "index to a location to which communications may be delivered" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/Index> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/PaymentSchedule> a owl:Class ;
    rdfs:label "payment schedule" ;
    rdfs:comment "schedule for delivery of money in fulfillment of an obligation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Seller> a owl:Class ;
    rdfs:label "seller" ;
    rdfs:comment "party that makes, offers or contracts to make a sale to an actual or potential buyer" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "purveyor",
        "vendor" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Difference> a owl:Class ;
    rdfs:label "difference" ;
    rdfs:comment "quantity by which amounts differ; the remainder left after subtraction of one value from another" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageEarnings> a owl:Class ;
    rdfs:label "average earnings" ;
    rdfs:comment "measure of the average wage an hourly or salaried worker makes in a given period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/MarketRate> a owl:Class ;
    rdfs:label "market rate" ;
    rdfs:comment "value of a rate established in the marketplace for a set of instruments or that describes the economic climate for an industry and/or political region (e.g., SOFR, Prime)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Ratio> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/ListedSecurity> a owl:Class ;
    rdfs:label "listed security" ;
    rdfs:comment "registered security listed on at least one exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/RegisteredSecurity> ;
    skos:altLabel "exchange-traded security" .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/Listing> a owl:Class ;
    rdfs:label "listing" ;
    rdfs:comment "catalog entry for a securities offering managed by an exchange that provides the terms under which that security is made available on that exchange" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "market listing" .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/ResponsibleParty> a owl:Class ;
    rdfs:label "responsible party" ;
    rdfs:comment "legal person acting in a role that has some formal responsibility" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizedParty> .

<https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity> a owl:Class ;
    rdfs:label "temporal entity" ;
    rdfs:comment "time interval or instant" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Documents/Record> a owl:Class ;
    rdfs:label "record" ;
    rdfs:comment "memorialization and objective evidence of activities performed, events occurred, results achieved, or statements made, regardless of its characteristics, media, physical form, or the manner in which it is recorded or stored" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Document> .

<https://www.omg.org/spec/Commons/Documents/Reference> a owl:Class ;
    rdfs:label "reference" ;
    rdfs:comment "source that may be used to ascertain, interpret, or understand something" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Documents/Specification> a owl:Class ;
    rdfs:label "specification" ;
    rdfs:comment "explicit requirement or set of requirements to be satisfied by something, such as a product, material, model, process or system" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "spec" .

<https://www.omg.org/spec/Commons/Organizations/OrganizationalSubUnit> a owl:Class ;
    rdfs:label "organizational sub-unit" ;
    rdfs:comment "any department or other entity within a larger organization that only has full recognition within the context of that organization, but requires identification for some purpose" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Organization> ;
    skos:altLabel "organization part" .

<https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> a owl:Class ;
    rdfs:label "agent role" ;
    rdfs:comment "role played by any agent" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Factor> a owl:Class ;
    rdfs:label "factor" ;
    rdfs:comment "number or quantity that when multiplied with another produces a given number or expression" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Aspect> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> a owl:Class ;
    rdfs:label "measurement unit" ;
    rdfs:comment "real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the second quantity to the first one as a number" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantity> ;
    skos:altLabel "unit of measurement" .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistryEntry> a owl:Class ;
    rdfs:label "registry entry" ;
    rdfs:comment "constituent of a registry that includes the details for something recorded in that registry" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Constituent> ;
    skos:altLabel "registry item" .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> a owl:Class ;
    rdfs:label "functional business entity" ;
    rdfs:comment "functional entity defined in terms of the nature of the commercial activity it conducts" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publication> a owl:Class ;
    rdfs:label "publication" ;
    rdfs:comment "document offered for general distribution and usually produced in multiple copies" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Document> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> a owl:Class ;
    rdfs:label "publisher" ;
    rdfs:comment "role of person(s) or organization(s) responsible for the printing or distribution of an item, whether in digital or print (physical) form" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/CorporateOfficer> a owl:Class ;
    rdfs:label "corporate officer" ;
    rdfs:comment "high-level management executive of a corporation or other organization, hired by the board of directors or the business owner(s), charged with certain operational responsibilities, and who has the authority to act on behalf of the organization, including the authority to enter into contracts on behalf of the organization" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialInstitution> a owl:Class ;
    rdfs:label "financial institution" ;
    rdfs:comment "financial service provider identified as either a government agency or privately owned entity that collects funds from the public and from other institutions, and invests those funds in financial assets, such as loans, securities, bank deposits, and income-generating property" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> ;
    skos:altLabel "financial intermediary" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account> a owl:Class ;
    rdfs:label "account" ;
    rdfs:comment "container for records associated with a business arrangement for regular transactions and services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/FinancialRecord> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/CustomerAccount> a owl:Class ;
    rdfs:label "customer account" ;
    rdfs:comment "account that represents an identified, named collection of balances and cumulative totals used to summarize customer transaction-related activity over a designated period of time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account> ;
    skos:altLabel "financial service account" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Exposure> a owl:Class ;
    rdfs:label "exposure" ;
    rdfs:comment "means by which an individual or organization is unprotected and open to damage, danger, risk of suffering a loss, or uncertainty" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/SettlementTerms> a owl:Class ;
    rdfs:label "settlement terms" ;
    rdfs:comment "contract terms that define the commitment to and mechanism for settling one or more sides of a transaction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractThirdParty> a owl:Class ;
    rdfs:label "contract third party" ;
    rdfs:comment "party that is indirectly involved in, but not a counterparty to, an agreement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/Lifecycle> a owl:Class ;
    rdfs:label "lifecycle" ;
    rdfs:comment "arrangement that compares the cyclical nature of families, organizations, processes, products, marketing, and order management, portfolio management or other systems with the cradle to grave life stages (birth, growth, maturity, decay, and death) of living organisms" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Arrangement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedCollectionConstituent> a owl:Class ;
    rdfs:label "dated collection constituent" ;
    rdfs:comment "element of a collection that is associated with a date and time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Constituent> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Objective> a owl:Class ;
    rdfs:label "objective" ;
    rdfs:comment "aim distinguished by specific scope and measurable criteria, often quantitative and short-term that a party seeks to attain, typically in order to achieve its long-term goals" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Aim> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalConstruct> a owl:Class ;
    rdfs:label "legal construct" ;
    rdfs:comment "something which is conferred by way of law or contract, such as a right" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/FormalOrganizations/Employee> a owl:Class ;
    rdfs:label "employee" ;
    rdfs:comment "person in the service of another under any contract of hire, express or implied, oral or written, where the employer has the right to control and direct that person in the material details of how the work is to be performed" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationMember> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControlledThing> a owl:Class ;
    rdfs:label "controlled thing" ;
    rdfs:comment "something over which some party exercises some form of control with respect to some situation" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/OwnersEquity> a owl:Class ;
    rdfs:label "owners' equity" ;
    rdfs:comment "owners' share in a business plus operating profit" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> ;
    skos:altLabel "capital",
        "contributed capital",
        "equity",
        "net worth" .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/Payment> a owl:Class ;
    rdfs:label "payment" ;
    rdfs:comment "delivery of money in fulfillment of an obligation, such as to satisfy a claim or debt" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Buyer> a owl:Class ;
    rdfs:label "buyer" ;
    rdfs:comment "party that purchases something in exchange for money or other consideration under a contract of sale" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "buyer",
        "purchaser" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Dispersion> a owl:Class ;
    rdfs:label "dispersion" ;
    rdfs:comment "degree of scatter or variability shown by observations" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalUniverse> a owl:Class ;
    rdfs:label "statistical universe" ;
    rdfs:comment "collection representing the total membership, or 'universe', of people, resources, products, services, events, or entities of interest for some question, experiment, survey or statistical program" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Productivity> a owl:Class ;
    rdfs:label "productivity" ;
    rdfs:comment "economic indicator representing ratio of a volume measure of output to a volume measure of input use" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EconomicIndicator> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/Volatility> a owl:Class ;
    rdfs:label "volatility" ;
    rdfs:comment "statistical measure of the dispersion around the average of some random variable over some period of time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Dispersion> .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/LegallyDelegatedAuthority> a owl:Class ;
    rdfs:label "legally delegated authority" ;
    rdfs:comment "authorized party empowered with some level of legal control and corresponding responsibility" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> .

<https://www.omg.org/spec/Commons/Collections/Constituent> a owl:Class ;
    rdfs:label "constituent" ;
    rdfs:comment "component of a collection or combination of things" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Collections/StructuredCollection> a owl:Class ;
    rdfs:label "structured collection" ;
    rdfs:comment "collection that has a clearly defined structure or organization" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://www.omg.org/spec/Commons/ContextualDesignators/ContextualName> a owl:Class ;
    rdfs:label "contextual name" ;
    rdfs:comment "designation by which someone, some place, or something is known in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Name> .

<https://www.omg.org/spec/Commons/ContextualIdentifiers/ContextualIdentifier> a owl:Class ;
    rdfs:label "contextual identifier" ;
    rdfs:comment "sequence of characters uniquely identifying that with which it is associated, within a specified context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://www.omg.org/spec/Commons/DatesAndTimes/DatePeriod> a owl:Class ;
    rdfs:label "date period" ;
    rdfs:comment "time span over one or more calendar days" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval> .

<https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDatePeriod> a owl:Class ;
    rdfs:label "explicit date period" ;
    rdfs:comment "date period for which the start date, end date, and/or duration are required" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ProperInterval> .

<https://www.omg.org/spec/Commons/Designators/Name> a owl:Class ;
    rdfs:label "name" ;
    rdfs:comment "designation for something by a linguistic expression" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://www.omg.org/spec/Commons/Documents/LegalDocument> a owl:Class ;
    rdfs:label "legal document" ;
    rdfs:comment "document specifying the terms of, or provides evidence for, an agreement, attestation, certification, conditions, permissions, and/or decisions of legal persons, government entities, or courts of law, drawn up in accordance with certain rules that apply in the relevant jurisdiction(s)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Document> .

<https://www.omg.org/spec/Commons/Organizations/FormalOrganization> a owl:Class ;
    rdfs:label "formal organization" ;
    rdfs:comment "organization that is recognized in some legal jurisdiction, with associated rights and responsibilities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Organization> .

<https://www.omg.org/spec/Commons/Organizations/Membership> a owl:Class ;
    rdfs:label "membership" ;
    rdfs:comment "situation, corresponding to an n-ary relation, in which some group or organization has at least one member (person or organization) for some period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/RegisteredIdentifier> a owl:Class ;
    rdfs:label "registered identifier" ;
    rdfs:comment "contextual identifier that is registered in a registry by, or on behalf of, a registration authority according to some registration scheme" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualIdentifiers/ContextualIdentifier> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistrationAuthority> a owl:Class ;
    rdfs:label "registration authority" ;
    rdfs:comment "service provider that is officially responsible for maintaining a registry and providing registration services and/or for delegating of some or all of these roles to a registrar" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/ServiceProvider> ;
    skos:altLabel "RA" .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/RegulatoryAgency> a owl:Class ;
    rdfs:label "regulatory agency" ;
    rdfs:comment "public authority or government agency responsible for exercising authority over something in a regulatory or supervisory capacity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizingParty> ;
    skos:altLabel "regulator",
        "regulatory authority",
        "regulatory body" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegion> a owl:Class ;
    rdfs:label "geographic region" ;
    rdfs:comment "an area, especially part of a country or the world having definable characteristics but not always fixed boundaries" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Location> .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Arrangement> a owl:Class ;
    rdfs:label "arrangement" ;
    rdfs:comment "a structure or means of organizing information such as a schema, numbering system, organization scheme, measurement system, taxonomy, or language for organizing information" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Government> a owl:Class ;
    rdfs:label "government" ;
    rdfs:comment "system by which a state or community is controlled" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> .

<https://spec.edmcouncil.org/fibo/ontology/BE/GovernmentEntities/GovernmentEntities/Polity> a owl:Class ;
    rdfs:label "polity" ;
    rdfs:comment "legal person that is a supranational entity, crown, state, or subordinate civil authority, such as a province, prefecture, county, municipality, city, or district representing the people of that entity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> a owl:Class ;
    rdfs:label "entity controlling party" ;
    rdfs:comment "party that has the authority to control some legal entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> a owl:Class ;
    rdfs:label "monetary price" ;
    rdfs:comment "price that that is expressed as a monetary amount" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Price> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> a owl:Class ;
    rdfs:label "contractual element" ;
    rdfs:comment "element, such as an arrangement, provision, requirement, rule, specification, and standard that forms an integral part of an agreement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Constituent> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> a owl:Class ;
    rdfs:label "lifecycle stage" ;
    rdfs:comment "phase in a lifecycle" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> a owl:Class ;
    rdfs:label "schedule" ;
    rdfs:comment "collection of events, observations, or other occurrences and the associated dates and/or times when they will be done" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Collection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Strategy> a owl:Class ;
    rdfs:label "strategy" ;
    rdfs:comment "high-level approach that guides decision-making and the coordination of actions and plans in pursuit of some aim" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Approach> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> a owl:Class ;
    rdfs:label "address component" ;
    rdfs:comment "aspect of an address" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Aspect> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> a owl:Class ;
    rdfs:label "conventional street address" ;
    rdfs:comment "physical address that identifies a location on a street to which communications may be delivered" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> a owl:Class ;
    rdfs:label "statistical measure" ;
    rdfs:comment "summary (means, mode, total, index, etc.) of the individual quantitative variable values for the statistical units in a specific group (study domain)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Measure> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EconomicIndicator> a owl:Class ;
    rdfs:label "economic indicator" ;
    rdfs:comment "statistical measure of economic activity that is regular and comparable in the context of a statistical area (region), used for analysis of economic performance and predictions of future performance" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/ScopedMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/QuotedExchangeRate> a owl:Class ;
    rdfs:label "quoted exchange rate" ;
    rdfs:comment "exchange rate quoted at a specific point in time, for a given block amount of currency as quoted against another (base) currency" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/MarketRate> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/SecuritiesOffering> a owl:Class ;
    rdfs:label "securities offering" ;
    rdfs:comment "offering of a security (or securities) for sale" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizedParty> a owl:Class ;
    rdfs:label "authorized party" ;
    rdfs:comment "party that has been given the ability to act on behalf of another party or to have specified capabilities under some set of guidelines for some period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> .

<https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme> a owl:Class ;
    rdfs:label "classification scheme" ;
    rdfs:comment "system for allocating classifiers to things" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Arrangement> .

<https://www.omg.org/spec/Commons/DatesAndTimes/DateTime> a owl:Class ;
    rdfs:label "date time" ;
    rdfs:comment "time point including a date and a time, optionally including a time zone offset" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> .

<https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> a owl:Class ;
    rdfs:label "time instant" ;
    rdfs:comment "temporal entity that is a member of a time scale, with no extent or duration" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity> ;
    skos:altLabel "instant in time",
        "time point" .

<https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval> a owl:Class ;
    rdfs:label "time interval" ;
    rdfs:comment "segment of the time axis, a location in time, with an extent or duration" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TemporalEntity> .

<https://www.omg.org/spec/Commons/Designators/Designation> a owl:Class ;
    rdfs:label "designation" ;
    rdfs:comment "representation for something, or for a conceptualization thereof, that denotes it in a domain or subject" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "designator" .

<https://www.omg.org/spec/Commons/Locations/CountrySubdivision> a owl:Class ;
    rdfs:label "country subdivision" ;
    rdfs:comment "geopolitical entity that is a legal division of a country, dependency, or other area of special geopolitical interest related to a country or other geopolitical entity" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeopoliticalEntity> .

<https://www.omg.org/spec/Commons/Locations/GeopoliticalEntity> a owl:Class ;
    rdfs:label "geopolitical entity" ;
    rdfs:comment "geographic area that represents a geophysical location associated with some form of political structure" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeographicRegion> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> a owl:Class ;
    rdfs:label "actor" ;
    rdfs:comment "primary performer in a relationship between parties, i.e., the party that does something, causes something to happen, or otherwise plays an agentive role in the relationship" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> a owl:Class ;
    rdfs:label "registry" ;
    rdfs:comment "authoritative record or collection of records relating to something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Record> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeopoliticalEntity> a owl:Class ;
    rdfs:label "geopolitical entity" ;
    rdfs:comment "any country, federal province, city or other administrative unit that represents a geophysical location and has some political identity" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegion> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwnership> a owl:Class ;
    rdfs:label "entity ownership" ;
    rdfs:comment "ownership by some party of an interest in some non-governmental formal organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Ownership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partnership> a owl:Class ;
    rdfs:label "partnership" ;
    rdfs:comment "association of two or more legal persons to carry on as co-owners a business for profit" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/BusinessEntity> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreement> a owl:Class ;
    rdfs:label "credit agreement" ;
    rdfs:comment "contractual agreement in which a debtor receives something of value and typically agrees to repay the creditor by some date in the future, in some form (e.g., cash, securities, etc.), generally with interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> a owl:Class ;
    rdfs:label "contract party" ;
    rdfs:comment "legally competent party that has entered into a binding agreement, accepting and conceding obligations, responsibilities, and benefits as specified" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/NettingProvision> a owl:Class ;
    rdfs:label "netting provision" ;
    rdfs:comment "contractual element that specifies the method of reducing credit, settlement and other risks by aggregating (combining) two or more obligations to achieve a reduced net obligation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedStructuredCollection> a owl:Class ;
    rdfs:label "dated structured collection" ;
    rdfs:comment "structured collection whose elements are required to have a date and time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/StructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> a owl:Class ;
    rdfs:label "occurrence kind" ;
    rdfs:comment "classifier that specifies the general nature of an occurrence (event)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Owner> a owl:Class ;
    rdfs:label "owner" ;
    rdfs:comment "party that is legally recognized as having the right to possess, the privilege to use, and ability to transfer any rights or privileges associated with something, as permitted by law" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Ownership> a owl:Class ;
    rdfs:label "ownership" ;
    rdfs:comment "situation in which some party holds the legal title to something (explicitly or implicitly) and has the right to transfer that title and/or possession" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/StreetAddress> a owl:Class ;
    rdfs:label "street address" ;
    rdfs:comment "index to a location that consists of a primary address number, predirectional, street name, suffix, postdirectional, and an optional secondary unit" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizingParty> a owl:Class ;
    rdfs:label "authorising party" ;
    rdfs:comment "party that delegates some role, authority, or control to another party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> .

<https://www.omg.org/spec/Commons/Classifiers/Aspect> a owl:Class ;
    rdfs:label "aspect" ;
    rdfs:comment "characteristic or feature that can be used to dimensionalize, filter, or subset a class, collection, or set of things" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "characteristic" .

<https://www.omg.org/spec/Commons/Collections/Arrangement> a owl:Class ;
    rdfs:label "arrangement" ;
    rdfs:comment "systematic plan, manner, or method for making, doing, achieving, or organizing something" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Documents/Document> a owl:Class ;
    rdfs:label "document" ;
    rdfs:comment "unitary expression of some realization of an intellectual or artistic work" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Organizations/Organization> a owl:Class ;
    rdfs:label "organisation" ;
    rdfs:comment "framework of authority within which a person, persons, or groups of people act, or are designated to act, towards some purpose, such as to meet a need or pursue collective goals" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> .

<https://www.omg.org/spec/Commons/Organizations/ServiceProvider> a owl:Class ;
    rdfs:label "service provider" ;
    rdfs:comment "role of an agent that provides some service, including but not limited to commercial or professional services" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> a owl:Class ;
    rdfs:label "undergoer" ;
    rdfs:comment "something that plays the role of the object or recipient in a situation, i.e., the thing (or party) that the situation impacts, affects, or that otherwise plays a passive recipient / patient or thematic role" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementScale> a owl:Class ;
    rdfs:label "measurement scale" ;
    rdfs:comment "ordered set of quantity values of quantities of a given kind of quantity used in ranking, according to magnitude, quantities of that kind" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme> ;
    skos:altLabel "quantity-value scale" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> a owl:Class ;
    rdfs:label "quantity kind" ;
    rdfs:comment "aspect common to mutually comparable quantities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> ;
    skos:altLabel "kind of quantity" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/LanguageIdentifier> a owl:Class ;
    rdfs:label "language identifier" ;
    rdfs:comment "a string of characters that uniquely identifies a linguistic entity" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Identifier> ;
    skos:altLabel "language symbol" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guaranty> a owl:Class ;
    rdfs:label "guaranty" ;
    rdfs:comment "commitment whereby something is formally assured if a party with primary liability fails to perform" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/NonDepositoryInstitution> a owl:Class ;
    rdfs:label "non-depository institution" ;
    rdfs:comment "financial institution that does not have a full banking license and typically is not supervised by a national or international banking regulatory agency" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialInstitution> ;
    skos:altLabel "non-bank financial company (NBFC)",
        "non-bank financial institution (NBFI)",
        "non-banking financial institution (NBFI)" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> a owl:Class ;
    rdfs:label "financial service provider" ;
    rdfs:comment "functional entity either licensed to provide financial services to consumers and/or businesses or established by law to provide financial services, such as a central bank" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalBusinessEntity> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalCapacity> a owl:Class ;
    rdfs:label "legal capacity" ;
    rdfs:comment "the capability to carry out certain actions or to have certain rights together with the resources to do so" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCapacity/LegalConstruct> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Product> a owl:Class ;
    rdfs:label "product" ;
    rdfs:comment "commercially distributed good that is (1) tangible property, (2) the output or result of a fabrication, manufacturing, or production process, or (3) something that passes through a distribution channel before being consumed or used." ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> a owl:Class ;
    rdfs:label "jurisdiction" ;
    rdfs:comment "power of a court or regulatory agency to adjudicate cases, issue orders, and interpret and apply the law with respect to some specific geographic area" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/Context> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> a owl:Class ;
    rdfs:label "market data provider" ;
    rdfs:comment "publisher that supplies financial information, reference data, analytics, or related datasets used in financial markets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> a owl:Class ;
    rdfs:label "derivative instrument" ;
    rdfs:comment "financial instrument that confers on its holders certain rights or obligations, whose value is derived from one or more underlying assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    skos:altLabel "derivative contract" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> a owl:Class ;
    rdfs:label "security" ;
    rdfs:comment "financial instrument that can be bought or sold" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> a owl:Class ;
    rdfs:label "agreement" ;
    rdfs:comment "negotiated understanding between two or more parties, reflecting the offer and acceptance of commitments on the part of either party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> a owl:Class ;
    rdfs:label "occurrence" ;
    rdfs:comment "happening of an OccurrenceKind, i.e., an event" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "event" .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/Control> a owl:Class ;
    rdfs:label "control" ;
    rdfs:comment "situation in which some party has the power to direct or strongly influence the direction of the management and policies related to something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/Authorization> a owl:Class ;
    rdfs:label "authorisation" ;
    rdfs:comment "situation in which a party authorizes someone to act on their behalf or to have specific capabilities under certain conditions for some period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://www.omg.org/spec/Commons/DatesAndTimes/Duration> a owl:Class ;
    rdfs:label "duration" ;
    rdfs:comment "interval of time of some specific length" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval> .

<https://www.omg.org/spec/Commons/Organizations/OrganizationMember> a owl:Class ;
    rdfs:label "organisation member" ;
    rdfs:comment "party (person or organization) that has a membership role with respect to some organization" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/SecurityPrice> a owl:Class ;
    rdfs:label "security price" ;
    rdfs:comment "monetary price for a financial instrument at some point in time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> a owl:Class ;
    rdfs:label "currency" ;
    rdfs:comment "medium of exchange value, defined by reference to the geographical location of the monetary authorities responsible for it" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> ;
    skos:altLabel "currency unit",
        "monetary unit" .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RecurrenceInterval> a owl:Class ;
    rdfs:label "recurrence interval" ;
    rdfs:comment "time interval that is consistent between elements of a regular schedule" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInterval> ;
    skos:altLabel "frequency" .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> a owl:Class ;
    rdfs:label "asset" ;
    rdfs:comment "something of monetary value that is owned or provides benefit to some party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> ;
    skos:altLabel "economic resource" .

<https://www.omg.org/spec/Commons/Collections/Collection> a owl:Class ;
    rdfs:label "collection" ;
    rdfs:comment "grouping of things (may be zero) that have some shared significance" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Identifiers/IdentificationScheme> a owl:Class ;
    rdfs:label "identification scheme" ;
    rdfs:comment "system for minting identifiers for things that specifies constraints on the structure of the identifier" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Arrangement> .

<https://www.omg.org/spec/Commons/Locations/GeographicRegion> a owl:Class ;
    rdfs:label "geographic region" ;
    rdfs:comment "area of land that has common features" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/Region> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> a owl:Class ;
    rdfs:label "financial instrument" ;
    rdfs:comment "written contract that gives rise to both a financial asset of one entity and a financial liability of another entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> a owl:Class ;
    rdfs:label "financial service" ;
    rdfs:comment "service provided to consumers and businesses by financial institutions such as banks, insurance companies, brokerage firms, consumer finance companies, and investment companies" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Service> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> a owl:Class ;
    rdfs:label "person" ;
    rdfs:comment "individual human being, with consciousness of self" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
    skos:altLabel "natural person" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> a owl:Class ;
    rdfs:label "contractual commitment" ;
    rdfs:comment "provision specifying something that the contracting parties agree to, i.e., a promise or pledge made by one of the parties to perform some action or fulfill some duty" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> a owl:Class ;
    rdfs:label "physical address" ;
    rdfs:comment "physical address where communications can be addressed, papers served or representatives located for any kind of organization or person" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/Address> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> a owl:Class ;
    rdfs:label "scalar quantity value" ;
    rdfs:comment "number and reference together expressing the magnitude of a quantity" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "measurement",
        "value of a quantity" .

<https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Language> a owl:Class ;
    rdfs:label "language" ;
    rdfs:comment "a systematic use of sounds, characters, symbols or signs to communicate meaning" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/ControlledParty> a owl:Class ;
    rdfs:label "controlled party" ;
    rdfs:comment "person or organization over which some party exercises some form of authority or influence with respect to some situation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControlledThing> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> a owl:Class ;
    rdfs:label "contract" ;
    rdfs:comment "voluntary, deliberate agreement between competent parties to which the parties agree to be legally bound, and for which the parties provide valuable consideration" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> a owl:Class ;
    rdfs:label "controlling party" ;
    rdfs:comment "actor that exercises some form of control in the context of some situation" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> a owl:Class ;
    rdfs:label "exchange" ;
    rdfs:comment "any organization, association, or group of persons, whether incorporated or unincorporated, which constitutes, maintains, or provides a facility for bringing together purchasers and sellers of financial instruments, commodities, or other products, services, or goods, and includes the market place and facilities maintained by such exchange" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/SitesAndFacilities/Facility> ;
    skos:altLabel "market" .

<https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> a owl:Class ;
    rdfs:label "code element" ;
    rdfs:comment "sequence of characters denoting something for some purpose, within a specified context, according to some rule set" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://www.omg.org/spec/Commons/Organizations/LegalPerson> a owl:Class ;
    rdfs:label "legal person" ;
    rdfs:comment "party that is recognized as having rights and obligations under the law, including but not limited to the right to sue and be sued, enter into contracts, own property, and incur financial and other obligations" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> a owl:Class ;
    rdfs:label "expression" ;
    rdfs:comment "finite combination of symbols that are well-formed according to applicable rules" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Specification> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Party> a owl:Class ;
    rdfs:label "party" ;
    rdfs:comment "person or organization" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Agent> ;
    skos:altLabel "independent party" .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> a owl:Class ;
    rdfs:label "situation" ;
    rdfs:comment "setting, state of being, or relationship that is relatively stable for some period of time" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RolesAndCompositions/Role> a owl:Class ;
    rdfs:label "role" ;
    rdfs:comment "named specific behavior of something participating in a particular context" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> a owl:Class ;
    rdfs:label "written contract" ;
    rdfs:comment "formal contract that is written and signed by the parties thereto" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> .

<https://www.omg.org/spec/Commons/Classifiers/Classifier> a owl:Class ;
    rdfs:label "classifier" ;
    rdfs:comment "standardized classification or delineation for something, per some scheme for such delineation, within a specified context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Aspect> .

<https://www.omg.org/spec/Commons/Organizations/LegalEntity> a owl:Class ;
    rdfs:label "legal entity" ;
    rdfs:comment "legal person that is a partnership, corporation, or other organization having the capacity to negotiate contracts, assume financial obligations, and pay off debts, organized under the laws of some jurisdiction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalPerson> ;
    skos:altLabel "artificial person",
        "juridical entity",
        "juridical person",
        "juristic person" .

<https://www.omg.org/spec/Commons/DatesAndTimes/Date> a owl:Class ;
    rdfs:label "date" ;
    rdfs:comment "calendar day on some calendar" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> .

<https://www.omg.org/spec/Commons/Identifiers/Identifier> a owl:Class ;
    rdfs:label "identifier" ;
    rdfs:comment "sequence of characters uniquely identifying that with which it is associated" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> a owl:Class ;
    rdfs:label "monetary amount" ;
    rdfs:comment "measure that is an amount of money specified in monetary units" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> a owl:Class ;
    rdfs:label "explicit date" ;
    rdfs:comment "date in which the 'has date value' property is required" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> a owl:Class ;
    rdfs:label "party role" ;
    rdfs:comment "role played by an organization or individual that may be time bound" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> .

ns:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:comment "Synthesized root class" .

