    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PhysicalAddress> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/PostOfficeBoxDesignator> a owl:Class ;
    rdfs:label "post office box designator" ;
    rdfs:comment "designator used, together with an identifier, for a post office box" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SupplementalAddressDesignator> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/RegionSpecificIdentifier> a owl:Class ;
    rdfs:label "region-specific identifier" ;
    rdfs:comment "geographic region or subdivision identifier used internally by a country or other region" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeographicRegionIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> a owl:Class ;
    rdfs:label "secondary unit designator" ;
    rdfs:comment "classifier for a smaller structure or component within a larger facility, such as an apartment, office, mail stop, or other similar designation" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitIndicator> a owl:Class ;
