    rdfs:comment "record about a party in a specific communicative or liaison role" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Record> .

<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/DeathCertificate> a owl:Class ;
    rdfs:label "death certificate" ;
