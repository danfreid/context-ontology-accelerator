    rdfs:label "exempt issuer" ;
    rdfs:comment "issuer that issues securities that are excused from certain regulatory reporting requirements" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Issuer> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/ExemptOffering> a owl:Class ;
