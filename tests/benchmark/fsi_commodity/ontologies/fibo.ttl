    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/AddressComponent> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/VirtualAddress> a owl:Class ;
