<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/PreciousMetalIdentifier> a owl:Class ;
    rdfs:label "precious metal identifier" ;
    rdfs:comment "sequence of characters uniquely identifying the precious metal in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/UnitOfAccount> a owl:Class ;
