    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStageOccurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Dealer> a owl:Class ;
    rdfs:label "dealer" ;
    rdfs:comment "any party that purchases goods or services for resale and acts on their own behalf in a transaction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/ServiceProvider> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialIntermediationService> a owl:Class ;
    rdfs:label "financial intermediation service" ;
    rdfs:comment "any financial service in which a third party (the intermediary) matches lenders and investors with entrepreneurs and other borrowers in need of capital" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialProductCatalog> a owl:Class ;
