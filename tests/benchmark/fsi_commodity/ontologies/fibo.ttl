    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalPerson> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwnership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/hasOwnedEntity> a owl:ObjectProperty ;
    rdfs:label "has owned entity" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwnership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/hasOwningEntity> a owl:ObjectProperty ;
    rdfs:label "has owning entity" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/OwnershipParties/EntityOwnership> ;
    rdfs:range <https://www.omg.org/spec/Commons/Organizations/LegalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/GeneralPartnership> a owl:Class ;
    rdfs:label "general partnership" ;
    rdfs:comment "partnership that has at least two general partners that agree to share in all assets, profits, and financial and legal liabilities of the business" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partnership> ;
    skos:altLabel "GP" .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/LimitedLiabilityLimitedPartnership> a owl:Class ;
    rdfs:label "limited liability limited partnership" ;
    rdfs:comment "limited partnership that consists of one or more general partners who are liable for the obligations of the entity as well as one or more protected limited liability partners" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/LimitedPartnership> ;
    skos:altLabel "LLLP" .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/LimitedLiabilityPartnership> a owl:Class ;
    rdfs:label "limited liability partnership" ;
    rdfs:comment "partnership that has general partners but provides its individual partners some level of protection against personal liability for certain partnership liabilities" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partnership> ;
    skos:altLabel "LLP" .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/PartnershipAgreement> a owl:Class ;
    rdfs:label "partnership agreement" ;
    rdfs:comment "contract between partners in a partnership that establishes the terms and conditions of the relationship between the partners" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/OrganizationCoveringAgreement> ;
    skos:altLabel "articles of partnership" .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/hasGeneralPartner> a owl:ObjectProperty ;
    rdfs:label "has general partner" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partnership> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/GeneralPartner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/hasLimitedPartner> a owl:ObjectProperty ;
    rdfs:label "has limited partner" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partnership> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/LimitedPartner> .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/isGeneralPartnerOf> a owl:ObjectProperty ;
    rdfs:label "is general partner of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/GeneralPartner> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partnership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/isLimitedPartnerOf> a owl:ObjectProperty ;
    rdfs:label "is limited partner of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/LimitedPartner> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/Partnerships/Partnerships/Partnership> .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/LimitedLiabilityCompanyMember> a owl:Class ;
    rdfs:label "limited liability company member" ;
    rdfs:comment "owner of an interest in a limited liability company" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/EntityControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/LimitedLiabilityCompanyTaxedAsACorporation> a owl:Class ;
    rdfs:label "limited liability company taxed as a corporation" ;
    rdfs:comment "limited liability company that has elected to have corporate tax status" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/LimitedLiabilityCompany> ;
    skos:altLabel "C-LLC" .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/ManagerManagedLimitedLiabilityCompany> a owl:Class ;
    rdfs:label "manager-managed limited liability company" ;
    rdfs:comment "limited liability company in which the members appoint one or more managers to handle the daily operations and administrative responsibilities of the organization" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/LimitedLiabilityCompany> .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/PrivateLimitedCompany> a owl:Class ;
    rdfs:label "private limited company" ;
    rdfs:comment "private limited company whose shareholders' liability is limited to the capital they originally invested" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/PrivateCompanyWithLimitedLiability> ;
    skos:altLabel "Ltd." .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/hasManagingMember> a owl:ObjectProperty ;
    rdfs:label "has managing member" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/ManagingMember> .

<https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/isManagingMemberOf> a owl:ObjectProperty ;
    rdfs:label "is managing member of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/BE/PrivateLimitedCompanies/PrivateLimitedCompanies/ManagingMember> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/CashflowExpression> a owl:Class ;
    rdfs:label "cashflow expression" ;
    rdfs:comment "expression that specifies a calculation of a cash flow as a component of a cashflow formula" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/CashflowFormula> a owl:Class ;
    rdfs:label "cashflow formula" ;
    rdfs:comment "formula for determining cashflows for a derivative instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Formula> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ContractForDifference> a owl:Class ;
    rdfs:label "contract for difference" ;
    rdfs:comment "cash-settled derivative where the parties agree to exchange on the maturity of the contract the difference between the current value of the underlying asset and the initial value of that asset when the contract is initiated" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> ;
    skos:altLabel "CFD",
        "spread trading" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/CreditDerivative> a owl:Class ;
    rdfs:label "credit derivative" ;
    rdfs:comment "derivative instrument that is a privately held, negotiable bilateral contract traded over-the-counter (OTC) between two parties in a creditor/debtor relationship, enabling the creditor to effectively transfer some or all of the risk of a debtor defaulting to a third party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/DerivativeSettlementTerms> a owl:Class ;
    rdfs:label "derivative settlement terms" ;
    rdfs:comment "settlement terms specifying additional details with respect to what is to be delivered when, to whom, under what conditions at the time of settlement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/DerivativeTerms> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/DerivativesClearingOrganization> a owl:Class ;
    rdfs:label "derivatives clearing organization" ;
    rdfs:comment "clearing house that enables parties to substitute the credit of the DCO for the credit of the parties" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ClearingHouse> ;
    skos:altLabel "DCO" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/EconomicRateBasedDerivative> a owl:Class ;
    rdfs:label "economic rate-based derivative" ;
    rdfs:comment "rate-based derivative whose underlier is some economic indicator" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/RateBasedDerivative> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ForwardRateAgreement> a owl:Class ;
    rdfs:label "forward rate agreement" ;
    rdfs:comment "agreement to exchange an interest rate commitment on a notional amount at a future date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/InterestRateDerivative> ;
    skos:altLabel "FRA" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/IntroducingBroker> a owl:Class ;
    rdfs:label "introducing broker" ;
    rdfs:comment "broker that solicits or accepts orders for derivatives that are traded on or subject to the rules of an exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Broker> ;
    skos:altLabel "IB" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ObservableValue> a owl:Class ;
    rdfs:label "observable value" ;
    rdfs:comment "specification for the value for something discernible and for which evidence can be obtained" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Specification> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/OverTheCounterDerivativeInstrument> a owl:Class ;
    rdfs:label "over-the-counter derivative instrument" ;
    rdfs:comment "derivative instrument that is not listed on an organized exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> ;
    skos:altLabel "OTC derivative instrument" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/OverTheCounterInstrument> a owl:Class ;
    rdfs:label "over-the-counter instrument" ;
    rdfs:comment "financial instrument and bilateral contract that is not listed on an organized exchange" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    skos:altLabel "OTC instrument" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ParametricCashflowTerms> a owl:Class ;
    rdfs:label "parametric cashflow terms" ;
    rdfs:comment "terms for a set of cashflows defined according to a mathematical formula" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/CashflowTerms> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/PayingParty> a owl:Class ;
    rdfs:label "paying party" ;
    rdfs:comment "party responsible for making payments in a transaction specified in a contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/Payer> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ReceivingParty> a owl:Class ;
    rdfs:label "receiving counterparty" ;
    rdfs:comment "party that receives payments in a transaction specified in a contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UnderlyingAssetValuation> a owl:Class ;
    rdfs:label "underlying asset valuation" ;
    rdfs:comment "assessment activity to estimate the value of an underlying asset of a derivative" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ValueAssessment> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UniqueProductIdentifier> a owl:Class ;
    rdfs:label "unique product identifier" ;
    rdfs:comment "sequence of characters uniquely identifying an OTC derivative product that is reportable to a trade repository" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualIdentifiers/StructuredIdentifier> ;
    skos:altLabel "UPI" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UniqueProductIdentifierRegistryEntry> a owl:Class ;
    rdfs:label "unique product identifier registry entry" ;
    rdfs:comment "entry in a unique product identifier registry" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistryEntry> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/UniqueProductIdentifierServiceProvider> a owl:Class ;
    rdfs:label "unique product identifier service provider" ;
    rdfs:comment "organization designated by an external body of financial regulators to assign UPIs and operate a UPI reference data library" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistrationAuthority> ;
    skos:altLabel "UPI service provider" .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasAccretingNotionalAmount> a owl:ObjectProperty ;
    rdfs:label "has accreting notional amount" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasAdditionalCosts> a owl:ObjectProperty ;
    rdfs:label "has additional costs" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasAmortizingNotionalAmount> a owl:ObjectProperty ;
    rdfs:label "has amortizing notional amount" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasConstantNotionalAmount> a owl:ObjectProperty ;
    rdfs:label "has constant notional amount" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasCustomNotionalAmount> a owl:ObjectProperty ;
    rdfs:label "has custom notional amount" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasFirstDeliveryDate> a owl:ObjectProperty ;
    rdfs:label "has first delivery date" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/SettlementTerms> ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasFirstNoticeDate> a owl:ObjectProperty ;
    rdfs:label "has first notice date" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/SettlementTerms> ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasLastDeliveryDate> a owl:ObjectProperty ;
    rdfs:label "has last delivery date" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/SettlementTerms> ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasLastNoticeDate> a owl:ObjectProperty ;
    rdfs:label "has last notice date" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/SettlementTerms> ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasSettlementTerms> a owl:ObjectProperty ;
    rdfs:label "has settlement terms" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/SettlementTerms> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasTickValue> a owl:ObjectProperty ;
    rdfs:label "has tick value" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasUnderlyingAssetPrice> a owl:ObjectProperty ;
    rdfs:label "has underlying asset price" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/hasValuationTerms> a owl:ObjectProperty ;
    rdfs:label "has valuation terms" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DerivativeInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/ValuationTerms> .

<https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/DerivativesBasics/specifiesValueOf> a owl:ObjectProperty ;
    rdfs:label "specifies value of" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Accrual> a owl:Class ;
    rdfs:label "accrual" ;
    rdfs:comment "the process of accumulating interest or other income that has been earned but not paid" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/AccruedInterest> a owl:Class ;
    rdfs:label "accrued interest" ;
    rdfs:comment "amount of interest that has been incurred, as of a specific date, on a loan or other financial obligation but has not yet been paid out" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Interest> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/AmortizationSchedule> a owl:Class ;
    rdfs:label "amortization schedule" ;
    rdfs:comment "schedule of periodic payments (repayment installments) that specify changes in the balance of the debt over time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/PaymentSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/BorrowerIdentificationScheme> a owl:Class ;
    rdfs:label "borrower identification scheme" ;
    rdfs:comment "system for allocating identifiers to borrowers" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyRoleIdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/BorrowerIdentifier> a owl:Class ;
    rdfs:label "borrower identifier" ;
    rdfs:comment "sequence of characters, capable of uniquely identifying a borrower" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyRoleIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/BorrowingCapacity> a owl:Class ;
    rdfs:label "borrowing capacity" ;
    rdfs:comment "upper bound on the total amount of money that a lender believes a party has the ability to repay an obligation when due, as of some point in time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CapitalLease> a owl:Class ;
    rdfs:label "capital lease" ;
    rdfs:comment "lease that must be reflected on an organization's balance sheet as an asset and as a corresponding liability" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Lease> ;
    skos:altLabel "financial lease" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CollateralValueAsOfDate> a owl:Class ;
    rdfs:label "collateral value as of date" ;
    rdfs:comment "appraised value of the collateral for an obligation as of a given date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AppraisedValue> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CommittedSubFacility> a owl:Class ;
    rdfs:label "committed sub-facility" ;
    rdfs:comment "contractually committed portion of a credit facility that is available to the borrower and may be associated with some specific collateral" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/SubFacility> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidAtMaturity> a owl:Class ;
    rdfs:label "credit agreement repaid at maturity" ;
    rdfs:comment "credit agreement in which accrued interest may be periodically repaid or paid at maturity, but principal is paid at maturity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditEnhancementAgreement> a owl:Class ;
    rdfs:label "credit enhancement agreement" ;
    rdfs:comment "collateral agreement that governs the exchange of collateral between parties to mitigate counterparty credit risk" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CollateralAgreement> ;
    skos:altLabel "collateralization",
        "credit support agreement",
        "financial collateral arrangement",
        "margin arrangement" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditEnhancementBeneficiary> a owl:Class ;
    rdfs:label "credit enhancement beneficiary" ;
    rdfs:comment "party that benefits from the collateral or guarantee established under the agreement, i.e., that is protected against counterparty credit risk because the collateral or guarantee serves as security for the obligation(s) owed to them" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/ExplicitContractEventSchedule> a owl:Class ;
    rdfs:label "explicit contract event schedule" ;
    rdfs:comment "schedule of events, including but not limited to payment events, rate reset events and others that will occur over the lifetime of the credit agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/AdHocSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/FixedInterestRate> a owl:Class ;
    rdfs:label "fixed interest rate" ;
    rdfs:comment "interest rate that does not fluctuate over the lifetime of a loan or other debt instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/InterestRate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/FloatingInterestRate> a owl:Class ;
    rdfs:label "floating interest rate" ;
    rdfs:comment "variable interest rate that is based on a specific index or benchmark rate" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/VariableInterestRate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/FullAmortization> a owl:Class ;
    rdfs:label "full amortization" ;
    rdfs:comment "amortization in which the very last payment (which, if the schedule was calculated correctly, should be equal to all others) pays off all remaining principal and interest on the loan" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Amortization> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestCalculationSchedule> a owl:Class ;
    rdfs:label "interest calculation schedule" ;
    rdfs:comment "regular, contract-specific schedule including the dates on which interest is calculated" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/ProjectedContractEventSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestPayment> a owl:Class ;
    rdfs:label "interest payment" ;
    rdfs:comment "event reflecting the actual payment of interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/Payment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestPaymentSchedule> a owl:Class ;
    rdfs:label "interest payment schedule" ;
    rdfs:comment "regular, contract-specific schedule including the dates on which interest is due to be paid" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/PaymentSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestPaymentTerms> a owl:Class ;
    rdfs:label "interest payment terms" ;
    rdfs:comment "contract terms for payment of interest on a debt" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestRateReset> a owl:Class ;
    rdfs:label "interest rate reset" ;
    rdfs:comment "event reflecting a potential adjustment to an interest rate, typically corresponding to a change in the underlying benchmark interest rate or index specified in the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestCalculation> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestRateResetSchedule> a owl:Class ;
    rdfs:label "interest rate reset schedule" ;
    rdfs:comment "regular, contract-specific schedule including the dates on which a rate reset, and corresponding actual rate, is recalculated" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/ProjectedContractEventSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestRateSettingEvent> a owl:Class ;
    rdfs:label "interest rate setting event" ;
    rdfs:comment "event on which an initial rate for a given contract is set, which may be relative the the occurrence of some other contract lifecycle event, such as the execution date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestCalculation> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/ManagedInterestRate> a owl:Class ;
    rdfs:label "managed interest rate" ;
    rdfs:comment "variable interest rate charged by a financial institution for borrowing that is not prescribed as a margin over base rate but is set from time to time by the institution" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/VariableInterestRate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/MotorVehicleLease> a owl:Class ;
    rdfs:label "motor vehicle lease" ;
    rdfs:comment "lease of a motor vehicle for a fixed period of time at an agreed amount of money" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Lease> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/NegativeAmortization> a owl:Class ;
    rdfs:label "negative amortization" ;
    rdfs:comment "amortization in which the payments made do not cover the interest due" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Amortization> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/NonPhysicalCollateral> a owl:Class ;
    rdfs:label "non-physical collateral" ;
    rdfs:comment "asset pledged as collateral that is a financial asset, rather than physical asset" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Collateral> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/PartialAmortization> a owl:Class ;
    rdfs:label "partial amortization" ;
    rdfs:comment "amortization in which the very last payment the last payment due may be a large balloon payment of all remaining principal and interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Amortization> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/PhysicalCollateral> a owl:Class ;
    rdfs:label "physical collateral" ;
    rdfs:comment "asset pledged as collateral that has a material form, i.e., is a physical asset of the obligor" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Collateral> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/PrincipalPayment> a owl:Class ;
    rdfs:label "principal payment" ;
    rdfs:comment "event reflecting the actual payment of some amount of the principal of a debt" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/Payment> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/PrincipalPaymentSchedule> a owl:Class ;
    rdfs:label "principal payment schedule" ;
    rdfs:comment "regular, contract-specific schedule including the dates on which some percentage or all of the principal is due to be (re)paid" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/ProjectedContractEventSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/RateResetTimeOfDay> a owl:Class ;
    rdfs:label "rate reset time of day" ;
    rdfs:comment "time of day that an interest rate is reset, as indicated by some interest rate authority or market data provider" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeOfDay> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/RetailCreditFacility> a owl:Class ;
    rdfs:label "retail credit facility" ;
    rdfs:comment "credit facility that is a loan or line of credit used by retailers and real estate companies" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CommittedCreditFacility> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/RevolvingLineOfCredit> a owl:Class ;
    rdfs:label "revolving line of credit" ;
    rdfs:comment "credit facility that enables the borrower to withdraw funds, repay, and withdraw again" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CommittedCreditFacility> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/SecurityAgreement> a owl:Class ;
    rdfs:label "security agreement" ;
    rdfs:comment "collateral agreement that grants a financial interest in some collateral to a party that is not an owner of that collateral, specifying terms including relative duties and rights, over and above those specified in the primary contract, regarding the disposition of the asset used as collateral" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CollateralAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/UncommittedCreditFacility> a owl:Class ;
    rdfs:label "uncommitted credit facility" ;
    rdfs:comment "credit facility that has yet to be confirmed as a source of financing for the borrower" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditFacility> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/UncommittedSubFacility> a owl:Class ;
    rdfs:label "uncommitted sub-facility" ;
    rdfs:comment "sub-facility that has yet to be confirmed as a source of financing for the borrower" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/SubFacility> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/governsPaymentOf> a owl:ObjectProperty ;
    rdfs:label "governs payment of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/hasAccrualBasis> a owl:ObjectProperty ;
    rdfs:label "has accrual basis" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/hasAmountOfCreditExtended> a owl:ObjectProperty ;
    rdfs:label "has amount of credit extended" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/hasAnticipatedNumberOfPayments> a owl:DatatypeProperty ;
    rdfs:label "has anticipated number of payments" ;
    rdfs:range xsd:positiveInteger .

