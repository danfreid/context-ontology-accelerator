    rdfs:label "is registered by" ;
    rdfs:range <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registrar> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/isRegisteredIn> a owl:ObjectProperty ;
    rdfs:label "is registered in" ;
    rdfs:range <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/isRegistrationAuthorityFor> a owl:ObjectProperty ;
    rdfs:label "is registration authority for" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistrationAuthority> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/registers> a owl:ObjectProperty ;
    rdfs:label "registers" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registrar> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/RegulatoryReport> a owl:Class ;
    rdfs:label "regulatory report" ;
    rdfs:comment "document required to support operational transparency that demonstrates compliance with some specification, law, policy, restriction, or other rule specified by a regulatory agency" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/ReferenceDocument> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/RegulatoryService> a owl:Class ;
    rdfs:label "regulatory service" ;
    rdfs:comment "service provided by a regulatory agency, which may include, but not be limited to, examination, monitoring, supervision, testing, or other capabilities required to ensure the integrity, fairness, safety, or other capacity of a given industry, organization, or product" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Service> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/governs> a owl:ObjectProperty ;
    rdfs:label "governs" .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/hasJurisdiction> a owl:ObjectProperty ;
    rdfs:label "has jurisdiction" ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/hasReach> a owl:ObjectProperty ;
    rdfs:label "has reach" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> ;
    rdfs:range <https://www.omg.org/spec/Commons/Locations/GeographicRegion> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/isApplicableInJurisdiction> a owl:ObjectProperty ;
    rdfs:label "is applicable in jurisdiction" .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/isGovernedBy> a owl:ObjectProperty ;
    rdfs:label "is governed by" .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/isJurisdictionOf> a owl:ObjectProperty ;
    rdfs:label "is jurisdiction of" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/isOrganizedIn> a owl:ObjectProperty ;
    rdfs:label "is organized in" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/isRecognizedIn> a owl:ObjectProperty ;
    rdfs:label "is recognized in" ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/isRegulatedBy> a owl:ObjectProperty ;
    rdfs:label "is regulated by" ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/RegulatoryAgency> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/regulates> a owl:ObjectProperty ;
    rdfs:label "regulates" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegulatoryAgencies/RegulatoryAgency> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/Composition> a owl:Class ;
    rdfs:label "composition" ;
    rdfs:comment "distinct thing resulting from bringing together other things, possibly in specific roles, for a particular purpose" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RolesAndCompositions/ProcessRole> a owl:Class ;
    rdfs:label "process role" ;
    rdfs:comment "role that associates resources and participants to a structured set of activities involving various enterprise entities, that is designed and organised for a given purpose" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/StructuralRole> a owl:Class ;
    rdfs:label "structural role" ;
    rdfs:comment "role specifying relations between entities in the sense of competence, often reflecting organizational or structural relations (hierarchies)" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/hasRole> a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:range <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/isManifestedIn> a owl:ObjectProperty ;
    rdfs:label "is manifested in" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/isPlayedBy> a owl:ObjectProperty ;
    rdfs:label "is played by" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/isRoleIn> a owl:ObjectProperty ;
    rdfs:label "is role in" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/manifests> a owl:ObjectProperty ;
    rdfs:label "manifests" ;
    rdfs:range <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/playsRole> a owl:ObjectProperty ;
    rdfs:label "plays role" ;
    rdfs:range <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/SitesAndFacilities/TractIdentifier> a owl:Class ;
    rdfs:label "tract identifier" ;
    rdfs:comment "unique identifier for a parcel issued for use in some jurisdiction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualIdentifiers/ContextualIdentifier> .

<https://www.omg.org/spec/Commons/SitesAndFacilities/TractOfLand> a owl:Class ;
    rdfs:label "tract of land" ;
    rdfs:comment "geographic region that is a contiguous parcel or area of land within a larger region on the surface of the earth, typically defined by its boundaries as described in a deed, survey, or legal document" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeographicRegion> .

<https://www.omg.org/spec/Commons/SitesAndFacilities/Venue> a owl:Class ;
    rdfs:label "venue" ;
    rdfs:comment "site where something happens, described in the context of an event, activity, or something else that occurs there" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/SitesAndFacilities/Site> .

<https://www.omg.org/spec/Commons/SitesAndFacilities/enables> a owl:ObjectProperty ;
    rdfs:label "enables" .

<https://www.omg.org/spec/Commons/SitesAndFacilities/isEnabledBy> a owl:ObjectProperty ;
    rdfs:label "is enabled by" .

<https://www.omg.org/spec/Commons/SitesAndFacilities/isSituatedAt> a owl:ObjectProperty ;
    rdfs:label "is situated at" .

<https://www.omg.org/spec/Commons/SitesAndFacilities/situates> a owl:ObjectProperty ;
    rdfs:label "situates" .

<https://www.omg.org/spec/Commons/TextDatatype/hasTextValue> a owl:DatatypeProperty ;
    rdfs:label "has text value" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Alpha2Code> a owl:Class ;
    rdfs:label "alpha-2 code" ;
    rdfs:comment "a digraph representing a country or geographic region" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegionIdentifier> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Alpha3Code> a owl:Class ;
    rdfs:label "alpha-3 code" ;
    rdfs:comment "a trigraph representing a country or geographic region" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegionIdentifier> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Country> a owl:Class ;
    rdfs:label "country" ;
    rdfs:comment "a geopolitical entity representing a country or dependent territory" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeopoliticalEntity> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/CountrySubdivision> a owl:Class ;
    rdfs:label "country subdivision" ;
    rdfs:comment "a geopolitical entity, typically a division of a country, dependency, or other area of special geopolitical interest related to a country or other geopolitical entity" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeopoliticalEntity> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicCoordinateSystem> a owl:Class ;
    rdfs:label "geographic coordinate system" ;
    rdfs:comment "a three-dimensional reference system that locates points on the Earth's surface" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/CoordinateSystem> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegionKind> a owl:Class ;
    rdfs:label "kind of geographic region" ;
    rdfs:comment "a classification scheme for geographic regions, including but not limited to subdivisions of a geopolitical entity, (noting that there may be more than one kind for a given country or other entity)" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Arrangement> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Territory> a owl:Class ;
    rdfs:label "territory" ;
    rdfs:comment "a geopolitical entity, typically considered an area of special geopolitical interest, related to a country or other geopolitical entity" ;
    rdfs:subClassOf <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeopoliticalEntity> .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/classifies> a owl:ObjectProperty ;
    rdfs:label "classifies" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasEnglishFullName> a owl:DatatypeProperty ;
    rdfs:label "has English full name" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasEnglishShortName> a owl:DatatypeProperty ;
    rdfs:label "has English short name" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasEnglishShortNameInCapitals> a owl:DatatypeProperty ;
    rdfs:label "has English short name in capitals" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasFrenchFullName> a owl:DatatypeProperty ;
    rdfs:label "has French full name" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasFrenchShortName> a owl:DatatypeProperty ;
    rdfs:label "has French short name" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasFrenchShortNameInCapitals> a owl:DatatypeProperty ;
    rdfs:label "has French short name in capitals" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasLatitude> a owl:DatatypeProperty ;
    rdfs:label "has latitude" .

<https://www.omg.org/spec/LCC/Countries/CountryRepresentation/hasLocalShortName> a owl:DatatypeProperty ;
