<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Appraiser> a owl:Class ;
    rdfs:label "appraiser" ;
    rdfs:comment "party that evaluates or estimates the nature, quality, ability, or value of someone or something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentActivity> a owl:Class ;
    rdfs:label "assessment activity" ;
    rdfs:comment "activity involving the evaluation or estimation of the nature, quality, ability, or value of someone or something" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ExpectedValue> a owl:Class ;
    rdfs:label "expected value" ;
    rdfs:comment "theoretical value that is anticipated based on a model or hypothesis" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Value> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/FairValue> a owl:Class ;
    rdfs:label "fair value" ;
    rdfs:comment "price that would be received to sell an asset, or paid to transfer a liability, in an orderly transaction between market participants at the measurement date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/QuantitativeValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ObservedValue> a owl:Class ;
    rdfs:label "observed value" ;
    rdfs:comment "value that is an actual data point collected from an experiment, survey, or observation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Value> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Opinion> a owl:Class ;
    rdfs:label "opinion" ;
    rdfs:comment "judgement, appraisal, or view about something" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/PresentValue> a owl:Class ;
    rdfs:label "present value" ;
    rdfs:comment "value of an asset today, which may be calculated from reference data and may based on its expected future value" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/QuantitativeValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/QualitativeValue> a owl:Class ;
    rdfs:label "qualitative value" ;
    rdfs:comment "value that has less precision or accuracy than a value determined via quantitative methods and which is usually expressed in codes rather than actual numbers" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Value> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ReferenceValue> a owl:Class ;
    rdfs:label "reference value" ;
    rdfs:comment "value for something discernible for which evidence can be obtained" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Reference> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/appliesMethodology> a owl:ObjectProperty ;
    rdfs:label "applies methodology" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/ValuationMethod> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/estimatesValueAt> a owl:ObjectProperty ;
    rdfs:label "estimates value at" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AppraisedValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/hasAppraiser> a owl:ObjectProperty ;
    rdfs:label "has appraiser" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/hasDateOfAssessment> a owl:ObjectProperty ;
    rdfs:label "has date of assessment" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/hasEstimatedValue> a owl:ObjectProperty ;
    rdfs:label "has estimated value" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AppraisedValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/isEstimatedValueOf> a owl:ObjectProperty ;
    rdfs:label "is estimated value of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AppraisedValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/hasExpirationDate> a owl:ObjectProperty ;
    rdfs:label "has expiration date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/hasRecord> a owl:ObjectProperty ;
    rdfs:label "has record" ;
    rdfs:range <https://www.omg.org/spec/Commons/Documents/Record> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/hasReportingPeriod> a owl:ObjectProperty ;
    rdfs:label "has reporting period" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDatePeriod> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/hasTerminationDate> a owl:ObjectProperty ;
    rdfs:label "has termination date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/ReassignableIdentifier> a owl:Class ;
    rdfs:label "reassignable identifier" ;
    rdfs:comment "identifier that uniquely identifies something for a given time period, and that may be reused to identify something else at a different point in time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/hasAssignmentTerminationDate> a owl:DatatypeProperty ;
    rdfs:label "has assignment termination date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/hasInitialAssignmentDate> a owl:DatatypeProperty ;
    rdfs:label "has initial assignment date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/isIndexTo> a owl:ObjectProperty ;
    rdfs:label "is index to" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/Index> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStatus> a owl:Class ;
    rdfs:label "lifecycle status" ;
    rdfs:comment "classifier indicating the position or state of something at a particular point in its life-cycle" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

