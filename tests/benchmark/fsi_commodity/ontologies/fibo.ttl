<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/ContractLifecycleEventOccurrence> a owl:Class ;
    rdfs:label "contract lifecycle event occurrence" ;
    rdfs:comment "actual occurrence of an event during a specific stage of a specific contract lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEventOccurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/ContractLifecycleOccurrence> a owl:Class ;
    rdfs:label "contract lifecycle occurrence" ;
    rdfs:comment "realization of the lifecycle of a specific contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleOccurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/ContractLifecycleStage> a owl:Class ;
