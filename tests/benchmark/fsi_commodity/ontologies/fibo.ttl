<https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/mandates> a owl:ObjectProperty ;
    rdfs:label "mandates" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/produces> a owl:ObjectProperty ;
    rdfs:label "produces" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/wasFormerlyKnownAs> a owl:DatatypeProperty ;
    rdfs:label "was formerly known as" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/AnnualizedStandardDeviation> a owl:Class ;
    rdfs:label "annualized standard deviation" ;
    rdfs:comment "standard deviation for some measure over a specific reference period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StandardDeviation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/ArithmeticMean> a owl:Class ;
    rdfs:label "arithmetic mean" ;
    rdfs:comment "sum of a collection of numbers divided by the number of numbers in the collection" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Mean> ;
    skos:altLabel "average" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/AverageAbsoluteDeviation> a owl:Class ;
    rdfs:label "average absolute deviation" ;
    rdfs:comment "average of the absolute deviations from a central point" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Dispersion> ;
    skos:altLabel "mean absolute deviation" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/GeometricMean> a owl:Class ;
    rdfs:label "geometric mean" ;
    rdfs:comment "mean that indicates the central tendency or typical value of a set of numbers by using the product of their values (as opposed to the arithmetic mean which uses their sum)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Mean> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/KeyPerformanceIndicator> a owl:Class ;
    rdfs:label "key performance indicator" ;
    rdfs:comment "measurable target that indicates how an individual or business is performing in terms of meeting its goals" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/QualifiedMeasure> ;
    skos:altLabel "KPI" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Median> a owl:Class ;
    rdfs:label "median" ;
    rdfs:comment "value of the variate dividing the total frequency of a data sample, population, or probability distribution, into two halves" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/MedianAbsoluteDeviation> a owl:Class ;
    rdfs:label "median absolute deviation" ;
    rdfs:comment "median of the absolute deviations of observations from the average which may be the arithmetic mean, the median or the mode" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Dispersion> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/NumericIndexValue> a owl:Class ;
    rdfs:label "numeric index value" ;
    rdfs:comment "numeric value of some aggregate relative to the value of that aggregate as of some date" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/SamplingVariance> a owl:Class ;
    rdfs:label "sampling variance" ;
    rdfs:comment "measure of the extent to which the estimate of a characteristic from different possible samples of the same size and the same design differ from one another" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Variance> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalAreaIdentifier> a owl:Class ;
    rdfs:label "statistical area identifier" ;
    rdfs:comment "identifier for a physical location that is defined per a nationally consistent program for designating geographic regions for the purposes of tabulating and presenting statistical data" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/GeographicRegionIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalPopulation> a owl:Class ;
    rdfs:label "statistical population" ;
    rdfs:comment "statistical universe filtered by time and region" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/FinitePopulation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalProgram> a owl:Class ;
    rdfs:label "statistical program" ;
    rdfs:comment "program that presents a detailed investigation and analysis of a subject or situation involving one or more studies or surveys" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/Objectives/Program> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/WeightingFunction> a owl:Class ;
    rdfs:label "weighting function" ;
    rdfs:comment "expression or function that determines the relative importance or influence of a given element of a set with respect to the whole" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasFixedComparativeDate> a owl:ObjectProperty ;
    rdfs:label "has fixed comparative date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasFormula> a owl:ObjectProperty ;
    rdfs:label "has formula" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Formula> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasMeasurementDateTime> a owl:DatatypeProperty ;
    rdfs:label "has measurement date time" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasMeasurementPeriodInMonths> a owl:DatatypeProperty ;
    rdfs:label "has measurement period in months" ;
    rdfs:range xsd:integer .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasMinuend> a owl:ObjectProperty ;
    rdfs:label "has minuend" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Difference> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasNumberOfEntries> a owl:DatatypeProperty ;
    rdfs:label "has number of entries" ;
    rdfs:range xsd:nonNegativeInteger .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasObservedValue> a owl:ObjectProperty ;
    rdfs:label "has observed value" ;
    rdfs:range <https://www.omg.org/spec/Commons/Collections/StructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasPeriodicity> a owl:ObjectProperty ;
    rdfs:label "has periodicity" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RecurrenceInterval> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasPopulationSize> a owl:DatatypeProperty ;
    rdfs:label "has population size" ;
    rdfs:range xsd:nonNegativeInteger .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasReferencePeriod> a owl:ObjectProperty ;
    rdfs:label "has reference period" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RecurrenceInterval> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasRelativeComparativeDate> a owl:ObjectProperty ;
    rdfs:label "has relative comparative date" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/RelativeDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasRelativeComparativePeriod> a owl:ObjectProperty ;
    rdfs:label "has relative comparative period" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/DatePeriod> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasReleaseDate> a owl:ObjectProperty ;
    rdfs:label "has release date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasReleaseDateTime> a owl:DatatypeProperty ;
    rdfs:label "has release date and time" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasSubtrahend> a owl:ObjectProperty ;
    rdfs:label "has subtrahend" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/Difference> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasTargetValue> a owl:ObjectProperty ;
    rdfs:label "has target value" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedStructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasUniverseSize> a owl:DatatypeProperty ;
    rdfs:label "has universe size" ;
    rdfs:range xsd:nonNegativeInteger .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/hasWeight> a owl:DatatypeProperty ;
    rdfs:label "has weight" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/isCalculatedViaMethodology> a owl:DatatypeProperty ;
    rdfs:label "is calculated via methodology" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/isEstimate> a owl:DatatypeProperty ;
    rdfs:label "is estimate" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalMeasure> ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/MaturityLevel> a owl:Class ;
    rdfs:label "maturity level" ;
    rdfs:comment "classifier used to indicate the state of an artifact with respect to its development lifecycle" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/AnnotationVocabulary/Module> a owl:Class ;
    rdfs:label "module" ;
    rdfs:comment "classifier used to indicate a category used to modularize something based on principles of the model driven architecture methodology (MDA), including but not limited to separation of concerns, coherence, and establishing clear logical boundaries in order to increase reusability and maintainability" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageDailyEarnings> a owl:Class ;
    rdfs:label "average daily earnings" ;
    rdfs:comment "measure of the average daily wage an employee makes over the reporting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageEarnings> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageHourlyEarnings> a owl:Class ;
    rdfs:label "average hourly earnings" ;
    rdfs:comment "measure of the average hourly wage an employee makes over the reporting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageEarnings> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageMonthlyEarnings> a owl:Class ;
    rdfs:label "average monthly earnings" ;
    rdfs:comment "measure of the average monthly wage an employee makes over the reporting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageEarnings> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageWeeklyEarnings> a owl:Class ;
    rdfs:label "average weekly earnings" ;
    rdfs:comment "measure of the average weekly wage an employee makes over the reporting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/AverageEarnings> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CapitalLaborEnergyMaterialsMultifactorProductivity> a owl:Class ;
    rdfs:label "capital-labor-energy-materials multifactor productivity" ;
    rdfs:comment "ratio of a quantity index of gross output to a quantity index of combined inputs" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Productivity> ;
    skos:altLabel "KLEMS multifactor productivity",
        "KLEMS-MFP" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CapitalLaborMultifactorProductivityValueAdded> a owl:Class ;
    rdfs:label "capital-labor multifactor productivity (MFP), based on value added" ;
    rdfs:comment "ratio of a quantity index of value added to a quantity index of combined labor and capital input" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Productivity> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CapitalProductivityValueAdded> a owl:Class ;
    rdfs:label "capital productivity, based on value added" ;
    rdfs:comment "ratio of a quantity index of value added to a quantity index of capital input" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Productivity> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Civilian> a owl:Class ;
    rdfs:label "civilian" ;
    rdfs:comment "person that is not a member of the military (i.e., that is not on active duty)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/LegallyCompetentNaturalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianLaborForceParticipationRate> a owl:Class ;
    rdfs:label "civilian labor force participation rate" ;
    rdfs:comment "economic indicator representing the rate of participation the labor force of a given economy for some specified period" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianNonInstitutionalPerson> a owl:Class ;
    rdfs:label "civilian non-institutional person" ;
    rdfs:comment "legal working-age person that does not live in an institution (for example, a correctional facility, long-term care hospital, or nursing home), and is not on active military duty" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/LegalWorkingAgePerson> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CombinedStatisticalArea> a owl:Class ;
    rdfs:label "combined statistical area" ;
    rdfs:comment "combination of adjacent metropolitan and micropolitan areas with economic ties measured by commuting patterns" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/GovernmentSpecifiedStatisticalArea> ;
    skos:altLabel "CSA" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/DiscouragedWorkerPopulation> a owl:Class ;
    rdfs:label "discouraged worker population" ;
    rdfs:comment "subset of the marginally attached population that have given a job-market related reason for not currently looking for work" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/MarginallyAttachedPopulation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulationPartTimeForEconomicReasons> a owl:Class ;
    rdfs:label "employed population part-time for economic reasons" ;
    rdfs:comment "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week due to slack work, unfavorable business conditions, inability to find full-time work, and seasonal declines in demand" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnderemployedPopulation> ;
    skos:altLabel "involuntary part-time population",
        "population employed part-time for economic reasons" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulationPartTimeForNonEconomicReasons> a owl:Class ;
    rdfs:label "employed population part-time for non-economic reasons" ;
    rdfs:comment "subset of the employed population that includes persons that are working fewer than 30 to 35 hours per week due to illness or other health or medical limitations, childcare problems, family or personal obligations, being in school or training, retirement or Social Security limits on earnings, and having a job where full-time work is less than 35 hours" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulationPartTime> ;
    skos:altLabel "population employed part-time for non-economic reasons" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulationTemporarilyNotAtWork> a owl:Class ;
    rdfs:label "employed population temporarily not at work" ;
    rdfs:comment "subset of the employed population that includes persons that are temporarily absent from work for various reasons" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmployedPopulation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EmploymentPopulationRatio> a owl:Class ;
    rdfs:label "employment-population ratio" ;
    rdfs:comment "economic indicator representing the ratio of the employed population with respect to the overall civilian non-institutional population of a given economy for some specified period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EconomicIndicator> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Enterprise> a owl:Class ;
    rdfs:label "enterprise" ;
    rdfs:comment "functional business entity that produces and/or sells goods or services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/InstitutionalUnit> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Establishment> a owl:Class ;
    rdfs:label "establishment" ;
    rdfs:comment "an enterprise (or part of an enterprise) that operates from a single physical location" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/InstitutionalUnit> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EstablishmentEmployment> a owl:Class ;
    rdfs:label "establishment employment" ;
    rdfs:comment "economic indicator representing the total number of persons who work in or for the establishment including working proprietors, active business partners and unpaid family workers, as well as persons working outside the establishment when paid by and under the control of the establishment, for example, sales representatives, outside service engineers and repair and maintenance personnel" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> ;
    skos:altLabel "payroll employment" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EstablishmentPopulation> a owl:Class ;
    rdfs:label "establishment population" ;
    rdfs:comment "a subset of the enterprise population focused on establishments" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EnterprisePopulation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/FixedBasket> a owl:Class ;
    rdfs:label "fixed basket" ;
    rdfs:comment "basket of goods and services whose quantity and quality are held fixed for some period of time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Basket> ;
    skos:altLabel "basket of goods" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/FixedBasketConstituent> a owl:Class ;
    rdfs:label "fixed basket constituent" ;
    rdfs:comment "component of a fixed basket" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedCollectionConstituent> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/FixedBasketPopulation> a owl:Class ;
    rdfs:label "fixed basket population" ;
    rdfs:comment "statistical universe consisting of specific goods and/or services designed for the purposes of supporting surveys such as those used as the basis for price indices" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalUniverse> ;
    skos:altLabel "goods and services population",
        "goods and/or services population" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/GrossDomesticProduct> a owl:Class ;
    rdfs:label "gross domestic product" ;
    rdfs:comment "economic indicator representing the broadest measure of aggregate economic activity, measuring the total unduplicated market value of all final goods and services produced within a statistical area in a period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EconomicIndicator> ;
    skos:altLabel "GDP" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Household> a owl:Class ;
    rdfs:label "household" ;
    rdfs:comment "individual or small group of persons who occupy a housing unit (such as a house or apartment) as their usual place of residence, who pool some, or all, of their income and wealth and who consume certain types of goods and services collectively, mainly housing and food" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/InstitutionalUnit> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/HousingUnit> a owl:Class ;
    rdfs:label "housing unit" ;
    rdfs:comment "house, an apartment, a mobile home or trailer, a group of rooms, or a single room occupied as separate living quarters, or if vacant, intended for occupancy as separate living quarters" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Locations/PhysicalLocation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/InflationRate> a owl:Class ;
    rdfs:label "inflation rate" ;
    rdfs:comment "economic indicator representing a change in prices of goods and services for a specified period, for a given statistical area" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EconomicIndicator> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/InputProducerPriceIndex> a owl:Class ;
    rdfs:label "input producer price index" ;
    rdfs:comment "economic indicator representing measure of the rate of change over time in the prices of inputs of goods and services purchased by the producer" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/ProducerPriceIndex> ;
    skos:altLabel "input PPI" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/InstitutionalPerson> a owl:Class ;
    rdfs:label "institutional person" ;
    rdfs:comment "person that resides in an institution for some reason, due, for example, to hospitalization, rehabilitation, or incarceration" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/LaborProductivityGrossOutput> a owl:Class ;
    rdfs:label "labor productivity, based on gross output" ;
    rdfs:comment "ratio of a quantity index of gross output to a quantity index of labor input" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Productivity> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/LaborProductivityValueAdded> a owl:Class ;
    rdfs:label "labor productivity, based on value added" ;
    rdfs:comment "ratio of a quantity index of value added to a quantity index of labor input" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/Productivity> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/MetropolitanStatisticalArea> a owl:Class ;
    rdfs:label "metropolitan statistical area" ;
    rdfs:comment "one or more adjacent counties or county equivalents that have at least one urban core area of at least 50,000 population, plus adjacent territory that has a high degree of social and economic integration with the core as measured by commuting ties" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/GovernmentSpecifiedStatisticalArea> ;
    skos:altLabel "MSA" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/MicropolitanStatisticalArea> a owl:Class ;
    rdfs:label "micropolitan statistical area" ;
    rdfs:comment "one or more adjacent counties or county equivalents that have at least one urban core area of at least 10,000 population but less than 50,000, plus adjacent territory that has a high degree of social and economic integration with the core as measured by commuting ties" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/GovernmentSpecifiedStatisticalArea> ;
    skos:altLabel "μSA" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/MilitaryPerson> a owl:Class ;
    rdfs:label "military person" ;
    rdfs:comment "person that is a member of the active duty military" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/LegallyCompetentNaturalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/OutputProducerPriceIndex> a owl:Class ;
    rdfs:label "output producer price index" ;
    rdfs:comment "economic indicator representing measure of the rate of change over time in the prices of products sold as they leave the producer" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/ProducerPriceIndex> ;
    skos:altLabel "output PPI" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/PersonalConsumptionExpenditures> a owl:Class ;
    rdfs:label "personal consumption expenditures" ;
    rdfs:comment "economic indicator representing measure of the value of the goods and services purchased by, or on the behalf of, 'persons'" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/EconomicIndicator> ;
    skos:altLabel "PCE" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/StatisticalInformationPublisher> a owl:Class ;
    rdfs:label "statistical information publisher" ;
    rdfs:comment "publisher that packages and makes analytical and statistical data available" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UltimateConsumer> a owl:Class ;
    rdfs:label "ultimate consumer" ;
    rdfs:comment "person that is the ultimate user of a good, product or service" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Consumer> ;
    skos:altLabel "consumer as defined by the Consumer Price Index (CPI)" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnderemployedPopulationWithRespectToOccupation> a owl:Class ;
    rdfs:label "underemployed population with respect to occupation" ;
    rdfs:comment "subset of the underemployed population that includes persons employed in a role that does not reflect their training and experience, excluding those that change careers" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnderemployedPopulation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnderutilizedPopulation> a owl:Class ;
    rdfs:label "underutilized population" ;
    rdfs:comment "subset of the civilian non-institutional population that includes persons employed part-time for economic reasons, persons that are marginally attached to the labor force, and persons that are identified as unemployed" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianNonInstitutionalPopulation> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnemployedPopulation> a owl:Class ;
    rdfs:label "unemployed population" ;
    rdfs:comment "subset of the civilian labor force that is considered to have had no employment but was available for work, except for temporary illness, and had made specific efforts to find employment sometime during a specified period, during the reporting period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/CivilianLaborForce> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/UnemploymentRate> a owl:Class ;
    rdfs:label "unemployment rate" ;
    rdfs:comment "economic indicator representing the ratio of the unemployed population with respect to the civilian labor force of a given economy for some specified period" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/Expression> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/ValueAddedProducerPriceIndex> a owl:Class ;
    rdfs:label "value-added producer price index" ;
    rdfs:comment "economic indicator representing a weighted average of the input and output producer price indices" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/ProducerPriceIndex> ;
    skos:altLabel "value-added PPI" .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/excludesEnergyAndFood> a owl:DatatypeProperty ;
    rdfs:label "excludes energy and food" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/ConsumerPriceIndex> ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/hasBaselinePopulation> a owl:ObjectProperty ;
    rdfs:label "has baseline population" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalUniverse> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/hasComparisonPopulation> a owl:ObjectProperty ;
    rdfs:label "has comparison population" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/StatisticalUniverse> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/hasDurationOfUnemployment> a owl:ObjectProperty ;
    rdfs:label "has duration of unemployment" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Duration> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/hasIndicatorValue> a owl:ObjectProperty ;
    rdfs:label "has indicator value" ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/hasSeriesOrigin> a owl:ObjectProperty ;
    rdfs:label "has series origin" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/IND/EconomicIndicators/EconomicIndicators/isSeasonallyAdjusted> a owl:DatatypeProperty ;
    rdfs:label "is seasonally adjusted" ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencyConversionService> a owl:Class ;
    rdfs:label "currency conversion service" ;
    rdfs:comment "foreign exchange service involving the conversion of currency of one country or group of countries for another, typically, but not always, as a counter transaction" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/ForeignExchangeService> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencyForwardRateVolatility> a owl:Class ;
    rdfs:label "currency forward rate volatility" ;
    rdfs:comment "measure of exchange rate fluctuation based on a range of projected values for exchange rates" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/ExchangeRateVolatility> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencySpotBuyRate> a owl:Class ;
    rdfs:label "currency spot buy rate" ;
    rdfs:comment "indicative spot buying market rate as observed by the reporting source" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencySpotRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencySpotMidRate> a owl:Class ;
    rdfs:label "currency spot mid rate" ;
    rdfs:comment "indicative middle market (mean of spot buying and selling) rate as observed by the reporting source" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencySpotRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencySpotSellRate> a owl:Class ;
    rdfs:label "currency spot sell rate" ;
    rdfs:comment "indicative spot selling market rate as observed by the reporting source" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencySpotRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencySpotVolatility> a owl:Class ;
    rdfs:label "currency spot volatility" ;
    rdfs:comment "measure of exchange rate fluctuation based on a range of past actual values for exchange rates" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/HistoricalVolatility> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/ExchangeRateStructure> a owl:Class ;
    rdfs:label "exchange rate structure" ;
    rdfs:comment "structured collection of quoted or projected exchange rates, such that volatility may be constructed for the structure" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedStructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/InternationalElectronicFundsTransferService> a owl:Class ;
    rdfs:label "international electronic funds transfer service" ;
    rdfs:comment "electronic funds transfer (EFT) service involving the transfer of funds across national borders, that may also involve currency conversion" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/ElectronicFundsTransferService> ;
    skos:altLabel "international wire transfer" .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/hasExchangeRateQuotationSource> a owl:ObjectProperty ;
    rdfs:label "has exchange rate quotation source" .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/hasQuotationBlockAmountBasis> a owl:ObjectProperty ;
    rdfs:label "has quotation block amount basis" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/QuotedExchangeRate> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/hasQuotationSettlementBasis> a owl:ObjectProperty ;
    rdfs:label "has quotation settlement basis" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/QuotedExchangeRate> ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Duration> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/hasQuoteCurrency> a owl:ObjectProperty ;
    rdfs:label "has quote currency" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/hasQuotedExchangeRate> a owl:ObjectProperty ;
    rdfs:label "has quoted exchange rate" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/QuotedExchangeRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/isPremiumOn> a owl:ObjectProperty ;
    rdfs:label "is premium on" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/CurrencyForwardRate> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/IND/ForeignExchange/ForeignExchange/QuotedExchangeRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/DailyAverageMarketRate> a owl:Class ;
    rdfs:label "daily average market rate" ;
    rdfs:comment "overall level of a given rate, calculated as the sum of some selected observed values of the rates for a particular reference rate, foreign exchange rate, lending rate, or other market rate divided by the number of samples collected over the course of a twenty-four (24) hour period for a specific date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/MarketRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/EndOfDayMarketRate> a owl:Class ;
    rdfs:label "end-of-day market rate" ;
    rdfs:comment "value of a given market rate of the end of the business day for a specific date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/MarketRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/HistoricalPriceVolatility> a owl:Class ;
    rdfs:label "historical price volatility" ;
    rdfs:comment "historical volatility measure of past trading ranges of prices of underlying securities and indexes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/HistoricalVolatility> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/ImpliedPriceVolatility> a owl:Class ;
    rdfs:label "implied price volatility" ;
    rdfs:comment "measure of volatility that represents the expected fluctuations of an underlying stock or index over a specific time frame" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/PriceVolatility> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/ImpliedVolatility> a owl:Class ;
    rdfs:label "implied volatility" ;
    rdfs:comment "measure of volatility that is a forward-looking metric used to calculate probability" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/Volatility> ;
    skos:altLabel "projected volatility" .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/MarketSpread> a owl:Class ;
    rdfs:label "market spread" ;
    rdfs:comment "statistical measure providing the difference (or spread) between two market rates" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Utilities/Analytics/ScopedMeasure> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/PriceStructure> a owl:Class ;
    rdfs:label "price structure" ;
    rdfs:comment "structured collection of prices, such as market prices for some index or security, such that volatility or other analyses may be performed over the structure" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedStructuredCollection> ;
    skos:altLabel "price history" .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/QuotedPrice> a owl:Class ;
    rdfs:label "quoted price" ;
    rdfs:comment "a monetary price quoted by some publisher on a given date" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/TermStructure> a owl:Class ;
    rdfs:label "term structure" ;
    rdfs:comment "structured collection of rates, such as interest rates, or bond yields with different terms to maturity, such that a yield curve may be constructed for the structure" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/DatedStructuredCollection> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/hasQuotationDate> a owl:ObjectProperty ;
    rdfs:label "has quotation date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/hasQuotationDateTime> a owl:DatatypeProperty ;
    rdfs:label "has quotation date and time" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/isVolatilityOf> a owl:ObjectProperty ;
    rdfs:label "is volatility of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/IND/Indicators/Indicators/Volatility> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/BaseRate> a owl:Class ;
    rdfs:label "base rate" ;
    rdfs:comment "basic rate of interest on which the actual rate a bank charges on loans to its customers is calculated" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/ReferenceInterestRate> ;
    skos:altLabel "BBR",
        "bank base rate" .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterbankBidRate> a owl:Class ;
    rdfs:label "interbank bid rate" ;
    rdfs:comment "interbank rate that is the interest rate at which participating banks are willing to borrow deposits from other banks" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterbankRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterbankMidRate> a owl:Class ;
    rdfs:label "interbank mid rate" ;
    rdfs:comment "interbank rate that represents the mid-point between bid and offer rates" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterbankRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterbankOfferedRate> a owl:Class ;
    rdfs:label "interbank offered rate" ;
    rdfs:comment "interbank rate that is the interest rate at which participating banks lend money" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterbankRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterestRateAuthority> a owl:Class ;
    rdfs:label "interest rate authority" ;
    rdfs:comment "financial service provider/publisher responsible for specifying some benchmark interest rate" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/Publisher> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterestRateBenchmarkClassificationScheme> a owl:Class ;
    rdfs:label "interest rate benchmark classification scheme" ;
    rdfs:comment "scheme for classifying interest rate benchmarks, such as the FpML classification scheme" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/ClassificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/OvernightRate> a owl:Class ;
    rdfs:label "overnight rate" ;
    rdfs:comment "reference rate that is an interest rate at which a depository institution lends funds to another depository institution (short-term), or the interest rate the central bank charges a financial institution to borrow money overnight" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/ReferenceInterestRate> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/SpecificProviderInterestRateBenchmark> a owl:Class ;
    rdfs:label "specific-provider interest rate benchmark" ;
    rdfs:comment "interest rate benchmark that is made available by a specific market data provider for reference purposes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/InterestRateBenchmark> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/hasRateResetTimeOfDay> a owl:ObjectProperty ;
    rdfs:label "has rate reset time of day" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/DateTime> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/hasReferenceCurrency> a owl:ObjectProperty ;
    rdfs:label "has reference currency" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/IND/InterestRates/InterestRates/hasTenor> a owl:ObjectProperty ;
    rdfs:label "has tenor" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Duration> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/> a owl:Ontology ;
    rdfs:label "FIBO" ;
    owl:versionInfo "1" .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/ClosedEndCredit> a owl:Class ;
    rdfs:label "closed-end credit" ;
    rdfs:comment "credit agreement in which the loan principal cannot be increased after funds are dispersed in full when the loan closes" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/CollateralizedLoan> a owl:Class ;
    rdfs:label "collateralized loan" ;
    rdfs:comment "secured loan that is secured with cash or other acceptable collateral (real property, securities or other assets) provided by the borrower as specified in the collateral agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/SecuredLoan> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Comaker> a owl:Class ;
    rdfs:label "co-maker" ;
    rdfs:comment "party that signs a borrower's promissory note, providing additional security and potentially improving the quality of the debt" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractThirdParty> ;
    skos:altLabel "comaker",
        "cosigner" .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/CombinedLoanToValueRatio> a owl:Class ;
    rdfs:label "combined loan-to-value ratio" ;
    rdfs:comment "ratio of the total amount of debt that is secured by the asset(s) and the appraised value of the asset(s) securing the financing" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/PercentageMonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/GuaranteedLoan> a owl:Class ;
    rdfs:label "guaranteed loan" ;
    rdfs:comment "loan that is secured with respect to repayment of principal and interest by guaranty" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/SecuredLoan> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/LenderLienPosition> a owl:Class ;
    rdfs:label "lender lien position" ;
    rdfs:comment "classifier indicating whether the lender has the primary lien position with respect to an asset used as collateral for the loan" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Classifiers/Classifier> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/LoanPaymentSchedule> a owl:Class ;
    rdfs:label "loan payment schedule" ;
    rdfs:comment "regular or explicit (ad hoc) payment schedule associated with a given loan-specific account" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/PaymentSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/LoanSpecificCustomerAccount> a owl:Class ;
    rdfs:label "loan-specific customer account" ;
    rdfs:comment "account held by the borrower associated with a specific loan" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/CustomerAccount> .

