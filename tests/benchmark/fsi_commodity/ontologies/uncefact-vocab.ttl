unece:idScheme a owl:ObjectProperty ;
    rdfs:label "ID scheme"@en ;
    rdfs:isDefinedBy unece-mod:core ;
    skos:closeMatch schema:propertyID ;
    skos:definition "The scheme under which this identifier is registered."@en ;
