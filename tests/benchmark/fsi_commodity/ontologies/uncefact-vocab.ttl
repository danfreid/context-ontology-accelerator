    schema:domainIncludes unece:Standard ;
    schema:rangeIncludes unece:Party ;
    unece:termStatus ts:proposed .

unece:issuingSoftware a owl:ObjectProperty ;
    rdfs:label "issuing software"@en ;
    dcterms:provenance "Proposed Vocab addition — not from BSP/UNTP; pending governance approval."@en ;
    rdfs:comment "Distinct from the issuer: the issuer is the party that takes responsibility for the content, the issuing software is what produced it."@en ;
