    skos:altLabel "price materiality" .

<https://cdm.finos.org/model/cdm.product.template.CalculationSchedule> a owl:Class ;
    rdfs:label "CalculationSchedule" ;
    rdfs:comment "A class that allows the full representation of a payout by defining a set of schedule periods. It supports standard schedule customization by expressing all the dates, quantities, and pricing data in a non-parametric way." ;
    skos:altLabel "calculation schedule" .

<https://cdm.finos.org/model/cdm.product.template.DividendTerms> a owl:Class ;
    rdfs:label "DividendTerms" ;
    rdfs:comment "Information related to dividends and payments." ;
    skos:altLabel "dividend terms" .

<https://cdm.finos.org/model/cdm.product.template.MandatoryEarlyTerminationAdjustedDates> a owl:Class ;
    rdfs:label "MandatoryEarlyTerminationAdjustedDates" ;
    rdfs:comment "A data defining:  the adjusted dates associated with a mandatory early termination provision." ;
    skos:altLabel "mandatory early termination adjusted dates" .

<https://cdm.finos.org/model/cdm.product.template.Product> a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "Enables either a TransferableProduct or a NonTransferableProduct to be used in an underlier." ;
    skos:altLabel "product" .

<https://cdm.finos.org/model/cdm.product.template.Quanto> a owl:Class ;
    rdfs:label "Quanto" ;
    rdfs:comment "Determines the currency rate that the seller of the equity amounts will apply at each valuation date for converting the respective amounts into a currency that is different from the currency denomination of the underlier." ;
    skos:altLabel "quanto" .

<https://cdm.finos.org/model/cdm.product.template.TradeLot> a owl:Class ;
    rdfs:label "TradeLot" ;
    rdfs:comment "Specifies the price and quantity of a trade lot, where the same product could be traded multiple times with the same counterparty but in different lots (at a different date, in a different quantity and at a different price). One trade lot combined with a product definition specifies the entire economics of a trade. The lifecycle mechanics of each such trade lot (e.g. cashflow payments) is independent of the other lots." ;
    skos:altLabel "trade lot" .

<https://cdm.finos.org/model/cdm.product.template.TransferableProduct> a owl:Class ;
    rdfs:label "TransferableProduct" ;
    rdfs:comment "A TransferableProduct is a type of financial product which can be held or transferred, represented as an Asset with the addition of specific EconomicTerms." ;
    skos:altLabel "transferable product" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.BuyerSeller> a owl:Class ;
    rdfs:label "BuyerSeller" ;
    rdfs:comment "This class corresponds to the FpML BuyerSeller.model construct." ;
    skos:altLabel "buyer seller" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.TelephoneNumber> a owl:Class ;
    rdfs:label "TelephoneNumber" ;
    rdfs:comment "A class to specify a telephone number as a type of phone number (e.g. work, personal, ...) alongside with the actual number." ;
    skos:altLabel "telephone number" .

<https://cdm.finos.org/model/cdm.event.common.ClosedState> a owl:Class ;
    rdfs:label "ClosedState" ;
    rdfs:comment " A class to qualify the closed state of an execution or a contract through the combination or a state (e.g. terminated, novated) and a set of dates: activity date, effective date and, when relevant, last payment date." ;
    skos:altLabel "closed state" .

<https://cdm.finos.org/model/cdm.event.common.CounterpartyPositionState> a owl:Class ;
    rdfs:label "CounterpartyPositionState" ;
    rdfs:comment "Defines the fundamental financial information that can be changed by a Primitive Event and by extension any business or life-cycle event. Each PositionState specifies where a Position is in its life-cycle. PositionState is a root type and as such, can be created independently to any other CDM data type, but can also be used as part of the CDM Event Model." ;
    skos:altLabel "counterparty position state" .

<https://cdm.finos.org/model/cdm.event.common.ExecutionDetails> a owl:Class ;
    rdfs:label "ExecutionDetails" ;
    rdfs:comment "Defines specific attributes that relate to trade executions." ;
    skos:altLabel "execution details" .

<https://cdm.finos.org/model/cdm.event.common.Merger> a owl:Class ;
    rdfs:label "Merger" ;
    rdfs:comment "Defines the underlier for both the Purchaser Company and the Acquired Compagny involved in Merger corporate action, as well as th respective price observation for each." ;
    skos:altLabel "merger" .

<https://cdm.finos.org/model/cdm.event.common.ObservationEvent> a owl:Class ;
    rdfs:label "ObservationEvent" ;
    rdfs:comment "Specifies the necessary information to create any observation event." ;
    skos:altLabel "observation event" .

<https://cdm.finos.org/model/cdm.event.common.SpinOff> a owl:Class ;
    rdfs:label "SpinOff" ;
    rdfs:comment "Defines the underlier for both the Parent Company and the Child Compagny involved in Spin Off corporate action, as well as th respective price observation for each." ;
    skos:altLabel "spin off" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.AmendmentEffectiveDate> a owl:Class ;
    rdfs:label "AmendmentEffectiveDate" ;
    rdfs:comment "A class to specify the effective date of the Amendment to Termination Currency. This date can be specified as either an actual date, a specific date (e.g. the annex date) or as a custom provision." ;
    skos:altLabel "amendment effective date" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CSAMinimumTransferAmountVariableSet> a owl:Class ;
    rdfs:label "CSAMinimumTransferAmountVariableSet" ;
    rdfs:comment "Defines a combination of Rating Agency, Rating Value, amount and Currency code." ;
    skos:altLabel "csaminimum transfer amount variable set" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CalculationAndTimingLegacy> a owl:Class ;
    rdfs:label "CalculationAndTimingLegacy" ;
    rdfs:comment "Specification of the Calculation, Valuation and Timing terms specific to the Legacy (1994/95) Credit Support Annex." ;
    skos:altLabel "calculation and timing legacy" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CollateralAccessBreach> a owl:Class ;
    rdfs:label "CollateralAccessBreach" ;
    rdfs:comment "A class to specify Collateral Access Breach language." ;
    skos:altLabel "collateral access breach" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ControlAgreementElections> a owl:Class ;
    rdfs:label "ControlAgreementElections" ;
    rdfs:comment "A class to specify the Control Agreement election sby each party to the agreement." ;
    skos:altLabel "control agreement elections" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportAmount> a owl:Class ;
    rdfs:label "CreditSupportAmount" ;
    rdfs:comment "The total amount one counterparty must deliver to the other at any time: the combination of the Exposure to that party and the net Independent Amounts it must post, minus any agreed Threshold." ;
    skos:altLabel "credit support amount" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportObligationsBase> a owl:Class ;
    rdfs:label "CreditSupportObligationsBase" ;
    rdfs:comment "A logical container designed to hold a set of related data. In this case, designed to hold a set of clauses that are common amongst Legacy (1994/95), Variation Margin and Initial Margin Credit Support Documents in regards to Credit Support Obligations." ;
    skos:altLabel "credit support obligations base" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportProviderElection> a owl:Class ;
    rdfs:label "CreditSupportProviderElection" ;
    rdfs:comment "The party election of Credit Support Provider(s), if any." ;
    skos:altLabel "credit support provider election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CustodianEventEndDate> a owl:Class ;
    rdfs:label "CustodianEventEndDate" ;
    rdfs:comment "A class to specify the Custodian Event." ;
    skos:altLabel "custodian event end date" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ElectiveAmountElection> a owl:Class ;
    rdfs:label "ElectiveAmountElection" ;
    rdfs:comment "A class to specify the party elective amounts which can be used for the purpose of specifying elections such as the ISDA CSA Threshold and Minimum Transfer Amount." ;
    skos:altLabel "elective amount election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ExceptionEnum> a owl:Class ;
    rdfs:label "ExceptionEnum" ;
    rdfs:comment "Values to specify the normalized exceptions applicable to an Initial Margin CSA." ;
    skos:altLabel "exception enum" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.FxHaircutCurrency> a owl:Class ;
    rdfs:label "FxHaircutCurrency" ;
    rdfs:comment "A class to specify the reference currency for the purpose of specifying the FX Haircut relating to a posting obligation, as being either the Termination Currency or an FX Designated Currency." ;
