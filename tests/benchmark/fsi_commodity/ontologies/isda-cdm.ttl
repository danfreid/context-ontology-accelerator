<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SimmException> a owl:Class ;
    rdfs:label "SimmException" ;
    rdfs:comment "A class to specify the SIMM exception to the regulatory regime clause." ;
    skos:altLabel "simm exception" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SimmVersion> a owl:Class ;
    rdfs:label "SimmVersion" ;
    rdfs:comment "A class to specify the ISDA SIMM version that applies to the ISDA 2018 CSA for Initial Margin." ;
