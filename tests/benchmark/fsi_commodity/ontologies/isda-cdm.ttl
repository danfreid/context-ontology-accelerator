<https://cdm.finos.org/model/cdm.legaldocumentation.csa.InterestAdjustmentPeriodicity> a owl:Class ;
    rdfs:label "InterestAdjustmentPeriodicity" ;
    rdfs:comment "A class to specify the Interest Adjustment periodicity." ;
    skos:altLabel "interest adjustment periodicity" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.LegacyIndependentAmount> a owl:Class ;
    rdfs:label "LegacyIndependentAmount" ;
    rdfs:comment "Sets out the additional amount of collateral that is required to be delivered by that party irrespective of the mark-to-market exposure under the related Transactions. It may take the form of a fixed amount, or be determined using credit ratings." ;
    skos:altLabel "legacy independent amount" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.MarginApproach> a owl:Class ;
    rdfs:label "MarginApproach" ;
    rdfs:comment "A class for selection of Margin Approach." ;
    skos:altLabel "margin approach" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RatingAgencyAmount> a owl:Class ;
    rdfs:label "RatingAgencyAmount" ;
    rdfs:comment "A logical container to hold a defined set of related data. In this case the collation of Rating Information and an associated Independent Amount." ;
    skos:altLabel "rating agency amount" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RatingMultiplier> a owl:Class ;
    rdfs:label "RatingMultiplier" ;
    rdfs:comment "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier." ;
    skos:altLabel "rating multiplier" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RetrospectiveEffect> a owl:Class ;
    rdfs:label "RetrospectiveEffect" ;
    rdfs:comment "A class to specify the retrospective effect exception to the regulatory regime clause of Initial Margin documents as either a normalized value specified as part of an enumeration or a customized value specified of type string." ;
    skos:altLabel "retrospective effect" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SecuredPartyRightsEventElection> a owl:Class ;
    rdfs:label "SecuredPartyRightsEventElection" ;
    rdfs:comment "A class to specify party specific Secured Party Rights Event language." ;
    skos:altLabel "secured party rights event election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SecurityProviderRightsEventElection> a owl:Class ;
    rdfs:label "SecurityProviderRightsEventElection" ;
    rdfs:comment "A class to specify party specific Secured Party Rights Event language." ;
    skos:altLabel "security provider rights event election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SensitivityMethodologies> a owl:Class ;
    rdfs:label "SensitivityMethodologies" ;
    rdfs:comment "A class to specificy methodologies to compute sensitivities specific to the agreement." ;
    skos:altLabel "sensitivity methodologies" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SinglePostingParty> a owl:Class ;
    rdfs:label "SinglePostingParty" ;
    rdfs:comment "Where only a single  party is explicitly designated to post collateral, the party which is specified as the sole poster of collateral." ;
    skos:altLabel "single posting party" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SubstitutedRegimeTerms> a owl:Class ;
    rdfs:label "SubstitutedRegimeTerms" ;
    rdfs:comment "Specifies the applicability of the Substituted Regime as denoted in the Substituted Regime Table as part of certain legal agreements, such as such as the ISDA 2016 and 2018 CSA for Initial Margin." ;
    skos:altLabel "substituted regime terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.AutomaticEarlyTerminationElection> a owl:Class ;
    rdfs:label "AutomaticEarlyTerminationElection" ;
    rdfs:comment "A class to specify the party elections specific to the Automatic Early Termination Clause." ;
    skos:altLabel "automatic early termination election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.PartyTerminationCurrencySelection> a owl:Class ;
    rdfs:label "PartyTerminationCurrencySelection" ;
    rdfs:comment "Specifies the termination currency to be used by a party when it is the Non-Defaulting Party or the Party which is not the Affected Party." ;
    skos:altLabel "party termination currency selection" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.SpecifiedEntities> a owl:Class ;
    rdfs:label "SpecifiedEntities" ;
    rdfs:comment "A provision that allows each party to specify its Specified Entities for certain Events of Default and Termination Events." ;
    skos:altLabel "specified entities" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.TerminationCurrency> a owl:Class ;
    rdfs:label "TerminationCurrency" ;
    rdfs:comment "Specifies how the Termination Currency for the agreement will be determined." ;
    skos:altLabel "termination currency" .

<https://cdm.finos.org/model/cdm.product.template.AssetLeg> a owl:Class ;
    rdfs:label "AssetLeg" ;
    rdfs:comment "Defines each asset movement of an asset payout." ;
    skos:altLabel "asset leg" .

<https://cdm.finos.org/model/cdm.product.template.AutomaticExercise> a owl:Class ;
    rdfs:label "AutomaticExercise" ;
    rdfs:comment "A type to define automatic exercise of a swaption. With automatic exercise the option is deemed to have exercised if it is in the money by more than the threshold amount on the exercise date." ;
    skos:altLabel "automatic exercise" .

<https://cdm.finos.org/model/cdm.product.template.AveragingStrikeFeature> a owl:Class ;
    rdfs:label "AveragingStrikeFeature" ;
    rdfs:comment "Defines the terms required to calculate the average observations associated with an averaging strike." ;
    skos:altLabel "averaging strike feature" .

<https://cdm.finos.org/model/cdm.product.template.Barrier> a owl:Class ;
    rdfs:label "Barrier" ;
    rdfs:comment "As per ISDA 2002 Definitions." ;
    skos:altLabel "barrier" .

<https://cdm.finos.org/model/cdm.product.template.CancellationEvent> a owl:Class ;
    rdfs:label "CancellationEvent" ;
    rdfs:comment "The adjusted dates for a specific cancellation date, including the adjusted exercise date and adjusted termination date." ;
    skos:altLabel "cancellation event" .

<https://cdm.finos.org/model/cdm.product.template.ExercisePeriod> a owl:Class ;
    rdfs:label "ExercisePeriod" ;
    rdfs:comment "This defines the time interval to the start of the exercise period, i.e. the earliest exercise date, and the frequency of subsequent exercise dates (if any)." ;
    skos:altLabel "exercise period" .

<https://cdm.finos.org/model/cdm.product.template.ExtensionEvent> a owl:Class ;
    rdfs:label "ExtensionEvent" ;
    rdfs:comment "A data to:  define the adjusted dates associated with an individual extension event." ;
    skos:altLabel "extension event" .

<https://cdm.finos.org/model/cdm.product.template.ManualExercise> a owl:Class ;
    rdfs:label "ManualExercise" ;
    rdfs:comment "A class defining manual exercise, i.e. that the option buyer counterparty must give notice to the option seller of exercise." ;
    skos:altLabel "manual exercise" .

<https://cdm.finos.org/model/cdm.product.template.PassThroughItem> a owl:Class ;
    rdfs:label "PassThroughItem" ;
    rdfs:comment "Class to represent a single pass through payment." ;
    skos:altLabel "pass through item" .

<https://cdm.finos.org/model/cdm.product.template.StrategyFeature> a owl:Class ;
    rdfs:label "StrategyFeature" ;
    rdfs:comment "A class for defining option strategy features." ;
    skos:altLabel "strategy feature" .

<https://cdm.finos.org/model/cdm.product.template.Strike> a owl:Class ;
    rdfs:label "Strike" ;
    rdfs:comment "A class describing a single cap or floor rate." ;
    skos:altLabel "strike" .

<https://cdm.finos.org/model/cdm.product.template.StrikeSchedule> a owl:Class ;
    rdfs:label "StrikeSchedule" ;
    rdfs:comment "A class describing a schedule of cap or floor rates." ;
    skos:altLabel "strike schedule" .

<https://cdm.finos.org/model/cdm.product.template.StrikeSpread> a owl:Class ;
    rdfs:label "StrikeSpread" ;
    rdfs:comment "A class for defining a strike spread feature." ;
    skos:altLabel "strike spread" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.AncillaryRoleEnum> a owl:Class ;
    rdfs:label "AncillaryRoleEnum" ;
    rdfs:comment "Defines the enumerated values to specify the ancillary roles to the transaction. The product is agnostic to the actual parties involved in the transaction, with the party references abstracted away from the product definition and replaced by the AncillaryRoleEnum. The AncillaryRoleEnum can then be positioned in the product and the AncillaryParty type, which is positioned outside of the product definition, allows the AncillaryRoleEnum to be associated with an actual party reference." ;
    skos:altLabel "ancillary role enum" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.BusinessUnit> a owl:Class ;
    rdfs:label "BusinessUnit" ;
    rdfs:comment "A class to specify an organizational unit." ;
    skos:altLabel "business unit" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.PartyRoleEnum> a owl:Class ;
    rdfs:label "PartyRoleEnum" ;
    rdfs:comment "The enumerated values for the party role. The enumerated values go beyond the FpML partyRoleScheme as they also include elements that are part of the FpML Trade, such as the Barrier Determination Agent and the Hedging Party." ;
    skos:altLabel "party role enum" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.PayerReceiverEnum> a owl:Class ;
    rdfs:label "PayerReceiverEnum" ;
    rdfs:comment "The enumerated values to specify an interest rate stream payer or receiver party." ;
    skos:altLabel "payer receiver enum" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.PersonIdentifier> a owl:Class ;
    rdfs:label "PersonIdentifier" ;
    rdfs:comment "Comprises an identifier and a source. The associated metadata key denotes the ability to associate a hash value to the PersonIdentifier instantiations for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage." ;
    skos:altLabel "person identifier" .

<https://cdm.finos.org/model/cdm.event.common.AccrualFactorCalculationTerms> a owl:Class ;
    rdfs:label "AccrualFactorCalculationTerms" ;
    rdfs:comment "Describes the input terms involved in the calculation of the accrual factor. Optionnally, long and short stub interpolation rates can be specified." ;
    skos:altLabel "accrual factor calculation terms" .

<https://cdm.finos.org/model/cdm.event.common.AgreementEventInstruction> a owl:Class ;
    rdfs:label "AgreementEventInstruction" ;
    rdfs:comment "Specifies the date of the event and the effective date of the event." ;
    skos:altLabel "agreement event instruction" .

<https://cdm.finos.org/model/cdm.event.common.AgreementInstruction> a owl:Class ;
    rdfs:label "AgreementInstruction" ;
    rdfs:comment "Instruction to a function that will be used to perform an agreement event" ;
    skos:altLabel "agreement instruction" .

<https://cdm.finos.org/model/cdm.event.common.AgreementTermsChangeInstruction> a owl:Class ;
    rdfs:label "AgreementTermsChangeInstruction" ;
    rdfs:comment "A primitive instruction set that details all associated terms changes that are defined within the instruction." ;
    skos:altLabel "agreement terms change instruction" .

<https://cdm.finos.org/model/cdm.event.common.CorporateActionTypeEnum> a owl:Class ;
    rdfs:label "CorporateActionTypeEnum" ;
    rdfs:comment "The enumerated values to specify the origin of a corporate action transfer." ;
    skos:altLabel "corporate action type enum" .

<https://cdm.finos.org/model/cdm.event.common.IndexTransitionInstruction> a owl:Class ;
    rdfs:label "IndexTransitionInstruction" ;
    rdfs:comment "Defines the information needed to create a Index Transition Business Event." ;
    skos:altLabel "index transition instruction" .

<https://cdm.finos.org/model/cdm.event.common.PositionIdentifier> a owl:Class ;
    rdfs:label "PositionIdentifier" ;
    rdfs:comment "Defines a position identifier as a special case of the generic identifier type, that also includes the position identifier class." ;
    skos:altLabel "position identifier" .

<https://cdm.finos.org/model/cdm.event.common.QuantityChangeInstruction> a owl:Class ;
    rdfs:label "QuantityChangeInstruction" ;
    rdfs:comment "Instructions required to create a Quantity Change Primitive Event, which can be either an increase, a decrease or a replacement. An increase adds a new trade lot to the original trade, whereas a decrease subtracts from an existing trade lot's quantity. A replacement updates the quantity of an existing trade lot to the new value." ;
    skos:altLabel "quantity change instruction" .

<https://cdm.finos.org/model/cdm.event.common.RegIMRoleEnum> a owl:Class ;
    rdfs:label "RegIMRoleEnum" ;
    rdfs:comment "Represents the enumeration values to specify the role of the party in relation to a regulatory initial margin call." ;
    skos:altLabel "reg imrole enum" .

<https://cdm.finos.org/model/cdm.event.common.RegMarginTypeEnum> a owl:Class ;
    rdfs:label "RegMarginTypeEnum" ;
    rdfs:comment "Represents the enumeration values to specify the margin type in relation to bilateral or regulatory obligation." ;
    skos:altLabel "reg margin type enum" .

<https://cdm.finos.org/model/cdm.event.common.State> a owl:Class ;
    rdfs:label "State" ;
    rdfs:comment "Defines the state of a trade at a point in the Trade's life cycle. Trades have many state dimensions, all of which are represented here. For example, states useful for position keeping are represented alongside those needed for regulatory reporting." ;
    skos:altLabel "state" .

<https://cdm.finos.org/model/cdm.event.common.TermsChangeInstruction> a owl:Class ;
    rdfs:label "TermsChangeInstruction" ;
    rdfs:comment "Specifies instructions for terms change consisting of the new transaction terms, and the renegotiation fee." ;
    skos:altLabel "terms change instruction" .

<https://cdm.finos.org/model/cdm.event.common.TransferState> a owl:Class ;
    rdfs:label "TransferState" ;
    rdfs:comment "Defines the fundamental financial information associated with a Transfer event. Each TransferState specifies where a Transfer is in its life-cycle. TransferState is a root type and as such, can be created independently to any other CDM data type, but can also be used as part of the CDM Event Model." ;
    skos:altLabel "transfer state" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.AgreementTerms> a owl:Class ;
    rdfs:label "AgreementTerms" ;
    rdfs:comment "Specification of the content of a legal agreement." ;
    skos:altLabel "agreement terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.NoticeInformationElection> a owl:Class ;
    rdfs:label "NoticeInformationElection" ;
    rdfs:comment "Specifies the party reference and the associated notice and contact information." ;
    skos:altLabel "notice information election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.OtherAgreement> a owl:Class ;
    rdfs:label "OtherAgreement" ;
    rdfs:comment "A class for defining an agreement executed between parties." ;
    skos:altLabel "other agreement" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.OtherAgreementTerms> a owl:Class ;
    rdfs:label "OtherAgreementTerms" ;
    rdfs:comment "A class to specify a related legal agreement. For example, ISDA 2016 Credit Support Annex for Initial Margin, paragraph 13, General Principles, (s): Other CSA and Japanese Law CSA (VM). | ISDA 2016 Credit Support Annex for Variation Margin, paragraph 13, (o): Other CSA." ;
    skos:altLabel "other agreement terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.UmbrellaAgreementSet> a owl:Class ;
    rdfs:label "UmbrellaAgreementSet" ;
    rdfs:comment "Represents the groups of agreement term elections that exist within the agreement and to which entities that particular group of elections apply. Where all entities under the umbrella have the same set of elections only one agreement set will exist. At least one agreement set must be defined for an Umbrella agreement" ;
    skos:altLabel "umbrella agreement set" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.AdditionalRepresentationElection> a owl:Class ;
    rdfs:label "AdditionalRepresentationElection" ;
    rdfs:comment "A class to specify the parties' Additional Representation(s) election." ;
    skos:altLabel "additional representation election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.AddressesForTransfer> a owl:Class ;
    rdfs:label "AddressesForTransfer" ;
    rdfs:comment "Specifies the address for transfer as specified by the respective parties to the agreement." ;
    skos:altLabel "addresses for transfer" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.AppropriatedCollateralValuation> a owl:Class ;
    rdfs:label "AppropriatedCollateralValuation" ;
    rdfs:comment "A class to specify the Valuation of Appropriated Collateral." ;
    skos:altLabel "appropriated collateral valuation" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.BespokeCalculationDate> a owl:Class ;
    rdfs:label "BespokeCalculationDate" ;
    rdfs:comment "A class to specify bespoke Calculation Date terms for the purposes of Initial Margin." ;
    skos:altLabel "bespoke calculation date" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.BespokeCalculationTime> a owl:Class ;
    rdfs:label "BespokeCalculationTime" ;
    rdfs:comment "A class to specify additional Calculation Time terms for the purposes of Initial Margin." ;
    skos:altLabel "bespoke calculation time" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CSAThresholdVariableSet> a owl:Class ;
    rdfs:label "CSAThresholdVariableSet" ;
    rdfs:comment "Defines a combination of Rating Agency, Rating Value, Threshold amount and Currency code." ;
    skos:altLabel "csathreshold variable set" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CalculationAgentTerms> a owl:Class ;
    rdfs:label "CalculationAgentTerms" ;
    rdfs:comment "Details of the party calculating the value of collateral to be delivered or returned." ;
    skos:altLabel "calculation agent terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CalculationCurrencyElection> a owl:Class ;
    rdfs:label "CalculationCurrencyElection" ;
    rdfs:comment "A class to specify the ISDA SIMM Calculation Currency." ;
    skos:altLabel "calculation currency election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CollateralValueMethod> a owl:Class ;
    rdfs:label "CollateralValueMethod" ;
    rdfs:comment "Details how particular types of collateral are valued (other than in respect of a default)." ;
    skos:altLabel "collateral value method" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportAgreementElections> a owl:Class ;
    rdfs:label "CreditSupportAgreementElections" ;
    rdfs:comment "The set of elections which specify a Credit Support Annex or Deed." ;
    skos:altLabel "credit support agreement elections" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CustodianRiskElection> a owl:Class ;
    rdfs:label "CustodianRiskElection" ;
    rdfs:comment "A class to specify the Custodian Risk." ;
    skos:altLabel "custodian risk election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ExcludedProducts> a owl:Class ;
    rdfs:label "ExcludedProducts" ;
    rdfs:comment "Description of the relevant derivative transactions excluded from the calculation of exposure." ;
    skos:altLabel "excluded products" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ExecutionLanguage> a owl:Class ;
    rdfs:label "ExecutionLanguage" ;
    rdfs:comment "A class to specify execution language terms of a Security Agreement." ;
    skos:altLabel "execution language" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.FrenchLawAddendumElection> a owl:Class ;
    rdfs:label "FrenchLawAddendumElection" ;
    rdfs:comment "A class to specify party specific French Law Addendum language." ;
    skos:altLabel "french law addendum election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.GeneralSimmElections> a owl:Class ;
    rdfs:label "GeneralSimmElections" ;
    rdfs:comment "A class to specify the ISDA SIMM as the Method for all Covered Transactions with respect to all Regimes." ;
    skos:altLabel "general simm elections" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.HoldingAndUsingPostedCollateralElection> a owl:Class ;
    rdfs:label "HoldingAndUsingPostedCollateralElection" ;
    rdfs:comment "Specifies the parties' elections related to the holding and using of posted collateral." ;
    skos:altLabel "holding and using posted collateral election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.IneligibleCreditSupport> a owl:Class ;
    rdfs:label "IneligibleCreditSupport" ;
    rdfs:comment "Identifies collateral that has been designated as not meeting the eligibility criteria set out in the agreement." ;
    skos:altLabel "ineligible credit support" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.LegacyResolutionAlternative> a owl:Class ;
    rdfs:label "LegacyResolutionAlternative" ;
    rdfs:comment "Alternative procedures to those in the pre-print for resolving collateral related disputes." ;
    skos:altLabel "legacy resolution alternative" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.OneWayProvisions> a owl:Class ;
    rdfs:label "OneWayProvisions" ;
    rdfs:comment "A class to specify whether One Way Provisions apply." ;
    skos:altLabel "one way provisions" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.PostingObligations> a owl:Class ;
    rdfs:label "PostingObligations" ;
    rdfs:comment "A class to specify the collateral posting obligations of the security provider or security providers as specified in the corresponding agreement." ;
    skos:altLabel "posting obligations" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ProcessAgent> a owl:Class ;
    rdfs:label "ProcessAgent" ;
    rdfs:comment "Specifies the Process Agent that might be appointed by the parties as part of a Credit Support Annex/Deed or Collateral Transfer Agreement." ;
    skos:altLabel "process agent" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RecalculationOfValueElection> a owl:Class ;
    rdfs:label "RecalculationOfValueElection" ;
    rdfs:comment "A class to specify Recalculation of Value terms that will be applicable." ;
    skos:altLabel "recalculation of value election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.Regime> a owl:Class ;
    rdfs:label "Regime" ;
    rdfs:comment "A class to specify one or more regimes that may be specified as relevant to a legal agreement." ;
    skos:altLabel "regime" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SecuredPartyRightsEvent> a owl:Class ;
    rdfs:label "SecuredPartyRightsEvent" ;
    rdfs:comment "A class to specify Secured Party Rights Event language." ;
    skos:altLabel "secured party rights event" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SensitivityMethodologiesPartyElection> a owl:Class ;
    rdfs:label "SensitivityMethodologiesPartyElection" ;
    rdfs:comment "A class to specificy methodologies to compute sensitivities specific to the agreement." ;
    skos:altLabel "sensitivity methodologies party election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SensitivityToEquity> a owl:Class ;
    rdfs:label "SensitivityToEquity" ;
    rdfs:comment "Represents risk sensitivity calculated with respect to the value of an individual equity instrument." ;
