    skos:altLabel "valuation calculation date location" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ValuationCalculationDateLocationElection> a owl:Class ;
    rdfs:label "ValuationCalculationDateLocationElection" ;
