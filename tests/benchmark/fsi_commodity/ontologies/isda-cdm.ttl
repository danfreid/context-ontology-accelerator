    skos:altLabel "sensitivity methodology" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.Substitution> a owl:Class ;
    rdfs:label "Substitution" ;
    rdfs:comment "A class to specify the conditions under which the Security Provider can substitute posted collateral. The details required for 'Legacy' agreements are substantially different to those required for newer agreements; where the agreement is a 1994 or 1995 CSA, or 1995 CSD, the legacyConsent attribute needs to be used which contains additional values beyond a simple true/false value." ;
    skos:altLabel "substitution" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SubstitutionPartyElection> a owl:Class ;
    rdfs:label "SubstitutionPartyElection" ;
    rdfs:comment "Party specific elections for substitution of posted collateral." ;
    skos:altLabel "substitution party election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ThresholdElection> a owl:Class ;
    rdfs:label "ThresholdElection" ;
    rdfs:comment "Specifies whether the threshold is rating based, a fixed amount, or infinity." ;
    skos:altLabel "threshold election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.MasterAgreementClause> a owl:Class ;
    rdfs:label "MasterAgreementClause" ;
    rdfs:comment "Defines clauses that make up a Master Agreement." ;
    skos:altLabel "master agreement clause" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.MasterAgreementClauseVariant> a owl:Class ;
    rdfs:label "MasterAgreementClauseVariant" ;
    rdfs:comment "Sets the details for a specific variant associated to a clause in a Master Agreement." ;
    skos:altLabel "master agreement clause variant" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.SpecifiedEntity> a owl:Class ;
    rdfs:label "SpecifiedEntity" ;
    rdfs:comment "The party specific election of Specified Entities for the Event of Default or Termination Event specified." ;
    skos:altLabel "specified entity" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.EquitySwapMasterConfirmation2018> a owl:Class ;
    rdfs:label "EquitySwapMasterConfirmation2018" ;
    rdfs:comment "Specification for the General Terms and Relationship Supplement Elections as provided in the 2018 ISDA CDM Equity Confirmation for Security Equity Swap." ;
    skos:altLabel "equity swap master confirmation2018" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.DeterminationRolesAndTerms> a owl:Class ;
    rdfs:label "DeterminationRolesAndTerms" ;
    rdfs:comment "Defines the roles and related terms which document the agreement of parties about any determination requirements ; mostly about Extraordinary Events, without being necessarily restricted to such scope, as further specified in the particular product at stake e.g. for instance when Calculation Agent is mentioned as the Price Determination Method enumarated value, etc." ;
    skos:altLabel "determination roles and terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.FxSubstitutionProvisionTypeEnum> a owl:Class ;
    rdfs:label "FxSubstitutionProvisionTypeEnum" ;
    skos:altLabel "fx substitution provision type enum" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.GeneralInconvertibility> a owl:Class ;
    rdfs:label "GeneralInconvertibility" ;
    skos:altLabel "general inconvertibility" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.GeneralNonTransferability> a owl:Class ;
    rdfs:label "GeneralNonTransferability" ;
    skos:altLabel "general non transferability" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.GovernmentalAuthorityDefault> a owl:Class ;
    rdfs:label "GovernmentalAuthorityDefault" ;
    skos:altLabel "governmental authority default" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.Illiquidity> a owl:Class ;
    rdfs:label "Illiquidity" ;
    skos:altLabel "illiquidity" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.Nationalization> a owl:Class ;
    rdfs:label "Nationalization" ;
    skos:altLabel "nationalization" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.Representations> a owl:Class ;
    rdfs:label "Representations" ;
    skos:altLabel "representations" .

<https://cdm.finos.org/model/cdm.product.template.AveragingFeature> a owl:Class ;
    rdfs:label "AveragingFeature" ;
    rdfs:comment "As per ISDA 2002 Definitions." ;
    skos:altLabel "averaging feature" .

<https://cdm.finos.org/model/cdm.product.template.Composite> a owl:Class ;
    rdfs:label "Composite" ;
    rdfs:comment "Specifies the conditions to be applied for converting into a reference currency when the actual currency rate is not determined upfront." ;
    skos:altLabel "composite" .

<https://cdm.finos.org/model/cdm.product.template.EarlyTerminationEvent> a owl:Class ;
    rdfs:label "EarlyTerminationEvent" ;
    rdfs:comment "A data to:  define the adjusted dates associated with an early termination provision." ;
    skos:altLabel "early termination event" .

<https://cdm.finos.org/model/cdm.product.template.ExerciseProcedure> a owl:Class ;
    rdfs:label "ExerciseProcedure" ;
    rdfs:comment "A class describing how notice of exercise should be given. This can be either manual or automatic." ;
    skos:altLabel "exercise procedure" .

<https://cdm.finos.org/model/cdm.product.template.FxFeature> a owl:Class ;
    rdfs:label "FxFeature" ;
    rdfs:comment "A type for defining FX Features." ;
    skos:altLabel "fx feature" .

<https://cdm.finos.org/model/cdm.product.template.OptionFeature> a owl:Class ;
    rdfs:label "OptionFeature" ;
    rdfs:comment "Defines additional optional features that can be included in an option contract." ;
    skos:altLabel "option feature" .

<https://cdm.finos.org/model/cdm.product.template.OptionStrike> a owl:Class ;
    rdfs:label "OptionStrike" ;
    rdfs:comment "Defines the strike price of an option." ;
    skos:altLabel "option strike" .

<https://cdm.finos.org/model/cdm.product.template.ReturnTerms> a owl:Class ;
    rdfs:label "ReturnTerms" ;
    rdfs:comment "Specifies the type of return of a performance payout." ;
    skos:altLabel "return terms" .

<https://cdm.finos.org/model/cdm.product.template.TerminationProvision> a owl:Class ;
    rdfs:label "TerminationProvision" ;
    rdfs:comment "A class for defining option provisions." ;
    skos:altLabel "termination provision" .

<https://cdm.finos.org/model/cdm.product.template.Underlier> a owl:Class ;
    rdfs:label "Underlier" ;
    rdfs:comment "The underlying financial product that will be physically or cash settled, which can be of any type, eg an asset such as cash or a security, a product, or the cash settlement of an index rate.  Conditions are usually applied when used in a data type, such as a payout, to ensure this aligns with the use case." ;
    skos:altLabel "underlier" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.Counterparty> a owl:Class ;
    rdfs:label "Counterparty" ;
    rdfs:comment "Defines a counterparty enumerated value, e.g. Party1 or Party2, with an associated party reference. The product is agnostic to the actual parties to the transaction, with the party references abstracted away from the product definition and replaced by the CounterpartyEnum (e.g. values Party1 or Party2). The CounterpartyEnum can then be positioned in the product (e.g. to specify which counterparty is the payer, receiver etc) and this Counterparty type, which is positioned outside of the product definition, allows the CounterpartyEnum to be associated with an actual party reference." ;
    skos:altLabel "counterparty" .

<https://cdm.finos.org/model/cdm.event.common.ClearingInstruction> a owl:Class ;
    rdfs:label "ClearingInstruction" ;
    rdfs:comment "All information required to perform the clear life cycle event; the clearing party (CCP), the two parties facing each other on the alpha contract, and optionally the parties acting as clearing members." ;
    skos:altLabel "clearing instruction" .

<https://cdm.finos.org/model/cdm.event.common.Exposure> a owl:Class ;
    rdfs:label "Exposure" ;
    rdfs:comment "Represents the current mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency)." ;
    skos:altLabel "exposure" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.LegalAgreementBase> a owl:Class ;
    rdfs:label "LegalAgreementBase" ;
    rdfs:comment "Specifies the legal agreement baseline information, being negotiated or having been executed. It excludes specialized elections" ;
    skos:altLabel "legal agreement base" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.LegalAgreementIdentification> a owl:Class ;
    rdfs:label "LegalAgreementIdentification" ;
    rdfs:comment "Specifies the type of legal agreement, identified via a set of composable attributes: agreementName, publisher, governing law and version, e.g. ISDA 2013 Standard Credit Support Annex English Law." ;
    skos:altLabel "legal agreement identification" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.TransferContactInformation> a owl:Class ;
    rdfs:label "TransferContactInformation" ;
    rdfs:comment "Specifies transfer information including address and, optionally, an associated account. This type also supports the ISDA CSA representation as a single string, through the address attribute in Contact Information." ;
    skos:altLabel "transfer contact information" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.AdditionalRepresentations> a owl:Class ;
    rdfs:label "AdditionalRepresentations" ;
    rdfs:comment "A class to specify Additional Representations that may be applicable to an agreement." ;
    skos:altLabel "additional representations" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.BespokeTransferTiming> a owl:Class ;
    rdfs:label "BespokeTransferTiming" ;
    rdfs:comment "A class to specify any bespoke Transfer Timing language by each party to the agreement." ;
    skos:altLabel "bespoke transfer timing" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CSADeliveryAmount> a owl:Class ;
    rdfs:label "CSADeliveryAmount" ;
    rdfs:comment "In respect of a Valuation Date, the amount of collateral which a party is entitled to demand to be transferred to it as a Delivery Amount." ;
    skos:altLabel "csadelivery amount" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CSAValuationDate> a owl:Class ;
    rdfs:label "CSAValuationDate" ;
    rdfs:comment "Specifies the date on which the value of collateral or exposure are calculated in accordance with the agreement." ;
    skos:altLabel "csavaluation date" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CollateralTransferTiming> a owl:Class ;
    rdfs:label "CollateralTransferTiming" ;
    rdfs:comment "Specification of transfer / settlement timing for cash and securities collateral assuming that the notice is provided before the Notification Time (and with a 1LBD lag introduced if the notice is delivered after the Notification Time), and that securities allow for a further Local Business Day for transfer / settlement." ;
    skos:altLabel "collateral transfer timing" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CoveredTransactions> a owl:Class ;
    rdfs:label "CoveredTransactions" ;
    rdfs:comment "Specification of Transactions covered by the legal agreement." ;
    skos:altLabel "covered transactions" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.EligibilityToHoldCollateralCriteria> a owl:Class ;
    rdfs:label "EligibilityToHoldCollateralCriteria" ;
    rdfs:comment "Defines a set of Criteria required by the party and its custodian to hold the other party's Posted Collateral." ;
    skos:altLabel "eligibility to hold collateral criteria" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.EligibleCollateralElection> a owl:Class ;
    rdfs:label "EligibleCollateralElection" ;
    rdfs:comment "Specifies the collateral posting obligations for the security provider party(ies)." ;
    skos:altLabel "eligible collateral election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ExecutionLocation> a owl:Class ;
    rdfs:label "ExecutionLocation" ;
    rdfs:comment "A class to specify execution location terms of a Security Agreement." ;
    skos:altLabel "execution location" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.FinalReturns> a owl:Class ;
    rdfs:label "FinalReturns" ;
    rdfs:comment "A clause providing that final return collateral is to be provided without consideration of any Minimum Transfer Amount and collateral haircut." ;
    skos:altLabel "final returns" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.JapaneseSecuritiesProvisions> a owl:Class ;
    rdfs:label "JapaneseSecuritiesProvisions" ;
    rdfs:comment "A class to specify Japanese Securities Provision elections." ;
    skos:altLabel "japanese securities provisions" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.OtherEligibleAndPostedSupport> a owl:Class ;
    rdfs:label "OtherEligibleAndPostedSupport" ;
    rdfs:comment "Specifies the Other Eligible Support elections." ;
    skos:altLabel "other eligible and posted support" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.PledgeeRepresentativeRider> a owl:Class ;
    rdfs:label "PledgeeRepresentativeRider" ;
    rdfs:comment "The terms of the Rider for the ISDA Euroclear 2019 Collateral Transfer Agreement with respect to the use of a Pledgee Representative attached to this Agreement." ;
    skos:altLabel "pledgee representative rider" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RightsEvents> a owl:Class ;
    rdfs:label "RightsEvents" ;
    rdfs:comment "A class to specify the rights of Security Taker and/or Security Provider when an Early Termination or Access Condition event has occurred." ;
    skos:altLabel "rights events" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.IsdaCalculationAgentElection> a owl:Class ;
    rdfs:label "IsdaCalculationAgentElection" ;
    rdfs:comment "An election to determine who the Calculation Agent is for various events in an ISDA Master Agreement." ;
    skos:altLabel "isda calculation agent election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.SubstituteCalculationAgentElection> a owl:Class ;
    rdfs:label "SubstituteCalculationAgentElection" ;
    rdfs:comment "An election to determine the characteristics around a subsitution Calculation Agent." ;
    skos:altLabel "substitute calculation agent election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isla.CollateralSpecification> a owl:Class ;
    rdfs:label "CollateralSpecification" ;
    rdfs:comment "The definitions regarding collateral relating to the GMSLA." ;
    skos:altLabel "collateral specification" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.TransactionAdditionalTerms> a owl:Class ;
    rdfs:label "TransactionAdditionalTerms" ;
    rdfs:comment "Additional specification for the extraordinary events that may affect a trade and the related contractual rights and obligation of the parties when this happens. Such terms are typically required to extend the economics terms, for the purpose of producing the final legal contractual form of the Transaction." ;
    skos:altLabel "transaction additional terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.SpecificNonTransferability> a owl:Class ;
    rdfs:label "SpecificNonTransferability" ;
    skos:altLabel "specific non transferability" .

<https://cdm.finos.org/model/cdm.product.template.EvergreenProvision> a owl:Class ;
    rdfs:label "EvergreenProvision" ;
    rdfs:comment "Specifies a transaction which automatically extends for a specified timeframe until the exercise of an embedded option." ;
    skos:altLabel "evergreen provision" .

<https://cdm.finos.org/model/cdm.product.template.ExerciseFee> a owl:Class ;
    rdfs:label "ExerciseFee" ;
    rdfs:comment "A class defining the fee payable on exercise of an option. This fee may be defined as an amount or a percentage of the notional exercised. As a difference with FpML, it extends the BuyerSeller class." ;
    skos:altLabel "exercise fee" .

<https://cdm.finos.org/model/cdm.product.template.ExerciseFeeSchedule> a owl:Class ;
    rdfs:label "ExerciseFeeSchedule" ;
    rdfs:comment "A class to define a fee or schedule of fees to be payable on the exercise of an option. This fee may be defined as an amount or a percentage of the notional exercised. As a difference with FpML, it extends the BuyerSeller class." ;
    skos:altLabel "exercise fee schedule" .

<https://cdm.finos.org/model/cdm.product.template.ExerciseNotice> a owl:Class ;
    rdfs:label "ExerciseNotice" ;
    rdfs:comment "Defines to whom and where notice of execution should be given. The exerciseNoticeGiver refers to one or both of the principal parties of the trade. If present the exerciseNoticeReceiver refers to a party, other than the principal party, to whom notice should be given." ;
    skos:altLabel "exercise notice" .

<https://cdm.finos.org/model/cdm.product.template.MultipleExercise> a owl:Class ;
    rdfs:label "MultipleExercise" ;
    rdfs:comment "A class defining multiple exercises. As defined in the 2000 ISDA Definitions, Section 12.4. Multiple Exercise, the buyer of the option has the right to exercise all or less than all the unexercised notional amount of the underlying swap on one or more days in the exercise period, but on any such day may not exercise less than the minimum notional amount or more than the maximum notional amount, and if an integral multiple amount is specified, the notional exercised must be equal to or, be an integral multiple of, the integral multiple amount. In FpML, MultipleExercise is built upon the PartialExercise.model." ;
    skos:altLabel "multiple exercise" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.Address> a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A class to specify a post or street address." ;
    skos:altLabel "address" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.AncillaryParty> a owl:Class ;
    rdfs:label "AncillaryParty" ;
    rdfs:comment "Defines an ancillary role enumerated value with an associated party reference. The product is agnostic to the actual parties involved in the transaction, with the party references abstracted away from the product definition and replaced by the AncillaryRoleEnum. The AncillaryRoleEnum can then be positioned in the product and this AncillaryParty type, which is positioned outside of the product definition, allows the AncillaryRoleEnum to be associated with an actual party reference." ;
    skos:altLabel "ancillary party" .

<https://cdm.finos.org/model/cdm.event.common.CollateralPortfolio> a owl:Class ;
    rdfs:label "CollateralPortfolio" ;
    rdfs:comment "Represents common attributes to define the details of collateral assets, to be used in margin call messaging and contribute to collateral balances e.g securities in a collateral account." ;
    skos:altLabel "collateral portfolio" .

<https://cdm.finos.org/model/cdm.event.common.CreditEvent> a owl:Class ;
    rdfs:label "CreditEvent" ;
    rdfs:comment "Specifies the relevant data regarding a credit event." ;
    skos:altLabel "credit event" .

<https://cdm.finos.org/model/cdm.event.common.Reset> a owl:Class ;
    rdfs:label "Reset" ;
    rdfs:comment "Defines the reset value or fixing value produced in cashflow calculations, during the life-cycle of a financial instrument. The reset process defined in Create_Reset function joins product definition details with observations to compute the reset value." ;
    skos:altLabel "reset" .

<https://cdm.finos.org/model/cdm.event.common.TradeIdentifier> a owl:Class ;
    rdfs:label "TradeIdentifier" ;
    rdfs:comment "Defines a trade identifier as a special case of the generic identifier type, that also includes the trade identifier class." ;
    skos:altLabel "trade identifier" .

<https://cdm.finos.org/model/cdm.event.common.Transfer> a owl:Class ;
    rdfs:label "Transfer" ;
    rdfs:comment "The type of transfer." ;
    skos:altLabel "transfer" .

<https://cdm.finos.org/model/cdm.event.common.UnscheduledTransfer> a owl:Class ;
    rdfs:label "UnscheduledTransfer" ;
    rdfs:comment "An ad-hoc transfer instigated by a party to the contract." ;
    skos:altLabel "unscheduled transfer" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.Agreement> a owl:Class ;
    rdfs:label "Agreement" ;
    rdfs:comment "Specification of the standard set of terms that define a legal agreement." ;
    skos:altLabel "agreement" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.NoticeContactInformation> a owl:Class ;
    rdfs:label "NoticeContactInformation" ;
    rdfs:comment "Specifies notice information including address and, optionally, an associated person. This type also supports the ISDA CSA representation as a single string, through the address attribute in Contact Information." ;
    skos:altLabel "notice contact information" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CalculationAndTimingCollateralTransferAgreement> a owl:Class ;
    rdfs:label "CalculationAndTimingCollateralTransferAgreement" ;
    rdfs:comment "Specification of the Calculation, Valuation and Timing terms specific to the Initial Margin Credit Support Annex." ;
    skos:altLabel "calculation and timing collateral transfer agreement" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CalculationAndTimingInitialMargin> a owl:Class ;
    rdfs:label "CalculationAndTimingInitialMargin" ;
    rdfs:comment "Specification of the Calculation, Valuation and Timing terms specific to the Initial Margin Credit Support Annex." ;
    skos:altLabel "calculation and timing initial margin" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ConditionsPrecedent> a owl:Class ;
    rdfs:label "ConditionsPrecedent" ;
    rdfs:comment "A class to specify the two set of elections that may overwrite the default Condition Precedent provision." ;
    skos:altLabel "conditions precedent" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CustodianElection> a owl:Class ;
    rdfs:label "CustodianElection" ;
    rdfs:comment "A class to specify the custodian and custody account details for each party to the agreement." ;
    skos:altLabel "custodian election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.DemandsAndNotices> a owl:Class ;
    rdfs:label "DemandsAndNotices" ;
    rdfs:comment "Specifies the address where the demands, specifications and notices will be communicated to for each of the parties to the agreement." ;
    skos:altLabel "demands and notices" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.DirectionRating> a owl:Class ;
    rdfs:label "DirectionRating" ;
    rdfs:comment "A logical container to hold a defined set of related data. In this case the collation of Ratings Agency, Rating value and an associated direction." ;
    skos:altLabel "direction rating" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.JurisdictionRelatedTerms> a owl:Class ;
    rdfs:label "JurisdictionRelatedTerms" ;
    rdfs:comment "A class to specify terms jurisdiction related terms." ;
    skos:altLabel "jurisdiction related terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.LegacyIndependentAmountRatingsBased> a owl:Class ;
    rdfs:label "LegacyIndependentAmountRatingsBased" ;
    rdfs:comment "Specifies that the Independent Amount is determined using a credit rating." ;
    skos:altLabel "legacy independent amount ratings based" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.LegacyIndependentAmountRatingsXExposure> a owl:Class ;
    rdfs:label "LegacyIndependentAmountRatingsXExposure" ;
    rdfs:comment "Specifies that the Independent Amount is determined using both credit rating and exposure metrics." ;
    skos:altLabel "legacy independent amount ratings xexposure" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.NotificationTime> a owl:Class ;
    rdfs:label "NotificationTime" ;
    rdfs:comment "Specifies the time by which a demand for the Transfer of Eligible Credit Support or Posted Credit Support needs to be made in order for the transfer to take place in accordance with the Transfer Timing provisions." ;
    skos:altLabel "notification time" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RatingAgencyValue> a owl:Class ;
    rdfs:label "RatingAgencyValue" ;
    rdfs:comment "A logical container designed to hold a set of related data. In this case the Rating Agency, Rating Value and Rating Type." ;
    skos:altLabel "rating agency value" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ValuationTime> a owl:Class ;
    rdfs:label "ValuationTime" ;
    rdfs:comment "Specifies the time by which the value of the collateral and obligations to transfer or return collateral are to be calculated relative to the Valuation Date." ;
    skos:altLabel "valuation time" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.IsdaCalculationAgent> a owl:Class ;
    rdfs:label "IsdaCalculationAgent" ;
    rdfs:comment "The set of elections to define and categorise the Calculation Agent for the ISDA master agreement." ;
    skos:altLabel "isda calculation agent" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.NonDeliverableSubstitute> a owl:Class ;
    rdfs:label "NonDeliverableSubstitute" ;
    skos:altLabel "non deliverable substitute" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.SpecificInconvertibility> a owl:Class ;
    rdfs:label "SpecificInconvertibility" ;
    skos:altLabel "specific inconvertibility" .

<https://cdm.finos.org/model/cdm.product.template.FixedPricePayout> a owl:Class ;
    rdfs:label "FixedPricePayout" ;
    rdfs:comment "Represents a fixed price payout. There is no underlier associated with this payout type and is based on fixed pricing per a given unit (e.g. in commodities price per barrel)" ;
    skos:altLabel "fixed price payout" .

<https://cdm.finos.org/model/cdm.product.template.NonTransferableProduct> a owl:Class ;
    rdfs:label "NonTransferableProduct" ;
    rdfs:comment "A data type to specify the financial product's economic terms, alongside the product identification and product taxonomy. The non-transferable product data type represents a product that can be traded (as part of a TradableProduct) but cannot be transferred to others.  It is meant to be used across the pre-execution, execution and (as part of the Contract) post-execution lifecycle contexts." ;
    skos:altLabel "non transferable product" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.ContactInformation> a owl:Class ;
    rdfs:label "ContactInformation" ;
    rdfs:comment "A class to specify contact information associated with a party: telephone, postal/street address, email and web page." ;
    skos:altLabel "contact information" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.PartyReferencePayerReceiver> a owl:Class ;
    rdfs:label "PartyReferencePayerReceiver" ;
    rdfs:comment "Specifies the parties responsible for making and receiving payments defined by this structure." ;
    skos:altLabel "party reference payer receiver" .

<https://cdm.finos.org/model/cdm.event.common.CollateralBalance> a owl:Class ;
    rdfs:label "CollateralBalance" ;
    rdfs:comment "Represents common attributes to define a collateral balance recorded by the principal as held or posted." ;
    skos:altLabel "collateral balance" .

<https://cdm.finos.org/model/cdm.event.common.CollateralPosition> a owl:Class ;
    rdfs:label "CollateralPosition" ;
    rdfs:comment "Specifies the individual components of collateral positions." ;
    skos:altLabel "collateral position" .

<https://cdm.finos.org/model/cdm.event.common.ScheduledTransfer> a owl:Class ;
    rdfs:label "ScheduledTransfer" ;
    rdfs:comment "A scheduled transfer built into the contract." ;
    skos:altLabel "scheduled transfer" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isla.EventsOfDefaultElection> a owl:Class ;
    rdfs:label "EventsOfDefaultElection" ;
    rdfs:comment "The specific party elections for events of default." ;
    skos:altLabel "events of default election" .

<https://cdm.finos.org/model/cdm.product.template.OptionalEarlyTermination> a owl:Class ;
    rdfs:label "OptionalEarlyTermination" ;
    rdfs:comment "A data defining:  an early termination provision where either or both parties have the right to exercise." ;
    skos:altLabel "optional early termination" .

<https://cdm.finos.org/model/cdm.product.template.SettlementPayout> a owl:Class ;
    rdfs:label "SettlementPayout" ;
    rdfs:comment "Represents a forward settling payout. The underlier attribute captures the underlying payout, which is settled according to the settlementTerms attribute (which is part of PayoutBase). Both FX Spot and FX Forward should use this component." ;
    skos:altLabel "settlement payout" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.PayerReceiver> a owl:Class ;
    rdfs:label "PayerReceiver" ;
    rdfs:comment "Specifies the parties responsible for making and receiving payments defined by this structure." ;
    skos:altLabel "payer receiver" .

<https://cdm.finos.org/model/cdm.event.common.BusinessEvent> a owl:Class ;
    rdfs:label "BusinessEvent" ;
    rdfs:comment "A business event represents a life cycle event of a trade. The combination of the state changes results in a qualifiable life cycle event. An example of a Business Event is a PartialTermination which is a defined by a quantity change primitive event." ;
    skos:altLabel "business event" .

<https://cdm.finos.org/model/cdm.event.common.ContingentTransfer> a owl:Class ;
    rdfs:label "ContingentTransfer" ;
    rdfs:comment "Specifies a transfer created from a trade contingent upon a specific, uncertain event on a contract" ;
    skos:altLabel "contingent transfer" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CollateralRounding> a owl:Class ;
    rdfs:label "CollateralRounding" ;
    rdfs:comment "A class to specify the rounding methodology applicable to the Delivery Amount and the Return Amount." ;
    skos:altLabel "collateral rounding" .

<https://cdm.finos.org/model/cdm.product.template.AssetPayout> a owl:Class ;
    rdfs:label "AssetPayout" ;
    rdfs:comment "Security finance payout specification in case the product payout involves some form of security collateral, as in a securities financing transaction. Plus additional description for ICMA." ;
    skos:altLabel "asset payout" .

<https://cdm.finos.org/model/cdm.event.common.AdjustmentFactorCalculationTerms> a owl:Class ;
    rdfs:label "AdjustmentFactorCalculationTerms" ;
    rdfs:comment "Describes the input terms involved in the calculation of the adjustment factor applied to the price of the underlier impacted by a Corporate Action." ;
    skos:altLabel "adjustment factor calculation terms" .

<https://cdm.finos.org/model/cdm.event.common.CorporateAction> a owl:Class ;
    rdfs:label "CorporateAction" ;
    rdfs:comment "Specifies the relevant data regarding a corporate action" ;
    skos:altLabel "corporate action" .

<https://cdm.finos.org/model/cdm.event.common.Valuation> a owl:Class ;
    rdfs:label "Valuation" ;
    rdfs:comment "Defines the value of an investment, asset, or security" ;
    skos:altLabel "valuation" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.BaseAndEligibleCurrency> a owl:Class ;
    rdfs:label "BaseAndEligibleCurrency" ;
    rdfs:comment "The base and eligible currency(ies) for the document as specified by the parties to the agreement." ;
    skos:altLabel "base and eligible currency" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportAgreementElectionsBase> a owl:Class ;
    rdfs:label "CreditSupportAgreementElectionsBase" ;
    rdfs:comment "A logical container designed to hold a set of related data. In this case, designed to hold a set of clauses that are common amongst Legacy (1994/95), Variation Margin and Initial Margin Credit Support Documents." ;
    skos:altLabel "credit support agreement elections base" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportObligationsCollateralTransferAgreement> a owl:Class ;
    rdfs:label "CreditSupportObligationsCollateralTransferAgreement" ;
    rdfs:comment "Specification of the Credit Support Obligations applicable to the Initial Margin Credit Support Annex." ;
    skos:altLabel "credit support obligations collateral transfer agreement" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportObligationsInitialMargin> a owl:Class ;
    rdfs:label "CreditSupportObligationsInitialMargin" ;
    rdfs:comment "Specification of the Credit Support Obligations applicable to the Initial Margin Credit Support Annex." ;
    skos:altLabel "credit support obligations initial margin" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportObligationsLegacy> a owl:Class ;
    rdfs:label "CreditSupportObligationsLegacy" ;
    rdfs:comment "Specification of the Credit Support Obligations applicable to the Legacy (1994/95) Credit Support Annex." ;
    skos:altLabel "credit support obligations legacy" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportObligationsVariationMargin> a owl:Class ;
    rdfs:label "CreditSupportObligationsVariationMargin" ;
    rdfs:comment "Specification of the Credit Support Obligations applicable to the Variation Margin Credit Support Annex." ;
    skos:altLabel "credit support obligations variation margin" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.DisputeResolution> a owl:Class ;
    rdfs:label "DisputeResolution" ;
    rdfs:comment "A class to specify the election terms under which a party disputes the Value of any Transfer of Eligible Credit Support or Posted Credit Support." ;
    skos:altLabel "dispute resolution" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SecurityAgreementElections> a owl:Class ;
    rdfs:label "SecurityAgreementElections" ;
    rdfs:comment "The set of elections which specify a Security Agremeent." ;
    skos:altLabel "security agreement elections" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.Clause> a owl:Class ;
    rdfs:label "Clause" ;
    rdfs:comment "A type for documenting additional clause that cannot yet be represented with the model and yet needed for a digital representation of the agreement." ;
    skos:altLabel "clause" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.NaturalPerson> a owl:Class ;
    rdfs:label "NaturalPerson" ;
    rdfs:comment "A class to represent the attributes that are specific to a natural person." ;
    skos:altLabel "natural person" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CustodyArrangements> a owl:Class ;
    rdfs:label "CustodyArrangements" ;
    rdfs:comment "Describes how posted collateral is held, maintained, and safeguarded by a custodian or third-party agent, in accordance with the terms of the governing agreement." ;
    skos:altLabel "custody arrangements" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.MasterAgreement> a owl:Class ;
    rdfs:label "MasterAgreement" ;
    rdfs:comment "The set of elections that define an ISDA Master Agreement." ;
    skos:altLabel "master agreement" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.ExtraordinaryEvents> a owl:Class ;
    rdfs:label "ExtraordinaryEvents" ;
    rdfs:comment "Where the underlying is shares, defines market events affecting the issuer of those shares that may require the terms of the transaction to be adjusted." ;
    skos:altLabel "extraordinary events" .

<https://cdm.finos.org/model/cdm.product.template.EconomicTerms> a owl:Class ;
    rdfs:label "EconomicTerms" ;
    rdfs:comment " This class represents the full set of price-forming features associated with a contractual product: the payout component, the notional/quantity, the effective and termination date and the date adjustment provisions when applying uniformily across the payout components. This class also includes the legal provisions which have valuation implications: cancelable provision, extendible provision, early termination provision and extraordinary events specification." ;
    skos:altLabel "economic terms" .

<https://cdm.finos.org/model/cdm.product.template.PortfolioReturnTerms> a owl:Class ;
    rdfs:label "PortfolioReturnTerms" ;
    rdfs:comment "Specifies an individual type of return of a Performance Payout, when such individual return is part of an aggregation of multiple similar returns, at Performance Payout level." ;
    skos:altLabel "portfolio return terms" .

<https://cdm.finos.org/model/cdm.event.common.ExecutionInstruction> a owl:Class ;
    rdfs:label "ExecutionInstruction" ;
    rdfs:comment "Specifies instructions for execution of a transaction, consisting of a product, price, quantity, parties, trade identifier, execution details, and settlement terms." ;
    skos:altLabel "execution instruction" .

<https://cdm.finos.org/model/cdm.event.common.TradeState> a owl:Class ;
    rdfs:label "TradeState" ;
    rdfs:comment "Defines the fundamental financial information that can be changed by a Primitive Event and by extension any business or life-cycle event. Each TradeState specifies where a Trade is in its life-cycle. TradeState is a root type and as such, can be created independently to any other CDM data type, but can also be used as part of the CDM Event Model." ;
    skos:altLabel "trade state" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.Resource> a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "Describes the resource that contains the media representation of a business event (i.e used for stating the Publicly Available Information). For example, can describe a file or a URL that represents the event. This type is an extended version of a type defined by RIXML (www.rixml.org).  Rosetta restricts the FpML implementation by not providing the ability to associated a document in hexadecimalBinary or base64Binary until such time that actual use cases will come up." ;
    skos:altLabel "resource" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.MinimumTransferAmountRatingsBased> a owl:Class ;
    rdfs:label "MinimumTransferAmountRatingsBased" ;
    rdfs:comment "Defines that the Minimum Transfer Amount (MTA) is based on a Ratings condition(s)." ;
    skos:altLabel "minimum transfer amount ratings based" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ThresholdRatingsBased> a owl:Class ;
    rdfs:label "ThresholdRatingsBased" ;
    rdfs:comment "Defines that the Threshold is based on Ratings condition(s)." ;
    skos:altLabel "threshold ratings based" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.AdditionalDisruptionEvents> a owl:Class ;
    rdfs:label "AdditionalDisruptionEvents" ;
    rdfs:comment "A type for defining the Additional Disruption Events." ;
    skos:altLabel "additional disruption events" .

<https://cdm.finos.org/model/cdm.product.template.ExtendibleProvision> a owl:Class ;
    rdfs:label "ExtendibleProvision" ;
    rdfs:comment "A data defining:  an option to extend an existing swap transaction on the specified exercise dates for a term ending on the specified new termination date. As a difference from FpML, it extends the BuyerSeller class, which represents the BuyerSeller.model." ;
    skos:altLabel "extendible provision" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.Account> a owl:Class ;
    rdfs:label "Account" ;
    rdfs:comment "A class to specify an account as an account number alongside, optionally. an account name, an account type, an account beneficiary and a servicing party." ;
    skos:altLabel "account" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.PartyRole> a owl:Class ;
    rdfs:label "PartyRole" ;
    rdfs:comment "A class to specify the role(s) that party(ies) may have in relation to the execution, contract or other legal agreement." ;
    skos:altLabel "party role" .

<https://cdm.finos.org/model/cdm.event.common.MarginCallBase> a owl:Class ;
    rdfs:label "MarginCallBase" ;
    rdfs:comment "Represents common attributes required for Issuance and Response to a Margin Call action as a result of a demand for delivery or return of collateral determined under a legal agreement such as a credit support document or equivalent." ;
    skos:altLabel "margin call base" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.FxDisruptionEvents> a owl:Class ;
    rdfs:label "FxDisruptionEvents" ;
    rdfs:comment "Additional Provisions for a Confirmation of an FX or Currency Option Transaction" ;
    skos:altLabel "fx disruption events" .

<https://cdm.finos.org/model/cdm.product.template.OptionPayout> a owl:Class ;
    rdfs:label "OptionPayout" ;
    rdfs:comment " The option payout specification terms. The associated globalKey denotes the ability to associate a hash value to the respective OptionPayout instantiation for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage." ;
    skos:altLabel "option payout" .

<https://cdm.finos.org/model/cdm.product.template.Payout> a owl:Class ;
    rdfs:label "Payout" ;
    rdfs:comment "Represents the set of future cashflow methodologies in the form of specific payout data type(s) which result from the financial product.  Examples: a trade in a cash asset will use only a settlement payout; for derivatives, two interest rate payouts can be combined to specify an interest rate swap; one interest rate payout can be combined with a credit default payout to specify a credit default swap." ;
    skos:altLabel "payout" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.EscrowArrangement> a owl:Class ;
    rdfs:label "EscrowArrangement" ;
    rdfs:comment "Refers to the segregation deposit procedure parties may want to commmit into during the time a Disruption Event is effective" ;
    skos:altLabel "escrow arrangement" .

<https://cdm.finos.org/model/cdm.product.template.PerformancePayout> a owl:Class ;
    rdfs:label "PerformancePayout" ;
    rdfs:comment "Contains the necessary specifications for all performance payouts, encompassing equity return, dividend, variance, volatility and correlation products." ;
    skos:altLabel "performance payout" .

<https://cdm.finos.org/model/cdm.event.common.MarginCallIssuance> a owl:Class ;
    rdfs:label "MarginCallIssuance" ;
    rdfs:comment "Represents common attributes required for a Margin Call Issuance under a legal agreement such as a credit support document or equivalent." ;
    skos:altLabel "margin call issuance" .

<https://cdm.finos.org/model/cdm.event.common.PrimitiveInstruction> a owl:Class ;
    rdfs:label "PrimitiveInstruction" ;
    rdfs:comment "A Primitive Instruction describes the inputs required to pass into the corresponding PrimitiveEvent function." ;
    skos:altLabel "primitive instruction" .

<https://cdm.finos.org/model/cdm.event.common.Trade> a owl:Class ;
    rdfs:label "Trade" ;
    rdfs:comment "Defines the output of a financial transaction between parties - a Business Event. A Trade impacts the financial position (i.e. the balance sheet) of involved parties." ;
    skos:altLabel "trade" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.AgreementName> a owl:Class ;
    rdfs:label "AgreementName" ;
    rdfs:comment "Specifies the agreement name through an agreement type and optional detailed sub agreement type." ;
    skos:altLabel "agreement name" .

<https://cdm.finos.org/model/cdm.product.template.CancelableProvision> a owl:Class ;
    rdfs:label "CancelableProvision" ;
    rdfs:comment "A data defining:  the right of a party to cancel a swap transaction on the specified exercise dates. The provision is for 'walk-away' cancellation (i.e. the fair value of the swap is not paid). A fee payable on exercise can be specified. As a difference from the FpML construct, the canonical model extends the BuyerSeller class." ;
    skos:altLabel "cancelable provision" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.LegalEntity> a owl:Class ;
    rdfs:label "LegalEntity" ;
    rdfs:comment "A class to specify a legal entity, with a required name and an optional entity identifier (such as the LEI)." ;
    skos:altLabel "legal entity" .

<https://cdm.finos.org/model/cdm.event.common.MarginCallResponse> a owl:Class ;
    rdfs:label "MarginCallResponse" ;
    rdfs:comment "Represents common attributes required for a Margin Call Response under a legal agreement such as a credit support document or equivalent." ;
    skos:altLabel "margin call response" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.LegalAgreement> a owl:Class ;
    rdfs:label "LegalAgreement" ;
    rdfs:comment "The specification of a legal agreement between two parties, being negotiated or having been executed. This includes the baseline information and the optional specialised elections" ;
    skos:altLabel "legal agreement" .

<https://cdm.finos.org/model/cdm.product.template.ExerciseTerms> a owl:Class ;
    rdfs:label "ExerciseTerms" ;
    rdfs:comment "A class defining the exercise period for an option together with any rules governing the notional amount of the underlying which can be exercised on any given exercise date and any associated exercise fees." ;
    skos:altLabel "exercise terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportAgreementLegacyElections> a owl:Class ;
    rdfs:label "CreditSupportAgreementLegacyElections" ;
    rdfs:comment "The set of elections which specify a Legacy (1994 or 1995) Credit Support Annex or Deed." ;
    skos:altLabel "credit support agreement legacy elections" .

<https://cdm.finos.org/model/cdm.event.common.MarginCallExposure> a owl:Class ;
    rdfs:label "MarginCallExposure" ;
    rdfs:comment "Represents attributes required for mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency)." ;
    skos:altLabel "margin call exposure" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportAgreementVariationMarginElections> a owl:Class ;
    rdfs:label "CreditSupportAgreementVariationMarginElections" ;
    rdfs:comment "The set of elections which specify a Variation Margin Credit Support Annex or Deed." ;
    skos:altLabel "credit support agreement variation margin elections" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CollateralTransferAgreementElections> a owl:Class ;
    rdfs:label "CollateralTransferAgreementElections" ;
    rdfs:comment "The set of elections which specify a Collateral Transfer Agreement." ;
    skos:altLabel "collateral transfer agreement elections" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportAgreementInitialMarginElections> a owl:Class ;
    rdfs:label "CreditSupportAgreementInitialMarginElections" ;
    rdfs:comment "The set of elections which specify an Initial Margin Credit Support Annex or Deed." ;
    skos:altLabel "credit support agreement initial margin elections" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.Party> a owl:Class ;
    rdfs:label "Party" ;
    rdfs:comment "A class to specify a party, without a qualification as to whether this party is a legal entity or a natural person, although the model provides the ability to associate a person (or set of persons) to a party, which use case would imply that such party would be a legal entity (even if not formally specified as such). " ;
    skos:altLabel "party" .

<https://cdm.finos.org/model/cdm.base.staticdata.party.CounterpartyRoleEnum> a owl:Class ;
    rdfs:label "CounterpartyRoleEnum" ;
    rdfs:comment "Defines the enumerated values to specify the two counterparties to the transaction." ;
    skos:altLabel "counterparty role enum" .

