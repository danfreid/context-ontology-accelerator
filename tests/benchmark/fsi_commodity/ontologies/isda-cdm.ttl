    rdfs:label "FxDualExchangeRate" ;
    skos:altLabel "fx dual exchange rate" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.FxPriceSourceDisruption> a owl:Class ;
    rdfs:label "FxPriceSourceDisruption" ;
    skos:altLabel "fx price source disruption" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.IndexAdjustmentEvents> a owl:Class ;
