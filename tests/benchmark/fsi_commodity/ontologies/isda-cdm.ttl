<https://cdm.finos.org/model/cdm.legaldocumentation.csa.LegacyExposureScopeElection> a owl:Class ;
    rdfs:label "LegacyExposureScopeElection" ;
    rdfs:comment "Specification of amendments to the calculation of Exposure in terms of the Transactions and Products covered." ;
    skos:altLabel "legacy exposure scope election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.MinimumTransferAmountAmendment> a owl:Class ;
    rdfs:label "MinimumTransferAmountAmendment" ;
    rdfs:comment " A class to specify whether Amendment to Minimum Transfer Amount language is applicable or not." ;
    skos:altLabel "minimum transfer amount amendment" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.MinimumTransferAmountElection> a owl:Class ;
    rdfs:label "MinimumTransferAmountElection" ;
    rdfs:comment "Specifies the method by which the minimum transfer amount is defined, such as a fixed amount, ratings based, or an alternative basis set out in the agreement." ;
    skos:altLabel "minimum transfer amount election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.NotificationTimeElection> a owl:Class ;
    rdfs:label "NotificationTimeElection" ;
    rdfs:comment "A class to specify the notification time election by the respective parties to the agreement." ;
    skos:altLabel "notification time election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.OtherAgreements> a owl:Class ;
    rdfs:label "OtherAgreements" ;
    rdfs:comment "The bespoke definition of other agreements or other credit support annex terms as specified by the parties to the agreement." ;
    skos:altLabel "other agreements" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.PostedCreditSupportItem> a owl:Class ;
    rdfs:label "PostedCreditSupportItem" ;
    rdfs:comment "Posted Credit Support item with corresponding Valuation Percentage, FX Haircut Percentage and any related disputed Posted Credit Support valuation." ;
    skos:altLabel "posted credit support item" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RatedPartyEnum> a owl:Class ;
    rdfs:label "RatedPartyEnum" ;
    rdfs:comment "The enumerated values applicable where a Rated Party is defined within the relevant clause." ;
    skos:altLabel "rated party enum" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ResolutionValue> a owl:Class ;
    rdfs:label "ResolutionValue" ;
    rdfs:comment "Methodology for resolving disputes in respect of the determination of the value of collateral." ;
    skos:altLabel "resolution value" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SpecifiedOrAccessConditionPartyElection> a owl:Class ;
    rdfs:label "SpecifiedOrAccessConditionPartyElection" ;
    rdfs:comment "The party specific elections in respect to the Specified Condition and Access Condition clause." ;
    skos:altLabel "specified or access condition party election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SubstitutedRegime> a owl:Class ;
    rdfs:label "SubstitutedRegime" ;
    rdfs:comment "A class to specify each party's election with respect to the Substituted Regimes that will be applicable..." ;
    skos:altLabel "substituted regime" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.TerminationCurrencyAmendment> a owl:Class ;
    rdfs:label "TerminationCurrencyAmendment" ;
    rdfs:comment "A class to specify the Amendment to Termination Currency elections by the parties to the agreement." ;
    skos:altLabel "termination currency amendment" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ThresholdMinimumTransferAmountFixedAmount> a owl:Class ;
    rdfs:label "ThresholdMinimumTransferAmountFixedAmount" ;
    rdfs:comment "Defines the Threshold or the Minimum Transfer Amount (MTA) as a fixed amount." ;
    skos:altLabel "threshold minimum transfer amount fixed amount" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ValuationAgent> a owl:Class ;
    rdfs:label "ValuationAgent" ;
    rdfs:comment "Details of the party valuating the collateral to be delivered or returned." ;
    skos:altLabel "valuation agent" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.MasterAgreementVariableSet> a owl:Class ;
    rdfs:label "MasterAgreementVariableSet" ;
    rdfs:comment "Defines a type where additional variables associated to clauses and their variants can be described." ;
    skos:altLabel "master agreement variable set" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isda.TerminationCurrencySelection> a owl:Class ;
    rdfs:label "TerminationCurrencySelection" ;
    rdfs:comment "Specifies Termination Currency where a currency is stated at the time the agreement is entered into." ;
    skos:altLabel "termination currency selection" .

<https://cdm.finos.org/model/cdm.legaldocumentation.master.isla.ApplicabilityOfElectionEnum> a owl:Class ;
    rdfs:label "ApplicabilityOfElectionEnum" ;
    rdfs:comment "The potential options for specifying whether a particular election applies in a GMSLA." ;
    skos:altLabel "applicability of election enum" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.UnderlierSubstitutionProvision> a owl:Class ;
    rdfs:label "UnderlierSubstitutionProvision" ;
    rdfs:comment "Where parties describe any substitution terms." ;
    skos:altLabel "underlier substitution provision" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.EquityCorporateEvents> a owl:Class ;
    rdfs:label "EquityCorporateEvents" ;
    rdfs:comment "A class for defining the merger events and their treatment." ;
    skos:altLabel "equity corporate events" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.FxBenchmarkObligationDefault> a owl:Class ;
    rdfs:label "FxBenchmarkObligationDefault" ;
    skos:altLabel "fx benchmark obligation default" .

<https://cdm.finos.org/model/cdm.legaldocumentation.transaction.additionalterms.FxInconvertibilityOrNonTransferability> a owl:Class ;
    rdfs:label "FxInconvertibilityOrNonTransferability" ;
    skos:altLabel "fx inconvertibility or non transferability" .

<https://cdm.finos.org/model/cdm.product.template.AveragingCalculation> a owl:Class ;
    rdfs:label "AveragingCalculation" ;
    rdfs:comment "Defines parameters for use in cases when a valuation or other term is based on an average of market observations." ;
    skos:altLabel "averaging calculation" .

<https://cdm.finos.org/model/cdm.product.template.EarlyTerminationProvision> a owl:Class ;
    rdfs:label "EarlyTerminationProvision" ;
    rdfs:comment "A data defining:  an early termination provision for a swap. This early termination is at fair value, i.e. on termination the fair value of the product must be settled between the parties." ;
    skos:altLabel "early termination provision" .

<https://cdm.finos.org/model/cdm.product.template.MandatoryEarlyTermination> a owl:Class ;
    rdfs:label "MandatoryEarlyTermination" ;
    rdfs:comment "A data to:  define an early termination provision for which exercise is mandatory." ;
    skos:altLabel "mandatory early termination" .

<https://cdm.finos.org/model/cdm.product.template.PartialExercise> a owl:Class ;
    rdfs:label "PartialExercise" ;
    rdfs:comment "A class defining partial exercise. As defined in the 2000 ISDA Definitions, Section 12.3 Partial Exercise, the buyer of the option may exercise all or less than all the notional amount of the underlying swap but may not be less than the minimum notional amount (if specified) and must be an integral multiple of the integral multiple amount if specified." ;
    skos:altLabel "partial exercise" .

<https://cdm.finos.org/model/cdm.product.template.RecallProvision> a owl:Class ;
    rdfs:label "RecallProvision" ;
    rdfs:comment "Defines the additional features that allow securities to be recalled by the lender before the term of the loan. A recall is not the same as an early termination, but may result in the early termination of a loan." ;
    skos:altLabel "recall provision" .

<https://cdm.finos.org/model/cdm.product.template.SchedulePeriod> a owl:Class ;
    rdfs:label "SchedulePeriod" ;
    rdfs:comment "A class that defines the period of a schedule. The period contains a set of start and end dates, quantities, fixing, and pricing data." ;
    skos:altLabel "schedule period" .

<https://cdm.finos.org/model/cdm.product.template.TradableProduct> a owl:Class ;
    rdfs:label "TradableProduct" ;
    rdfs:comment "Definition of a product as ready to be traded, i.e. included in an execution or contract, by associating a specific price and quantity to this product plus an (optional) mechanism for any potential future quantity adjustment." ;
    skos:altLabel "tradable product" .

<https://cdm.finos.org/model/cdm.event.common.AgreementEvent> a owl:Class ;
    rdfs:label "AgreementEvent" ;
    rdfs:comment "An agreement event represents a life cycle event of a legal document. The combination of legal term amendments, contracting party changes or agreement status changes that are represented by an amendment agreement that includes a change to the overall Legal agreement representation through a change in contractual parties or terms." ;
    skos:altLabel "agreement event" .

<https://cdm.finos.org/model/cdm.event.common.BillingInstruction> a owl:Class ;
    rdfs:label "BillingInstruction" ;
    rdfs:comment "Specifies the instructions for creation of a Security Lending billing invoice." ;
    skos:altLabel "billing instruction" .

<https://cdm.finos.org/model/cdm.event.common.BillingRecord> a owl:Class ;
    rdfs:label "BillingRecord" ;
    rdfs:comment "Specifies individual records within a billing invoice." ;
    skos:altLabel "billing record" .

<https://cdm.finos.org/model/cdm.event.common.BillingRecordInstruction> a owl:Class ;
    rdfs:label "BillingRecordInstruction" ;
    rdfs:comment "Specifies the instructions for creation of a billing record." ;
    skos:altLabel "billing record instruction" .

<https://cdm.finos.org/model/cdm.event.common.CalculateTransferInstruction> a owl:Class ;
    rdfs:label "CalculateTransferInstruction" ;
    rdfs:comment "Defines the tradeState or payout on which to create a Transfer along with all necessary resets." ;
    skos:altLabel "calculate transfer instruction" .

<https://cdm.finos.org/model/cdm.event.common.CounterpartyPositionBusinessEvent> a owl:Class ;
    rdfs:label "CounterpartyPositionBusinessEvent" ;
    rdfs:comment "A business event represents a life cycle event of a position. The combination of the state changes results in a qualifiable life cycle event." ;
    skos:altLabel "counterparty position business event" .

<https://cdm.finos.org/model/cdm.event.common.ExerciseInstruction> a owl:Class ;
    rdfs:label "ExerciseInstruction" ;
    rdfs:comment "Specifies the information required to communicate the choices made by the exercising party, in a financial product endowing the party with at least one option." ;
    skos:altLabel "exercise instruction" .

<https://cdm.finos.org/model/cdm.event.common.MarginCallInstructionType> a owl:Class ;
    rdfs:label "MarginCallInstructionType" ;
    rdfs:comment "Represents enumeration values to specify the call notification type, direction, specific action type." ;
    skos:altLabel "margin call instruction type" .

<https://cdm.finos.org/model/cdm.event.common.PartyChangeInstruction> a owl:Class ;
    rdfs:label "PartyChangeInstruction" ;
    rdfs:comment "Specifies instruction to change the party on a trade. This primitive instruction is used in a number of scenarios including: clearing, allocation and novation. The instrution must include a trade identifier, because a change of party effectively results in a different trade." ;
    skos:altLabel "party change instruction" .

<https://cdm.finos.org/model/cdm.event.common.SecurityLendingInvoice> a owl:Class ;
    rdfs:label "SecurityLendingInvoice" ;
    rdfs:comment "Specifies the information required for inclusion in a securities lending billing invoice." ;
    skos:altLabel "security lending invoice" .

<https://cdm.finos.org/model/cdm.event.common.TransferBase> a owl:Class ;
    rdfs:label "TransferBase" ;
    rdfs:comment "Defines the movement of an Asset (eg cash, securities or commodities) between two parties on a date." ;
    skos:altLabel "transfer base" .

<https://cdm.finos.org/model/cdm.legaldocumentation.common.UmbrellaAgreementParty> a owl:Class ;
    rdfs:label "UmbrellaAgreementParty" ;
    rdfs:comment "Specifies the entities that are part of the umbrella agreement." ;
    skos:altLabel "umbrella agreement party" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ApplicableRegime> a owl:Class ;
    rdfs:label "ApplicableRegime" ;
    rdfs:comment "A class to specify the applicable regulatory regime(s) that parties to a legal agreement, such as the ISDA 2016 and 2018 CSA for Initial Margin, might be subject to." ;
    skos:altLabel "applicable regime" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CSAReturnAmount> a owl:Class ;
    rdfs:label "CSAReturnAmount" ;
    rdfs:comment "In respect of a Valuation Date, the amount of collateral which a party is entitled to demand to be recalled to it as a Return Amount." ;
    skos:altLabel "csareturn amount" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CalculationAndTimingVariationMargin> a owl:Class ;
    rdfs:label "CalculationAndTimingVariationMargin" ;
    rdfs:comment "Specification of the Calculation, Valuation and Timing terms specific to the Variation Margin Credit Support Annex." ;
    skos:altLabel "calculation and timing variation margin" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.CreditSupportDocumentElection> a owl:Class ;
    rdfs:label "CreditSupportDocumentElection" ;
    rdfs:comment "The party election of Credit Support Provider(s), if any." ;
    skos:altLabel "credit support document election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.DirectionRatingSet> a owl:Class ;
    rdfs:label "DirectionRatingSet" ;
    rdfs:comment "A logical container to hold a defined set of related data. In this case the collation of Ratings Agency, Rating value and an associated direction that are grouped by either AND or OR logic." ;
    skos:altLabel "direction rating set" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.EligibilityToHoldCollateral> a owl:Class ;
    rdfs:label "EligibilityToHoldCollateral" ;
    rdfs:comment "Specifies the conditions under which a party and its custodian(s) are entitled to hold collateral." ;
    skos:altLabel "eligibility to hold collateral" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.HoldingAndUsingPostedCollateral> a owl:Class ;
    rdfs:label "HoldingAndUsingPostedCollateral" ;
    rdfs:comment "Specifies the conditions that need to be satisfied before the Secured Party or Custodian acting on its behalf can hold and use posted collateral." ;
    skos:altLabel "holding and using posted collateral" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.LegacyIndependentAmountParty> a owl:Class ;
    rdfs:label "LegacyIndependentAmountParty" ;
    rdfs:comment "The party specific elections for the Independent Amount clause." ;
    skos:altLabel "legacy independent amount party" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.MasterAgreementDatedAsOfDate> a owl:Class ;
    rdfs:label "MasterAgreementDatedAsOfDate" ;
    rdfs:comment "Defines the dates agreed by the parties as the date of the Credit Support Annex or Credit Support Deed." ;
    skos:altLabel "master agreement dated as of date" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.MinimumTransferAmount> a owl:Class ;
    rdfs:label "MinimumTransferAmount" ;
    rdfs:comment "Represents the threshold specified in the agreement below which collateral need not be delivered, and represents the smallest incremental value of exposure that must be reached before the parties are obliged to transfer collateral." ;
    skos:altLabel "minimum transfer amount" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.PostingObligationsElection> a owl:Class ;
    rdfs:label "PostingObligationsElection" ;
    rdfs:comment "Specifies the collateral posting obligations for the security provider party(ies)." ;
    skos:altLabel "posting obligations election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.ProcessAgentElection> a owl:Class ;
    rdfs:label "ProcessAgentElection" ;
    rdfs:comment "Specifies the parties' respective elections with respect to the Process Agent." ;
    skos:altLabel "process agent election" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RatingTypeEnum> a owl:Class ;
    rdfs:label "RatingTypeEnum" ;
    rdfs:comment "The relevant rating type." ;
    skos:altLabel "rating type enum" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.RegimeTerms> a owl:Class ;
    rdfs:label "RegimeTerms" ;
    rdfs:comment "A class that is used by the ApplicableRegime and the AdditionalRegime classes to specify the regulatory regime terms." ;
    skos:altLabel "regime terms" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SecurityInterestForObligations> a owl:Class ;
    rdfs:label "SecurityInterestForObligations" ;
    rdfs:comment "Security Interest for Obligations clause applicable to 1994 NY CSA, 1995 English Law CSA, 1995 English Law Credit Support Deed, 2016 English Law VM CSA and 2016 New York Law VM CSA." ;
    skos:altLabel "security interest for obligations" .

<https://cdm.finos.org/model/cdm.legaldocumentation.csa.SecurityProviderRightsEvent> a owl:Class ;
    rdfs:label "SecurityProviderRightsEvent" ;
    rdfs:comment "A class to specify the Pledgor/Obligor/Chargor Rights Event election." ;
