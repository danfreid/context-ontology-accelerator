        "建筑业",
        "建設業" .

<https://folio.openlegalstandard.org/RCTnebwmInNgHYwFLgAOf0z> a owl:Class ;
    rdfs:label "Employment Record" ;
    rdfs:comment "An \"Employment Record\" is a structured historical record that documents an individual's employment-related information, including details about their work history, positions held, employers, dates of employment, and relevant achievements." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RC1FD6ezZdf7ZABmyDWmeg7> .

<https://folio.openlegalstandard.org/RCUAcLSyxeRKsnkjTydl6sM> a owl:Class ;
