        "工作场所安全索赔",
        "職場安全請求" .

<https://folio.openlegalstandard.org/R8YpJBaF5zesoc0jtaNESdQ> a owl:Class ;
    rdfs:label "Precedent" ;
    rdfs:comment "Precedent refers to a legal decision or judgment passed in a previous case, used as an authoritative rule or example in subsequent similar cases. It serves as a guiding principle, helping courts decide future cases with similar issues or facts." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RC1CZydjfH8oiM4W3rCkma3> .

<https://folio.openlegalstandard.org/R8aQIG92fCROCjs6BkU82Qf> a owl:Class ;
    rdfs:label "Peremptory Challenge" ;
    rdfs:comment "A peremptory challenge is a motion made during a trial to remove a potential juror or judge without stating a reason, typically limited in number, and used to ensure a fair and impartial trial." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8zwKGkogGKIKWSVWb1ItRL> ;
