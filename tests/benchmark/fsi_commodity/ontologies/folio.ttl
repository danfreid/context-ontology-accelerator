    rdfs:subClassOf <https://folio.openlegalstandard.org/RhBgnef56iLBXYfPqWQE41> .

<https://folio.openlegalstandard.org/RDKGeTDagCQ714D5C4sASPP> a owl:Class ;
    rdfs:label "Anxiety and Obsessive-Compulsive Disorders" ;
    rdfs:comment "Anxiety and Obsessive-Compulsive Disorders are characterized by excessive anxiety, worry, apprehension, and fear, or by avoidance of feelings, thoughts, activities, objects, places, or people.  Symptoms and signs may include restlessness, difficulty concentrating, hyper-vigilance, muscle tension, sleep disturbance, fatigue, panic attacks, obsessions and compulsions, constant thoughts and fears about safety, and frequent physical complaints." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RN3TubQIlusDFnPgrNAk8D> .

<https://folio.openlegalstandard.org/RDN8CVqeiDlOeHJO8Oeltq6> a owl:Class ;
    rdfs:label "Climate-Based Market Segment" ;
    rdfs:comment "A climate-based market segment refers to a group of consumers or businesses categorized based on the climatic conditions of their geographical location. This segmentation helps businesses tailor their products, services, and marketing strategies to suit the specific needs and preferences of people living in areas with similar climatic characteristics" ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7z0ey8ZMeOT1q01VNPe1HY> ;
    skos:altLabel "Climatic Market Segment" .

<https://folio.openlegalstandard.org/RDNsW4JqaHcQ9KPtpXLzCPc> a owl:Class ;
    rdfs:label "Requirements for Public Benefits" ;
    rdfs:comment "Requirements for public benefits refer to the conditions or activities that an individual or family must fulfill to qualify for or continue receiving financial assistance or services from a government program. These can include mandates for job searches, participation in educational or vocational training programs, or completion of specific plans aimed at improving self-sufficiency. Failure to meet these requirements may result in reduction, suspension, or termination of benefits." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R79ZRcChNA1jEORJLsPWYSv> .

<https://folio.openlegalstandard.org/RDR8hWYIaoudg2qZmCbzto6> a owl:Class ;
    rdfs:label "Breach of Employment Contract" ;
