    rdfs:label "Literary Work" ;
    rdfs:comment "A Literary Work is a written or printed creation that conveys ideas, stories, or information through text. Protected under copyright law, literary works grant the author or creator exclusive rights to reproduce, distribute, and adapt the content." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RVaHiNBU68DENmeHicnzro> ;
    skos:altLabel "Literary Creation",
