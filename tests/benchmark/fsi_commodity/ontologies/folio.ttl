    rdfs:subClassOf <https://folio.openlegalstandard.org/R1F4dbe4CD17b3B2a7f15b97> ;
    skos:altLabel "ID" .

<https://folio.openlegalstandard.org/RDBYmMtBs3jHkWCzKsvQP44> a owl:Class ;
