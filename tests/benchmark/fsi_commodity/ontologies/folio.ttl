<https://folio.openlegalstandard.org/RCsRWbVwZat6lud2K3XpOLj> a owl:Class ;
    rdfs:label "Hearing Disability" ;
    rdfs:comment "A Hearing Disability is a partial or total inability to hear sounds in one or both ears, which can affect communication, social interaction, and daily activities. This condition can range from mild hearing loss to profound deafness and may require the use of hearing aids, cochlear implants, or other assistive devices." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RC9rPAii8f99I7p4Hi5Qdia> ;
