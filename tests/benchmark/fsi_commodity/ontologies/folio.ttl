    rdfs:label "Port of Entry" ;
    rdfs:comment "\"Port of Entry\" (POE) is the official location where an individual enters a country, subject to immigration inspection and clearance by authorities, determining their eligibility to enter and stay within the country's borders." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8cGjHXv3vecVd4ZO6HVjo> ;
