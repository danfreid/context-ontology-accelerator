    rdfs:subClassOf <https://folio.openlegalstandard.org/R7QqT8OYSjPMxWY3Tj1Nlam> ;
    skos:altLabel "Case Transferred" .

<https://folio.openlegalstandard.org/R951hKkSGUrKhm07RqJ1hDc> a owl:Class ;
