<https://folio.openlegalstandard.org/RSwOCeFhWxUA3fOiTvlja4> a owl:Class ;
    rdfs:label "Government Benefits" ;
    rdfs:comment "Government Benefits are financial assistance programs provided by the government to individuals in need, designed to support basic living expenses, healthcare, and other essential needs. These benefits include payments such as Social Security, unemployment benefits, and welfare payments, which help to ensure a safety net for the vulnerable and unemployed." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RLrqGkP9fi5OO2RhpttmVI> ;
    skos:altLabel "Public Assistance",
