        "संशोधन धारा",
        "修正条款",
        "改正条項" .

<https://folio.openlegalstandard.org/R7Xjkk7EkIgiSA3LmsPofVx> a owl:Class ;
    rdfs:label "Illegal Gambling" ;
    rdfs:comment "To unlawfully bet or wager money or something else of value; assist, promote, or operate a game of chance for money or some other stake; possess or transmit wagering information; manufacture, sell, purchase, possess, or transport gambling equipment, devices or goods; or tamper with the outcome of a sporting event or contest to gain a gambling advantage." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RCqBiJAwLT5iG2nvk12tNKW> ;
    skos:altLabel "Illegal Gambling",
        "Illegales Glücksspiel",
        "Jeu illégal",
        "Jogo ilegal",
        "Juego ilegal",
        "הימורים בלתי חוקיים",
        "अवैध जुआ",
        "違法賭博",
        "非法赌博" .

<https://folio.openlegalstandard.org/R7mMPoEuA9Ja4rODr1LGXcR> a owl:Class ;
    rdfs:label "Copyright Work Types" ;
    rdfs:comment "Copyright Work Types encompass various forms of creative works such as Derivative Work, Collective Work, and Joint Work, each with unique characteristics and legal implications. Derivative Works are based on pre-existing works, Collective Works involve the assembly of independent works into a single publication, and Joint Works are created by collaboration with merged contributions." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy> .

<https://folio.openlegalstandard.org/R7p3ZBGzc1BxDrCwYJnsTo> a owl:Class ;
    rdfs:label "Structured Finance Agreement" ;
    rdfs:comment "A Structured Finance Agreement pertains to complex financial transactions that pool and repackage financial assets, often for the purpose of risk diversification and enhanced returns. These agreements govern the terms, parties involved, and the structure of such transactions." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R88D8i8AcSTUig2X3yPbFHg> .

<https://folio.openlegalstandard.org/R7qicnAOVCTYIaiJHt9KmIy> a owl:Class ;
    rdfs:label "Medical Test" ;
    rdfs:comment "A Medical Test is a clinical procedure performed to detect, diagnose, or monitor diseases, disease processes, susceptibility, or to determine a course of treatment. Examples include blood tests, DNA tests, drug tests, and paternity tests." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RBOz1UXsX4cnOePooNnJ6Xc> ;
    skos:altLabel "Clinical Test",
        "Health Examination Procedure" .

<https://folio.openlegalstandard.org/R7xpf80TbUte15aQuYy4a12> a owl:Class ;
    rdfs:label "Poultry" ;
    rdfs:comment "Poultry refers to domesticated birds raised primarily for their meat, eggs, and feathers. This category includes chickens, turkeys, ducks, and geese, and these birds are integral to agriculture, providing a significant source of protein and other products for human consumption." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8i9ifFKGOUWKWVHDXvxgR1> ;
    skos:altLabel "Domestic Fowl",
        "Domesticated Birds",
        "Farm Birds" .

<https://folio.openlegalstandard.org/R85Datx36zz4sBBoEYxCByw> a owl:Class ;
    rdfs:label "Governmental Representative" ;
    rdfs:comment "A governmental representative is an individual elected or appointed to act on behalf of a larger group of citizens within a governmental system. Examples include presidents, prime ministers, legislators, or council members, each holding specific roles and responsibilities within their respective branches of government." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7L5eLIzH0CpOUE74uJvSjL> .

<https://folio.openlegalstandard.org/R88m06glAkTkIFNVlAF30zy> a owl:Class ;
    rdfs:label "Artificial Intelligence System Taxonomy" ;
