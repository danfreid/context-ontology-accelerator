<https://folio.openlegalstandard.org/RCrctN8FUd3Tj5gi4DWHTZx> a owl:Class ;
    rdfs:label "Food and Cash Public Benefit" ;
    rdfs:comment "Food and cash public benefit refers to government programs that provide financial assistance and food resources to individuals or families in need. Cash benefits, often delivered through electronic benefit transfer (EBT) cards or direct deposits, are intended to help cover basic living expenses, while food benefits, such as the Supplemental Nutrition Assistance Program (SNAP) in the United States, are designated for purchasing eligible food items." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8xrmgt6tyyFf3b2CaMlaOe> .

<https://folio.openlegalstandard.org/RCw8IC5TbjkV1rxNruwttNL> a owl:Class ;
    rdfs:label "Adoption" ;
    rdfs:comment "The legal process by which a person or couple becomes the legal parent(s) of a child who is not biologically their own, often involving termination of the biological parents' rights and responsibilities." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RCUXzL8Z4Ddh2CK6TBhofjU> ;
    skos:altLabel "Adopción",
        "Adoption",
        "Adoção",
