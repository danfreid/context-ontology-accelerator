<https://folio.openlegalstandard.org/RBKT1I6J8ce2Gs6xwwFcUTr> a owl:Class ;
    rdfs:label "Appellate Practice" ;
    rdfs:comment "Any service before a court oflaw that is empowered to hear an appeal of a trial court or other lower tribunal." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R79LjWBKHCdmQKEW6zPY8Co> ;
    skos:altLabel "APP",
        "Appeal",
        "Appeals",
        "Appellate",
        "Appellate Practice",
        "Appellate Service",
