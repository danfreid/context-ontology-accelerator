<https://folio.openlegalstandard.org/RDFlPu4VKGyebs9dqmg6iFh> a owl:Class ;
    rdfs:label "Malignant Melanoma" ;
    rdfs:comment "Malignant melanoma is an aggressive type of cancer that originates in melanocytes, the cells responsible for producing melanin, the pigment that gives skin its color. This cancer can develop in the skin, eyes (ocular melanoma), or mucosal surfaces (mucosal melanoma), and is known for its high potential to metastasize to other parts of the body." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs> ;
