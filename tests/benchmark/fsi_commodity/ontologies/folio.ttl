<https://folio.openlegalstandard.org/R8ItOPdbcc8mA2sYecRl3cu> a owl:Class ;
    rdfs:label "Criminal Incarceration" ;
    rdfs:comment "The concept of Criminal Incarceration refers to the punishment of a person who has been convicted of a crime by being confined to a prison or jail for a specified period of time, as a penalty for their wrongdoing." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R0tJKDoGSixec7FgGKnAAl> ;
