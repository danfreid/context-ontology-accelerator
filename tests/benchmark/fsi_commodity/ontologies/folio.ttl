    skos:altLabel "TM" .

<https://folio.openlegalstandard.org/R688d7293074eA6C38b47f71> a owl:Class ;
    rdfs:label "California State Courts" ;
    rdfs:comment "California State Courts are the judicial branch of the California government responsible for interpreting and applying the law in civil and criminal cases within the state." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R1F4dbe4CD17b3B2a7f15b97> ;
    skos:altLabel "CA" .

<https://folio.openlegalstandard.org/R70EVLsDqbyH67OcMFU5d1p> a owl:Class ;
    rdfs:label "Crops" ;
    rdfs:comment "Crops are cultivated plants grown on a large scale for food, fiber, fuel, or other commercial purposes. They play a crucial role in agriculture and the global economy, providing essential resources for human and animal consumption, industrial uses, and energy production." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RB9zzoSs7UGZstS4ptLmvxR> ;
    skos:altLabel "Agricultural Plants",
        "Cultivated Plants",
        "Farm Crops" .

<https://folio.openlegalstandard.org/R74NaktGSuv9KJ3aBnw26GP> a owl:Class ;
    rdfs:label "Leafy Vegetables" ;
    rdfs:comment "Leafy vegetables, also known as greens, are a category of vegetables harvested primarily for their edible leaves, which are rich in vitamins, minerals, and dietary fiber. They are consumed raw or cooked and are valued for their nutritional benefits, including high levels of vitamins A, C, and K, as well as antioxidants and phytonutrients." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/Rub2xErcJ0t8GToQfoaVG1> ;
    skos:altLabel "Leafy Greens",
        "Salad Greens" .

<https://folio.openlegalstandard.org/R752LnUHc6rfnv4O2TfcpZl> a owl:Class ;
    rdfs:label "Virgin Islands Territory Courts" ;
    rdfs:comment "The Virgin Islands Territory Courts are a subset of U.S. Territory Courts and include the Virgin Islands Police Court, Virgin Islands Supreme Court, Superior Court of the Virgin Islands, Virgin Islands Territorial Court, and Virgin Islands Municipal Court." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RyItksdT5vInqyBuoGgoDr> .

<https://folio.openlegalstandard.org/R79ZnCKDSoLOn17LGjAF6G6> a owl:Class ;
    rdfs:label "Patent Subject-Matter Classifications" ;
    rdfs:comment "Patent Subject-Matter Classifications are a system of categorizing patents and patent applications based on the technical fields or subject matter they pertain to, such as chemical, mechanical, electrical, and life sciences. This classification system facilitates the organization, search, and examination of patents by grouping similar inventions together." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/Rzy5rvrKtuL8AwKrBTFfBQ> .

<https://folio.openlegalstandard.org/R7I7inwWLqKi8ZMm0Ey6dkK> a owl:Class ;
    rdfs:label "Real Estate Agreement" ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R9OVY5GWczMSrxKsf8cfgpq> .

<https://folio.openlegalstandard.org/R7J7NYI0WlIIflyMEgnXHIq> a owl:Class ;
    rdfs:label "Buyer Consent Requirement" ;
    rdfs:comment "Buyer Consent Requirement is a legal concept that refers to the obligation of a party to obtain the consent of the buyer before taking certain actions, subject to certain conditions and limitations, as specified in a negative covenant." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R3bU74bKrSAyu2rkZ4SZEa> ;
    skos:altLabel "Buyer Consent Requirement",
        "Exigence de consentement de l'acheteur",
        "Käufer-Einwilligungserfordernis",
        "Requisito de consentimento do comprador",
        "Requisito de consentimiento del comprador",
        "דרישת הסכמת הקונה",
        "खरीदार सहमति आवश्यकता",
        "バイヤーの同意要件",
        "买方同意要求" .

<https://folio.openlegalstandard.org/R7KnhbKXnWBeCBhayT7e9BY> a owl:Class ;
    rdfs:label "Supply Agreement" ;
    rdfs:comment "A supply agreement is a legally binding contract between two parties that outlines the terms and conditions for the supply and delivery of goods or services." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R88D8i8AcSTUig2X3yPbFHg> ;
    skos:altLabel "Accord d'approvisionnement",
        "Acordo de fornecimento",
        "Acuerdo de suministro",
        "Contrato de suministro",
        "Liefervereinbarung",
        "Supply Agreement",
        "הסכם אספקה",
        "आपूर्ति समझौता",
        "供应协议",
        "供給契約" .

<https://folio.openlegalstandard.org/R7MsH9WtTPf14W1GB1m8zrB> a owl:Class ;
    rdfs:label "Product Liability Claims" ;
    rdfs:comment "Product Liability Claims refer to civil tort claims that arise when a consumer is injured or suffers damages due to a defective or dangerous product, and seeks compensation from the manufacturer or seller of the product." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X> ;
    skos:altLabel "Demandas por responsabilidad del producto",
        "Product Liability Claims",
        "Produkthaftungsansprüche",
        "Reclamaciones por responsabilidad del producto",
        "Reclamações de responsabilidade do produto",
        "Réclamations en responsabilité de produit",
        "תביעות אחריות מוצר",
        "उत्पाद दायित्व दावे",
        "产品责任索赔",
        "製品責任請求" .

<https://folio.openlegalstandard.org/R7RTOi3HJBujhrMQbvqgmBZ> a owl:Class ;
    rdfs:label "Speech Disability" ;
    rdfs:comment "Speech Disability refers to impairments that affect an individual's ability to produce sounds that create words, impacting verbal communication. These disabilities can result from various causes, such as neurological disorders, physical impairments, or developmental conditions, and may affect articulation, fluency, voice, or resonance." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RC9rPAii8f99I7p4Hi5Qdia> ;
    skos:altLabel "Speech Communication Disorder",
        "Speech Deficit",
        "Speech Disorder",
        "Speech Impairment",
        "Verbal Communication Disability" .

<https://folio.openlegalstandard.org/R7UiQA8gafbU8G6XKu27y62> a owl:Class ;
    rdfs:label "Amendment Clause" ;
    rdfs:comment "An Amendment Clause is a provision in a contract that allows for changes or modifications to be made to the original agreement." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDe0RKU39BlhcyACJW30ZLc> ;
    skos:altLabel "Amendment Clause",
        "Clause de modification",
        "Cláusula de Enmienda",
        "Cláusula de Modificación",
