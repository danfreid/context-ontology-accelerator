<https://folio.openlegalstandard.org/RUCs1tfF1J4XdhUkIhPx3R> a owl:Class ;
    rdfs:label "Lung Transplantation" ;
    rdfs:comment "Lung transplantation is a surgical procedure in which one or both diseased lungs are replaced with healthy lungs from a donor. This treatment is typically considered for patients with end-stage lung disease, such as chronic obstructive pulmonary disease (COPD) or pulmonary fibrosis, who have not responded to other therapies." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RcqrMBmLwAweHAkomaAaNq> .

<https://folio.openlegalstandard.org/RUDVKmMNlScgBVLBkFrgcQ> a owl:Class ;
    rdfs:label "Equity Committee" ;
    rdfs:comment "An Equity Committee represents the interests of equity holders (shareholders) in a bankruptcy or restructuring process. This committee ensures that the rights and priorities of shareholders are considered in negotiations, particularly in scenarios where their investments are at risk of being diluted or wiped out." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RCoOnTANPIS6LCYx2SVkLJL> ;
    skos:altLabel "Equity Holders' Committee" .

