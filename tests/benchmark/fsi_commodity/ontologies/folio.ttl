        "领养",
        "養子縁組" .

<https://folio.openlegalstandard.org/RCwxVWPUdbPjn2tWtFJg6IZ> a owl:Class ;
    rdfs:label "Trespass" ;
    rdfs:comment "The act of unlawfully entering or interfering with someone else's property, whether it be real property or personal property, resulting in potential liability for the trespasser." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn> ;
    skos:altLabel "Hausfriedensbruch",
