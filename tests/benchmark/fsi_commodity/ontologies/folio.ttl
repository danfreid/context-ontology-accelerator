    skos:altLabel "DK" .

<https://folio.openlegalstandard.org/R1F90737631a64BFab93D83e> a owl:Class ;
    rdfs:label "Georgia State Courts" ;
    rdfs:comment "Georgia State Courts are the judicial branches of the government of the state of Georgia, responsible for interpreting and enforcing the laws of the state." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R1F4dbe4CD17b3B2a7f15b97> ;
    skos:altLabel "GA" .

<https://folio.openlegalstandard.org/R2Kr3kWHR9cR4zALXqt1nM> a owl:Class ;
    rdfs:label "Structured Certificate" ;
    rdfs:comment "A Structured Certificate is a financial instrument that combines features of fixed income securities and derivatives to offer customized risk-return profiles based on the performance of underlying assets. It typically provides exposure to various asset classes while offering some form of principal protection or enhanced returns under specific market conditions." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RBVQj7fYsBw67yNXs4WI6RX> .

<https://folio.openlegalstandard.org/R3E5f6b5B7244860b4e4B5e3> a owl:Class ;
    rdfs:label "Florida District Court of Appeals" ;
    rdfs:comment "Fla. Dist. Ct. App." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R97075cD0123f97C9e3AC116> ;
    skos:altLabel "FLADISTCTAPP" .

<https://folio.openlegalstandard.org/R3OI7nrib1LEPtUfn5G5CH> a owl:Class ;
    rdfs:label "Bequest" ;
    rdfs:comment "A Bequest is a provision in a will or trust that designates the transfer of specific assets, property, or money to a particular beneficiary upon the death of the testator. It ensures that the intended recipients receive the designated items as part of the estate distribution." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8M0UJWeEVpeK5gMPLTQSl2> ;
    skos:altLabel "Estate Gift",
        "Inheritance Gift",
        "Inherited Bequest",
        "Legacy",
        "Testamentary Gift" .

<https://folio.openlegalstandard.org/R527Rr0DAZ1Lu9VPx6QRbj> a owl:Class ;
    rdfs:label "Tax Practice" ;
    rdfs:comment "Tax practice refers lawyers assisting individuals or organizations in navigating tax laws, including compliance, filing returns, and handling disputes with tax authorities. These lawyers may also advise on tax planning strategies to optimize tax liability and benefit" ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RBWo88jsbY4qHzhlTFr5Np7> ;
    skos:altLabel "Tax",
        "Tax Service" .

<https://folio.openlegalstandard.org/R5403b7ED64ea54Ee25297c2> a owl:Class ;
    rdfs:label "Massachusetts State Courts" ;
    rdfs:comment "The Massachusetts State Courts refer to the judicial system of Massachusetts, including the Massachusetts District Court, Massachusetts Appeals Court, Massachusetts Supreme Judicial Court, Massachusetts Trial Court, and Massachusetts Department of Industrial Accidents." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R1F4dbe4CD17b3B2a7f15b97> ;
    skos:altLabel "MA" .

<https://folio.openlegalstandard.org/R55E0bdA4190f26580e9A380> a owl:Class ;
    rdfs:label "Turkmenistan" ;
