<https://folio.openlegalstandard.org/R8sLSP3fcYlpo2TNHbyFkQ8> a owl:Class ;
    rdfs:label "Secondary Offering Practice" ;
    rdfs:comment "Secondary Offering Practice involves the sale of shares by existing shareholders, typically through a public offering, after the company's initial public offering (IPO). It includes the legal and regulatory processes to ensure compliance with securities laws and protect investors' interests." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R5mVKmojg3FKSzxupI6FLy> ;
