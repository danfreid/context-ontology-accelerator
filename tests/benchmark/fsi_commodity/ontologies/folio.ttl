<https://folio.openlegalstandard.org/RCgUkOdOjwvB2yJwL59gBUf> a owl:Class ;
    rdfs:label "Auditor" ;
    rdfs:comment "A person who conducts audits and investigates accounting functions of a private or governmental entity." ;
