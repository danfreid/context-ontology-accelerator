<https://folio.openlegalstandard.org/R8Gzr9WKsdck4rRcLAqMHej> a owl:Class ;
    rdfs:label "Nuisance" ;
    rdfs:comment "A nuisance is a legal claim that arises from the use of one's property or conduct that interferes with another's use or enjoyment of their property, resulting in harm or annoyance." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDSBerlLWg1ntpLqDQn1eVn> ;
