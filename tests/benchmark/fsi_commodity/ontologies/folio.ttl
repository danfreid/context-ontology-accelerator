<https://folio.openlegalstandard.org/Ri4LGaOgWzMWy2yX79DQi0> a owl:Class ;
    rdfs:label "Hemolytic Anemias" ;
    rdfs:comment "Hemolytic Anemias are a group of conditions characterized by the premature destruction of red blood cells, leading to a decreased number of circulating red blood cells and a resultant anemia. The condition can be caused by intrinsic factors, such as genetic defects, or extrinsic factors, such as autoimmune reactions or infections." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7O2ClQ73HLZZLgFgtNbVTF> .

<https://folio.openlegalstandard.org/Rijn2Efl5I4ixKTA86MDfT> a owl:Class ;
    rdfs:label "Spinal Cord Disorders" ;
    rdfs:comment "Spinal cord disorders involve conditions that affect the spinal cord, impairing its function and potentially causing a range of neurological and physical disabilities. These disorders can result from trauma, disease, or degeneration, impacting the transmission of nerve signals between the brain and the rest of the body." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH> ;
    skos:altLabel "Spinal Cord Disease",
        "Spinal Cord Injury" .

<https://folio.openlegalstandard.org/RioWfXa6EStqdylbbgrK0lA> a owl:Class ;
