<https://folio.openlegalstandard.org/R86KwDCIco0lQwycGRDQ7M1> a owl:Class ;
    rdfs:label "Abuse of Adults" ;
    rdfs:comment "The mistreatment or harm of an adult who is dependent on another person, which can result in civil claims. This includes abuse of adults who are dependent on their children or elderly individuals." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X> ;
