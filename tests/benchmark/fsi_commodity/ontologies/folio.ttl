        "控訴手続き" .

<https://folio.openlegalstandard.org/RBNTLgdEoQpfLgYExWmsFao> a owl:Class ;
    rdfs:label "Public Benefit Document" ;
    rdfs:comment "A public benefit document is an official form, notification, or record associated with a government-provided public assistance program. These documents may include applications, eligibility criteria, award letters, or notices of changes to benefits, and serve as the legal foundation for the provision and management of public benefits to individuals or families." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RBCzyIAi2Hjl80hfQr8wAMR> .

<https://folio.openlegalstandard.org/RBPD5CT0qSBTNnFlNAZ6kln> a owl:Class ;
    rdfs:label "Medical Form" ;
    rdfs:comment "A Medical Form is a standardized document used within healthcare settings for collecting, storing, or conveying information related to a patient's medical history, condition, or treatment. Examples include consent forms, referral forms, and records release forms." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RBOz1UXsX4cnOePooNnJ6Xc> ;
    skos:altLabel "Clinical Data Sheet",
        "Patient Form" .

<https://folio.openlegalstandard.org/RBRPjYycc1QcWOn4irY0BW9> a owl:Class ;
    rdfs:label "Residential Real Estate Asset" ;
    rdfs:comment "A Residential Real Estate Asset is a property designated for residential use, including houses, townhouses, condominiums, and mobile homes." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RUhSbbDJZa8Crs3tIWcIfV> ;
