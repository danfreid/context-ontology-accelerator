<https://folio.openlegalstandard.org/RCoXvGg5LXK9dGHQMqGPNCe> a owl:Class ;
    rdfs:label "Originality" ;
    rdfs:comment "Originality in copyright law requires that a work must be independently created and possess a minimum degree of creativity. This concept ensures that copyright protection is granted only to works that reflect the author's own intellectual effort and not mere copies or trivial variations of existing works." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy> ;
    skos:altLabel "Creative" .

