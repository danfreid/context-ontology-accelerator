        "बैंकिंग और क्रेडिट उद्योग",
        "銀行・クレジット業界",
        "银行和信贷行业" .

<https://folio.openlegalstandard.org/RBXoCwCeY64Ow60nWKSZCC> a owl:Class ;
    rdfs:label "Health-Conscious Market Segment" ;
    rdfs:comment "The health-conscious segment refers to a portion of the market that is characterized by consumers who prioritize health and wellness in their purchasing decisions. This segment includes products and services that are designed to promote physical, mental, and emotional well-being, catering to individuals who seek a healthy lifestyle." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8Tktpdf3HuYd3nI7nf9xQU> .

<https://folio.openlegalstandard.org/RBbkOoA0Hp0UmEnkGJOjs6D> a owl:Class ;
    rdfs:label "Skin Disorders" ;
    rdfs:comment "Skin disorders encompass a range of conditions affecting the skin's structure and function, including inflammatory, infectious, and neoplastic diseases. These disorders can cause symptoms such as rashes, lesions, and systemic effects that impair the skin's ability to protect the body." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RD12xMI38C0qkkx19ISgWWD> ;
    skos:altLabel "Cutaneous Disorders" .

<https://folio.openlegalstandard.org/RBc5RGWuFjIluthibNwahF6> a owl:Class ;
    rdfs:label "Telecommunications Industry" ;
    rdfs:comment "Industries in this group provide telecommunications and the services related to that activity (e.g., telephony, including Voice over Internet Protocol (VoIP); cable and satellite television distribution services; Internet access; telecommunications reselling services). The group is primarily engaged in operating, and/or providing access to facilities for the transmission of voice, data, text, sound, and video." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RHwCmZ2yKrJobzC86GC6Ep> ;
    skos:altLabel "Industria de las Telecomunicaciones",
        "Industrie des télécommunications",
        "Indústria de telecomunicações",
        "TELE",
        "Telecommunications",
        "Telecommunications Industry",
        "Telekommunikationsbranche",
