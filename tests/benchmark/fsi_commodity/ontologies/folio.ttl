<https://folio.openlegalstandard.org/RmiYQJshZzYvIsqEWLjj1x> a owl:Class ;
    rdfs:label "Export Control Claims" ;
    rdfs:comment "An Export Control Claim arises when an individual or entity is accused of violating regulations that govern the export, re-export, and transfer of controlled goods, technology, and services. This claim involves allegations of unauthorized exports, failure to obtain necessary licenses, or exporting to prohibited destinations or entities." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R9LVBKjvGRuzwgtlhuLST36> ;
