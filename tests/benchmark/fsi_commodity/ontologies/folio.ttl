<https://folio.openlegalstandard.org/R76RHEQOV5lf5HrdZ6uL0sf> a owl:Class ;
    rdfs:label "Bias" ;
    rdfs:comment "Bias refers to a preconceived opinion or inclination that affects an individual's ability to make fair, objective, and impartial judgments. In a legal context, bias can compromise the fairness of legal proceedings and may be grounds for disqualification of an Actor (e.g., juror, witness, prosecutor, judge)." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8jYAnNATrfoBxAtIKpf72X> .

<https://folio.openlegalstandard.org/R77Cad28AAf260122cc9B742> a owl:Class ;
