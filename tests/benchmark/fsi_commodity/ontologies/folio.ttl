<https://folio.openlegalstandard.org/RCC6qZKk4vInl0VVZfVhnNp> a owl:Class ;
    rdfs:label "Bus Lane Violation Claim" ;
    rdfs:comment "A Bus Lane Violation Claim involves allegations that a driver has unlawfully used a bus lane designated solely for buses, potentially impeding public transport efficiency and violating traffic regulations. These claims aim to uphold the integrity of public transit lanes and typically result in fines or other penalties to enforce compliance." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7hDCTMLoPZrFgIFAMlNHvf> ;
