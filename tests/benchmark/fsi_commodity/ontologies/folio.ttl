<https://folio.openlegalstandard.org/R8YfXog92OHuOj0eFmQBB4> a owl:Class ;
    rdfs:label "Skin Cancer" ;
    rdfs:comment "Skin cancer is a type of cancer that begins in the cells of the skin. It includes various forms, such as basal cell carcinoma, squamous cell carcinoma, and melanoma, each requiring specific treatments like surgery, radiation therapy, chemotherapy, and immunotherapy." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs> ;
