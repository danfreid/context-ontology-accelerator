<https://folio.openlegalstandard.org/RCcONOqbeZp3iIDXbl7spOT> a owl:Class ;
    rdfs:label "Employee Disciplinary Event" ;
    rdfs:comment "An Employment Disciplinary Event refers to actions taken by an employer to address an employee's misconduct, performance issues, or violations of company policies, short of termination. These actions can include warnings, suspensions, mandatory training, or demotion." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RBila9ckW95W84Tk54tGfZO> ;
