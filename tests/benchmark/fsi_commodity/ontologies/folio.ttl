    rdfs:comment "Moral Rights in copyright law refer to the rights of creators to protect the personal and reputational value of their works. These rights typically include the right to claim authorship, the right to prevent distortion or mutilation, and the right to withdraw or alter the work." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8O3PoolmgHAy2hrZsguhqy> .

<https://folio.openlegalstandard.org/R9Idcfy3k3uRwC4XohbcMAg> a owl:Class ;
    rdfs:label "Evidentiary Objection" ;
    rdfs:comment "An evidentiary objection is a formal protest raised by a party in a legal proceeding, challenging the admissibility of specific evidence. Common grounds for such objections include lack of foundation, hearsay, irrelevance, and prejudicial nature." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RrwKWn7PQLCSscgstTNLqf> ;
    skos:altLabel "Admissibility challenge" .

