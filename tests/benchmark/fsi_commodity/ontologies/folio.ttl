<https://folio.openlegalstandard.org/RdJQsU95Vq3NCs4Q7326F5> a owl:Class ;
    rdfs:label "Idea Misappropriation" ;
    rdfs:comment "The unauthorized use or theft of someone else's original idea, without their permission or compensation, which can be claimed as a violation of intellectual property rights." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RJL4HDUmZp1VEEZ7lCwSSF> ;
