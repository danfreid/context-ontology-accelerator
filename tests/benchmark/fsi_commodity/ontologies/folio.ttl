<https://folio.openlegalstandard.org/R77n3Z14OcgllZTAx8sw9xZ> a owl:Class ;
    rdfs:label "Legal Argument" ;
    rdfs:comment "A legal argument is a structured presentation of facts and law aimed at persuading a court to reach a specific ruling or judgment. It can be made orally in court, written in briefs, or submitted electronically, and typically includes citations to statutes, regulations, and case law to support the position taken." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDmbgHQXJxEvx3QYfR6qWAn> .

<https://folio.openlegalstandard.org/R77rieb3DsQdxBQrzBKyb0k> a owl:Class ;
    rdfs:label "Debts" ;
    rdfs:comment "Debts are financial obligations that require an individual or entity to repay borrowed money or assets to a lender according to agreed-upon terms. These obligations can take various forms, including loans, bonds, or promissory notes, and may accrue interest over time." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDMogej8AdNSlkztHiKlIGK> .

<https://folio.openlegalstandard.org/R7898901BE0daF16ddaD4ec8> a owl:Class ;
