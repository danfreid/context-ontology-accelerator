<https://folio.openlegalstandard.org/R8xzICx2jmaNf0lhp5OGKx> a owl:Class ;
    rdfs:label "Copyright Infringement" ;
    rdfs:comment "The unauthorized use or reproduction of a copyrighted work, without the permission of the owner, which may include copying, distributing, displaying, or performing the work." ;
