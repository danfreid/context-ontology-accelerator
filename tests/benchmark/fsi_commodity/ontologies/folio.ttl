<https://folio.openlegalstandard.org/RBDTPeYwNkU855npTtnlA0q> a owl:Class ;
    rdfs:label "Spendthrift Trust" ;
    rdfs:comment "A Spendthrift Trust is a trust established to provide financial support to a beneficiary while protecting the trust assets from the beneficiary's creditors or reckless spending. The trustee has control over the distribution of funds to ensure they are used for the beneficiary's welfare in accordance with the trust's terms." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R9KvzcwdZ3asqh9BPZRGWR7> ;
