<https://folio.openlegalstandard.org/RCjgFvO2VxpIklnhZMbSD9k> a owl:Class ;
    rdfs:label "Health Insurance Policy" ;
    rdfs:comment "A health insurance policy is an agreement between an insurer and a policyholder wherein the insurer covers part or all of the policyholder's healthcare costs in exchange for premium payments. The policy specifies what medical services are covered, the network of healthcare providers, and any co-payments, deductibles, or other financial responsibilities for the insured." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R9uTFHGFCMBjtYw5MOmpotJ> .

<https://folio.openlegalstandard.org/RCkDbrXh0odYXI7GjSkjxzE> a owl:Class ;
