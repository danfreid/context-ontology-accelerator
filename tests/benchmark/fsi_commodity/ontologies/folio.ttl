        "公正な裁判の権利",
        "公正审判权" .

<https://folio.openlegalstandard.org/RBU1MPZclWmAITpDAoWCKm1> a owl:Class ;
    rdfs:label "Confidential" ;
    rdfs:comment "Confidential is a security classification level used for information that requires protection because its unauthorized disclosure could cause damage to the organization (e.g., company, nation). Access to confidential information is restricted to individuals with the appropriate security clearance and a demonstrated need to know." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R89ziIl0nXs5c4ONtS7qXTP> ;
    skos:altLabel "Protected Data",
        "Restricted Information",
        "Sensitive Information" .

<https://folio.openlegalstandard.org/RBU1z7AUARMHEr7RMR6feWY> a owl:Class ;
    rdfs:label "Undeveloped - Real Estate Asset" ;
    rdfs:comment "An \"Undeveloped Real Estate Asset\" refers to parcels of land that have not yet been altered or improved for specific use. The associated legal matters typically involve zoning laws, land use rights, environmental assessments, and property taxation." ;
