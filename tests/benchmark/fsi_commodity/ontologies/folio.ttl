<https://folio.openlegalstandard.org/RCiwr86zmjFFCLgof7UXAiU> a owl:Class ;
    rdfs:label "Warrants - Assets" ;
    rdfs:comment "A warrant is a derivative that gives the right, but not the obligation, to buy or sell a security-most commonly an equity-at a certain price before the expiration. The price at which the underlying security can be bought or sold is referred to as the exer" ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RB5FdDMLLaFHBHANY4bMB3T> ;
