    rdfs:label "JI00 Case and Costs Management Hearings (UK J-CODE)" ;
    rdfs:comment "Work relating to such hearings and the preparation for them, including PTR and CMC’s. This does not include interim applications heard at the same time." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RCAZQP6AHCQX7HNZqzV7oIR> .

<https://folio.openlegalstandard.org/RCr24hGjy5GJ6AOHToVT7YN> a owl:Class ;
    rdfs:label "M&A Purchase Agreement" ;
    rdfs:comment "A M&A Purchase Agreement is a legal document that outlines the terms and conditions of a merger or acquisition transaction between two companies." ;
