    rdfs:label "Degree of Payment Completeness" ;
    rdfs:comment "Degree of Payment Completeness refers to the extent to which a financial obligation or transaction has been fulfilled. This attribute encompasses varying levels of payment completion, such as nothing paid, partial payment (including installment payments), and full payment." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R9sdPQV8kCK3BNF8jcPV5cD> ;
