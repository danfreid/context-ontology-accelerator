<https://folio.openlegalstandard.org/R8mhr9YGlyTNig0Qdru2f4t> a owl:Class ;
    rdfs:label "Synchronous Communication" ;
    rdfs:comment "A communication that occurs synchronously (at the same time), such as an in-person meeting, telephone call, or videoconference." ;
