<https://folio.openlegalstandard.org/RgHUj7ZKoJL0s6JURcX8OI> a owl:Class ;
    rdfs:label "Suspension of Sentence" ;
    rdfs:comment "A Suspension of Sentence is a legal provision where a court imposes a sentence but delays or refrains from executing it, typically on certain conditions. This approach allows the offender to remain in the community under supervision, with the understanding that violating the conditions may result in the original sentence being imposed." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R8fFf9YNTCtz4Q15Jjj7AXF> ;
