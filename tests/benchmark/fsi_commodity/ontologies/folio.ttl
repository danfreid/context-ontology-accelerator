<https://folio.openlegalstandard.org/RQbVKPVl5dj5nW6aXoNxx4> a owl:Class ;
    rdfs:label "Price-Based Market Segments" ;
    rdfs:comment "Price-based segments refer to divisions of the market that are categorized based on the pricing and affordability of products and services. These segments include luxury, budget, and mass market, each targeting consumers with different levels of purchasing power and preferences for price versus quality." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7KxYUBMSAuzPHdBhWfPSv7> .

<https://folio.openlegalstandard.org/RRR2i6KF52EMANSCZJce4j> a owl:Class ;
    rdfs:label "Online Dispute Resolution Forum" ;
    rdfs:comment "An Online Dispute Resolution (ODR) Forum is a type of Alternative Dispute Resolution (ADR) Forum that operates through digital means, either with or without human facilitation, to resolve disputes between parties." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RC8gGTL4dazXLDWuElLZLjI> ;
