<https://folio.openlegalstandard.org/R9LBsMo1i6vrjdqZMZJ3mmq> a owl:Class ;
    rdfs:label "Esophagus or Stomach Cancer" ;
    rdfs:comment "Esophagus or stomach cancer refers to malignant tumors that originate in the esophagus or stomach, significantly impacting the digestive system. These cancers can affect swallowing, digestion, and nutrient absorption, often requiring a combination of treatments such as surgery, chemotherapy, and radiation therapy." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDF3VrmH1eapfkrSQstevLs> ;
