<https://folio.openlegalstandard.org/R8D6zCNSxUO8g0ZstLxnK28> a owl:Class ;
    rdfs:label "Chronic Obstructive Pulmonary Disease" ;
    rdfs:comment "Chronic Obstructive Pulmonary Disease (COPD) is a progressive respiratory condition characterized by persistent airflow limitation due to chronic inflammation of the airways and lung tissue. The most common forms of COPD are chronic bronchitis and emphysema, leading to symptoms such as chronic cough, breathlessness, and reduced lung function, necessitating ongoing management and treatment." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RcqrMBmLwAweHAkomaAaNq> ;
    skos:altLabel "COPD" .

