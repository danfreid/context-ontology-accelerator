        "允许合同撤销的不合理性" .

<https://folio.openlegalstandard.org/R8paNAt8rFPV0BKzwRBKnQ4> a owl:Class ;
    rdfs:label "Disorders of Thrombosis and Hemostasis" ;
    rdfs:comment "Disorders of thrombosis and hemostasis are conditions affecting the body's ability to form and dissolve blood clots. These disorders include both excessive clotting (thrombosis) and problems with blood clotting (hemorrhage), leading to an increased risk of either unwanted clot formation or bleeding." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7O2ClQ73HLZZLgFgtNbVTF> ;
    skos:altLabel "Clotting Disorders" .

<https://folio.openlegalstandard.org/R8pf9ONP6CajS4BilFsvW0l> a owl:Class ;
    rdfs:label "Total Amount - Fee or Expense" ;
