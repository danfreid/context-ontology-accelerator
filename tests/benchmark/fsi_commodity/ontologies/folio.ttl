<https://folio.openlegalstandard.org/RrYc14SDMHyXfplFhiI2Ok> a owl:Class ;
    rdfs:label "Unsecured Creditor" ;
    rdfs:comment "An unsecured creditor is an individual or institution that lends money without obtaining specified assets as collateral. If a borrower fails to make payment on debt that is unsecured, the creditor cannot take any of the borrower's assets without winning a lawsuit first." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7PHFZzZmVmczzNQl6iZKsa> ;
