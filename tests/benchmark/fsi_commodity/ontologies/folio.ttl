        "电信行业",
        "通信産業" .

<https://folio.openlegalstandard.org/RBfgMJEBmJrI7Wp0zUjROJ3> a owl:Class ;
    rdfs:label "Temporary Employee" ;
    rdfs:comment "A Temporary Employee is an individual hired for a specific, limited period, often to assist with seasonal workloads or to fill in for a regular employee who is absent. Temporary employees may or may not have access to company benefits, and their employment is generally terminated when the specified period or project is completed." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RBY4j5UKZ7L8gp0q9Wrxyge> .

<https://folio.openlegalstandard.org/RBgKnOpRzmN0EAjwIwILJoc> a owl:Class ;
    rdfs:label "Elements of Criminal Claim" ;
    rdfs:comment "The Elements of Criminal Claim refer to the specific components that must be proven in a criminal case, including the harm caused, the intent of the accused, and the causal link between the two." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/RDspRIwoJTlopUDjSgLRduf> ;
    skos:altLabel "Elemente des Strafanspruchs",
        "Elementos da ação penal",
        "Elementos de la Demanda Penal",
        "Elements of Criminal Claim",
        "Éléments de la demande pénale",
        "אלמנטים של תביעה פלילית",
        "आपराधिक दावे के तत्व",
        "刑事索赔要素",
        "刑事請求の要素" .

<https://folio.openlegalstandard.org/RBgzWJQz52CrObfGXDKH1t7> a owl:Class ;
    rdfs:label "Trial Court Practice" ;
    rdfs:comment "Trial Court Practice refers to the legal work performed by a Legal Services Provider in the course of a legal matter that involves presenting evidence and arguments before a judge or jury in a trial court, including procedures and rules specific to district courts." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R79LjWBKHCdmQKEW6zPY8Co> ;
