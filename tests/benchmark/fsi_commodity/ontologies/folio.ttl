<https://folio.openlegalstandard.org/RgHKgBYfidbNNddNK2ube4> a owl:Class ;
    rdfs:label "Individualized Restructuring" ;
    rdfs:comment "Individualized restructuring involves private negotiations between a debtor and one or more creditors to modify the terms of existing debt agreements. This process allows parties to tailor solutions to their specific needs without court intervention, often resulting in revised payment schedules, reduced interest rates, or partial debt forgiveness." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R9HPXBgZpsNyy2AbQLv1rLG> ;
