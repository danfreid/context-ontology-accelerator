<https://folio.openlegalstandard.org/R8u4eipKZkVmT9acNJCHM1U> a owl:Class ;
    rdfs:label "Parkinson's Disease" ;
    rdfs:comment "Parkinson's disease is a progressive neurodegenerative disorder characterized by the loss of dopamine-producing neurons in the brain, leading to motor symptoms such as tremors, rigidity, bradykinesia (slowness of movement), and postural instability. It also includes non-motor symptoms like cognitive impairment, mood disorders, and autonomic dysfunction, requiring comprehensive medical and supportive care." ;
    rdfs:subClassOf <https://folio.openlegalstandard.org/R7M8wW11LJaLtWjQS7DmTQH> ;
    skos:altLabel "Neurodegenerative Motor Disorder",
        "Paralysis Agitans" .

