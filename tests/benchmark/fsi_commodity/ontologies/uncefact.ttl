    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductBatchCharacteristic> a owl:Class ;
    rdfs:label "ProductBatchCharacteristic" ;
    rdfs:comment "A prominent attribute or aspect of a group of products considered or dealt with together." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductGroup> a owl:Class ;
    rdfs:label "ProductGroup" ;
    rdfs:comment "A grouping of trade products." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductionDevice> a owl:Class ;
    rdfs:label "ProductionDevice" ;
    rdfs:comment "An object, especially a piece of mechanical or electronic equipment, made or adapted in order to perform a production activity." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductionUnit> a owl:Class ;
    rdfs:label "ProductionUnit" ;
    rdfs:comment "A defined set of production processes under the single management of a facility." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/QuantityAnalysis> a owl:Class ;
    rdfs:label "QuantityAnalysis" ;
    rdfs:comment "The quantity analysis for this work item." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/RadioactiveIsotope> a owl:Class ;
    rdfs:label "RadioactiveIsotope" ;
    rdfs:comment "Any of several species of the same chemical element with different masses whose nuclei are unstable and dissipate excess energy by spontaneously emitting radiation in the form of alpha, beta, or gamma rays." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ReferencePrice> a owl:Class ;
    rdfs:label "ReferencePrice" ;
    rdfs:comment "A reference to a sum of money for which something is or may be bought or sold." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ReturnableAssetInstructions> a owl:Class ;
    rdfs:label "ReturnableAssetInstructions" ;
    rdfs:comment "The procedures to follow for returnable assets, such as reusable packaging (pallets, crates)." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpeciesTTAnimal> a owl:Class ;
    rdfs:label "SpeciesTTAnimal" ;
    rdfs:comment "The species of a Track and Trace (TT) animal or batch of animals." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedMethod> a owl:Class ;
    rdfs:label "SpecifiedMethod" ;
    rdfs:comment "A defined way of performing something." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedNote> a owl:Class ;
    rdfs:label "SpecifiedNote" ;
    rdfs:comment "A specified textual or coded description, such as a remark or additional information." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedParameter> a owl:Class ;
    rdfs:label "SpecifiedParameter" ;
    rdfs:comment "A specified feature that is fixed for the case in question but may be different in other cases." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TTExchangedDocument> a owl:Class ;
    rdfs:label "TTExchangedDocument" ;
    rdfs:comment "A collection of data for a piece of written, printed or electronic matter that is exchanged between two or more parties for Track and Trace (TT) purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TTTransformationEvent> a owl:Class ;
    rdfs:label "TTTransformationEvent" ;
    rdfs:comment "Information about an event that captures the relationship between one or more physical or digital objects identified by identifiers, such as an EPC (Electronic Product Code) or EPC class, that are fully or partially consumed as inputs or as outputs." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportSettingTemperature> a owl:Class ;
    rdfs:label "TransportSettingTemperature" ;
    rdfs:comment "Temperature settings for a transport movement, such as a required storage temperature range." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/XHEDocument> a owl:Class ;
    rdfs:label "XHEDocument" ;
    rdfs:comment "A collection of data for electronic matter that provides XHE (Exchange Header Envelope) information or evidence." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AdvancePayment> a owl:Class ;
    rdfs:label "AdvancePayment" ;
    rdfs:comment "A prepaid discharge of obligations in respect of funds or securities transferred between two or more parties." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CommunicationEvent> a owl:Class ;
    rdfs:label "CommunicationEvent" ;
    rdfs:comment "A significant occurrence or happening communicated by means of sending or receiving information, such as transmitting digital data by using the internet." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ComplexDescription> a owl:Class ;
    rdfs:label "ComplexDescription" ;
    rdfs:comment "An aggregation of descriptive information consisting of different but related characteristics that together constitute a work item complex description." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Convoy> a owl:Class ;
    rdfs:label "Convoy" ;
    rdfs:comment "A number of means of transport following each other with a common logistics purpose." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CountrySubDivision> a owl:Class ;
    rdfs:label "CountrySubDivision" ;
    rdfs:comment "A political or physical area or region within the political boundaries of a country used or referenced for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CustomerClass> a owl:Class ;
    rdfs:label "CustomerClass" ;
    rdfs:comment "The conditions and requirements of the type of person who may use or purchase a product or service." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DigitalMethod> a owl:Class ;
    rdfs:label "DigitalMethod" ;
    rdfs:comment "The use of online and digital technologies to collect monetary payment amounts." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Envelope> a owl:Class ;
    rdfs:label "Envelope" ;
    rdfs:comment "A structure providing XHE (Exchange Header Envelope) information." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/FinancingSummaryDocument> a owl:Class ;
    rdfs:label "FinancingSummaryDocument" ;
    rdfs:comment "A collection of financing related data that provides an overview of key points." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/GeographicalObjectCharacteristic> a owl:Class ;
    rdfs:label "GeographicalObjectCharacteristic" ;
    rdfs:comment "An attribute of a geographical object." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/InstructedTemperature> a owl:Class ;
    rdfs:label "InstructedTemperature" ;
    rdfs:comment "Temperature settings instructed for storage or movement of goods." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LaboratoryObservationParty> a owl:Class ;
    rdfs:label "LaboratoryObservationParty" ;
    rdfs:comment "An individual, group, or body having a role in laboratory observations." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Licence> a owl:Class ;
    rdfs:label "Licence" ;
    rdfs:comment "A permit from an authority to own or use something, do a particular thing, or to conduct a trade." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LineTradeSettlement> a owl:Class ;
    rdfs:label "LineTradeSettlement" ;
    rdfs:comment "The information, at a line level, that enables the reconciliation of a financial transaction with the item(s) that the financial transaction is intended to settle, for example a commercial invoice." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/MetricCharacteristic> a owl:Class ;
    rdfs:label "MetricCharacteristic" ;
    rdfs:comment "A prominent attribute or aspect of a metric (a standard of measurement)." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Object> a owl:Class ;
    rdfs:label "Object" ;
    rdfs:comment "Anything that is visible or tangible, such as a product, process, or organization." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Produce> a owl:Class ;
    rdfs:label "Produce" ;
    rdfs:comment "Agricultural plants or plant products grown and harvested, such as grain, fruit, vegetables, silage." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Project> a owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "An endeavour carefully planned to achieve a procurement of goods, works and service." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/RegisteredTax> a owl:Class ;
    rdfs:label "RegisteredTax" ;
    rdfs:comment "A registered tax or duty system pertaining to an authority." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Source> a owl:Class ;
    rdfs:label "Source" ;
    rdfs:comment "A place from which water originates, such as a hot spring or lake that provides water to public drinking water supplies and private wells." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedFault> a owl:Class ;
    rdfs:label "SpecifiedFault" ;
    rdfs:comment "An unattractive or unsatisfactory characteristic." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedInspection> a owl:Class ;
    rdfs:label "SpecifiedInspection" ;
    rdfs:comment "The process of performing documented checks, such as on materials or processes, with a focus on discovering deviations, errors or faults related to documented requirements." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedRoute> a owl:Class ;
    rdfs:label "SpecifiedRoute" ;
    rdfs:comment "A specified way or course taken from one location to another." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeLocation> a owl:Class ;
    rdfs:label "TradeLocation" ;
    rdfs:comment "A physical location or place used or referenced for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/UsageCondition> a owl:Class ;
    rdfs:label "UsageCondition" ;
    rdfs:comment "The particular state of something, affected by use, that should be respected." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/WorkItemDimension> a owl:Class ;
    rdfs:label "WorkItemDimension" ;
    rdfs:comment "A measure of spatial extent associated with this work item, such as length, breadth, or height." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AppliedAllowanceCharge> a owl:Class ;
    rdfs:label "AppliedAllowanceCharge" ;
    rdfs:comment "The applied allowance or charge component of pricing." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Assertion> a owl:Class ;
    rdfs:label "Assertion" ;
    rdfs:comment "A statement that user needs of the present are met without compromising the needs of future generations." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/BreakdownStatement> a owl:Class ;
    rdfs:label "BreakdownStatement" ;
    rdfs:comment "A detailed statement of work, prices, and dimensions for this valuation." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Clause> a owl:Class ;
    rdfs:label "Clause" ;
    rdfs:comment "A distinct article or provision in a document, which requires compliance." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Contract> a owl:Class ;
    rdfs:label "Contract" ;
    rdfs:comment "An agreement between two or more parties for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DisposalInstructions> a owl:Class ;
    rdfs:label "DisposalInstructions" ;
    rdfs:comment "A set of instructions detailing how to properly dispose of a material." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DocumentCharacteristic> a owl:Class ;
    rdfs:label "DocumentCharacteristic" ;
    rdfs:comment "A prominent attribute or aspect of a document." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/FinancialAdjustment> a owl:Class ;
    rdfs:label "FinancialAdjustment" ;
    rdfs:comment "A correction or modification to reflect actual financial conditions." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/IngredientRangeMeasurement> a owl:Class ;
    rdfs:label "IngredientRangeMeasurement" ;
    rdfs:comment "A measurement of the variation limits of an ingredient." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LanguageProficiency> a owl:Class ;
    rdfs:label "LanguageProficiency" ;
    rdfs:comment "Skills in any principal method of human communication, consisting of words used in a structured and conventional way and conveyed by speech, writing, or gesture." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LegalOrganization> a owl:Class ;
    rdfs:label "LegalOrganization" ;
    rdfs:comment "An organization set up on a legal basis as a business, government body, department, charity, or financial institution." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LocationParty> a owl:Class ;
    rdfs:label "LocationParty" ;
    rdfs:comment "An individual, a group, or a body having a role related to a location." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Measurement> a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "An amount, size, or extent as established by measuring." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/PortMovementEvent> a owl:Class ;
    rdfs:label "PortMovementEvent" ;
    rdfs:comment "A movement of a vessel during a port call." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductCharacteristic> a owl:Class ;
    rdfs:label "ProductCharacteristic" ;
    rdfs:comment "A prominent attribute or aspect of a product." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductLabel> a owl:Class ;
    rdfs:label "ProductLabel" ;
    rdfs:comment "A label, such as a garment label or a radio frequency tag, used for identifying a product." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Range> a owl:Class ;
    rdfs:label "Range" ;
    rdfs:comment "A row, line or series, commonly used to express the difference between lowest and highest values." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Schedule> a owl:Class ;
    rdfs:label "Schedule" ;
    rdfs:comment "A series of planned activities or things to be done in this supply chain." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Sensor> a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "An object which can detect and measure physical properties and which can record, indicate and transmit such measurements." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ShippingMarks> a owl:Class ;
    rdfs:label "ShippingMarks" ;
    rdfs:comment "Physical markings or labels on individual packages or transport units for logistics purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SustainabilityCharacteristic> a owl:Class ;
    rdfs:label "SustainabilityCharacteristic" ;
    rdfs:comment "A prominent attribute or aspect of an object, such as recyclability of a product, which can meet customer needs without compromising the ability of future generations to meet their own needs." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TTLocation> a owl:Class ;
    rdfs:label "TTLocation" ;
    rdfs:comment "A physical place related to a Track and Trace (TT) process." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TechnicalCharacteristic> a owl:Class ;
    rdfs:label "TechnicalCharacteristic" ;
    rdfs:comment "A prominent technical attribute or aspect." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeSettlementMonetarySummation> a owl:Class ;
    rdfs:label "TradeSettlementMonetarySummation" ;
    rdfs:comment "A collection of monetary amount totals specified for a trade settlement." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportationWasteMaterialComponent> a owl:Class ;
    rdfs:label "TransportationWasteMaterialComponent" ;
    rdfs:comment "An unused and rejected as unwanted component of transport material resulting from transportation." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Accreditation> a owl:Class ;
    rdfs:label "Accreditation" ;
    rdfs:comment "A certified recognition that provides evidence of a level of competency in a given area, such as certifying a level of skill in a trade." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AnimalCertification> a owl:Class ;
    rdfs:label "AnimalCertification" ;
    rdfs:comment "The process of certifying that a certain animal has met performance and quality assurance requirements, or qualification requirements as stipulated in regulations." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CalibratedMeasurement> a owl:Class ;
    rdfs:label "CalibratedMeasurement" ;
    rdfs:comment "A measurement established by a device which is tested to a calibration standard of known accuracy." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CountryId> a owl:Class ;
    rdfs:label "CountryId" ;
    rdfs:comment "A character string to identify and distinguish uniquely, one instance of a country in an identification scheme from all other objects within the same scheme." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/FinancialCard> a owl:Class ;
    rdfs:label "FinancialCard" ;
    rdfs:comment "A card used to represent a financial account for a trade settlement." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/GeographicalGrid> a owl:Class ;
    rdfs:label "GeographicalGrid" ;
    rdfs:comment "The combination of the latitude and longitude forming a graticule, used for specifying the position of any location on the surface of the Earth, without consideration of altitude or depth (reference ISO 19136)." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Illness> a owl:Class ;
    rdfs:label "Illness" ;
    rdfs:comment "A WHO MDH (Maritime Declaration of Health) reported illness or disease for an onboard person." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LaboratoryObservationAnalysisMethod> a owl:Class ;
    rdfs:label "LaboratoryObservationAnalysisMethod" ;
    rdfs:comment "A defined way of performing laboratory observation analysis." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Marking> a owl:Class ;
    rdfs:label "Marking" ;
    rdfs:comment "An inscription, stamp or label on packaging, such as to indicate date, ownership, quality, manufacture or origin." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ObservationResultCharacteristic> a owl:Class ;
    rdfs:label "ObservationResultCharacteristic" ;
    rdfs:comment "Specifies the type of the performed observation and the acquired values of this observation on the sample." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/PaymentFinancialInstitution> a owl:Class ;
    rdfs:label "PaymentFinancialInstitution" ;
    rdfs:comment "An institution that provides financial services and financial transactions for payment." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Print> a owl:Class ;
    rdfs:label "Print" ;
    rdfs:comment "Any text or pattern put on the surface of a product using a specific material such as dye." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/RiskAnalysisResult> a owl:Class ;
    rdfs:label "RiskAnalysisResult" ;
    rdfs:comment "The result of a logistics risk analysis calculation." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Seal> a owl:Class ;
    rdfs:label "Seal" ;
    rdfs:comment "A device used to secure an object and protect it from unauthorized entry or tampering during transport or other logistics operations." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Standard> a owl:Class ;
    rdfs:label "Standard" ;
    rdfs:comment "A referenced norm or requirement that establishes uniform criteria, methods, processes and practices, such as in engineering or technical areas." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SubordinateTradeLineItem> a owl:Class ;
    rdfs:label "SubordinateTradeLineItem" ;
    rdfs:comment "A collection of information specific to a subordinate item being used or reported on for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TTAnimal> a owl:Class ;
    rdfs:label "TTAnimal" ;
    rdfs:comment "A Track and Trace (TT) animal or a group of animals, such as those kept or raised on a farm, ranch." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Tolerance> a owl:Class ;
    rdfs:label "Tolerance" ;
    rdfs:comment "Permissible limit or limits of variation that is fixed for the case in question but may be different in other cases." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/UnitMeasureType> a owl:Class ;
    rdfs:label "UnitMeasureType" ;
    rdfs:comment "A numeric value determined by measuring an object along with the specified unit of measure." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AgriculturalApplication> a owl:Class ;
    rdfs:label "AgriculturalApplication" ;
    rdfs:comment "Any substance such as seed, fertilizer, water, gas or chemical applied to an agricultural field, substrate, construction, plant, animal or product." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AgriculturalZoneArea> a owl:Class ;
    rdfs:label "AgriculturalZoneArea" ;
    rdfs:comment "A named, delimited and identified part of a land and or water surface of the globe subject to dedicated uniform agricultural treatment." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AppliedChemicalTreatment> a owl:Class ;
    rdfs:label "AppliedChemicalTreatment" ;
    rdfs:comment "A process of applying a chemical, physical, or biological agent to an object." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CropProduceBatch> a owl:Class ;
    rdfs:label "CropProduceBatch" ;
    rdfs:comment "A group of crop produce considered or dealt with together." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DeliveryInstructions> a owl:Class ;
    rdfs:label "DeliveryInstructions" ;
    rdfs:comment "Delivery information of an instructive nature." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DeliveryTerms> a owl:Class ;
    rdfs:label "DeliveryTerms" ;
    rdfs:comment "Conditions agreed upon between the parties with regard to the delivery of goods and or services for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DocumentContextParameter> a owl:Class ;
    rdfs:label "DocumentContextParameter" ;
    rdfs:comment "A feature that is fixed for a particular document context." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ExperienceFacility> a owl:Class ;
    rdfs:label "ExperienceFacility" ;
    rdfs:comment "A structure or place, such as a restaurant, hotel, theme park, hot spring bathing pool, parking lot, or meeting room, that provides a particular experience." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ExperienceProduct> a owl:Class ;
    rdfs:label "ExperienceProduct" ;
    rdfs:comment "Any service that provides an involvement, such as an adventure experience, wellness experience, social or business activity experience." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedLocation> a owl:Class ;
    rdfs:label "SpecifiedLocation" ;
    rdfs:comment "A specified physical location or place." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportationWasteMaterial> a owl:Class ;
    rdfs:label "TransportationWasteMaterial" ;
    rdfs:comment "Any materials unused and rejected as unwanted resulting from transportation." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/XHEReference> a owl:Class ;
    rdfs:label "XHEReference" ;
    rdfs:comment "Information related to an XHE (Exchange Header Envelope)." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Cheque> a owl:Class ;
    rdfs:label "Cheque" ;
    rdfs:comment "A written payment order to a bank to pay the stated sum from the drawer's account." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Classification> a owl:Class ;
    rdfs:label "Classification" ;
    rdfs:comment "A systematic arrangement of products in classes or categories according to established criteria." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CreditorFinancialAccount> a owl:Class ;
    rdfs:label "CreditorFinancialAccount" ;
    rdfs:comment "A specific business arrangement whereby credits arising from transactions are recorded." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ExchangedDocumentContext> a owl:Class ;
    rdfs:label "ExchangedDocumentContext" ;
    rdfs:comment "The scenario or setting of an exchanged document, such as its business process application context." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LogisticsStatus> a owl:Class ;
    rdfs:label "LogisticsStatus" ;
    rdfs:comment "The information relevant to a condition or a position related to logistics." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Plot> a owl:Class ;
    rdfs:label "Plot" ;
    rdfs:comment "A small piece of land or water used for a crop such as an agricultural or aquacultural crop." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TTParty> a owl:Class ;
    rdfs:label "TTParty" ;
    rdfs:comment "An individual, group, or body related to a Track and Trace (TT) process." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportInstructions> a owl:Class ;
    rdfs:label "TransportInstructions" ;
    rdfs:comment "Transport information of an instructive nature." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportationHealth> a owl:Class ;
    rdfs:label "TransportationHealth" ;
    rdfs:comment "Health indications to be reported on a WHO MDH (Maritime Declaration of Health)." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AnimalBatch> a owl:Class ;
    rdfs:label "AnimalBatch" ;
    rdfs:comment "A group of animals dealt with together." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Colour> a owl:Class ;
    rdfs:label "Colour" ;
    rdfs:comment "A colour of a product." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DocumentLineDocument> a owl:Class ;
    rdfs:label "DocumentLineDocument" ;
    rdfs:comment "A collection of data for a line on a piece of written, printed or electronic matter that provides information or evidence." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DurationUnitMeasureType> a owl:Class ;
    rdfs:label "DurationUnitMeasureType" ;
    rdfs:comment "A numeric value determined by measuring a duration of time." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/RadioactiveMaterial> a owl:Class ;
    rdfs:label "RadioactiveMaterial" ;
    rdfs:comment "Material capable of undergoing spontaneous nuclear decay involving emission of ionizing radiation in the form of particles or gamma rays." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SupplyChainTradeTransaction> a owl:Class ;
    rdfs:label "SupplyChainTradeTransaction" ;
    rdfs:comment "A group of supply chain trade line items, trade agreement, trade delivery and trade settlement details." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeAllowanceCharge> a owl:Class ;
    rdfs:label "TradeAllowanceCharge" ;
    rdfs:comment "A component of pricing, such as an allowance or charge for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AgriculturalCertificate> a owl:Class ;
    rdfs:label "AgriculturalCertificate" ;
    rdfs:comment "A legal proof of ownership, worthiness or qualification to operate an agricultural item." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AgriculturalProcess> a owl:Class ;
    rdfs:label "AgriculturalProcess" ;
    rdfs:comment "A practice of cultivating land, raising crops, or treatment of the agricultural produce." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/HandlingInstructions> a owl:Class ;
    rdfs:label "HandlingInstructions" ;
    rdfs:comment "Handling information of an instructive nature." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LogisticsLabel> a owl:Class ;
    rdfs:label "LogisticsLabel" ;
    rdfs:comment "A label used for identifying goods for logistics purposes, such as a barcode, a radio frequency tag or a Vehicle Identification Number (VIN)." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/PayloadInstance> a owl:Class ;
    rdfs:label "PayloadInstance" ;
    rdfs:comment "An individual set of transmitted data in an XHE (Exchange Header Envelope)." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TTAggregationEvent> a owl:Class ;
    rdfs:label "TTAggregationEvent" ;
    rdfs:comment "A Track and Trace (TT) event where objects or processes are grouped." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportRoute> a owl:Class ;
    rdfs:label "TransportRoute" ;
    rdfs:comment "A way or course taken from one location to another for the purpose of transporting cargo and or passengers." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/VolumeUnitMeasureType> a owl:Class ;
    rdfs:label "VolumeUnitMeasureType" ;
    rdfs:comment "The numeric value determined by volume measuring." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AgriculturalCharacteristic> a owl:Class ;
    rdfs:label "AgriculturalCharacteristic" ;
    rdfs:comment "A prominent attribute or aspect of an agricultural object." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DocumentStatus> a owl:Class ;
    rdfs:label "DocumentStatus" ;
    rdfs:comment "The information relevant to a condition related to a document." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/FinancingRequestDocument> a owl:Class ;
    rdfs:label "FinancingRequestDocument" ;
    rdfs:comment "The set of characteristics shared by all individual transactions grouped for this financing request document." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LinearUnitMeasureType> a owl:Class ;
    rdfs:label "LinearUnitMeasureType" ;
    rdfs:comment "The numeric value determined by linear measuring." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Picture> a owl:Class ;
    rdfs:label "Picture" ;
    rdfs:comment "A photograph or video still represented as a digital image for electronic sharing." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpatialDimension> a owl:Class ;
    rdfs:label "SpatialDimension" ;
    rdfs:comment "A measure of spatial extent of an object, such as the length, breadth or height of a shipping container." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedMaterial> a owl:Class ;
    rdfs:label "SpecifiedMaterial" ;
    rdfs:comment "A substance from which something is or could be made." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Assessment> a owl:Class ;
    rdfs:label "Assessment" ;
    rdfs:comment "The evaluation of an object, such as a product, process, or organization, with respect to the object's worth or condition." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/GeographicalFeature> a owl:Class ;
    rdfs:label "GeographicalFeature" ;
    rdfs:comment "Representation of real world phenomenon associated with a location relative to the Earth, such as cities, buildings, roads, rivers, forests and lakes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/InspectionResultCharacteristic> a owl:Class ;
    rdfs:label "InspectionResultCharacteristic" ;
    rdfs:comment "A property of a collection of diagnostic data, visual or technical data, obtained by a performed inspection." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/MDHHealthIndication> a owl:Class ;
    rdfs:label "MDHHealthIndication" ;
    rdfs:comment "Information related to a specific transportation indication to be reported on a WHO MDH (Maritime Declaration of Health)." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CustomsValuation> a owl:Class ;
    rdfs:label "CustomsValuation" ;
    rdfs:comment "A cross-border trade related assessment of the worth of an object, such as its monetary value, for customs purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ExchangedDeclaration> a owl:Class ;
    rdfs:label "ExchangedDeclaration" ;
    rdfs:comment "A collection of data for a piece of written, printed or electronic matter that is exchanged between two parties as a formal declaration." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/FinancialInstitutionAddress> a owl:Class ;
    rdfs:label "FinancialInstitutionAddress" ;
    rdfs:comment "The location at which a financial institution may be found or reached." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Product> a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A reference to a product or service produced by human or mechanical effort or by a natural process for trading purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SupplyChainPackaging> a owl:Class ;
    rdfs:label "SupplyChainPackaging" ;
    rdfs:comment "Any material with which supply chain goods are packaged, such as a box or bubble wrap." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeAddress> a owl:Class ;
    rdfs:label "TradeAddress" ;
    rdfs:comment "The location at which a particular trade related organization or person may be found or reached." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Chemical> a owl:Class ;
    rdfs:label "Chemical" ;
    rdfs:comment "Any clearly defined substance having a defined molecular composition." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/GeographicalCoordinate> a owl:Class ;
    rdfs:label "GeographicalCoordinate" ;
    rdfs:comment "A set of geographical coordinates of a specific point such as the longitude, latitude and altitude." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/PaymentTradeSettlement> a owl:Class ;
    rdfs:label "PaymentTradeSettlement" ;
    rdfs:comment "The information that enables the reconciliation of a payment with the item(s) that the payment is intended to settle, for example a commercial invoice." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeContact> a owl:Class ;
    rdfs:label "TradeContact" ;
    rdfs:comment "A person or a department that acts as a point of contact with another person or department in a trading relationship." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/WeightUnitMeasureType> a owl:Class ;
    rdfs:label "WeightUnitMeasureType" ;
    rdfs:comment "The numeric value determined by weight measuring." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CurrencyCodeList> a owl:Class ;
    rdfs:label "CurrencyCodeList" ;
    rdfs:comment "A character string used to represent a currency." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SupplyPlan> a owl:Class ;
    rdfs:label "SupplyPlan" ;
    rdfs:comment "Specification of the delivery quantities and date/time values in a supply schedule." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AccountingAccount> a owl:Class ;
    rdfs:label "AccountingAccount" ;
    rdfs:comment "A specific trade account for recording debits and credits to general accounting, cost accounting or budget accounting." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AcknowledgementDocument> a owl:Class ;
    rdfs:label "AcknowledgementDocument" ;
    rdfs:comment "A document exchanged between parties for a business application level acknowledgement of the receipt of information." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/BasicWorkItem> a owl:Class ;
    rdfs:label "BasicWorkItem" ;
    rdfs:comment "A basic item of work." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CurrencyExchange> a owl:Class ;
    rdfs:label "CurrencyExchange" ;
    rdfs:comment "The conversion of one currency to another for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ExperienceEvent> a owl:Class ;
    rdfs:label "ExperienceEvent" ;
    rdfs:comment "An involvement in an experience program in which some thing happens, such as a nature watching, woodware manufacturing, meditation, holiday trip, dinner, theme park visit, could be experienced." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/FieldCrop> a owl:Class ;
    rdfs:label "FieldCrop" ;
    rdfs:comment "A field with one or more cultivated plants or produce from one or more botanical species or varieties." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/PaymentTerms> a owl:Class ;
    rdfs:label "PaymentTerms" ;
    rdfs:comment "Terms and conditions by which payment has been or will be made for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Stowaway> a owl:Class ;
