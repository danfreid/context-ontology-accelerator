<https://vocabulary.uncefact.org/IOTDevice> a owl:Class ;
    rdfs:label "IOTDevice" ;
    rdfs:comment "An IOT (Internet of Things) piece of mechanical or electronic equipment which can collect, report and autonomously transmit digital data." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Location> a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A reference to a physical location or place." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LogisticsPackaging> a owl:Class ;
    rdfs:label "LogisticsPackaging" ;
    rdfs:comment "Any wrapping or containment, such as a box or a barrel, whether or not any goods are contained within." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/GuestPerson> a owl:Class ;
    rdfs:label "GuestPerson" ;
    rdfs:comment "An individual guest." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Machine> a owl:Class ;
    rdfs:label "Machine" ;
    rdfs:comment "An apparatus specified to be used to perform an activity to produce something." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ObservationResult> a owl:Class ;
    rdfs:label "ObservationResult" ;
    rdfs:comment "A collection of diagnostic data, visual or technical, and processing data, performed on a sample." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/PaymentMeans> a owl:Class ;
    rdfs:label "PaymentMeans" ;
    rdfs:comment "The means by which a payment will be or has been made for trade settlement purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SupplyChainInventory> a owl:Class ;
    rdfs:label "SupplyChainInventory" ;
    rdfs:comment "Supply chain goods and materials held in stock." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Service> a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A referenced service associated with a specified event during transport movement." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/BinaryFile> a owl:Class ;
    rdfs:label "BinaryFile" ;
    rdfs:comment "A specified computer file or program stored in a binary format." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ContactPerson> a owl:Class ;
    rdfs:label "ContactPerson" ;
    rdfs:comment "An individual human being in a position to give assistance or information." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Note> a owl:Class ;
    rdfs:label "Note" ;
    rdfs:comment "A textual or coded description, such as a remark or additional information." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Package> a owl:Class ;
