    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ExperienceItem> a owl:Class ;
    rdfs:label "ExperienceItem" ;
    rdfs:comment "A collection of information specific to the involvement of a person or persons in a happening, such as a theme park, a guided tour being used or reported on for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedCertificate> a owl:Class ;
    rdfs:label "SpecifiedCertificate" ;
    rdfs:comment "A document issued by a government, public organization or association to certify a property of a person, entity, process or object." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Authentication> a owl:Class ;
    rdfs:label "Authentication" ;
    rdfs:comment "A proof that a document is genuine." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportPerson> a owl:Class ;
    rdfs:label "TransportPerson" ;
    rdfs:comment "A transport related person, such as a member of a crew or a passenger." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductionFacility> a owl:Class ;
    rdfs:label "ProductionFacility" ;
    rdfs:comment "A man made physical structure, such as a building, in which something is produced." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Country> a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "The area of land that belongs to a nation together with its properties, such as population, political organization, etc., used or referenced for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductBatch> a owl:Class ;
    rdfs:label "ProductBatch" ;
    rdfs:comment "A group of products considered or dealt with together." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Communication> a owl:Class ;
    rdfs:label "Communication" ;
    rdfs:comment "The exchange of thoughts, messages, or information, as universally exchanged by speech, signals, writing, or behaviour between persons and/or organizations." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductionProcess> a owl:Class ;
    rdfs:label "ProductionProcess" ;
    rdfs:comment "A naturally occurring or designed sequence of operations or events in order to produce something." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ConsignmentItem> a owl:Class ;
    rdfs:label "ConsignmentItem" ;
    rdfs:comment "A reference to an item within a supply chain consignment of goods separately identified for transport and customs purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeSettlementHeaderMonetarySummation> a owl:Class ;
    rdfs:label "TradeSettlementHeaderMonetarySummation" ;
    rdfs:comment "A collection of monetary amount totals, specified at header level, for a trade settlement." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AssociatedTransportEquipment> a owl:Class ;
    rdfs:label "AssociatedTransportEquipment" ;
    rdfs:comment "A piece of transport equipment that is associated with another piece of transport equipment, such as a maritime container placed on a rail wagon for transportation." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/InspectionResult> a owl:Class ;
    rdfs:label "InspectionResult" ;
    rdfs:comment "Results obtained by performing an inspection." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LineTradeAgreement> a owl:Class ;
    rdfs:label "LineTradeAgreement" ;
    rdfs:comment "The contractual terms of a line trade agreement." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SupplyChainTradeLineItem> a owl:Class ;
    rdfs:label "SupplyChainTradeLineItem" ;
    rdfs:comment "A collection of information specific to an item being used or reported on for supply chain trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ProductInstance> a owl:Class ;
    rdfs:label "ProductInstance" ;
    rdfs:comment "An individual trade product or batch of similar trade products produced by human or mechanical effort or by a natural process." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ExchangedDocument> a owl:Class ;
    rdfs:label "ExchangedDocument" ;
    rdfs:comment "A collection of data for a piece of written, printed or electronic matter that is exchanged between two or more parties." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/CreditorFinancialInstitution> a owl:Class ;
    rdfs:label "CreditorFinancialInstitution" ;
    rdfs:comment "A bank, building society, credit union, stock brokerage, or similar business of the party that receives money." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/ServiceCharge> a owl:Class ;
    rdfs:label "ServiceCharge" ;
    rdfs:comment "A charge made for a logistics related service." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradePrice> a owl:Class ;
    rdfs:label "TradePrice" ;
    rdfs:comment "A sum of money for which something is or may be bought or sold for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LineTradeDelivery> a owl:Class ;
    rdfs:label "LineTradeDelivery" ;
    rdfs:comment "Shipping arrangements and movement of products and or services including despatch and delivery at a line level." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeTax> a owl:Class ;
    rdfs:label "TradeTax" ;
    rdfs:comment "A trade related fiscal levy or duty." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SupplyChainEvent> a owl:Class ;
    rdfs:label "SupplyChainEvent" ;
    rdfs:comment "A significant occurrence or happening in a supply chain." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LogisticsTransportMeans> a owl:Class ;
    rdfs:label "LogisticsTransportMeans" ;
    rdfs:comment "The devices used to convey goods or other objects from place to place during logistics cargo movements." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LogisticsTransportEquipment> a owl:Class ;
    rdfs:label "LogisticsTransportEquipment" ;
    rdfs:comment "A piece of equipment used to hold, protect or secure cargo for logistics purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/RegulatoryProcedure> a owl:Class ;
    rdfs:label "RegulatoryProcedure" ;
    rdfs:comment "A set of formal steps to satisfy a cross-border regulation, law or convention." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/SpecifiedPeriod> a owl:Class ;
    rdfs:label "SpecifiedPeriod" ;
    rdfs:comment "A specified period of time." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/LogisticsLocation> a owl:Class ;
    rdfs:label "LogisticsLocation" ;
    rdfs:comment "A logistics related physical location or place." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/HeaderTradeSettlement> a owl:Class ;
    rdfs:label "HeaderTradeSettlement" ;
    rdfs:comment "The information, at a header level, that enables the reconciliation of a financial transaction, with the item(s) that the financial transaction is intended to settle, such as a commercial invoice." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/HeaderTradeDelivery> a owl:Class ;
    rdfs:label "HeaderTradeDelivery" ;
    rdfs:comment "Shipping arrangements and movement of products and or services including despatch and delivery at a header level." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/DangerousGoods> a owl:Class ;
    rdfs:label "DangerousGoods" ;
    rdfs:comment "Goods which may contain a substance which poses risks to people and/or the environment during transportation which is regulated by dangerous goods regulations." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/HeaderTradeAgreement> a owl:Class ;
    rdfs:label "HeaderTradeAgreement" ;
    rdfs:comment "The contractual terms of a header trade agreement." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportEvent> a owl:Class ;
    rdfs:label "TransportEvent" ;
    rdfs:comment "A referenced significant occurrence or happening during transport." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/MeasureType> a owl:Class ;
    rdfs:label "MeasureType" ;
    rdfs:comment "Missing description" ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TransportMovement> a owl:Class ;
    rdfs:label "TransportMovement" ;
    rdfs:comment "The conveyance (physical carriage) of goods or other objects used for logistics transport purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/AmountType> a owl:Class ;
    rdfs:label "AmountType" ;
    rdfs:comment "A number of monetary units specified in a currency where the unit of the currency is explicit or implied." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/QuantityType> a owl:Class ;
    rdfs:label "QuantityType" ;
    rdfs:comment "Missing description" ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeProduct> a owl:Class ;
    rdfs:label "TradeProduct" ;
    rdfs:comment "Any tangible output or service produced by human or mechanical effort or by a natural process for trade purposes." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Document> a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "Written, printed or electronic matter that is referenced." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/TradeParty> a owl:Class ;
    rdfs:label "TradeParty" ;
    rdfs:comment "An individual, a group, or a body having a role in a trade business function." ;
    rdfs:subClassOf ns:Thing .

<https://vocabulary.uncefact.org/Consignment> a owl:Class ;
    rdfs:label "Consignment" ;
    rdfs:comment "A referenced, separately identifiable collection of goods items to be transported or available to be transported from one consignor to one consignee via one or more modes of transport where each consignment is the subject of one single transport contract." ;
    rdfs:subClassOf ns:Thing .

ns:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:comment "Synthesized root class" .

