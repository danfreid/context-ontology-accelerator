    rdfs:label "maturity level" ;
    rdfs:comment "classifier used to indicate the state of an artifact with respect to its development lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/CallEvent> a owl:Class ;
    rdfs:label "call event" ;
    rdfs:comment "an event associated with the call schedule for a debt instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/RedemptionEvent> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/CallFeature> a owl:Class ;
    rdfs:label "call feature" ;
    rdfs:comment "redemption provision defining the rights of the issuer to buy back a security at a call price after a call protection period" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/RedemptionProvision> ;
    skos:altLabel "call provision" .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/CallPremium> a owl:Class ;
    rdfs:label "call premium" ;
    rdfs:comment "the price over par paid by an issuer to redeem securities when exercising a call provision" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/CallSchedule> a owl:Class ;
    rdfs:label "call schedule" ;
    rdfs:comment "a schedule of call prices and when they are in effect" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/DebtOffering> a owl:Class ;
    rdfs:label "debt offering" ;
    rdfs:comment "an offering of one or more debt instruments for sale" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/SecuritiesOffering> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/NonTradableDebtInstrument> a owl:Class ;
    rdfs:label "non-tradable debt instrument" ;
    rdfs:comment "a debt instrument that may not be bought or sold" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/DebtInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/PubliclyIssuedDebt> a owl:Class ;
    rdfs:label "publicly issued debt" ;
    rdfs:comment "an issued debt in the form of a tradable debt instrument (security)" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/IssuedDebt> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/PutEvent> a owl:Class ;
    rdfs:label "put event" ;
    rdfs:comment "an event associated with the put schedule for a debt instrument, i.e., an event involving the 'put', or surrender of the instrument by the holder" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/RedemptionEvent> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/PutFeature> a owl:Class ;
    rdfs:label "put feature" ;
    rdfs:comment "redemption provision giving the holder the right, but not the obligation, to sell a specified amount of the debt instrument (i.e., redeem it), prior to maturity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> ;
    skos:altLabel "put provision" .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/PutPremium> a owl:Class ;
    rdfs:label "put premium" ;
    rdfs:comment "an amount over par that a debt instrument holder must pay to sell the security early" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/PutSchedule> a owl:Class ;
    rdfs:label "put schedule" ;
    rdfs:comment "a schedule that defines the events associated with the put feature of a debt instrument, i.e, the dates on which the debt instrument may be sold at what price by the holder" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/StepEvent> a owl:Class ;
    rdfs:label "step event" ;
    rdfs:comment "event that prescribes a change in a contractual term, such as a rate or notional amount, for a given contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/CalculationEvent> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/StepSchedule> a owl:Class ;
    rdfs:label "step schedule" ;
    rdfs:comment "schedule specifying the date(s) and change in a contractual term(s), e.g., rate or notional amount, for a contract that has a feature where stipulated changes occur at specified intervals or on specified dates" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/Strip> a owl:Class ;
    rdfs:label "strip" ;
    rdfs:comment "a tradeable debt instrument created either through the process of removing coupons from a bond and then selling the separate parts as a zero coupon bond and an interest paying coupon bond or through taking the opposite position from some variant in the options market" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/FixedIncomeSecurity> ;
    skos:altLabel "Separate Trading of Registered Interest and Principal of Securities" .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/hasInterestPaymentTerms> a owl:ObjectProperty ;
    rdfs:label "has interest payment terms" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestPaymentTerms> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/hasRelativePriceAtIssue> a owl:ObjectProperty ;
    rdfs:label "has relative price at issue" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/RelativePrice> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/hasRelativePriceAtRedemption> a owl:ObjectProperty ;
    rdfs:label "has relative price at redemption" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/RelativePrice> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Debt/DebtInstruments/hasRepaymentTerms> a owl:ObjectProperty ;
    rdfs:label "has repayment terms" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/PrincipalRepaymentTerms> .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/OfferingDocument> a owl:Class ;
    rdfs:label "offering document" ;
    rdfs:comment "legal document that states the objectives, risks and terms of an investment" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/SecurityForm> a owl:Class ;
