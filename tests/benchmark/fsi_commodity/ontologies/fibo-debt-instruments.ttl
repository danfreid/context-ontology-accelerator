@prefix ns: <https://w3id.org/ontology-registry/fibo-debt-instruments#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/hasRegisteredAddress> a owl:ObjectProperty ;
    rdfs:label "has registered address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalForm> a owl:Class ;
    rdfs:label "entity legal form" ;
    rdfs:comment "a classifier for a legal entity that indicates the nature of that entity as defined from a legal or regulatory perspective, in the jurisdiction in which it was established" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormIdentifier> a owl:Class ;
    rdfs:label "entity legal form identifier" ;
    rdfs:comment "code that denotes an entity legal form as defined in ISO 20275" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormScheme> a owl:Class ;
    rdfs:label "entity legal form scheme" ;
    rdfs:comment "scheme that specifies the elements of the codes for entity legal forms, such as those that are sanctioned in a given jurisdiction as defined in ISO 20725" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LEIRegisteredEntity> a owl:Class ;
    rdfs:label "LEI registered entity" ;
    rdfs:comment "a legal person that has registered for and is identified by a legal entity identifier" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifier> a owl:Class ;
    rdfs:label "legal entity identifier" ;
    rdfs:comment "an organization identifier that uniquely identifies a legal person as defined in ISO 17442" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifierScheme> a owl:Class ;
    rdfs:label "legal entity identifier scheme" ;
    rdfs:comment "a scheme that specifies the elements of an unambiguous legal entity identifier (LEI) scheme to identify the legal entities relevant to any financial transaction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatus> a owl:Class ;
    rdfs:label "relationship status" ;
    rdfs:comment "a classifier that specifies the status of the relationship between consolidated entities during the reporting period (active or inactive)" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/hasLegalAddress> a owl:ObjectProperty ;
    rdfs:label "has legal address" ;
    rdfs:domain <https://www.omg.org/spec/Commons/Organizations/LegalEntity> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/ConventionalStreetAddress> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/Authorization> a owl:Class ;
    rdfs:label "Authorization" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/AuthorizedParty> a owl:Class ;
    rdfs:label "AuthorizedParty" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/AuthorizingParty> a owl:Class ;
    rdfs:label "AuthorizingParty" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/authorizesThrough> a owl:ObjectProperty ;
    rdfs:label "authorizesThrough" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/hasAuthorizedParty> a owl:ObjectProperty ;
    rdfs:label "hasAuthorizedParty" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/hasAuthorizingParty> a owl:ObjectProperty ;
    rdfs:label "hasAuthorizingParty" .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/isAuthorizedThrough> a owl:ObjectProperty ;
    rdfs:label "isAuthorizedThrough" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention> a owl:Class ;
    rdfs:label "day-count convention" ;
    rdfs:comment "a business recurrence interval convention that is used to calculate the number of days in an interest payment, which applies to the amount of accrued interest or the present value for debt instruments" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/governsPaymentOf> a owl:ObjectProperty ;
    rdfs:label "governs payment of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/hasBorrower> a owl:ObjectProperty ;
    rdfs:label "has borrower" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Borrower> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/hasLender> a owl:ObjectProperty ;
    rdfs:label "has lender" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Lender> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isInterestOn> a owl:ObjectProperty ;
    rdfs:label "is interest on" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Interest> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwed> a owl:ObjectProperty ;
    rdfs:label "is owed" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwedBy> a owl:ObjectProperty ;
    rdfs:label "is owed by" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwedTo> a owl:ObjectProperty ;
    rdfs:label "is owed to" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isPrincipalOf> a owl:ObjectProperty ;
    rdfs:label "is principal of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Principal> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/owes> a owl:ObjectProperty ;
    rdfs:label "owes" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Issuer> a owl:Class ;
    rdfs:label "issuer" ;
    rdfs:comment "role of a party that makes (or proposes to make) one or more financial instruments available in some well-defined, typically formal way" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security> a owl:Class ;
    rdfs:label "security" ;
    rdfs:comment "financial instrument that can be bought or sold" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isDenominatedIn> a owl:ObjectProperty ;
    rdfs:label "is denominated in" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isLegallyRecordedIn> a owl:ObjectProperty ;
    rdfs:label "is legally recorded in" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/isNegotiable> a owl:DatatypeProperty ;
    rdfs:label "is negotiable" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityExpirationReason> a owl:Class ;
    rdfs:label "entity expiration reason" ;
    rdfs:comment "code for the reason that a legal entity ceased to exist and/or operate" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityStatus> a owl:Class ;
    rdfs:label "entity status" ;
    rdfs:comment "lifecycle stage indicating the operational and/or legal status of an entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/EntityValidationLevel> a owl:Class ;
    rdfs:label "entity validation level" ;
    rdfs:comment "code for the level of validation performed by the GLEIF or LOU with respect to the reference data provided by the registrant" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/BusinessRegistries/RegistrationStatus> a owl:Class ;
    rdfs:label "registration status" ;
    rdfs:comment "lifecycle stage indicating the status of a given registration of something, such as a business or legal entity, as specified by the registration authority" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/CryptoAssetServicesProvider> a owl:Class ;
    rdfs:label "crypto asset services provider" ;
    rdfs:comment "financial services provider that provides services for crypto assets that enable the control of crypto assets, and participate in, or provide, financial services for issuers' offers, or sale, of crypto assets" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialServiceProvider> ;
    skos:altLabel "CASP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/DataReportingServicesProvider> a owl:Class ;
    rdfs:label "data reporting services provider" ;
    rdfs:comment "market data provider and reporting party that reports and/or publishes data on securities transactions, including required regulatory reporting for such transactions, and as such is subject to regulatory supervision" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/Publishers/MarketDataProvider> ;
    skos:altLabel "DRSP" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange> a owl:Class ;
    rdfs:label "exchange" ;
    rdfs:comment "any organization, association, or group of persons, whether incorporated or unincorporated, which constitutes, maintains, or provides a facility for bringing together purchasers and sellers of financial instruments, commodities, or other products, services, or goods, and includes the market place and facilities maintained by such exchange" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "market" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketCategoryClassifier> a owl:Class ;
    rdfs:label "market category classifier" ;
    rdfs:comment "classifier representing the controlled vocabulary that delineates the nature of the exchange or data reporting services provider where possible" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketIdentifierCodeStatus> a owl:Class ;
    rdfs:label "market indicator code status" ;
    rdfs:comment "lifecycle stage indicating the status of the MIC code, as specified by the registration authority" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/MarketLevelClassifier> a owl:Class ;
    rdfs:label "market level classifier" ;
    rdfs:comment "classifier that indicates whether the exchange or data reporting services provider is an operating level or market segment level facility" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/TradeReportingFacility> a owl:Class ;
    rdfs:label "trade reporting facility" ;
    rdfs:comment "facility that provides a mechanism for the reporting of transactions effected otherwise than on an exchange" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "TRF" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/operatesInCountry> a owl:ObjectProperty ;
    rdfs:label "operates in country" ;
    rdfs:range <https://www.omg.org/spec/Commons/Locations/Country> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/operatesInMunicipality> a owl:ObjectProperty ;
    rdfs:label "operates in municipality" ;
    rdfs:range <https://www.omg.org/spec/Commons/Locations/Municipality> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/FinancialService> a owl:Class ;
    rdfs:label "financial service" ;
    rdfs:comment "service provided to consumers and businesses by financial institutions such as banks, insurance companies, brokerage firms, consumer finance companies, and investment companies" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/Service> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Offeror> a owl:Class ;
    rdfs:label "offeror" ;
    rdfs:comment "party that proposes to make something available to someone (i.e., an offeree) based on the terms of the offering" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Trade> a owl:Class ;
    rdfs:label "trade" ;
    rdfs:comment "situation that realizes an agreement between parties participating in a voluntary action of buying and selling goods and services" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/TradeLifecycle> a owl:Class ;
    rdfs:label "trade lifecycle" ;
    rdfs:comment "lifecycle that defines the evolution of a trade, from initiation through settlement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/Lifecycle> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/TradeLifecycleEvent> a owl:Class ;
    rdfs:label "trade lifecycle event" ;
    rdfs:comment "kind of event that occurs during one or more stages of the lifecycle of a trade" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEvent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/TradeLifecycleStage> a owl:Class ;
    rdfs:label "trade lifecycle stage" ;
    rdfs:comment "phase in the lifecycle of a trade" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/hasOfferingPrice> a owl:ObjectProperty ;
    rdfs:label "has offering price" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryPrice> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/isEmbodiedIn> a owl:ObjectProperty ;
    rdfs:label "is embodied in" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasAmount> a owl:DatatypeProperty ;
    rdfs:label "has amount" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> a owl:ObjectProperty ;
    rdfs:label "has currency" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasNumericCode> a owl:DatatypeProperty ;
    rdfs:label "has numeric code" ;
    rdfs:range xsd:string .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasPrice> a owl:ObjectProperty ;
    rdfs:label "has price" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Price> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/isPriceFor> a owl:ObjectProperty ;
    rdfs:label "is price for" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Price> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/hasObligation> a owl:ObjectProperty ;
    rdfs:label "has obligation" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/isObligationOf> a owl:ObjectProperty ;
    rdfs:label "is obligation of" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasContractParty> a owl:ObjectProperty ;
    rdfs:label "has contract party" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasContractualElement> a owl:ObjectProperty ;
    rdfs:label "has contractual element" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> a owl:ObjectProperty ;
    rdfs:label "has counterparty" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasGoverningJurisdiction> a owl:ObjectProperty ;
    rdfs:label "has governing jurisdiction" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasPrincipalParty> a owl:ObjectProperty ;
    rdfs:label "has principal party" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/isAssignable> a owl:DatatypeProperty ;
    rdfs:label "is assignable" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/isEvidenceFor> a owl:ObjectProperty ;
    rdfs:label "is evidence for" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/isEvidencedBy> a owl:ObjectProperty ;
    rdfs:label "is evidenced by" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/hasExpirationDate> a owl:ObjectProperty ;
    rdfs:label "has expiration date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/IndexingScheme> a owl:Class ;
    rdfs:label "indexing scheme" ;
    rdfs:comment "system for indexing values, data, information, or knowledge" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/isIndexTo> a owl:ObjectProperty ;
    rdfs:label "is index to" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/IdentifiersAndIndices/Index> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEventOccurrence> a owl:Class ;
    rdfs:label "lifecycle event occurrence" ;
    rdfs:comment "realization of an event in a stage of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleOccurrence> a owl:Class ;
    rdfs:label "lifecycle occurrence" ;
    rdfs:comment "realization of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStageOccurrence> a owl:Class ;
    rdfs:label "lifecycle stage occurrence" ;
    rdfs:comment "realization of a phase in a given lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/hasLifecycle> a owl:ObjectProperty ;
    rdfs:label "has lifecycle" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/Lifecycle> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/hasStage> a owl:ObjectProperty ;
    rdfs:label "has stage" .

