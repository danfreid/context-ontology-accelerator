@prefix ns: <https://w3id.org/ontology-registry/fibo-debt#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> a owl:Class ;
    rdfs:label "functional entity" ;
    rdfs:comment "party defined in terms of a function they or it performs" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalForm> a owl:Class ;
    rdfs:label "entity legal form" ;
    rdfs:comment "a classifier for a legal entity that indicates the nature of that entity as defined from a legal or regulatory perspective, in the jurisdiction in which it was established" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormIdentifier> a owl:Class ;
    rdfs:label "entity legal form identifier" ;
    rdfs:comment "code that denotes an entity legal form as defined in ISO 20275" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/EntityLegalFormScheme> a owl:Class ;
    rdfs:label "entity legal form scheme" ;
    rdfs:comment "scheme that specifies the elements of the codes for entity legal forms, such as those that are sanctioned in a given jurisdiction as defined in ISO 20725" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LEIRegisteredEntity> a owl:Class ;
    rdfs:label "LEI registered entity" ;
    rdfs:comment "a legal person that has registered for and is identified by a legal entity identifier" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/LegalPerson> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifier> a owl:Class ;
    rdfs:label "legal entity identifier" ;
    rdfs:comment "an organization identifier that uniquely identifies a legal person as defined in ISO 17442" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/LegalEntityIdentifierScheme> a owl:Class ;
    rdfs:label "legal entity identifier scheme" ;
    rdfs:comment "a scheme that specifies the elements of an unambiguous legal entity identifier (LEI) scheme to identify the legal entities relevant to any financial transaction" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> .

<https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LEIEntities/RelationshipStatus> a owl:Class ;
    rdfs:label "relationship status" ;
    rdfs:comment "a classifier that specifies the status of the relationship between consolidated entities during the reporting period (active or inactive)" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Amortization> a owl:Class ;
    rdfs:label "amortization" ;
    rdfs:comment "the process of reduction of debt or other costs through periodic charges to assets or liabilities, such as through principal payments on mortgages" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/AmortizationSchedule> a owl:Class ;
    rdfs:label "amortization schedule" ;
    rdfs:comment "schedule of periodic payments (repayment installments) that specify changes in the balance of the debt over time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/ProjectedContractEventSchedule> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Borrower> a owl:Class ;
    rdfs:label "borrower" ;
    rdfs:comment "party to a credit agreement that is obligated to repay the amount borrowed (principal) with interest and other fees according to the terms of the instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Collateral> a owl:Class ;
    rdfs:label "collateral" ;
    rdfs:comment "something pledged as security to ensure fulfillment of an obligation to another party, to lend money, extend credit, or provision securities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditFacility> a owl:Class ;
    rdfs:label "credit facility" ;
    rdfs:comment "credit agreement that allows the borrower to periodically take out money over an extended period of time rather than reapplying for a loan every time they need funds" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically> ;
    skos:altLabel "master commitment" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DayCountConvention> a owl:Class ;
    rdfs:label "day-count convention" ;
    rdfs:comment "a business recurrence interval convention that is used to calculate the number of days in an interest payment, which applies to the amount of accrued interest or the present value for debt instruments" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/FixedInterestRate> a owl:Class ;
    rdfs:label "fixed interest rate" ;
    rdfs:comment "interest rate that does not fluctuate over the lifetime of a loan or other debt instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/InterestRate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/FloatingInterestRate> a owl:Class ;
    rdfs:label "floating interest rate" ;
    rdfs:comment "variable interest rate that is based on a specific index or benchmark rate" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/VariableInterestRate> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/InterestPaymentTerms> a owl:Class ;
    rdfs:label "interest payment terms" ;
    rdfs:comment "contract terms for payment of interest on a debt" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Lender> a owl:Class ;
    rdfs:label "lender" ;
    rdfs:comment "a party that extends credit or money to a borrower with the expectation of being repaid, usually with interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/PrincipalRepaymentTerms> a owl:Class ;
    rdfs:label "principal repayment terms" ;
    rdfs:comment "contract terms that specify requirements for repayment of the principal" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/SecurityAgreement> a owl:Class ;
    rdfs:label "security agreement" ;
    rdfs:comment "collateral agreement that grants a financial interest in some collateral to a party that is not an owner of that collateral, specifying terms including relative duties and rights, over and above those specified in the primary contract, regarding the disposition of the asset used as collateral" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CollateralAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/governsPaymentOf> a owl:ObjectProperty ;
    rdfs:label "governs payment of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/DebtTerms> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/hasAnticipatedNumberOfPayments> a owl:DatatypeProperty ;
    rdfs:label "has anticipated number of payments" ;
    rdfs:range xsd:positiveInteger .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isInterestOn> a owl:ObjectProperty ;
    rdfs:label "is interest on" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Interest> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwed> a owl:ObjectProperty ;
    rdfs:label "is owed" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwedBy> a owl:ObjectProperty ;
    rdfs:label "is owed by" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isOwedTo> a owl:ObjectProperty ;
    rdfs:label "is owed to" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isPrincipalOf> a owl:ObjectProperty ;
    rdfs:label "is principal of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Principal> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/owes> a owl:ObjectProperty ;
    rdfs:label "owes" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Trade> a owl:Class ;
    rdfs:label "trade" ;
    rdfs:comment "situation that realizes an agreement between parties participating in a voluntary action of buying and selling goods and services" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/TradeLifecycle> a owl:Class ;
    rdfs:label "trade lifecycle" ;
    rdfs:comment "lifecycle that defines the evolution of a trade, from initiation through settlement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/Lifecycle> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/TradeLifecycleEvent> a owl:Class ;
    rdfs:label "trade lifecycle event" ;
    rdfs:comment "kind of event that occurs during one or more stages of the lifecycle of a trade" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEvent> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/TradeLifecycleStage> a owl:Class ;
    rdfs:label "trade lifecycle stage" ;
    rdfs:comment "phase in the lifecycle of a trade" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/isEmbodiedIn> a owl:ObjectProperty ;
    rdfs:label "is embodied in" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasAmount> a owl:DatatypeProperty ;
    rdfs:label "has amount" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> a owl:ObjectProperty ;
    rdfs:label "has currency" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasMonetaryAmount> a owl:ObjectProperty ;
    rdfs:label "has monetary amount" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasNumericCode> a owl:DatatypeProperty ;
    rdfs:label "has numeric code" ;
    rdfs:range xsd:string .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasRateValue> a owl:DatatypeProperty ;
    rdfs:label "has rate value" ;
    rdfs:range xsd:decimal .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/hasObligation> a owl:ObjectProperty ;
    rdfs:label "has obligation" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/isObligationOf> a owl:ObjectProperty ;
    rdfs:label "is obligation of" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractDocument> a owl:Class ;
    rdfs:label "contract document" ;
    rdfs:comment "legal document that records the formal terms and conditions of some contract" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasContractParty> a owl:ObjectProperty ;
    rdfs:label "has contract party" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasContractualElement> a owl:ObjectProperty ;
    rdfs:label "has contractual element" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> a owl:ObjectProperty ;
    rdfs:label "has counterparty" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasPrincipalParty> a owl:ObjectProperty ;
    rdfs:label "has principal party" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/isAssignable> a owl:DatatypeProperty ;
    rdfs:label "is assignable" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/isEvidenceFor> a owl:ObjectProperty ;
    rdfs:label "is evidence for" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/isEvidencedBy> a owl:ObjectProperty ;
    rdfs:label "is evidenced by" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/isPrimaryContractFor> a owl:ObjectProperty ;
    rdfs:label "is primary contract for" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/isSubordinateTo> a owl:ObjectProperty ;
    rdfs:label "is subordinate to" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/QuantitativeValue> a owl:Class ;
    rdfs:label "quantitative value" ;
    rdfs:comment "value determined via quantitative methods, expressed as a numerical value in appropriate units" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/hasEstimatedValue> a owl:ObjectProperty ;
    rdfs:label "has estimated value" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AppraisedValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/isEstimatedValueOf> a owl:ObjectProperty ;
    rdfs:label "is estimated value of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AppraisedValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEventOccurrence> a owl:Class ;
    rdfs:label "lifecycle event occurrence" ;
    rdfs:comment "realization of an event in a stage of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleOccurrence> a owl:Class ;
    rdfs:label "lifecycle occurrence" ;
    rdfs:comment "realization of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStageOccurrence> a owl:Class ;
    rdfs:label "lifecycle stage occurrence" ;
    rdfs:comment "realization of a phase in a given lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/hasLifecycle> a owl:ObjectProperty ;
    rdfs:label "has lifecycle" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/Lifecycle> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/hasStage> a owl:ObjectProperty ;
    rdfs:label "has stage" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/isLifecycleOf> a owl:ObjectProperty ;
    rdfs:label "is lifecycle of" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/Lifecycle> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/isStageOf> a owl:ObjectProperty ;
    rdfs:label "is stage of" .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessDayConvention> a owl:Class ;
    rdfs:label "business day convention" ;
    rdfs:comment "convention that enumerates the possible ways to handle a date that falls on a weekend or holiday" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> ;
    skos:altLabel "business day adjustment" .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/DayOfWeek> a owl:Class ;
    rdfs:label "day of the week" ;
    rdfs:comment "specific, recurring day of the week" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceInterval> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/hasBusinessRecurrenceIntervalConvention> a owl:ObjectProperty ;
    rdfs:label "has business recurrence interval convention" ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CalculatedDate> a owl:Class ;
    rdfs:label "calculated date" ;
    rdfs:comment "date that is or will be determined based on some formula" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/hasCount> a owl:DatatypeProperty ;
    rdfs:label "has count" ;
    rdfs:range xsd:positiveInteger .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/hasOverallPeriod> a owl:ObjectProperty ;
    rdfs:label "has overall period" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/hasEventDate> a owl:ObjectProperty ;
    rdfs:label "has event date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/hasEventDateValue> a owl:DatatypeProperty ;
    rdfs:label "has event date value" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/SecondaryUnitDesignator> a owl:Class ;
    rdfs:label "secondary unit designator" ;
    rdfs:comment "classifier for a smaller structure or component within a larger facility, such as an apartment, office, mail stop, or other similar designation" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Addresses/requiresSecondaryUnitRange> a owl:DatatypeProperty ;
    rdfs:label "requires secondary unit range" ;
    rdfs:range xsd:boolean .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/PaymentSchedule> a owl:Class ;
    rdfs:label "payment schedule" ;
    rdfs:comment "schedule for delivery of money in fulfillment of an obligation" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/Schedule> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/hasPaymentAmount> a owl:ObjectProperty ;
    rdfs:label "has payment amount" ;
    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/PaymentsAndSchedules/Payment> ;
    rdfs:range <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Customer> a owl:Class ;
    rdfs:label "customer" ;
    rdfs:comment "party that receives or consumes products (goods or services) and has the ability to choose between different products and suppliers" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Buyer> .

