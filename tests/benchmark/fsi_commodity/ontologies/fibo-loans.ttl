    rdfs:label "has related party role" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    rdfs:range <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/hasSubjectRole> a owl:ObjectProperty ;
    rdfs:label "has subject role" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> ;
    rdfs:range <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/hasUndergoer> a owl:ObjectProperty ;
    rdfs:label "has undergoer" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> ;
    rdfs:range <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/holdsDuring> a owl:ObjectProperty ;
    rdfs:label "holds during" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/DatePeriod> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/isAPartyTo> a owl:ObjectProperty ;
    rdfs:label "is a party to" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/isObjectRoleIn> a owl:ObjectProperty ;
    rdfs:label "is object role in" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/isSubjectRoleIn> a owl:ObjectProperty ;
    rdfs:label "is subject role in" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> ;
    rdfs:range <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/undergoes> a owl:ObjectProperty ;
    rdfs:label "undergoes" ;
    rdfs:domain <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> ;
    rdfs:range <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasDimension> a owl:ObjectProperty ;
    rdfs:label "has dimension" ;
    rdfs:domain <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityDimension> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasMeasurementUnit> a owl:ObjectProperty ;
    rdfs:label "has measurement unit" ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasNumericValue> a owl:DatatypeProperty ;
    rdfs:label "has numeric value" ;
    rdfs:range xsd:decimal .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasQuantityKind> a owl:ObjectProperty ;
    rdfs:label "has quantity kind" ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/hasQuantityValue> a owl:ObjectProperty ;
    rdfs:label "has quantity value" ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/isDimensionOf> a owl:ObjectProperty ;
    rdfs:label "is dimension of" ;
    rdfs:domain <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityDimension> ;
    rdfs:range <https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/isValueOf> a owl:ObjectProperty ;
    rdfs:label "is value of" ;
    rdfs:domain <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/RegisteredIdentifier> a owl:Class ;
    rdfs:label "registered identifier" ;
    rdfs:comment "contextual identifier that is registered in a registry by, or on behalf of, a registration authority according to some registration scheme" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualIdentifiers/ContextualIdentifier> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistrationAuthority> a owl:Class ;
    rdfs:label "registration authority" ;
    rdfs:comment "service provider that is officially responsible for maintaining a registry and providing registration services and/or for delegating of some or all of these roles to a registrar" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizingParty> ;
    skos:altLabel "RA" .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/RegistrationScheme> a owl:Class ;
    rdfs:label "registration scheme" ;
    rdfs:comment "scheme for organizing information in a registry and allocating identifiers to registered items" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/hasRegistrationDate> a owl:DatatypeProperty ;
    rdfs:label "has registration date" ;
    rdfs:range <https://www.omg.org/spec/Commons/DatesAndTimes/CombinedDateTime> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/isRegisteredBy> a owl:ObjectProperty ;
    rdfs:label "is registered by" ;
    rdfs:range <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registrar> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/isRegisteredIn> a owl:ObjectProperty ;
    rdfs:label "is registered in" ;
    rdfs:range <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/registers> a owl:ObjectProperty ;
    rdfs:label "registers" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegistrationAuthorities/Registrar> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/hasReach> a owl:ObjectProperty ;
    rdfs:label "has reach" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> ;
    rdfs:range <https://www.omg.org/spec/Commons/Locations/GeographicRegion> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/isRecognizedIn> a owl:ObjectProperty ;
    rdfs:label "is recognized in" ;
    rdfs:range <https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/Composition> a owl:Class ;
    rdfs:label "composition" ;
    rdfs:comment "distinct thing resulting from bringing together other things, possibly in specific roles, for a particular purpose" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RolesAndCompositions/hasRole> a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:range <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/isPlayedBy> a owl:ObjectProperty ;
    rdfs:label "is played by" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/isRoleIn> a owl:ObjectProperty ;
    rdfs:label "is role in" ;
    rdfs:domain <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/playsRole> a owl:ObjectProperty ;
    rdfs:label "plays role" ;
    rdfs:range <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> a owl:Class ;
    rdfs:label "functional entity" ;
    rdfs:comment "party defined in terms of a function they or it performs" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> .

<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeJureControllingInterestParty> a owl:Class ;
    rdfs:label "de jure controlling interest party" ;
    rdfs:comment "party that has the legal authority to exercise control" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Borrower> a owl:Class ;
    rdfs:label "borrower" ;
    rdfs:comment "party to a credit agreement that is obligated to repay the amount borrowed (principal) with interest and other fees according to the terms of the instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Collateral> a owl:Class ;
    rdfs:label "collateral" ;
    rdfs:comment "something pledged as security to ensure fulfillment of an obligation to another party, to lend money, extend credit, or provision securities" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically> a owl:Class ;
    rdfs:label "credit agreement repaid periodically" ;
    rdfs:comment "credit agreement in which the principal and accrued interest may be periodically repaid or exchanged" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreement> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Lender> a owl:Class ;
    rdfs:label "lender" ;
    rdfs:comment "a party that extends credit or money to a borrower with the expectation of being repaid, usually with interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Guaranty/Guarantor> a owl:Class ;
    rdfs:label "guarantor" ;
    rdfs:comment "party that guarantees, endorses, or provides indemnity for some obligation on behalf of some other party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/ControlParties/DeJureControllingInterestParty> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account> a owl:Class ;
    rdfs:label "account" ;
    rdfs:comment "container for records associated with a business arrangement for regular transactions and services" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Balance> a owl:Class ;
    rdfs:label "balance" ;
    rdfs:comment "amount of money available or owed" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/OpenDate> a owl:Class ;
    rdfs:label "open date" ;
    rdfs:comment "date on which something was created" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligee> a owl:Class ;
    rdfs:label "obligee" ;
    rdfs:comment "party to whom some commitment or obligation is owed, either legally or per the terms of an agreement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/CollateralAgreement> a owl:Class ;
    rdfs:label "collateral agreement" ;
    rdfs:comment "written contract related to another contract designed to provide clarity and additional protection for all parties involved, that is separate from the primary contract and that can be independently enforced" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractThirdParty> a owl:Class ;
    rdfs:label "contract third party" ;
    rdfs:comment "party that is indirectly involved in, but not a counterparty to, an agreement" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualCommitment> a owl:Class ;
    rdfs:label "contractual commitment" ;
    rdfs:comment "provision specifying something that the contracting parties agree to, i.e., a promise or pledge made by one of the parties to perform some action or fulfill some duty" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Counterparty> a owl:Class ;
    rdfs:label "counterparty" ;
    rdfs:comment "party to a contract with whom one negotiates on a given agreement" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/MarketValue> a owl:Class ;
    rdfs:label "market value" ;
    rdfs:comment "price an asset would sell for in the market" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleEvent> a owl:Class ;
    rdfs:label "lifecycle event" ;
    rdfs:comment "kind of event that occurs during one or more stages of a lifecycle" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceInterval> a owl:Class ;
    rdfs:label "business recurrence interval" ;
    rdfs:comment "recurrence interval that is defined per a specific convention that determines how recurring days should be handled" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/OccurrenceKind> a owl:Class ;
    rdfs:label "occurrence kind" ;
    rdfs:comment "classifier that specifies the general nature of an occurrence (event)" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan> a owl:Class ;
    rdfs:label "loan" ;
    rdfs:comment "debt instrument whereby one party extends money or credit to another party (or parties) with the understanding that the borrowed money will be repaid according to the terms of the contract" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreementRepaidPeriodically> .

<https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeSet> a owl:Class ;
    rdfs:label "code set" ;
    rdfs:comment "system of alpha-numeric symbols, or combinations of symbols, that stand for specified values in some context" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "coding scheme" .

<https://www.omg.org/spec/Commons/ContextualDesignators/Context> a owl:Class ;
    rdfs:label "context" ;
    rdfs:comment "situation or frame of reference in which something applies, exists, happens, or is used and that helps to illustrate or explain it" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/ContextualDesignators/ContextualDesignation> a owl:Class ;
    rdfs:label "contextual designation" ;
    rdfs:comment "designation that applies to something in some context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://www.omg.org/spec/Commons/ContextualIdentifiers/ContextualIdentifier> a owl:Class ;
    rdfs:label "contextual identifier" ;
    rdfs:comment "sequence of characters uniquely identifying that with which it is associated, within a specified context" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/ContextualDesignation> .

<https://www.omg.org/spec/Commons/Organizations/LegalPerson> a owl:Class ;
    rdfs:label "legal person" ;
    rdfs:comment "party that is recognized as having rights and obligations under the law, including but not limited to the right to sue and be sued, enter into contracts, own property, and incur financial and other obligations" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Party> .

<https://www.omg.org/spec/Commons/Organizations/OrganizationIdentificationScheme> a owl:Class ;
    rdfs:label "organization identification scheme" ;
    rdfs:comment "identification scheme dedicated to the unique identification of organizations" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Organizations/OrganizationIdentifier> a owl:Class ;
    rdfs:label "organisation identifier" ;
    rdfs:comment "identifier assigned to an organization within an organization identification scheme, and unique within that scheme" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Identifiers/Identifier> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Agent> a owl:Class ;
    rdfs:label "agent" ;
    rdfs:comment "something autonomous that can adapt to and interact with its environment" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> a owl:Class ;
    rdfs:label "agent role" ;
    rdfs:comment "role played by any agent" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantity> a owl:Class ;
    rdfs:label "scalar quantity" ;
    rdfs:comment "property of a phenomenon, body, or substance, where the property has a magnitude that can be expressed by means of a number and a reference" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/Registry> a owl:Class ;
    rdfs:label "registry" ;
    rdfs:comment "authoritative record or collection of records relating to something" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/CreditAgreement> a owl:Class ;
    rdfs:label "credit agreement" ;
    rdfs:comment "contractual agreement in which a debtor receives something of value and typically agrees to repay the creditor by some date in the future, in some form (e.g., cash, securities, etc.), generally with interest" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Principal> a owl:Class ;
    rdfs:label "principal" ;
    rdfs:comment "with respect to a debt: the value of an obligation, such as a bond or loan, raised and that must be repaid at maturity; for investments: the original amount of money invested, separate from any associated interest, dividends or capital gains" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument> a owl:Class ;
    rdfs:label "financial instrument" ;
    rdfs:comment "written contract that gives rise to both a financial asset of one entity and a financial liability of another entity" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency> a owl:Class ;
    rdfs:label "currency" ;
    rdfs:comment "medium of exchange value, defined by reference to the geographical location of the monetary authorities responsible for it" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> ;
    skos:altLabel "currency unit",
        "monetary unit" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> a owl:Class ;
    rdfs:label "agreement" ;
    rdfs:comment "negotiated understanding between two or more parties, reflecting the offer and acceptance of commitments on the part of either party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> a owl:Class ;
    rdfs:label "commitment" ;
    rdfs:comment "promise made by some party to act or refrain from acting in some manner" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractPrincipal> a owl:Class ;
    rdfs:label "contract principal" ;
    rdfs:comment "party that originates a contract and is identified as the first party to that contract, in the event that the contract distinguishes any party as such" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractualElement> a owl:Class ;
    rdfs:label "contractual element" ;
    rdfs:comment "element, such as an arrangement, provision, requirement, rule, specification, and standard that forms an integral part of an agreement" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AppraisedValue> a owl:Class ;
    rdfs:label "appraised value" ;
    rdfs:comment "estimated value of some asset as of a given point in time" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/MarketValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Supplier> a owl:Class ;
    rdfs:label "supplier" ;
    rdfs:comment "party that provides goods or services that some party wants or needs, especially over a long period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/SecuredLoan> a owl:Class ;
    rdfs:label "secured loan" ;
    rdfs:comment "loan in which the borrower pledges some asset via a security agreement as collateral for the loan, or that is secured via third-party guarantee" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan> .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizedParty> a owl:Class ;
    rdfs:label "authorised party" ;
    rdfs:comment "party that has been given the ability to act on behalf of another party or to have specified capabilities under some set of guidelines for some period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> .

<https://www.omg.org/spec/Commons/DatesAndTimes/Duration> a owl:Class ;
    rdfs:label "duration" ;
    rdfs:comment "interval of time of some specific length" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/DatesAndTimes/ExplicitDate> a owl:Class ;
    rdfs:label "explicit date" ;
    rdfs:comment "date in which the 'has date value' property is required" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/Date> .

<https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> a owl:Class ;
    rdfs:label "time instant" ;
    rdfs:comment "temporal entity that is a member of a time scale, with no extent or duration" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "instant in time",
        "time point" .

<https://www.omg.org/spec/Commons/Locations/GeographicRegion> a owl:Class ;
    rdfs:label "geographic region" ;
    rdfs:comment "area of land that has common features" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Organizations/ServiceProvider> a owl:Class ;
    rdfs:label "service provider" ;
    rdfs:comment "role of an agent that provides some service, including but not limited to commercial or professional services" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/MeasurementUnit> a owl:Class ;
    rdfs:label "measurement unit" ;
    rdfs:comment "real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the second quantity to the first one as a number" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantity> ;
    skos:altLabel "unit of measurement" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityDimension> a owl:Class ;
    rdfs:label "quantity dimension" ;
    rdfs:comment "expression of the dependence of a quantity on the base quantities of a system of quantities as a product of powers of factors corresponding to the base quantities, omitting any numerical factor" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "dimension",
        "dimension of a quantity" .

<https://www.omg.org/spec/Commons/RegistrationAuthorities/Registrar> a owl:Class ;
    rdfs:label "registrar" ;
    rdfs:comment "role of a party that acts as a representative of a registration authority to provide registration services, including official record keeping" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Organizations/ServiceProvider> .

<https://www.omg.org/spec/Commons/RegulatoryAgencies/Jurisdiction> a owl:Class ;
    rdfs:label "jurisdiction" ;
    rdfs:comment "power of a court or regulatory agency to adjudicate cases, issue orders, and interpret and apply the law with respect to some specific geographic area" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/ContextualDesignators/Context> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/FunctionalRole> a owl:Class ;
    rdfs:label "functional role" ;
    rdfs:comment "role representing an underlying functionality that something, such as a person, organization, process, or service, is expected to perform or deliver" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Creditor> a owl:Class ;
    rdfs:label "creditor" ;
    rdfs:comment "a party to whom an obligation, such as an amount of money, or good, or performance of some service exists" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligee> .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debtor> a owl:Class ;
    rdfs:label "debtor" ;
    rdfs:comment "a party that owes a debt or other obligation to another party" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Obligor> a owl:Class ;
    rdfs:label "obligor" ;
    rdfs:comment "party that is bound legally or by agreement to repay a debt, make a payment, do something, or refrain from doing something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "obligated party",
        "obligator" .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/ContractParty> a owl:Class ;
    rdfs:label "contract party" ;
    rdfs:comment "legally competent party that has entered into a binding agreement, accepting and conceding obligations, responsibilities, and benefits as specified" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/Lifecycle> a owl:Class ;
    rdfs:label "lifecycle" ;
    rdfs:comment "arrangement that compares the cyclical nature of families, organizations, processes, products, marketing, and order management, portfolio management or other systems with the cradle to grave life stages (birth, growth, maturity, decay, and death) of living organisms" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/BusinessRecurrenceIntervalConvention> a owl:Class ;
    rdfs:label "business recurrence interval convention" ;
    rdfs:comment "convention that specifies how recurring days should be handled, such as the end of the month, a particular day of the month, a day of the week, or more specifically, a t-bill auction date" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> a owl:Class ;
    rdfs:label "occurrence" ;
    rdfs:comment "happening of an OccurrenceKind, i.e., an event" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "event" .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/AuthorizingParty> a owl:Class ;
    rdfs:label "authorising party" ;
    rdfs:comment "party that delegates some role, authority, or control to another party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> .

<https://www.omg.org/spec/Commons/CodesAndCodeSets/CodeElement> a owl:Class ;
    rdfs:label "code element" ;
    rdfs:comment "sequence of characters denoting something for some purpose, within a specified context, according to some rule set" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://www.omg.org/spec/Commons/DatesAndTimes/DatePeriod> a owl:Class ;
    rdfs:label "date period" ;
    rdfs:comment "time span over one or more calendar days" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/Identifiers/Identifier> a owl:Class ;
    rdfs:label "identifier" ;
    rdfs:comment "sequence of characters uniquely identifying that with which it is associated" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Designators/Designation> .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/QuantityKind> a owl:Class ;
    rdfs:label "quantity kind" ;
    rdfs:comment "aspect common to mutually comparable quantities" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "kind of quantity" .

<https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/Debt> a owl:Class ;
    rdfs:label "debt" ;
    rdfs:comment "obligation to pay something, such as an amount of money, good, service, or instrument" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Commitment> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/MonetaryAmount> a owl:Class ;
    rdfs:label "monetary amount" ;
    rdfs:comment "measure that is an amount of money specified in monetary units" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Lifecycles/LifecycleStage> a owl:Class ;
    rdfs:label "lifecycle stage" ;
    rdfs:comment "phase in a lifecycle" ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControlledThing> a owl:Class ;
    rdfs:label "controlled thing" ;
    rdfs:comment "something over which some party exercises some form of control with respect to some situation" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Asset> a owl:Class ;
    rdfs:label "asset" ;
    rdfs:comment "something of monetary value that is owned or provides benefit to some party" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> ;
    skos:altLabel "economic resource" .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Owner> a owl:Class ;
    rdfs:label "owner" ;
    rdfs:comment "party that is legally recognized as having the right to possess, the privilege to use, and ability to transfer any rights or privileges associated with something, as permitted by law" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Ownership> a owl:Class ;
    rdfs:label "ownership" ;
    rdfs:comment "situation in which some party holds the legal title to something (explicitly or implicitly) and has the right to transfer that title and/or possession" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Product> a owl:Class ;
    rdfs:label "product" ;
    rdfs:comment "commercially distributed good that is (1) tangible property, (2) the output or result of a fabrication, manufacturing, or production process, or (3) something that passes through a distribution channel before being consumed or used." ;
    rdfs:subClassOf ns:Thing .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Seller> a owl:Class ;
    rdfs:label "seller" ;
    rdfs:comment "party that makes, offers or contracts to make a sale to an actual or potential buyer" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "purveyor",
        "vendor" .

<https://www.omg.org/spec/Commons/BusinessAuthorizations/Authorization> a owl:Class ;
    rdfs:label "authorisation" ;
    rdfs:comment "situation in which a party authorizes someone to act on their behalf or to have specific capabilities under certain conditions for some period of time" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://www.omg.org/spec/Commons/DatesAndTimes/Date> a owl:Class ;
    rdfs:label "date" ;
    rdfs:comment "calendar day on some calendar" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/DatesAndTimes/TimeInstant> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Party> a owl:Class ;
    rdfs:label "party" ;
    rdfs:comment "person or organization" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Agent> ;
    skos:altLabel "independent party" .

<https://www.omg.org/spec/Commons/QuantitiesAndUnits/ScalarQuantityValue> a owl:Class ;
    rdfs:label "scalar quantity value" ;
    rdfs:comment "number and reference together expressing the magnitude of a quantity" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "measurement",
        "value of a quantity" .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/Control> a owl:Class ;
    rdfs:label "control" ;
    rdfs:comment "situation in which some party has the power to direct or strongly influence the direction of the management and policies related to something" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> .

<https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Control/ControllingParty> a owl:Class ;
    rdfs:label "controlling party" ;
    rdfs:comment "actor that exercises some form of control in the context of some situation" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> .

<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Buyer> a owl:Class ;
    rdfs:label "buyer" ;
    rdfs:comment "party that purchases something in exchange for money or other consideration under a contract of sale" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> ;
    skos:altLabel "buyer",
        "purchaser" .

<https://www.omg.org/spec/Commons/Designators/Designation> a owl:Class ;
    rdfs:label "designation" ;
    rdfs:comment "representation for something, or for a conceptualization thereof, that denotes it in a domain or subject" ;
    rdfs:subClassOf ns:Thing ;
    skos:altLabel "designator" .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Actor> a owl:Class ;
    rdfs:label "actor" ;
    rdfs:comment "primary performer in a relationship between parties, i.e., the party that does something, causes something to happen, or otherwise plays an agentive role in the relationship" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Undergoer> a owl:Class ;
    rdfs:label "undergoer" ;
    rdfs:comment "something that plays the role of the object or recipient in a situation, i.e., the thing (or party) that the situation impacts, affects, or that otherwise plays a passive recipient / patient or thematic role" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/RolesAndCompositions/Role> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> a owl:Class ;
    rdfs:label "contract" ;
    rdfs:comment "voluntary, deliberate agreement between competent parties to which the parties agree to be legally bound, and for which the parties provide valuable consideration" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Agreements/Agreement> .

<https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/WrittenContract> a owl:Class ;
    rdfs:label "written contract" ;
    rdfs:comment "formal contract that is written and signed by the parties thereto" ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract> .

<https://www.omg.org/spec/Commons/RolesAndCompositions/Role> a owl:Class ;
    rdfs:label "role" ;
    rdfs:comment "named specific behavior of something participating in a particular context" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/PartiesAndSituations/Situation> a owl:Class ;
    rdfs:label "situation" ;
    rdfs:comment "setting, state of being, or relationship that is relatively stable for some period of time" ;
    rdfs:subClassOf ns:Thing .

<https://www.omg.org/spec/Commons/PartiesAndSituations/PartyRole> a owl:Class ;
    rdfs:label "party role" ;
    rdfs:comment "role played by an organization or individual that may be time bound" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/PartiesAndSituations/AgentRole> .

ns:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:comment "Synthesized root class" .

