#!/usr/bin/env bash
# Test double for the AWS CLI (see coa-deploy-project.test.ts). Never talks to AWS.
# FAKE_AWS_DIR holds: outcomes (line N = "STATUS:TIMED_OUT_PHASES" for build N, PHASES may be
# ERR), stack.<name> (one status per line, consumed in order; MISSING or DENIED simulate
# errors), calls.log (every call).
d="$FAKE_AWS_DIR"
echo "$*" >> "$d/calls.log"
arg_after() {
  local key="$1"
  shift
  while [ $# -gt 0 ]; do
    if [ "$1" = "$key" ]; then echo "$2"; return; fi
    shift
  done
}
case "$1 $2" in
  "--version "*) echo "aws-cli/2.15.0 Python/3.11 Linux/x86_64" ;;
  "cloudformation describe-stacks")
    name="$(arg_after --stack-name "$@")"
    if [ "$name" = "coa-codebuild-deploy" ]; then echo "coa-deploy"; exit 0; fi
    f="$d/stack.$name"
    if [ ! -f "$f" ]; then echo "UPDATE_COMPLETE"; exit 0; fi
    st="$(head -n 1 "$f")"
    if [ "$(wc -l < "$f")" -gt 1 ]; then tail -n +2 "$f" > "$f.tmp" && mv "$f.tmp" "$f"; fi
    if [ "$st" = "MISSING" ]; then
      echo "An error occurred (ValidationError) when calling the DescribeStacks operation: Stack with id $name does not exist" >&2
      exit 254
    fi
    if [ "$st" = "DENIED" ]; then echo "An error occurred (AccessDenied)" >&2; exit 254; fi
    echo "$st"
    ;;
  "codebuild start-build")
    n=$(( $(cat "$d/count" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$d/count"
    printf '%s\n' "$@" > "$d/start-build.$n.args"
    echo "coa-deploy:$n"
    ;;
  "codebuild batch-get-projects")
    case "$*" in
      *"name=='SCL_PREFIX'"*) echo "${FAKE_PROJECT_PREFIX:-coa}" ;;
      *"name=='COA_DEPLOY_ENV'"*) echo "dev" ;;
      *"name=='COA_REPO_URL'"*) echo "https://example.com/org/repo" ;;
      *"name=='COA_REPO_REF'"*) echo "main" ;;
      *) echo "None" ;;
    esac
    ;;
  "codebuild batch-get-builds")
    id="$(arg_after --ids "$@")"
    n="${id##*:}"
    line="$(sed -n "${n}p" "$d/outcomes" 2>/dev/null || true)"
    if [ -z "$line" ]; then line="${FAKE_BUILD_STATUS:-SUCCEEDED}:0"; fi
    status="${line%%:*}"
    phases="${line#*:}"
    case "$*" in
      *buildStatus*)
        if [ -n "${FAKE_STATUS_FAIL:-}" ]; then echo "throttled" >&2; exit 254; fi
        echo "$status"
        ;;
      *"length(@)"*)
        if [ "$phases" = "ERR" ]; then echo "throttled" >&2; exit 254; fi
        echo "$phases"
        ;;
      *timeoutInMinutes*) echo "45" ;;
      *) echo "None" ;;
    esac
    ;;
  *) echo "unexpected aws call: $*" >&2; exit 9 ;;
esac
